  hDeserHelpers : subroutine_ok
    (CryptoVerification.SignalSession.Cli.RunProofs.DecryptPrekeyHelpers.dpPollProgPlaced
      (cliGhostExterns gh (cliExternsPlaced mmpl W)))
    (lsmpl.base 46)
    (sessDeserializeSpecPlaced scopeKit

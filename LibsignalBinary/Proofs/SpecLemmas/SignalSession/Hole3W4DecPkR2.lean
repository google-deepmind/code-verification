  hG : CliGhostAllocHooks fineCostModel
    (fineHookRustCliAllocBudget γ mmpl tp brkStart) cliBudgetLimits gh
  hh : RunHooksPlaced (fineHookRustCliAllocBudget γ mmpl tp brkStart) cliBudgetLimits

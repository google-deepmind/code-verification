HEX40_RE = re.compile(r"^[0-9a-f]{40}$")
HEX64_RE = re.compile(r"^[0-9a-f]{64}$")
PLACEHOLDER_RE = re.compile(r"^<([A-Z0-9_]+)(?::([^>]+))?>$")

SCRUB_EXACT_ENV_KEYS: tuple[str, ...] = (
    "RUSTUP_TOOLCHAIN",
    "RUST_OBJ2LEAN_PERTURB_BYTES",
    "RUSTFLAGS",
    "CARGO_ENCODED_RUSTFLAGS",
    "CFLAGS",
    "CPPFLAGS",
    "CXXFLAGS",
    "LDFLAGS",
    "CC",
    "CXX",
    "AR",
    "RANLIB",
    "LLD",
    "OBJCOPY",
    "LLVM_OBJCOPY",
)
SCRUB_PREFIX_ENV_KEYS: tuple[str, ...] = (
    "CARGO_BUILD_",
    "CARGO_TARGET_",
    "CARGO_PROFILE_",
    "ZIG_",
)
PRESERVE_ZIG_CACHE_KEYS: frozenset[str] = frozenset(
    {"ZIG_GLOBAL_CACHE_DIR", "ZIG_LOCAL_CACHE_DIR"}
)


def _scrub_build_env(env: dict[str, str], *, preserve_zig_cache: bool = False) -> list[str]:
    """Scrub ambient toolchain/compiler/Cargo/Zig overrides from `env`, returning sorted scrubbed keys."""
    scrubbed: list[str] = []
    for k in list(env.keys()):
        if preserve_zig_cache and k in PRESERVE_ZIG_CACHE_KEYS:
            continue
        if k in SCRUB_EXACT_ENV_KEYS or any(k.startswith(pfx) for pfx in SCRUB_PREFIX_ENV_KEYS):
            env.pop(k, None)
            scrubbed.append(k)
    scrubbed.sort()
    return scrubbed


def _env_scrub_checked_spec(*, preserve_zig_cache: bool = False) -> list[str]:
    """Return sorted list of exact keys + prefix patterns checked by `_scrub_build_env`."""
    exact = [
        k
        for k in SCRUB_EXACT_ENV_KEYS
        if not (preserve_zig_cache and k in PRESERVE_ZIG_CACHE_KEYS)
    ]
    prefixes = [f"{pfx}*" for pfx in SCRUB_PREFIX_ENV_KEYS]
    return sorted([*exact, *prefixes])


def _resolve_scrubbed_pinned_toolchain(
    lock: dict[str, Any], tmp_dir: pathlib.Path
) -> tuple[dict[str, str], list[str]]:
    """Scrub `os.environ` BEFORE probing `rustc`/`ld.lld`/`llvm-objcopy`/`zig` so `RUSTUP_TOOLCHAIN`
    or ambient linker/compiler flags can never leak into toolchain resolution or child builds."""
    tmp_dir.mkdir(parents=True, exist_ok=True)
    env = os.environ.copy()
    scrubbed_keys = _scrub_build_env(env, preserve_zig_cache=False)
    env["TMPDIR"] = str(tmp_dir)

    rustc_vv = subprocess.run(
        ["rustc", "-vV"], capture_output=True, text=True, check=True, env=env
    ).stdout
    release = ""
    for line in rustc_vv.splitlines():
        if line.startswith("release:"):
            release = line.split(":", 1)[1].strip()
            break
    if release != lock["rustc_version"]:
        raise RuntimeError(
            f"rustc release mismatch: expected {lock['rustc_version']!r}, got {release!r}"
        )

    tlibdir = subprocess.run(
        ["rustc", "--print", "target-libdir"],
        capture_output=True,
        text=True,
        check=True,
        env=env,
    ).stdout.strip()
    sysroot_bin = pathlib.Path(tlibdir).parent / "bin"
    lld = sysroot_bin / "gcc-ld" / "ld.lld"
    objcopy = sysroot_bin / "llvm-objcopy"
    if not (lld.is_file() and os.access(lld, os.X_OK)):
        raise RuntimeError(f"pinned sysroot ld.lld not found at {lld}")
    if not (objcopy.is_file() and os.access(objcopy, os.X_OK)):
        raise RuntimeError(f"pinned sysroot llvm-objcopy not found at {objcopy}")

    lld_ver = subprocess.run(
        [str(lld), "--version"], capture_output=True, text=True, check=True, env=env
    ).stdout.strip()
    if not lld_ver.startswith(lock["lld_version_prefix"]):
        raise RuntimeError(
            f"sysroot ld.lld version mismatch: expected prefix {lock['lld_version_prefix']!r}, got {lld_ver!r}"
        )
    subprocess.run([str(objcopy), "--version"], capture_output=True, text=True, check=True, env=env)

    zig = _BASE.find_zig_binary(lock["zig_version"])
    env["LLD"] = str(lld)
    env["LLVM_OBJCOPY"] = str(objcopy)
    env["ZIG"] = str(zig)
    return env, scrubbed_keys


def _expected_engine_commit(lock: dict[str, Any]) -> str:
    c1 = lock.get("arm64_semantics_commit")
    c2 = lock.get("engine_commit")
    if c1 and c2 and c1 != c2:
        raise RuntimeError(
            f"lock file has conflicting arm64_semantics_commit={c1!r} vs engine_commit={c2!r}"
        )
    commit = str(c1 or c2 or "")
    if not HEX40_RE.match(commit):
        raise RuntimeError(
            f"lock file must pin a full 40-hex engine commit, got {commit!r}"
        )
    return commit


def _verify_clean_pinned_engine(
    engine_dir: pathlib.Path,
    exp_eng: str,
    *,
    allow_explicit_mismatch: bool = False,
    ci_mode: bool = False,
) -> str:
    """F3: Verify `engine_dir` is a clean git checkout at 40-hex `HEAD == exp_eng` (unless explicit
    `--engine` override is permitted on non-`--verify-pin` commands via `allow_explicit_mismatch`,
    which still requires a clean 40-hex git commit and records `explicit_engine=True`). When
    `engine_dir` exists without `.git` (flattened source export) and neither
    `allow_explicit_mismatch` nor `ci_mode` is set, emit a note to stderr and return `exp_eng`
    without running `git` (which would walk up to an enclosing repository)."""
    if not HEX40_RE.match(exp_eng):
        raise RuntimeError(f"expected 40-hex engine commit, got {exp_eng!r}")
    if not engine_dir.is_dir():
        raise RuntimeError(
            f"engine directory missing at {engine_dir} (cannot verify pinned commit)"
        )
    if not (engine_dir / ".git").exists():
        if allow_explicit_mismatch or ci_mode:
            raise RuntimeError(
                f"engine git metadata missing at {engine_dir / '.git'} (cannot verify pinned commit)"
            )
        print(
            f"note: {engine_dir.name} has no git metadata (source export); trusting lock pin {exp_eng}",
            file=sys.stderr,
        )
        return exp_eng
    head_res = subprocess.run(
        ["git", "-C", str(engine_dir), "rev-parse", "--verify", "HEAD"],
        capture_output=True,
        text=True,
        check=False,
    )
    if head_res.returncode != 0:
        raise RuntimeError(
            f"git rev-parse HEAD failed in {engine_dir}: {head_res.stderr.strip()}"
        )
    eng_head = head_res.stdout.strip()
    if not HEX40_RE.match(eng_head):
        raise RuntimeError(f"engine HEAD is not a 40-hex commit: {eng_head!r}")
    if eng_head != exp_eng and not allow_explicit_mismatch:
        raise RuntimeError(
            f"arm64-semantics HEAD {eng_head!r} != pinned lock commit {exp_eng!r}"
        )
    dirty_res = subprocess.run(
        ["git", "-C", str(engine_dir), "status", "--porcelain", "--untracked-files=normal"],
        capture_output=True,
        text=True,
        check=False,
    )
    if dirty_res.returncode != 0:
        raise RuntimeError(
            f"git status failed in {engine_dir}: {dirty_res.stderr.strip()}"
        )
    if dirty_res.stdout.strip():
        raise RuntimeError(
            f"arm64-semantics working tree is dirty at {engine_dir}:\n{dirty_res.stdout.strip()}"
        )
    return eng_head


def _build_fresh_snapshot_link(engine_dir: pathlib.Path, env: dict[str, str]) -> pathlib.Path:
    """F3: Build `snapshot-link` via Cargo (`--locked`) so a stale prebuilt binary is never used."""
    manifest = engine_dir / "tools" / "Cargo.toml"
    if not manifest.is_file():
        raise RuntimeError(f"engine tools manifest missing: {manifest}")
    subprocess.run(
        [
            "cargo",
            "build",
            "--release",
            "--quiet",
            "--locked",
            "--manifest-path",
            str(manifest),
            "--bin",
            "snapshot-link",
        ],
        cwd=str(engine_dir),
        check=True,
        env=env,
    )
    bin_path = engine_dir / "tools" / "target" / "release" / "snapshot-link"
    if not bin_path.is_file() or not os.access(bin_path, os.X_OK):
        raise RuntimeError(f"freshly built snapshot-link binary missing at {bin_path}")
    return bin_path


def derive_placed_expectations(
    repo_root: pathlib.Path,
    cfg_path: pathlib.Path | None = None,
    base_lock_path: pathlib.Path | None = None,
    stock_lock: Mapping[str, Any] | None = None,
) -> dict[str, Any]:
    """(b) & F2: Recipe-driven derivation of placed block/data counts, `[placed].exports`, and
    `libsignalSessionExterns` directly from `.GeneratedLean/**/LibsignalSessionPlacedObj.{lean,bin}`,
    `translation.toml`, and optional lock pins (never hard-coded Python constants)."""
    gen_root = repo_root / ".GeneratedLean"
    if not gen_root.is_dir():
        raise RuntimeError(
            f"missing `.GeneratedLean` directory at {gen_root} (refusing silent externs fallback)"
        )
    placed_candidates = sorted(
        p for p in gen_root.glob("**/LibsignalSessionPlacedObj.lean") if p.is_file()
    )
    bin_candidates = sorted(
        p for p in gen_root.glob("**/LibsignalSessionPlacedObj.bin") if p.is_file()
    )
    if len(placed_candidates) != 1 or len(bin_candidates) != 1:
        raise RuntimeError(
            f"expected exactly 1 LibsignalSessionPlacedObj.{{lean,bin}} under {gen_root}, "
            f"found lean={placed_candidates}, bin={bin_candidates}"
        )

    lib = elf_loader.parse_multi_placed_lib(placed_candidates[0], bin_candidates[0])
    if not lib.blocks:
        raise RuntimeError("LibsignalSessionPlacedObj has 0 blocks")

    externs = list(lib.blocks[0].externs)
    if not externs or len(set(externs)) != len(externs):
        raise RuntimeError("LibsignalSessionPlacedObj has empty or duplicate externs list")
    for idx, blk in enumerate(lib.blocks[1:], start=1):
        if list(blk.externs) != externs:
            raise RuntimeError(f"LibsignalSessionPlacedObj block[{idx}] externs differ from block[0]")

    eff_cfg = (
        cfg_path
        if cfg_path is not None
        else (repo_root / "third_party/libsignal/libsignal-session/translation.toml")
    )
    if not eff_cfg.is_file():
        raise RuntimeError(f"translation.toml missing at {eff_cfg}")
    cfg = tomllib.loads(eff_cfg.read_text(encoding="utf-8"))
    cfg_exports = [str(x) for x in cfg.get("placed", {}).get("exports", [])]
    if (
        not cfg_exports
        or len(set(cfg_exports)) != len(cfg_exports)
        or "main" not in cfg_exports
        or set(cfg_exports) != set(lib.exports)
    ):
        raise RuntimeError(
            f"exports mismatch: translation.toml={cfg_exports!r}, PlacedObj={lib.exports!r}"
        )
    if stock_lock is not None and "expected_exports" in stock_lock:
        exp_exps = [str(x) for x in stock_lock["expected_exports"]]
        if cfg_exports != exp_exps:
            raise RuntimeError(
                f"translation.toml [placed].exports {cfg_exports!r} != lock expected_exports {exp_exps!r}"
            )

    eff_lock = base_lock_path if base_lock_path is not None else (repo_root / DEFAULT_REL_LOCK)
    legacy_stub_count: int | None = None
    if eff_lock.is_file():
        base_lock = tomllib.loads(eff_lock.read_text(encoding="utf-8"))
        if "expected_stub_count" in base_lock:
            legacy_stub_count = int(base_lock["expected_stub_count"])
            if (
                stock_lock is not None
                and "expected_legacy_stub_count" in stock_lock
                and legacy_stub_count != int(stock_lock["expected_legacy_stub_count"])
            ):
                raise RuntimeError(
                    f"inputs.lock expected_stub_count {legacy_stub_count} != lock "
                    f"expected_legacy_stub_count {int(stock_lock['expected_legacy_stub_count'])}"
                )

    if stock_lock is not None:
        if "expected_placed_blocks" in stock_lock and len(lib.blocks) != int(
            stock_lock["expected_placed_blocks"]
        ):
            raise RuntimeError(
                f"LibsignalSessionPlacedObj block count {len(lib.blocks)} != lock "
                f"expected_placed_blocks {int(stock_lock['expected_placed_blocks'])}"
            )
        if "expected_placed_data_objects" in stock_lock and len(lib.data) != int(
            stock_lock["expected_placed_data_objects"]
        ):
            raise RuntimeError(
                f"LibsignalSessionPlacedObj data count {len(lib.data)} != lock "
                f"expected_placed_data_objects {int(stock_lock['expected_placed_data_objects'])}"
            )
        if "expected_extern_count" in stock_lock and len(externs) != int(
            stock_lock["expected_extern_count"]
        ):
            raise RuntimeError(
                f"LibsignalSessionPlacedObj extern count {len(externs)} != lock "
                f"expected_extern_count {int(stock_lock['expected_extern_count'])}"
            )

    placed_code_bytes = sum(len(b.code) for b in lib.blocks)
    placed_data_bytes = sum(len(d.bytes_slice) + d.zeroTail for d in lib.data)
    return {
        "blocks": len(lib.blocks),
        "placed_code_bytes": placed_code_bytes,
        "data_objects": len(lib.data),
        "placed_data_bytes": placed_data_bytes,
        "exports": cfg_exports,
        "externs": externs,
        "extern_count": len(externs),
        "legacy_expected_stub_count": legacy_stub_count,
        "musl_text_size": PROOF_MUSL_TEXT_SIZE,
    }


def _canonical_stub_manifest_bytes(stub_manifest: Sequence[dict[str, Any]]) -> bytes:
    if not stub_manifest:
        raise RuntimeError("stub_manifest must not be empty")
    normalized = sorted(
        (
            {
                "kind": str(entry["kind"]),
                "name": str(entry["name"]),
                "size": int(entry["size"]),
            }
            for entry in stub_manifest
        ),
        key=lambda item: item["name"],
    )
    if [item["name"] for item in normalized] != [str(e["name"]) for e in stub_manifest]:
        raise RuntimeError("stub_manifest entries must be sorted by `name` with unique names")
    if len({item["name"] for item in normalized}) != len(normalized):
        raise RuntimeError("stub_manifest contains duplicate symbol names")
    return json.dumps(normalized, separators=(",", ":"), sort_keys=True).encode("utf-8")


def stub_manifest_sha256(stub_manifest: Sequence[dict[str, Any]]) -> str:
    return hashlib.sha256(_canonical_stub_manifest_bytes(stub_manifest)).hexdigest()


def _c_str_at(strtab: bytes, off: int) -> str:
    if off < 0 or off >= len(strtab):
        return ""
    end = strtab.find(b"\x00", off)
    if end < 0:
        end = len(strtab)
    return strtab[off:end].decode("utf-8", errors="replace")


def _elf64_syms_and_relocs(
    obj: bytes,
) -> tuple[set[str], set[str], dict[str, set[int]], list[tuple[str, int, int, int, int, int, bool]]]:
    """F1: Parse an input relocatable `.o` member for stub synthesis, failing closed if
    section headers are missing/truncated or if `SHT_SYMTAB` count != 1."""
    if len(obj) < 64 or obj[:4] != b"\x7fELF":
        raise ValueError("not an ELF64 object")
    if obj[4] != 2 or obj[5] != 1:
        raise ValueError("expected 64-bit little-endian ELF object")
    (e_shoff,) = struct.unpack_from("<Q", obj, 40)
    e_shentsize, e_shnum, _ = struct.unpack_from("<HHH", obj, 58)
    if e_shoff == 0 or e_shnum == 0 or e_shentsize < 64:
        raise ValueError(
            f"input ELF object missing valid section header table (e_shoff={e_shoff}, e_shnum={e_shnum}, e_shentsize={e_shentsize})"
        )
    if e_shoff + e_shnum * e_shentsize > len(obj):
        raise ValueError("input ELF object section header table truncated")

    shdrs = [
        struct.unpack_from("<IIQQQQIIQQ", obj, e_shoff + i * e_shentsize)
        for i in range(e_shnum)
    ]
    symtab_secs = [idx for idx, sh in enumerate(shdrs) if sh[1] == 2]  # SHT_SYMTAB
    if len(symtab_secs) != 1:
        raise ValueError(
            f"input ELF object must contain exactly 1 SHT_SYMTAB section, found {len(symtab_secs)}"
        )

    defined: set[str] = set()
    undefined: set[str] = set()
    reloc_types: dict[str, set[int]] = {}
    all_syms: list[tuple[str, int, int, int, int, int, bool]] = []
    sym_names_by_sec: dict[int, list[str]] = {}

    for sec_idx in symtab_secs:
        sh = shdrs[sec_idx]
        _sh_type, sh_offset, sh_size, sh_link, sh_info, sh_entsize = (
            sh[1],
            sh[4],
            sh[5],
            sh[6],
            sh[7],
            sh[9],
        )
        if sh_entsize < 24 or sh_size % sh_entsize != 0 or sh_offset + sh_size > len(obj):
            raise ValueError("malformed SHT_SYMTAB bounds or entsize in input ELF object")
        if sh_link == 0 or sh_link >= e_shnum:
            raise ValueError(f"invalid SHT_SYMTAB sh_link={sh_link} in input ELF object")
        str_sh = shdrs[sh_link]
        if str_sh[4] + str_sh[5] > len(obj):
            raise ValueError("truncated SHT_STRTAB in input ELF object")
        strtab = obj[str_sh[4] : str_sh[4] + str_sh[5]]
        names: list[str] = []
        count = sh_size // sh_entsize
        for i in range(count):
            st_name, st_info, _st_other, st_shndx, st_value, st_size = struct.unpack_from(
                "<IBBHQQ", obj, sh_offset + i * sh_entsize
            )
            name = _c_str_at(strtab, st_name)
            names.append(name)
            bind = st_info >> 4
            stype = st_info & 0xF
            all_syms.append((name, bind, stype, st_shndx, st_value, st_size, i >= sh_info))
            if i == 0 or not name:
                continue
            if st_shndx == 0:
                if bind in (1, 2):  # STB_GLOBAL, STB_WEAK
                    undefined.add(name)
            else:
                if bind in (1, 2):
                    defined.add(name)
        sym_names_by_sec[sec_idx] = names

    for sh in shdrs:
        sh_type, sh_offset, sh_size, sh_link, _sh_info, sh_entsize = (
            sh[1],
            sh[4],
            sh[5],
            sh[6],
            sh[7],
            sh[9],
        )
        if sh_type != 4:  # SHT_RELA
            continue
        if sh_entsize < 24 or sh_size % sh_entsize != 0 or sh_offset + sh_size > len(obj):
            raise ValueError("malformed SHT_RELA section in input ELF object")
        names = sym_names_by_sec.get(sh_link)
        if not names:
            raise ValueError(f"SHT_RELA references missing SHT_SYMTAB sh_link={sh_link}")
        for i in range(sh_size // sh_entsize):
            _r_offset, r_info, _r_addend = struct.unpack_from(
                "<QQq", obj, sh_offset + i * sh_entsize
            )
            sym_idx = r_info >> 32
            rtype = r_info & 0xFFFFFFFF
            if 0 < sym_idx < len(names) and names[sym_idx]:
                reloc_types.setdefault(names[sym_idx], set()).add(rtype)

    return defined, undefined, reloc_types, all_syms


def _iter_archive_elf_members(ar_bytes: bytes) -> list[bytes]:
    """F7: Parse Unix `.a` archive members, failing closed on truncated headers, non-ELF object
    members (e.g. LLVM bitcode / LTO IR), or empty archives."""
    if not ar_bytes.startswith(b"!<arch>\n"):
        raise ValueError("not a Unix ar archive")
    pos = 8
    members: list[bytes] = []
    n = len(ar_bytes)
    while pos < n:
        if pos + 60 > n:
            raise ValueError("truncated Unix ar member header")
        hdr = ar_bytes[pos : pos + 60]
        if hdr[58:60] != b"`\n":
            raise ValueError(f"invalid Unix ar member magic {hdr[58:60]!r}")
        pos += 60
        member_name = hdr[:16].decode("ascii", errors="replace").strip()
        size_str = hdr[48:58].decode("ascii", errors="replace").strip()
        if not size_str.isdigit():
            raise ValueError(f"non-numeric Unix ar member size {size_str!r} for {member_name!r}")
        size = int(size_str)
        if pos + size > n:
            raise ValueError(f"truncated Unix ar member body for {member_name!r}")
        body = ar_bytes[pos : pos + size]
        pos += size + (size & 1)
        if member_name in ARCHIVE_SPECIAL_MEMBER_NAMES:
            continue
        if not body.startswith(b"\x7fELF"):
            raise ValueError(
                f"non-ELF archive member {member_name!r} (head={body[:8]!r}); bitcode/non-ELF members forbidden"
            )
        members.append(body)
    if not members:
        raise ValueError("Unix ar archive contains 0 ELF object members")
    return members


def _compile_stock_native_objects(
    repo_root: pathlib.Path,
    engine_dir: pathlib.Path,
    lock: dict[str, Any],
    work_root: pathlib.Path,
    env: dict[str, str],
    *,
    allow_empty: bool = False,
) -> list[pathlib.Path]:
    """F4: Require mandatory `musl_string_config_sha256` and non-empty `native_only`
    (unless `allow_empty=True` with explicit `native_only = []`, WP7 StdBin)."""
    if (
        allow_empty
        and "native_only" in lock
        and isinstance(lock["native_only"], list)
        and not [str(x) for x in lock["native_only"] if str(x).strip()]
    ):
        return []
    musl_cfg_rel = lock.get("musl_string_config_path")
    if not musl_cfg_rel:
        raise RuntimeError("lock file missing `musl_string_config_path` for cli-elf-stock")
    musl_cfg_src = repo_root / musl_cfg_rel
    if not musl_cfg_src.is_file():
        raise RuntimeError(f"missing musl-string config at {musl_cfg_src}")

    exp_musl_cfg_sha = str(lock.get("musl_string_config_sha256") or "")
    if not HEX64_RE.match(exp_musl_cfg_sha):
        raise RuntimeError(
            f"lock file missing or invalid mandatory `musl_string_config_sha256`: {exp_musl_cfg_sha!r}"
        )
    got_sha = _BASE.sha256_file(musl_cfg_src)
    if got_sha != exp_musl_cfg_sha:
        raise RuntimeError(f"{musl_cfg_src} sha256 {got_sha} != lock {exp_musl_cfg_sha}")

    if "native_only" not in lock or not isinstance(lock["native_only"], list):
        raise RuntimeError("lock file missing mandatory `native_only` list")
    wanted_names = [str(x) for x in lock["native_only"] if str(x).strip()]
    if not wanted_names:
        raise RuntimeError("lock `native_only` must not be empty (refusing fallback to all objects)")

    musl_cfg = tomllib.loads(musl_cfg_src.read_text(encoding="utf-8"))
    by_name = {entry["name"]: entry for entry in musl_cfg.get("native_objects", [])}

    native_root = work_root / "musl-native"
    native_cfg_dir = native_root / "Implementation" / "musl-string"
    native_out_dir = native_cfg_dir / "out"
    native_out_dir.mkdir(parents=True, exist_ok=True)
    (native_root / "third_party").symlink_to((engine_dir / "third_party").resolve())
    vendored_inc = musl_cfg_src.parent / "string-include"
    if vendored_inc.is_dir():
        (native_cfg_dir / "string-include").symlink_to(vendored_inc.resolve())

    zig_bin = env["ZIG"]
    extra_cflags = [str(f) for f in musl_cfg.get("c_flags", [])]
    compiled: list[pathlib.Path] = []
    for name in wanted_names:
        entry = by_name.get(name)
        if entry is None:
            raise RuntimeError(f"native object `{name}` not found in {musl_cfg_src}")
        rel_out = pathlib.Path("out") / f"{name}.o"
        cmd = [
            zig_bin,
            "cc",
            *STOCK_NATIVE_CFLAGS,
            *extra_cflags,
            *[str(f) for f in entry.get("c_flags", [])],
            *[f"-I{inc}" for inc in entry.get("include_dirs", [])],
            *[f"-D{d}" for d in entry.get("defines", [])],
            "-c",
            str(entry["source"]),
            "-o",
            str(rel_out),
        ]
        subprocess.run(cmd, cwd=str(native_cfg_dir), check=True, env=env)
        compiled.append(native_cfg_dir / rel_out)
    return compiled


def classify_stub_symbol(
    sym: str,
    rtypes: set[int],
    stypes: set[int],
    lean_externs_set: set[str],
) -> tuple[str, int]:
    """F2/F7 & B1: Classify an undefined symbol into `(kind, byte_size)`.
    `R_AARCH64_ABS64` (`257`) alone NEVER produces a `function_udf0` code stub: only symbols in
    `libsignalSessionExterns` or non-`STT_OBJECT` symbols referenced via `JUMP26`/`CALL26`
    (`282`/`283`) become `function_udf0`. All 3 8-byte `externData` symbols (`MAX_LOG_LEVEL_FILTER`,
    `GETRANDOM_FN`, `ED25519_BASEPOINT_TABLE`) get exact 8-byte `object_rw8` stubs."""
    is_tls = (6 in stypes) or any(512 <= rt <= 580 for rt in rtypes)
    is_obj_sym = 1 in stypes  # STT_OBJECT
    is_func_ref = (sym in lean_externs_set) or (
        not is_obj_sym and any(rt in (282, 283) for rt in rtypes)
    )
    if is_tls:
        return "tls_object", 16
    if sym in alpha_checks.EIGHT_BYTE_EXTERN_DATA_SYMS:
        return "object_rw8", 8
    if not is_func_ref:
        return "object_rw256", 256
    return "function_udf0", 4


def _load_pinned_musl_refs_from_rustc(
    lock: Mapping[str, Any] | None = None,
    env: dict[str, str] | None = None,
) -> tuple[dict[str, dict[str, Any]], dict[str, bytes]]:
    """Verify SHA-pinned `rustc 1.98.1` `aarch64-unknown-linux-musl/lib/self-contained/libc.a`
    and extract `strlen.lo`, `memcpy.lo`, and `memset.lo` (GK rows 373–375)."""
    eff_env = env if env is not None else os.environ.copy()
    musl_tlib = subprocess.run(
        ["rustc", "--print", "target-libdir", "--target", "aarch64-unknown-linux-musl"],
        capture_output=True,
        text=True,
        check=True,
        env=eff_env,
    ).stdout.strip()
    sc_libc = pathlib.Path(musl_tlib) / "self-contained" / "libc.a"
    if not sc_libc.is_file():
        raise RuntimeError(f"pinned rustc self-contained/libc.a not found at {sc_libc}")
    exp_ar_sha = str(
        (lock or {}).get(
            "pinned_rustc_self_contained_libc_sha256",
            alpha_checks.PINNED_RUSTC_SELF_CONTAINED_LIBC_SHA256,
        )
    )
    return alpha_checks.extract_and_verify_pinned_musl_members(
        sc_libc.read_bytes(),
        expected_archive_sha256=exp_ar_sha,
    )


def _extract_pinned_musl_strlen_and_refs(
    lock: Mapping[str, Any],
    work_root: pathlib.Path,
    env: dict[str, str],
) -> tuple[pathlib.Path, dict[str, dict[str, Any]], dict[str, str]]:
    """S1 & GK rows 373–375: Extract `strlen.lo` from SHA-pinned `rustc 1.98.1`
    `self-contained/libc.a` (`b03473b6...`) and return `(strlen_lo_path, ref_map, strlen_override)`."""
    ref_map, raw_objs = _load_pinned_musl_refs_from_rustc(lock=lock, env=env)
    sc_dir = work_root / "musl-self-contained"
    sc_dir.mkdir(parents=True, exist_ok=True)
    strlen_lo = sc_dir / "strlen.lo"
    strlen_lo.write_bytes(raw_objs["strlen"])
    strlen_info = ref_map["strlen"]
    strlen_override = {
        "source_file": "libc.a",
        "archive_member": str(strlen_info["member"]),
        "archive_sha256": str(strlen_info["archive_sha256"]),
        "member_sha256": str(strlen_info["member_sha256"]),
    }
    return strlen_lo, ref_map, strlen_override


def _elf64_strong_and_weak_defs(obj: bytes) -> tuple[set[str], set[str]]:
    """Partition non-local defined symbols (`st_shndx != 0`) into `(STB_GLOBAL, STB_WEAK)` sets."""
    _defs, _undefs, _rmap, all_syms = _elf64_syms_and_relocs(obj)
    strong: set[str] = set()
    weak: set[str] = set()
    for name, bind, _stype, shndx, *_ in all_syms:
        if shndx == 0 or not name:
            continue
        if bind == 1:
            strong.add(name)
        elif bind == 2:
            weak.add(name)
    return strong, weak


def _compute_stock_stub_manifest(
    lib_objs: Sequence[pathlib.Path],
    rt_inputs: Sequence[pathlib.Path],
    lean_externs: Sequence[str],
    *,
    displaced_weak: Sequence[str] = alpha_checks.EXPECTED_DISPLACED_WEAK,
) -> list[dict[str, Any]]:
    """F2, F7 & B1 (Option α): Compute the canonical sorted `stub_manifest` from `lib_objs` and
    `rt_inputs`. Subtracts only `STB_GLOBAL` runtime/native definitions, enforcing that the only
    weak-only runtime symbols referenced by `lib_objs` are `displaced_weak` (`__aarch64_*`), which
    receive strong `STB_GLOBAL` `function_udf0` (`udf #0`) stubs."""
    if not lean_externs:
        raise RuntimeError("`_compute_stock_stub_manifest` requires non-empty `lean_externs`")

    rt_strong_defined: set[str] = set()
    rt_weak_defined: set[str] = set()
    for p in rt_inputs:
        data = p.read_bytes()
        if p.suffix == ".a":
            for member in _iter_archive_elf_members(data):
                s_defs, w_defs = _elf64_strong_and_weak_defs(member)
                rt_strong_defined |= s_defs
                rt_weak_defined |= w_defs
        else:
            s_defs, w_defs = _elf64_strong_and_weak_defs(data)
            rt_strong_defined |= s_defs
            rt_weak_defined |= w_defs

    sibling_obj_re = re.compile(r"^lib[1-9]\d*_\d+\.o$")
    image0_defined: set[str] = set()
    sibling_lib_defined: set[str] = set()
    lib_undefs: set[str] = set()
    reloc_types: dict[str, set[int]] = {}
    sym_types: dict[str, set[int]] = {}
    for p in lib_objs:
        defs, undefs, rmap, syms = _elf64_syms_and_relocs(p.read_bytes())
        if sibling_obj_re.match(p.name):
            sibling_lib_defined |= defs
        else:
            image0_defined |= defs
        lib_undefs |= undefs
        for sym, rset in rmap.items():
            reloc_types.setdefault(sym, set()).update(rset)
        for name, bind, stype, shndx, *_ in syms:
            if shndx == 0 and bind in (1, 2) and name:
                sym_types.setdefault(name, set()).add(stype)

    lib_defined = image0_defined | sibling_lib_defined
    unresolved_by_lib = lib_undefs - lib_defined
    rt_weak_only = rt_weak_defined - rt_strong_defined
    dw_set = set(displaced_weak)

    if dw_set:
        dw_strong = sorted(dw_set & rt_strong_defined)
        if dw_strong:
            raise RuntimeError(
                f"Option α `displaced_weak` symbol(s) have strong runtime definitions: {dw_strong}"
            )
        dw_missing_weak = sorted(dw_set - rt_weak_only)
        if dw_missing_weak:
            raise RuntimeError(
                f"Option α `displaced_weak` symbol(s) missing STB_WEAK runtime definitions: {dw_missing_weak}"
            )
        dw_missing_undef = sorted(dw_set - unresolved_by_lib)
        if dw_missing_undef:
            raise RuntimeError(
                f"Option α `displaced_weak` symbol(s) not referenced by library objects: {dw_missing_undef}"
            )

    unexpected_weak_refs = sorted((unresolved_by_lib & rt_weak_only) - dw_set)
    if unexpected_weak_refs:
        raise RuntimeError(
            f"library objects reference STB_WEAK-only runtime symbol(s) outside `displaced_weak`: "
            f"{unexpected_weak_refs}"
        )

    need_stubs = sorted(unresolved_by_lib - rt_strong_defined)
    if not need_stubs:
        raise RuntimeError("computed empty `need_stubs` list for extern_stubs_clean.o")

    lean_externs_set = set(lean_externs)
    image0_self_externs = sorted(lean_externs_set & image0_defined)
    if image0_self_externs:
        raise RuntimeError(
            f"engine-model contradiction: libsignalSessionExterns defined by Image 0 itself: {image0_self_externs}"
        )
    missing_exts = sorted(lean_externs_set - (set(need_stubs) | rt_strong_defined | sibling_lib_defined))
    if missing_exts:
        raise RuntimeError(
            f"libsignalSessionExterns missing from (need_stubs | rt_strong_defined | sibling_lib_defined): {missing_exts}"
        )

    stub_manifest: list[dict[str, Any]] = []
    for sym in need_stubs:
        kind, size = classify_stub_symbol(
            sym,
            reloc_types.get(sym, set()),
            sym_types.get(sym, set()),
            lean_externs_set,
        )
        stub_manifest.append({"kind": kind, "name": sym, "size": size})
    return stub_manifest


def _assemble_stub_manifest_object(
    stub_manifest: Sequence[dict[str, Any]],
    stubs_dir: pathlib.Path,
    env: dict[str, str],
    *,
    expected_manifest_count: int | None = None,
    expected_manifest_sha: str | None = None,
    stem: str = STUB_OBJ_STEM,
) -> tuple[pathlib.Path, str]:
    """Assemble a canonical `stub_manifest` into an `STB_GLOBAL` zero-stub object with
    `.stock.stub_manifest` section, verifying lock-pinned count and SHA-256 (F7(1))."""
    if expected_manifest_count is None or expected_manifest_count <= 0:
        raise RuntimeError(
            f"missing mandatory lock `expected_stub_manifest_count`: {expected_manifest_count!r}"
        )
    if not expected_manifest_sha or not HEX64_RE.match(expected_manifest_sha):
        raise RuntimeError(
            f"missing or invalid lock `stub_manifest_sha256`: {expected_manifest_sha!r}"
        )
    manifest_sha = stub_manifest_sha256(stub_manifest)
    if len(stub_manifest) != expected_manifest_count:
        raise RuntimeError(
            f"stub manifest count {len(stub_manifest)} != expected {expected_manifest_count}"
        )
    if manifest_sha != expected_manifest_sha:
        raise RuntimeError(
            f"stub manifest sha256 {manifest_sha} != pinned {expected_manifest_sha}"
        )

    stubs_dir.mkdir(parents=True, exist_ok=True)
    asm_lines = [
        "// Deterministic unrenamed extern/panic stubs for `scripts/cli-elf-stock`",
    ]
    for entry in stub_manifest:
        sym = str(entry["name"])
        kind = str(entry["kind"])
        size = int(entry["size"])
        if kind == "tls_object":
            if size != 16:
                raise RuntimeError(f"tls_object stub `{sym}` expected size 16, got {size}")
            asm_lines.extend([
                f'.section .tdata.{sym},"awT",@progbits',
                ".p2align 3",
                f'.globl "{sym}"',
                f'.type "{sym}",@tls_object',
                f'"{sym}":',
                ".quad 0",
                ".quad 0",
                f'.size "{sym}", 16',
            ])
        elif kind == "object_rw8":
            if size != 8:
                raise RuntimeError(f"object_rw8 stub `{sym}` expected size 8, got {size}")
            asm_lines.extend([
                f'.section .data.{sym},"aw",@progbits',
                ".p2align 3",
                f'.globl "{sym}"',
                f'.type "{sym}",@object',
                f'"{sym}":',
                ".zero 8",
                f'.size "{sym}", 8',
            ])
        elif kind == "object_rw256":
            if size != 256:
                raise RuntimeError(f"object_rw256 stub `{sym}` expected size 256, got {size}")
            asm_lines.extend([
                f'.section .data.{sym},"aw",@progbits',
                ".p2align 4",
                f'.globl "{sym}"',
                f'.type "{sym}",@object',
                f'"{sym}":',
                ".zero 256",
                f'.size "{sym}", 256',
            ])
        elif kind == "function_udf0":
            if size != 4:
                raise RuntimeError(f"function_udf0 stub `{sym}` expected size 4, got {size}")
            asm_lines.extend([
                f'.section .text.{sym},"ax",@progbits',
                ".p2align 2",
                f'.globl "{sym}"',
                f'.type "{sym}",@function',
                f'"{sym}":',
                ".word 0",
                f'.size "{sym}", 4',
            ])
        else:
            raise RuntimeError(f"unknown stub manifest kind {kind!r} for `{sym}`")

    asm_lines.extend([
        f'.section {STUB_MANIFEST_SECTION},"",@progbits',
        f'.ascii "{manifest_sha}"',
    ])

    stubs_s = stubs_dir / f"{stem}.s"
    stubs_o = stubs_dir / f"{stem}.o"
    stubs_s.write_text("\n".join(asm_lines) + "\n", encoding="utf-8")
    subprocess.run(
        [
            env["ZIG"],
            "cc",
            "-target",
            "aarch64-linux-musl",
            "-g0",
            "-c",
            f"{stem}.s",
            "-o",
            f"{stem}.o",
        ],
        cwd=str(stubs_dir),
        check=True,
        env=env,
    )
    return stubs_o, manifest_sha


def _build_stock_extern_stubs(
    lib_objs: list[pathlib.Path],
    rt_inputs: list[pathlib.Path],
    lean_externs: Sequence[str],
    stubs_dir: pathlib.Path,
    env: dict[str, str],
    *,
    displaced_weak: Sequence[str] = alpha_checks.EXPECTED_DISPLACED_WEAK,
    expected_manifest_count: int | None = None,
    expected_manifest_sha: str | None = None,
) -> tuple[pathlib.Path, list[dict[str, Any]], str]:
    """F2, F7 & B1: Compute and assemble deterministic `STB_GLOBAL` stubs + `.stock.stub_manifest`."""
    stub_manifest = _compute_stock_stub_manifest(
        lib_objs=lib_objs,
        rt_inputs=rt_inputs,
        lean_externs=lean_externs,
        displaced_weak=displaced_weak,
    )
    stubs_o, manifest_sha = _assemble_stub_manifest_object(
        stub_manifest=stub_manifest,
        stubs_dir=stubs_dir,
        env=env,
        expected_manifest_count=expected_manifest_count,
        expected_manifest_sha=expected_manifest_sha,
    )
    return stubs_o, stub_manifest, manifest_sha


def _verify_runtime_archive_shas(
    actual_shas: Mapping[str, str], expected_shas: Mapping[str, str] | None = None
) -> None:
    if not isinstance(expected_shas, Mapping) or not expected_shas:
        raise RuntimeError("missing mandatory lock `runtime_archives` sha256 table")
    target = {str(k): str(v) for k, v in expected_shas.items()}
    if set(actual_shas.keys()) != set(target.keys()):
        raise RuntimeError(
            f"runtime archive key set mismatch: got {sorted(actual_shas.keys())}, expected {sorted(target.keys())}"
        )
    for name, exp_sha in sorted(target.items()):
        got_sha = str(actual_shas.get(name, ""))
        if not HEX64_RE.match(exp_sha):
            raise RuntimeError(
                f"invalid lock `runtime_archives` sha256 for `{name}`: {exp_sha!r}"
            )
        if not HEX64_RE.match(got_sha) or got_sha != exp_sha:
            raise RuntimeError(
                f"runtime input `{name}` sha256 {got_sha!r} != expected {exp_sha!r}"
            )


def build_canonical_lld_argv(
    lld_bin: str,
    placed_exports: Sequence[str],
    stock_ld_rel: str,
    stock_ld_abs: pathlib.Path,
    out_elf: pathlib.Path,
    crt1_o: pathlib.Path,
    main_o: pathlib.Path,
    native_objs: Sequence[pathlib.Path],
    lib_objs: Sequence[pathlib.Path],
    stubs_o: pathlib.Path,
    runtime_archives: Sequence[pathlib.Path],
    *,
    out_map: pathlib.Path | None = None,
    cwd_dir: pathlib.Path | None = None,
) -> tuple[list[str], list[str]]:
    """Return `(lld_cmd_raw, lld_argv_template)` in exact 1-to-1 positional correspondence.
    When `cwd_dir` is supplied, emits `cwd_dir`-relative paths so `ld.lld -Map` output (`link.map`)
    is 100% byte-identical across arbitrary `TMPDIR` and path-nesting depths."""

    def _fmt_p(p: pathlib.Path) -> str:
        return os.path.relpath(p, cwd_dir) if cwd_dir is not None else str(p)

    u_flags: list[str] = []
    for exp in placed_exports:
        if exp != "main":
            u_flags.extend(["-u", exp])

    prefix_flags = [
        "-static",
        "-no-pie",
        "--entry=_start",
        *u_flags,
        "--icf=none",
        "--orphan-handling=error",
        "-z",
        "norelro",
        "-z",
        "max-page-size=4096",
        "-z",
        "common-page-size=4096",
        "--build-id=none",
        "--strip-debug",
    ]
    map_raw = ["-Map", _fmt_p(out_map)] if out_map is not None else []
    map_tmpl = ["-Map", f"<OUT_MAP:{out_map.name}>"] if out_map is not None else []
    lld_cmd_raw = [
        lld_bin,
        *prefix_flags,
        "-T",
        _fmt_p(stock_ld_abs),
        "--gc-sections",
        "-o",
        _fmt_p(out_elf),
        *map_raw,
        _fmt_p(crt1_o),
        _fmt_p(main_o),
        *[_fmt_p(p) for p in native_objs],
        *[_fmt_p(p) for p in lib_objs],
        _fmt_p(stubs_o),
        "--start-group",
        *[_fmt_p(p) for p in runtime_archives],
        "--end-group",
    ]
    lld_argv_template = [
        "<LLD>",
        *prefix_flags,
        "-T",
        f"<STOCK_LD:{stock_ld_rel}>",
        "--gc-sections",
        "-o",
        f"<OUT_ELF:{out_elf.name}>",
        *map_tmpl,
        f"<CRT1_O:{crt1_o.name}>",
        f"<MAIN_O:{main_o.name}>",
        *[f"<NATIVE_O:{p.name}>" for p in native_objs],
        *[f"<LIB_O:{idx}>" for idx in range(len(lib_objs))],
        f"<STUBS_O:{stubs_o.name}>",
        "--start-group",
        *[f"<RT_A:{p.name}>" for p in runtime_archives],
        "--end-group",
    ]
    if len(lld_cmd_raw) != len(lld_argv_template):
        raise RuntimeError("internal error: lld_cmd_raw and lld_argv_template length mismatch")
    return lld_cmd_raw, lld_argv_template


def _verify_lld_argv_against_lock(
    lld_argv_template: Any,
    lld_argv_raw: Any,
    expected_template: Sequence[str],
    inputs_meta: Sequence[dict[str, Any]],
    stock_lld_arg_files: dict[str, str],
) -> None:
    """(c): Enforce `lld_argv == lock['lld_argv']` with 0 extra `lld` args, 0 banned flags, and
    every input path slot backed by a sha256-recorded input or `stock_lld_arg_files` entry."""
    if not isinstance(lld_argv_template, list) or [str(x) for x in lld_argv_template] != list(
        expected_template
    ):
        raise RuntimeError(
            f"cv-stock-link.json lld_argv mismatch vs lock:\n"
            f"  got:      {lld_argv_template!r}\n"
            f"  expected: {list(expected_template)!r}"
        )
    if not isinstance(lld_argv_raw, list) or len(lld_argv_raw) != len(expected_template):
        raise RuntimeError(
            f"cv-stock-link.json lld_argv_raw length {(len(lld_argv_raw) if isinstance(lld_argv_raw, list) else None)} "
            f"!= pinned lock argv length {len(expected_template)} (extra/missing lld args forbidden)"
        )

    for idx, raw_item in enumerate(lld_argv_raw):
        tok = str(raw_item)
        if tok == "-r" or any(tok.startswith(bp) for bp in BANNED_LLD_FLAG_PREFIXES):
            raise RuntimeError(f"banned lld flag {tok!r} at argv[{idx}]")
        if idx > 0 and str(lld_argv_raw[idx - 1]) == "-z" and tok in ("muldefs", "undefs"):
            raise RuntimeError(f"banned `-z {tok}` in lld argv")

    input_names_with_sha = {
        str(entry.get("name")): str(entry.get("sha256"))
        for entry in inputs_meta
        if isinstance(entry, dict) and HEX64_RE.match(str(entry.get("sha256") or ""))
    }

    for idx, (raw_item, tmpl) in enumerate(zip(lld_argv_raw, expected_template)):
        raw_tok = str(raw_item)
        m = PLACEHOLDER_RE.match(tmpl)
        if m is None:
            if raw_tok != tmpl:
                raise RuntimeError(
                    f"lld_argv_raw[{idx}] = {raw_tok!r} != pinned flag {tmpl!r}"
                )
            continue

        # Placeholder slot: NEVER allow a CLI flag (`-...`) to hide in a path slot!
        if raw_tok.startswith("-"):
            raise RuntimeError(
                f"unexpected CLI flag {raw_tok!r} in input-file slot argv[{idx}] ({tmpl})"
            )
        kind, arg = m.group(1), m.group(2)
        base = pathlib.Path(raw_tok).name
        if kind == "LLD":
            if "lld" not in base:
                raise RuntimeError(f"unexpected LLD binary basename {base!r}")
        elif kind == "STOCK_LD":
            assert arg is not None
            if base != pathlib.Path(arg).name or arg not in stock_lld_arg_files:
                raise RuntimeError(
                    f"linker script slot {raw_tok!r} not hashed in stock_lld_arg_files ({arg!r})"
                )
        elif kind in ("OUT_ELF", "OUT_MAP"):
            if base != arg:
                raise RuntimeError(f"output {kind} basename {base!r} != expected {arg!r}")
        elif kind == "LIB_O":
            exp_name = f"lib0_{arg}.o"
            if base != exp_name or exp_name not in input_names_with_sha:
                raise RuntimeError(
                    f"library object slot argv[{idx}] ({base!r}) missing sha256 in inputs[] (expected {exp_name!r})"
                )
        elif kind in ("CRT1_O", "MAIN_O", "NATIVE_O", "STUBS_O", "RT_A"):
            assert arg is not None
            if base != arg or arg not in input_names_with_sha:
                raise RuntimeError(
                    f"input slot argv[{idx}] ({base!r}) missing sha256 in inputs[] (expected {arg!r})"
                )
        else:
            raise RuntimeError(f"unknown placeholder {tmpl!r} in lock lld_argv[{idx}]")


def _resolve_and_verify_stdbin_linker_script(
    repo_root: pathlib.Path | None,
    lock: Mapping[str, Any],
    lock_label: pathlib.Path,
    *,
    ci_mode: bool = False,
    fallback_repo_root: pathlib.Path | None = None,
    unpinned: bool = False,
) -> tuple[str, str | None, str | None, pathlib.Path | None, dict[str, str]]:
    """Resolve and fail-closed verify `StdBin` linker-script mode (`none` | `pinned` | `scratch`).

    - Authority for `pinned` is SOLELY `lock` (`--stock-lock`, e.g. `cli-elf/inputs.lock` in CI —
      zero dependency on legacy `inputs_stock.lock` and zero hardcoded sha256):
      `linker_script_path` MUST equal `DEFAULT_REL_STOCK_LD`
      (`third_party/libsignal/libsignal-session/cli-elf/stock.ld`) or `DEFAULT_REL_STOCK_C2_LD`
      (`third_party/libsignal/libsignal-session/cli-elf/stock/stock_c2.ld`, verified against
      `_render_c2_stock_ld` when `c2_moved_libc_rows = "all"`), its on-disk SHA-256 MUST equal
      `lock["linker_script_sha256"]`, and post-link `stock-link.json` `lld.argFiles` MUST record
      `len == 1` with `(path == linker_script_path, sha256 == lock["linker_script_sha256"])`.
    - Under `--ci` (`ci_mode=True`), ONLY `pinned` is permitted (`none` and `scratch` fail closed).
    - `scratch`: non-`--ci` rehearsal mode; `linker_script_path` MUST be a clean repo-relative path
      distinct from `DEFAULT_REL_STOCK_LD` and `DEFAULT_REL_STOCK_C2_LD`, its on-disk SHA-256 MUST equal `lock["linker_script_sha256"]`,
      post-link `stock-link.json` `lld.argFiles` MUST match, AND on-disk `stock.ld` itself MUST be
      byte-unchanged (verified against git `HEAD:.../stock.ld` + staged index when `.git` exists,
      and/or `lock["pinned_stock_ld_sha256"]`).
    """
    if ci_mode and unpinned:
        raise RuntimeError(f"{lock_label}: `--unpinned` is forbidden in CI mode (`--ci`)")
    eff_lock = _unwrap_stock_lock_dict(lock)
    explicit_mode = str(eff_lock.get("stock_ld_mode") or "").strip()
    raw_rel = str(eff_lock.get("linker_script_path") or "").strip()
    raw_sha = str(eff_lock.get("linker_script_sha256") or "").strip()
    raw_af = eff_lock.get("stock_lld_arg_files")

    if explicit_mode:
        mode = explicit_mode
        if mode not in STDBIN_STOCK_LD_MODES:
            raise RuntimeError(
                f"{lock_label}: invalid `stock_ld_mode` {mode!r} "
                f"(expected one of {sorted(STDBIN_STOCK_LD_MODES)})"
            )
    else:
        mode = "pinned" if (raw_rel or raw_sha or raw_af) else "none"

    if ci_mode and mode != "pinned":
        raise RuntimeError(
            f"{lock_label}: CI mode (`--ci`) requires StdBin `stock_ld_mode = 'pinned'` "
            f"(`-T {DEFAULT_REL_STOCK_LD}` or `-T {DEFAULT_REL_STOCK_C2_LD}`), got {mode!r}"
        )

    if mode == "none":
        if raw_rel or raw_sha or raw_af:
            raise RuntimeError(
                f"{lock_label}: `stock_ld_mode = 'none'` forbids `linker_script_path`, "
                f"`linker_script_sha256`, and `stock_lld_arg_files`"
            )
        return "none", None, None, None, {}

    if (
        not raw_rel
        or raw_rel.startswith("/")
        or "\\" in raw_rel
        or ".." in pathlib.Path(raw_rel).parts
    ):
        raise RuntimeError(
            f"{lock_label}: `stock_ld_mode = {mode!r}` requires clean repo-relative "
            f"`linker_script_path`, got {raw_rel!r}"
        )
    if not HEX64_RE.match(raw_sha):
        raise RuntimeError(
            f"{lock_label}: `stock_ld_mode = {mode!r}` requires 64-hex `linker_script_sha256`, "
            f"got {raw_sha!r}"
        )

    pinned_rel = str(DEFAULT_REL_STOCK_LD)
    allowed_pinned_rels = {pinned_rel, str(DEFAULT_REL_STOCK_C2_LD)}
    if mode == "pinned" and raw_rel not in allowed_pinned_rels:
        raise RuntimeError(
            f"{lock_label}: `stock_ld_mode = 'pinned'` requires `linker_script_path == {pinned_rel!r}` "
            f"(or `{DEFAULT_REL_STOCK_C2_LD}`), got {raw_rel!r}"
        )
    if mode == "scratch" and raw_rel in allowed_pinned_rels:
        raise RuntimeError(
            f"{lock_label}: `stock_ld_mode = 'scratch'` forbids pointing at pinned `{raw_rel}` "
            f"(must use a distinct scratch linker script)"
        )

    if raw_af is not None:
        if not isinstance(raw_af, Mapping) or not raw_af:
            raise RuntimeError(
                f"{lock_label}: `stock_lld_arg_files` must be a non-empty mapping when set"
            )
        norm_af = {str(k): str(v) for k, v in raw_af.items()}
        if norm_af != {raw_rel: raw_sha}:
            raise RuntimeError(
                f"{lock_label}: `stock_lld_arg_files` {norm_af!r} != {{{raw_rel!r}: {raw_sha!r}}}"
            )
    else:
        norm_af = {raw_rel: raw_sha}

    ld_abs: pathlib.Path | None = None
    if repo_root is not None:
        repo_resolved = repo_root.resolve()
        ld_abs = (repo_root / raw_rel).resolve()
        if not ld_abs.is_relative_to(repo_resolved):
            raise RuntimeError(
                f"StdBin linker script {ld_abs} escapes repo_root {repo_resolved}"
            )
        if not ld_abs.is_file() and unpinned and fallback_repo_root is not None:
            fb_resolved = fallback_repo_root.resolve()
            fb_cand = (fallback_repo_root / raw_rel).resolve()
            if fb_cand.is_relative_to(fb_resolved) and fb_cand.is_file():
                ld_abs = fb_cand
        if not ld_abs.is_file():
            raise RuntimeError(f"missing StdBin linker script on disk: {ld_abs}")
        got_ld_sha = _BASE.sha256_file(ld_abs)
        if got_ld_sha != raw_sha and not unpinned:
            raise RuntimeError(
                f"on-disk linker script {ld_abs} sha256 {got_ld_sha} != lock {raw_sha}"
            )
        if unpinned and got_ld_sha != raw_sha:
            raw_sha = got_ld_sha
            norm_af = {raw_rel: got_ld_sha}

        if mode == "scratch":
            pinned_ld_disk = (repo_root / DEFAULT_REL_STOCK_LD).resolve()
            if not pinned_ld_disk.is_file():
                raise RuntimeError(f"missing pinned linker script {pinned_ld_disk}")
            if ld_abs == pinned_ld_disk:
                raise RuntimeError(
                    f"`stock_ld_mode = 'scratch'` linker script {ld_abs} resolves to `{pinned_rel}`"
                )
            got_pinned_disk_sha = _BASE.sha256_file(pinned_ld_disk)
            opt_pin_sha = str(eff_lock.get("pinned_stock_ld_sha256") or "").strip()
            has_git = (repo_root / ".git").exists()
            if not has_git and not opt_pin_sha:
                raise RuntimeError(
                    f"{lock_label}: `stock_ld_mode = 'scratch'` outside a git worktree requires "
                    f"64-hex `pinned_stock_ld_sha256` to verify `{pinned_rel}` is byte-unchanged"
                )
            if opt_pin_sha:
                if not HEX64_RE.match(opt_pin_sha):
                    raise RuntimeError(
                        f"{lock_label}: invalid 64-hex `pinned_stock_ld_sha256`: {opt_pin_sha!r}"
                    )
                if got_pinned_disk_sha != opt_pin_sha:
                    raise RuntimeError(
                        f"scratch mode requires `{pinned_rel}` byte-unchanged: "
                        f"disk sha256 {got_pinned_disk_sha} != lock pinned_stock_ld_sha256 {opt_pin_sha}"
                    )
            if has_git:
                proc_show = subprocess.run(
                    ["git", "-C", str(repo_root), "show", f"HEAD:{pinned_rel}"],
                    capture_output=True,
                    check=False,
                )
                if proc_show.returncode != 0:
                    err_s = proc_show.stderr.decode("utf-8", errors="replace").strip()
                    raise RuntimeError(
                        f"scratch mode unable to read `HEAD:{pinned_rel}` from git: {err_s}"
                    )
                head_stock_ld_sha = hashlib.sha256(proc_show.stdout).hexdigest()
                if got_pinned_disk_sha != head_stock_ld_sha:
                    raise RuntimeError(
                        f"scratch mode requires `{pinned_rel}` byte-unchanged vs git HEAD: "
                        f"disk sha256 {got_pinned_disk_sha} != HEAD {head_stock_ld_sha}"
                    )
                proc_idx = subprocess.run(
                    ["git", "-C", str(repo_root), "diff", "--cached", "--quiet", "--", pinned_rel],
                    capture_output=True,
                    check=False,
                )
                if proc_idx.returncode != 0:
                    raise RuntimeError(
                        f"scratch mode forbids staged git index changes to `{pinned_rel}`"
                    )

    return mode, raw_rel, raw_sha, ld_abs, norm_af


def _normalize_and_verify_stdbin_engine_arg_files(
    *,
    eng_lld_args_raw: Sequence[str],
    eng_arg_files_raw: Any,
    stock_ld_mode: str,
    linker_script_rel: str | None,
    linker_script_sha: str | None,
    repo_root: pathlib.Path | None = None,
    ld_abs: pathlib.Path | None = None,
) -> list[str]:
    """Verify `stock-link.json` `lld.argFiles` post-link and normalize `-T <path>` in `lld.args` to
    `<STOCK_LD:<linker_script_rel>>` so zero absolute host paths enter the lock or `cv-stock-stdbin-link.json`."""
    af_list = list(eng_arg_files_raw) if isinstance(eng_arg_files_raw, list) else []
    if stock_ld_mode == "none":
        if af_list:
            raise RuntimeError(
                f"stock-link.json recorded unexpected `lld.argFiles` in `stock_ld_mode = 'none'`: {af_list!r}"
            )
        if "-T" in eng_lld_args_raw or any(str(x).startswith("-T") for x in eng_lld_args_raw):
            raise RuntimeError(
                f"stock-link.json `lld.args` contains `-T` when `stock_ld_mode = 'none'`: {eng_lld_args_raw!r}"
            )
        return [str(x) for x in eng_lld_args_raw]

    assert linker_script_rel is not None and linker_script_sha is not None
    if len(af_list) != 1 or not isinstance(af_list[0], Mapping):
        raise RuntimeError(
            f"stock-link.json `lld.argFiles` expected exactly 1 entry for `{linker_script_rel}`, got {af_list!r}"
        )
    got_af_path = str(af_list[0].get("path") or "")
    got_af_sha = str(af_list[0].get("sha256") or "")
    if got_af_path != linker_script_rel or got_af_sha != linker_script_sha:
        raise RuntimeError(
            f"stock-link.json `lld.argFiles[0]` mismatch: got (path={got_af_path!r}, sha256={got_af_sha!r}) "
            f"!= expected (path={linker_script_rel!r}, sha256={linker_script_sha!r})"
        )

    allowed_t_vals = {linker_script_rel}
    if repo_root is not None:
        allowed_t_vals.add(str((repo_root / linker_script_rel).resolve()))
    if ld_abs is not None:
        allowed_t_vals.add(str(ld_abs.resolve()))

    norm_args: list[str] = []
    t_count = 0
    idx = 0
    raw_strs = [str(x) for x in eng_lld_args_raw]
    while idx < len(raw_strs):
        tok = raw_strs[idx]
        if tok == "-T":
            if idx + 1 >= len(raw_strs):
                raise RuntimeError("dangling `-T` at end of `stock-link.json` `lld.args`")
            t_val = raw_strs[idx + 1]
            if t_val not in allowed_t_vals:
                raise RuntimeError(
                    f"stock-link.json `-T` target {t_val!r} != expected {sorted(allowed_t_vals)!r}"
                )
            norm_args.append("-T")
            norm_args.append(f"<STOCK_LD:{linker_script_rel}>")
            t_count += 1
            idx += 2
            continue
        if tok.startswith("-T"):
            raise RuntimeError(
                f"unsupported fused `{tok}` in `lld.args`; pass separate `-T <path>`"
            )
        norm_args.append(tok)
        idx += 1

    if t_count != 1:
        raise RuntimeError(
            f"expected exactly 1 `-T` flag in `stock-link.json` `lld.args`, found {t_count}"
        )
    return norm_args


def _verify_stdbin_lld_argv_against_lock(
    lld_args: Any,
    expected_args: Sequence[str],
    engine_inputs: Sequence[Mapping[str, Any]],
    stock_lld_arg_files: Mapping[str, str] | None = None,
) -> None:
    """Enforce exact normalized `lld.args == lock['lld_argv']` (0 extra/missing `lld` args,
    0 absolute host paths, 0 banned flags, SHA-256-pinned `<STOCK_LD:...>` when `-T` is used, and
    1-to-1 SHA-256 coverage in `stock-link.json` `inputs[]`)."""
    if not isinstance(lld_args, list) or [str(x) for x in lld_args] != [str(x) for x in expected_args]:
        raise RuntimeError(
            f"stock-link.json lld.args mismatch vs lock:\n"
            f"  got:      {lld_args!r}\n"
            f"  expected: {list(expected_args)!r}"
        )

    eff_arg_files = dict(stock_lld_arg_files or {})
    for idx, item in enumerate(lld_args):
        tok = str(item)
        if tok.startswith("/") or ":/" in tok or "=/" in tok:
            raise RuntimeError(
                f"absolute host path forbidden in StdBin `lld_argv[{idx}]`: {tok!r}"
            )
        if tok == "-r" or any(tok.startswith(bp) for bp in BANNED_LLD_FLAG_PREFIXES):
            raise RuntimeError(f"banned lld flag {tok!r} at lld.args[{idx}]")
        if idx > 0 and str(lld_args[idx - 1]) == "-z" and tok in ("muldefs", "undefs"):
            raise RuntimeError(f"banned `-z {tok}` in lld.args")

    engine_input_shas = {
        str(ent.get("path")): str(ent.get("sha256"))
        for ent in engine_inputs
        if isinstance(ent, Mapping) and HEX64_RE.match(str(ent.get("sha256") or ""))
    }
    if len(engine_input_shas) != len(engine_inputs):
        raise RuntimeError(
            f"stock-link.json `inputs[]` contains missing/invalid sha256 or duplicate path "
            f"({len(engine_input_shas)} valid unique vs {len(engine_inputs)} total)"
        )

    seen_input_paths: list[str] = []
    seen_ld_scripts: list[str] = []
    skip_next = False
    for idx, item in enumerate(lld_args):
        tok = str(item)
        if skip_next:
            skip_next = False
            continue
        if tok == "-T":
            if idx + 1 >= len(lld_args):
                raise RuntimeError("dangling `-T` at end of `lld.args`")
            ld_tok = str(lld_args[idx + 1])
            m = PLACEHOLDER_RE.match(ld_tok)
            if m is None or m.group(1) != "STOCK_LD" or not m.group(2):
                raise RuntimeError(
                    f"StdBin `lld_argv[{idx + 1}]` after `-T` must be `<STOCK_LD:<rel_path>>`, got {ld_tok!r}"
                )
            ld_rel = m.group(2)
            if ld_rel not in eff_arg_files or not HEX64_RE.match(str(eff_arg_files[ld_rel])):
                raise RuntimeError(
                    f"linker script `{ld_rel}` in `lld_argv` missing valid 64-hex sha256 in `stock_lld_arg_files`"
                )
            seen_ld_scripts.append(ld_rel)
            skip_next = True
            continue
        if tok in ("-o", "--entry", "-z", "-u", "-Map", "-flavor", "-m", "-L"):
            skip_next = True
            continue
        if tok.startswith("-"):
            continue
        if tok not in engine_input_shas:
            raise RuntimeError(
                f"lld.args[{idx}] input {tok!r} missing valid 64-hex sha256 in stock-link.json `inputs[]`"
            )
        seen_input_paths.append(tok)

    if set(seen_ld_scripts) != set(eff_arg_files.keys()):
        raise RuntimeError(
            f"`stock_lld_arg_files` keys {sorted(eff_arg_files.keys())} != `-T` scripts in `lld_argv` {seen_ld_scripts}"
        )

    if set(seen_input_paths) != set(engine_input_shas.keys()):
        missing_from_argv = sorted(set(engine_input_shas.keys()) - set(seen_input_paths))
        raise RuntimeError(
            f"stock-link.json `inputs[]` contains unreferenced path(s) absent from `lld.args`: {missing_from_argv}"
        )


def verify_stock_elf(
    elf_path: pathlib.Path,
    cfg_path: pathlib.Path,
    stub_manifest: Sequence[dict[str, Any]],
    *,
    repo_root: pathlib.Path | None = None,
    expected_externs: Sequence[str] | None = None,
    dehooked_syms: Sequence[str] | None = None,
    retired_stub_slots: Sequence[Mapping[str, Any]] = (),
    expected_symtab_count: int | None = None,
    expected_loader_sym_count: int | None = None,
    expected_stub_manifest_count: int | None = None,
    expected_retained_stub_count: int | None = None,
    expected_stub_manifest_sha: str | None = None,
    verbose: bool = True,
) -> dict[str, Any]:
    if not stub_manifest:
        raise RuntimeError("verify_stock_elf requires a non-empty `stub_manifest` (refusing None/empty)")
    if expected_symtab_count is None or expected_symtab_count <= 0:
        raise RuntimeError("verify_stock_elf requires lock `expected_symtab_count` (refusing default)")
    if expected_loader_sym_count is None or expected_loader_sym_count <= 0:
        raise RuntimeError("verify_stock_elf requires lock `expected_loader_sym_count` (refusing default)")
    if expected_stub_manifest_count is None or expected_stub_manifest_count <= 0:
        raise RuntimeError("verify_stock_elf requires lock `expected_stub_manifest_count` (F7(1))")
    if expected_retained_stub_count is None or expected_retained_stub_count < 0:
        raise RuntimeError("verify_stock_elf requires lock `expected_retained_stub_count` (F7(1))")
    if expected_stub_manifest_sha is None or not HEX64_RE.match(expected_stub_manifest_sha):
        raise RuntimeError(
            f"verify_stock_elf requires 64-hex lock `stub_manifest_sha256` (F2(3)/F7(1)), got {expected_stub_manifest_sha!r}"
        )

    if repo_root is not None:
        derived = derive_placed_expectations(repo_root, cfg_path=cfg_path)
        lean_externs = list(derived["externs"])
        if expected_externs is not None and list(expected_externs) != lean_externs:
            raise RuntimeError("explicit expected_externs disagrees with .GeneratedLean externs")
    elif expected_externs is not None and len(expected_externs) > 0:
        lean_externs = list(expected_externs)
    else:
        raise RuntimeError(
            "verify_stock_elf requires `repo_root` (with `.GeneratedLean`) or explicit `expected_externs` "
            "(refusing silent hardcoded externs fallback)"
        )

    elf_bytes = elf_path.read_bytes()

    # F1 & F5: Parse ELF via `stock_elf_prep.elf_loader.parse_raw_elf(..., require_symtab=True)`.
    img, _phdrs, sections, raw_syms = elf_loader.parse_raw_elf(elf_bytes, require_symtab=True)
    entry, segs = _BASE.parse_elf64_header_and_pt_loads(elf_bytes)
    if entry != img.entry:
        raise RuntimeError(f"entry mismatch between parsers: {entry:#x} vs {img.entry:#x}")
    if (entry & 0xFFF) != 0:
        raise RuntimeError(f"stock ELF e_entry={entry:#x} is not 0x1000-aligned (`hC.entry_page`)")
    if len(segs) != 3:
        raise RuntimeError(f"stock ELF expected exactly 3 PT_LOAD segments, got {len(segs)}")

    # F1: Check symbol counts and all `[placed].exports` from `translation.toml`.
    if len(raw_syms) != expected_symtab_count:
        raise RuntimeError(
            f"stock ELF .symtab symbol count {len(raw_syms)} != expected {expected_symtab_count}"
        )
    if len(img.symbols) != expected_loader_sym_count:
        raise RuntimeError(
            f"stock ELF Loader.lean symbol count {len(img.symbols)} != expected {expected_loader_sym_count}"
        )

    cfg = tomllib.loads(cfg_path.read_text(encoding="utf-8"))
    exports = [str(x) for x in cfg.get("placed", {}).get("exports", [])]
    if not exports or len(set(exports)) != len(exports) or "main" not in exports:
        raise RuntimeError(
            f"translation.toml [placed].exports must be non-empty, duplicate-free, and include `main`, got {exports!r}"
        )
    export_addrs: dict[str, int] = {}
    for exp in exports:
        hits = [val for name, val in img.symbols if name == exp]
        if len(hits) != 1:
            raise RuntimeError(
                f"stock ELF export `{exp}` expected 1 unique entry in `img.symbols`, found {len(hits)}: {hits}"
            )
        export_addrs[exp] = hits[0]

    # F8: Assert 0 undefined symbols in `.symtab` (`idx >= 1`), including `STB_WEAK` and `STB_LOCAL`.
    undef_syms = [
        (s.idx, s.name, s.bind, s.stype) for s in raw_syms[1:] if s.st_shndx == 0
    ]
    if undef_syms:
        raise RuntimeError(
            f"stock ELF has {len(undef_syms)} undefined symbol(s) in .symtab (weak/local included): {undef_syms}"
        )

    # F7: Verify `.stock.stub_manifest` section SHA-256 against `stub_manifest` and lock-pinned SHA.
    manifest_sha = stub_manifest_sha256(stub_manifest)
    pin_sha = expected_stub_manifest_sha
    if manifest_sha != pin_sha:
        raise RuntimeError(
            f"stub_manifest sha256 {manifest_sha} != expected {pin_sha}"
        )
    if len(stub_manifest) != expected_stub_manifest_count:
        raise RuntimeError(
            f"stub_manifest entry count {len(stub_manifest)} != expected {expected_stub_manifest_count}"
        )
    manifest_secs = [s for s in sections if s.name == STUB_MANIFEST_SECTION]
    if len(manifest_secs) != 1:
        raise RuntimeError(
            f"stock ELF expected 1 `{STUB_MANIFEST_SECTION}` section, found {len(manifest_secs)}"
        )
    msec = manifest_secs[0]
    if (msec.sh_flags & 0x2) != 0:  # SHF_ALLOC must NOT be set
        raise RuntimeError(
            f"`{STUB_MANIFEST_SECTION}` must be non-SHF_ALLOC, got sh_flags={msec.sh_flags:#x}"
        )
    if msec.sh_offset + msec.sh_size > len(elf_bytes) or msec.sh_size != 64:
        raise RuntimeError(
            f"`{STUB_MANIFEST_SECTION}` expected 64-byte sha256 payload, got size={msec.sh_size}"
        )
    sec_sha_ascii = elf_bytes[msec.sh_offset : msec.sh_offset + msec.sh_size].decode(
        "ascii", errors="replace"
    )
    if sec_sha_ascii != manifest_sha:
        raise RuntimeError(
            f"`{STUB_MANIFEST_SECTION}` payload {sec_sha_ascii!r} != stub_manifest sha256 {manifest_sha!r}"
        )

    # F7: Verify every GC-retained manifest entry in `.symtab` has matching type, size, AND
    # all-zero loaded bytes (`0x00000000` `udf #0` in RX for `function_udf0`; zero RW/TLS bytes for objects).
    retired_by_orig = {
        str(r["originalSymbol"]): dict(r)
        for r in retired_stub_slots
        if isinstance(r, Mapping) and r.get("originalSymbol")
    }
    defined_by_name: dict[str, list[elf_loader.RawElfSym]] = {}
    for s in raw_syms[1:]:
        if s.st_shndx != 0 and s.name:
            defined_by_name.setdefault(s.name, []).append(s)
    expected_stype = {"function_udf0": 2, "object_rw8": 1, "object_rw256": 1, "tls_object": 6}
    retained_stubs = 0
    retained_func_stubs: set[str] = set()
    for item in stub_manifest:
        sname = str(item["name"])
        skind = str(item["kind"])
        ssize = int(item["size"])
        exp_t = expected_stype.get(skind)
        if exp_t is None:
            raise RuntimeError(f"unknown stub manifest kind `{skind}` for `{sname}`")
        if sname in retired_by_orig:
            if skind != "function_udf0" or ssize != 4:
                raise RuntimeError(f"retired stub `{sname}` must be 4-byte function_udf0, got ({skind}, {ssize})")
            ret_sym_nm = str(retired_by_orig[sname]["retiredSymbol"])
            rcands = [
                c
                for c in defined_by_name.get(ret_sym_nm, [])
                if c.bind == 0 and c.stype == 2 and c.st_size == 4
            ]
            if len(rcands) != 1:
                raise RuntimeError(
                    f"retired stub slot `{ret_sym_nm}` (from `{sname}`) expected 1 STB_LOCAL STT_FUNC size 4, found {rcands}"
                )
            rc = rcands[0]
            if not (rc.st_value < entry):
                raise RuntimeError(
                    f"retired stub slot `{ret_sym_nm}` at {rc.st_value:#x} >= e_entry {entry:#x}"
                )
            rgot = img.read_bytes(rc.st_value, 4)
            if rgot is None or rgot[1] != elf_loader.PERM_RX or rgot[0] != b"\x00\x00\x00\x00":
                raise RuntimeError(
                    f"retired stub slot `{ret_sym_nm}` at {rc.st_value:#x} not RX zero-word `udf #0`"
                )
            retained_stubs += 1
            retained_func_stubs.add(sname)
            continue
        cands = defined_by_name.get(sname, [])
        if not cands:
            continue  # Dead stub eliminated by `ld.lld --gc-sections`
        retained_stubs += 1
        matching = [c for c in cands if c.stype == exp_t and c.st_size == ssize]
        if not matching:
            raise RuntimeError(
                f"stub manifest symbol `{sname}` ({skind}, size={ssize}) mismatch in .symtab: {cands}"
            )
        for c in matching:
            if skind == "function_udf0":
                retained_func_stubs.add(sname)
                if ssize != 4:
                    raise RuntimeError(f"function_udf0 stub `{sname}` must have size 4, got {ssize}")
                got = img.read_bytes(c.st_value, 4)
                if got is None or got[1] != elf_loader.PERM_RX:
                    raise RuntimeError(
                        f"function_udf0 stub `{sname}` at {c.st_value:#x} not mapped in RX segment"
                    )
                if got[0] != b"\x00\x00\x00\x00":
                    raise RuntimeError(
                        f"function_udf0 stub `{sname}` at {c.st_value:#x} has non-zero payload {got[0].hex()!r} (expected udf #0 = 00000000)"
                    )
            elif skind in ("object_rw8", "object_rw256"):
                got = img.read_bytes(c.st_value, ssize)
                if got is None or got[1] != elf_loader.PERM_RW:
                    raise RuntimeError(
                        f"object stub `{sname}` at {c.st_value:#x} not mapped in RW segment"
                    )
                if got[0] != (b"\x00" * ssize):
                    raise RuntimeError(
                        f"object stub `{sname}` at {c.st_value:#x} has non-zero bytes"
                    )
            elif skind == "tls_object":
                if c.st_shndx == 0 or c.st_shndx >= len(sections):
                    raise RuntimeError(f"tls_object stub `{sname}` has invalid shndx={c.st_shndx}")
                tsec = sections[c.st_shndx]
                if (tsec.sh_flags & 0x400) == 0:  # SHF_TLS
                    raise RuntimeError(f"tls_object stub `{sname}` section `{tsec.name}` missing SHF_TLS")
                if tsec.sh_type != 8:  # SHT_PROGBITS TLS template
                    rel = c.st_value
                    if rel + ssize > tsec.sh_size or tsec.sh_offset + rel + ssize > len(elf_bytes):
                        raise RuntimeError(f"tls_object stub `{sname}` out of section bounds")
                    if elf_bytes[tsec.sh_offset + rel : tsec.sh_offset + rel + ssize] != (b"\x00" * ssize):
                        raise RuntimeError(f"tls_object stub `{sname}` has non-zero template bytes")

    if retained_stubs != expected_retained_stub_count:
        raise RuntimeError(
            f"retained stub manifest symbol count {retained_stubs} != expected {expected_retained_stub_count}"
        )

    # F6: `memcmp` guard — direct PC-rel branches, `collect_adrp_add_code_targets`, and 8-byte pointers.
    memcmp_ranges = [
        (s.st_value, s.st_value + max(4, s.st_size))
        for s in raw_syms[1:]
        if s.name == "memcmp" and s.stype == 2 and s.st_shndx != 0
    ]
    bcmp_ranges = [
        (s.st_value, s.st_value + max(4, s.st_size))
        for s in raw_syms[1:]
        if s.name == "bcmp" and s.stype == 2 and s.st_shndx != 0
    ]
    if not memcmp_ranges or not bcmp_ranges:
        raise RuntimeError(
            f"stock ELF expected defined `memcmp` and `bcmp` symbols, got memcmp={memcmp_ranges}, bcmp={bcmp_ranges}"
        )
    non_bcmp_memcmp_callers: list[int] = []
    for p_offset, p_vaddr, p_filesz, _p_memsz, p_flags in segs:
        if (p_flags & 0x1) == 0:
            continue
        seg_data = elf_bytes[p_offset : p_offset + (p_filesz & ~3)]
        for rel in range(0, len(seg_data), 4):
            pc = p_vaddr + rel
            if any(b_lo <= pc < b_hi for b_lo, b_hi in bcmp_ranges):
                continue
            (word,) = struct.unpack_from("<I", seg_data, rel)
            tgt = _BASE.decode_pc_rel_target(word, pc)
            if tgt is not None and any(
                m_lo <= tgt < m_hi and not (m_lo <= pc < m_hi) for m_lo, m_hi in memcmp_ranges
            ):
                non_bcmp_memcmp_callers.append(pc)
    for m_lo, m_hi in memcmp_ranges:
        for src_pc, _tgt_va in _BASE.collect_adrp_add_code_targets(
            segs, elf_bytes, m_lo, m_hi - m_lo
        ):
            if any(b_lo <= src_pc < b_hi for b_lo, b_hi in bcmp_ranges):
                continue
            if m_lo <= src_pc < m_hi:
                continue
            non_bcmp_memcmp_callers.append(src_pc)
    for p_offset, p_vaddr, p_filesz, _p_memsz, _p_flags in segs:
        seg_data = elf_bytes[p_offset : p_offset + (p_filesz & ~7)]
        for rel in range(0, len(seg_data), 8):
            (qword,) = struct.unpack_from("<Q", seg_data, rel)
            if any(m_lo <= qword < m_hi for m_lo, m_hi in memcmp_ranges):
                raise RuntimeError(
                    f"stock ELF stores pointer to unhooked `memcmp` ({qword:#x}) at {p_vaddr + rel:#x}"
                )
    if non_bcmp_memcmp_callers:
        raise RuntimeError(
            f"stock ELF has non-bcmp callers/refs to unhooked `memcmp`: {[hex(pc) for pc in non_bcmp_memcmp_callers]}"
        )

    # F2 & D-C2d: Exact `libsignalSessionExterns` `hstubLt` check (NO heuristic prefix scans!):
    # 1. Every hooked `ext_name` in `lean_externs \ cliDehookedSymsPlaced` must be defined as
    #    `STT_FUNC` with `st_value < entry`; de-hooked symbols in `cliDehookedSymsPlaced` are
    #    positively verified as unique defined RX `STT_FUNC`s with non-`udf #0` code bytes.
    # 2. Every retained `function_udf0` stub must belong to `lean_externs` and satisfy `st_value < entry`.
    eff_dehooked: tuple[str, ...]
    if dehooked_syms is not None:
        eff_dehooked = tuple(str(x) for x in dehooked_syms)
    elif repo_root is not None and (repo_root / DEFAULT_REL_CLI_BINARY_PQ).is_file():
        eff_dehooked = tuple(load_cli_binary_pq_tables(repo_root)["cliDehookedSymsPlaced"])
    else:
        eff_dehooked = ()
    dehooked_set = set(eff_dehooked)

    lean_externs_set = set(lean_externs)
    extra_retained_fn_stubs = sorted(retained_func_stubs - lean_externs_set)
    if extra_retained_fn_stubs:
        raise RuntimeError(
            f"stock ELF retained function_udf0 stub(s) outside libsignalSessionExterns: {extra_retained_fn_stubs}"
        )
    for ext_name in lean_externs:
        fn_hits = [s for s in defined_by_name.get(ext_name, []) if s.stype == 2]
        if not fn_hits:
            raise RuntimeError(
                f"stock ELF `hstubLt` check failed: Lean extern `{ext_name}` missing as STT_FUNC in .symtab"
            )
        if ext_name in dehooked_set:
            continue
        for s in fn_hits:
            if not (s.st_value < entry):
                raise RuntimeError(
                    f"stock ELF `hstubLt` violated: `{ext_name}` at {s.st_value:#x} >= e_entry {entry:#x}"
                )
    _verify_dehooked_placed_symbols(
        img=img,
        sections=sections,
        raw_syms=raw_syms,
        dehooked_syms=eff_dehooked,
        allowed_sec_names=frozenset({".text.crate", ".text.b_pre", ".text.lib2", ".text"}),
        label="stock ELF",
    )

    # F9: Assert proof layout constants (`muslRwStart = entry + 0x2000`, `.got` at `+0x2008`,
    # `.bss.musl` at `+0x2040`, `0x5e8` musl `.text` window, and `main` before `entry`).
    sec_by_name: dict[str, elf_loader.RawElfSection] = {}
    for s in sections:
        if s.name:
            if s.name in sec_by_name:
                raise RuntimeError(f"duplicate section name `{s.name}` in stock ELF")
            sec_by_name[s.name] = s
    for req_sec in (".text", ".init_array", ".fini_array", ".data", ".got", ".bss.musl"):
        if req_sec not in sec_by_name:
            raise RuntimeError(f"stock ELF missing required section `{req_sec}`")

    text_sec = sec_by_name[".text"]
    if text_sec.sh_addr != entry or text_sec.sh_size != PROOF_MUSL_TEXT_SIZE:
        raise RuntimeError(
            f"F9 musl .text mismatch: addr={text_sec.sh_addr:#x} (expected {entry:#x}), "
            f"size={text_sec.sh_size:#x} (expected {PROOF_MUSL_TEXT_SIZE:#x})"
        )
    musl_rw_start = entry + PROOF_MUSL_RW_OFFSET
    for rw_head_sec in (".init_array", ".fini_array", ".data"):
        if sec_by_name[rw_head_sec].sh_addr != musl_rw_start:
            raise RuntimeError(
                f"F9 `{rw_head_sec}` addr={sec_by_name[rw_head_sec].sh_addr:#x} != "
                f"muslRwStart {musl_rw_start:#x} (entry + 0x2000)"
            )
    got_sec = sec_by_name[".got"]
    if got_sec.sh_addr != entry + PROOF_MUSL_GOT_OFFSET:
        raise RuntimeError(
            f"F9 `.got` addr={got_sec.sh_addr:#x} != {entry + PROOF_MUSL_GOT_OFFSET:#x} (entry + 0x2008)"
        )
    bss_musl_sec = sec_by_name[".bss.musl"]
    if bss_musl_sec.sh_addr != entry + PROOF_MUSL_BSS_OFFSET:
        raise RuntimeError(
            f"F9 `.bss.musl` addr={bss_musl_sec.sh_addr:#x} != {entry + PROOF_MUSL_BSS_OFFSET:#x} (entry + 0x2040)"
        )
    musl_rw_end = bss_musl_sec.sh_addr + bss_musl_sec.sh_size
    if musl_rw_end - musl_rw_start != PROOF_MUSL_RW_TOTAL_SIZE:
        raise RuntimeError(
            f"F9 musl RW total size {musl_rw_end - musl_rw_start:#x} != {PROOF_MUSL_RW_TOTAL_SIZE:#x}"
        )
    main_addr = export_addrs["main"]
    if not (main_addr < entry):
        raise RuntimeError(f"F9 `main` at {main_addr:#x} is not strictly before entry {entry:#x}")

    if verbose:
        print(
            f"cli-elf-stock: verified {elf_path.name} (entry={entry:#x}, 3 PT_LOADs, "
            f"{len(exports)}/{len(exports)} exports, {len(raw_syms)} symtab / {len(img.symbols)} loader syms, 0 SHN_UNDEF, "
            f"{len(lean_externs)}/{len(lean_externs)} libsignalSessionExterns < entry, "
            f"{retained_stubs} zero-verified retained stubs, stub_manifest={manifest_sha[:12]}...)"
        )
    return {
        "entry": hex(entry),
        "main_addr": hex(main_addr),
        "main_delta": hex(entry - main_addr),
        "musl_text_size": hex(text_sec.sh_size),
        "musl_rw_start": hex(musl_rw_start),
        "got_addr": hex(got_sec.sh_addr),
        "bss_musl_addr": hex(bss_musl_sec.sh_addr),
        "pt_loads": len(segs),
        "symtab_count": len(raw_syms),
        "loader_sym_count": len(img.symbols),
        "undef_sym_count": 0,
        "exports_verified": exports,
        "memcmp_crate_or_musl_callers": 0,
        "externs_verified": len(lean_externs),
        "retained_stubs_verified": retained_stubs,
        "stub_manifest_sha256": manifest_sha,
    }


READELF_PHDR_TYPE_MAP: dict[str, int] = {
    "NULL": 0,
    "LOAD": 1,
    "DYNAMIC": 2,
    "INTERP": 3,
    "NOTE": 4,
    "SHLIB": 5,
    "PHDR": 6,
    "TLS": 7,
    "GNU_EH_FRAME": 0x6474E550,
    "GNU_STACK": 0x6474E551,
    "GNU_RELRO": 0x6474E552,
}
READELF_SYMTAB_ROW_RE = re.compile(
    r"^\s*(\d+):\s+([0-9a-fA-F]+)\s+(0x[0-9a-fA-F]+|\d+)\s+(\S+)\s+(\S+)\s+(\S+)"
    r"(?:\s+\[[^\]]*\])?\s+(\S+)(?:\s+(.*?))?\s*$"
)


def _find_readelf_bin() -> str:
    for cand in ("readelf", "llvm-readelf"):
        p = shutil.which(cand)
        if p:
            return p
    proc = subprocess.run(
        ["rustc", "--print", "sysroot"], capture_output=True, text=True, check=False
    )
    if proc.returncode == 0:
        sr = pathlib.Path(proc.stdout.strip())
        for p in sr.glob("lib/rustlib/*/bin/llvm-readelf"):
            if p.is_file():
                return str(p)
    raise RuntimeError("neither `readelf` nor `llvm-readelf` found on PATH")


def _fmt_5d_phdr_flags(p_flags: int) -> str:
    return (
        ("R" if (p_flags & 4) else " ")
        + ("W" if (p_flags & 2) else " ")
        + ("E" if (p_flags & 1) else " ")
    ).strip() or "none"


def parse_readelf_5d(readelf_h: str, readelf_lw: str, readelf_sw: str) -> dict[str, Any]:
    """Fail-closed parser for GNU-style `readelf -h`, `readelf -lW`, and `readelf -sW` output."""
    m_ent = re.search(r"Entry point address:\s+(0x[0-9a-fA-F]+|\d+)", readelf_h)
    m_phn = re.search(r"Number of program headers:\s+(\d+)", readelf_h)
    if m_ent is None or m_phn is None:
        raise RuntimeError("`readelf -h` output missing `Entry point address` or `Number of program headers`")
    e_entry = int(m_ent.group(1), 0)
    e_phnum = int(m_phn.group(1))

    phdrs: list[dict[str, Any]] = []
    in_phdrs = False
    for line in readelf_lw.splitlines():
        stripped = line.strip()
        if stripped.startswith("Program Headers:"):
            in_phdrs = True
            continue
        if not in_phdrs:
            continue
        if stripped.startswith("Section to Segment mapping:"):
            break
        if not stripped or stripped.startswith("Type ") or stripped.startswith("["):
            continue
        toks = stripped.split()
        if len(toks) < 7 or not toks[1].startswith("0x") or not toks[2].startswith("0x"):
            continue
        tname = toks[0]
        p_offset = int(toks[1], 16)
        p_vaddr = int(toks[2], 16)
        p_paddr = int(toks[3], 16)
        p_filesz = int(toks[4], 16)
        p_memsz = int(toks[5], 16)
        p_align = int(toks[-1], 0)
        flg_raw = "".join(toks[6:-1])
        p_flags = (
            (4 if "R" in flg_raw else 0)
            | (2 if "W" in flg_raw else 0)
            | (1 if "E" in flg_raw else 0)
        )
        p_type = READELF_PHDR_TYPE_MAP.get(
            tname, int(tname, 0) if tname.startswith("0x") else -1
        )
        phdrs.append(
            {
                "idx": len(phdrs),
                "p_type": p_type,
                "type_name": tname,
                "p_flags": p_flags,
                "flags": _fmt_5d_phdr_flags(p_flags),
                "p_offset": p_offset,
                "p_vaddr": p_vaddr,
                "p_paddr": p_paddr,
                "p_filesz": p_filesz,
                "p_memsz": p_memsz,
                "p_align": p_align,
            }
        )
    if len(phdrs) != e_phnum:
        raise RuntimeError(
            f"`readelf -lW` parsed {len(phdrs)} program headers != `readelf -h` e_phnum {e_phnum}"
        )

    syms: list[dict[str, Any]] = []
    saw_table_hdr = False
    in_symtab = True
    saw_symtab = False
    for line in readelf_sw.splitlines():
        m_tbl = re.match(r"^\s*Symbol table '([^']+)'", line)
        if m_tbl is not None:
            saw_table_hdr = True
            in_symtab = m_tbl.group(1) == ".symtab"
            if in_symtab:
                saw_symtab = True
            continue
        if not in_symtab:
            continue
        m_row = READELF_SYMTAB_ROW_RE.match(line)
        if m_row is None:
            continue
        idx = int(m_row.group(1))
        st_value = int(m_row.group(2), 16)
        st_size = int(m_row.group(3), 0)
        type_name = m_row.group(4)
        bind_name = m_row.group(5)
        ndx_s = m_row.group(7)
        name = (m_row.group(8) or "").strip()
        if ndx_s == "UND":
            st_shndx = 0
        elif ndx_s == "ABS":
            st_shndx = 0xFFF1
        elif ndx_s == "COM":
            st_shndx = 0xFFF2
        elif ndx_s.isdigit():
            st_shndx = int(ndx_s)
        else:
            st_shndx = 0xFF00
        syms.append(
            {
                "idx": idx,
                "name": name,
                "bind_name": bind_name,
                "type_name": type_name,
                "st_shndx": st_shndx,
                "st_value": st_value,
                "st_size": st_size,
            }
        )
    if saw_table_hdr and not saw_symtab:
        raise RuntimeError("`readelf -sW` output missing `.symtab` symbol table")
    if not syms:
        raise RuntimeError("`readelf -sW` output contained 0 `.symtab` entries")
    return {
        "e_entry": e_entry,
        "e_phnum": e_phnum,
        "phdrs": phdrs,
        "syms": syms,
    }


def _parse_raw_elf64_for_5d(elf_bytes: bytes) -> dict[str, Any]:
    img, raw_phdrs, _sections, raw_syms = elf_loader.parse_raw_elf(elf_bytes, require_symtab=True)
    rev_pt_map = {v: k for k, v in READELF_PHDR_TYPE_MAP.items()}
    stb_names = {0: "LOCAL", 1: "GLOBAL", 2: "WEAK"}
    stt_names = {0: "NOTYPE", 1: "OBJECT", 2: "FUNC", 3: "SECTION", 4: "FILE", 6: "TLS"}
    phdrs = [
        {
            "idx": i,
            "p_type": int(ph.p_type),
            "type_name": rev_pt_map.get(int(ph.p_type), hex(int(ph.p_type))),
            "p_flags": int(ph.p_flags),
            "flags": _fmt_5d_phdr_flags(int(ph.p_flags)),
            "p_offset": int(ph.p_offset),
            "p_vaddr": int(ph.p_vaddr),
            "p_paddr": int(ph.p_paddr),
            "p_filesz": int(ph.p_filesz),
            "p_memsz": int(ph.p_memsz),
            "p_align": int(ph.p_align),
        }
        for i, ph in enumerate(raw_phdrs)
    ]
    syms = [
        {
            "idx": int(s.idx),
            "name": str(s.name),
            "bind_name": stb_names.get(int(s.bind), str(s.bind)),
            "type_name": stt_names.get(int(s.stype), str(s.stype)),
            "st_shndx": int(s.st_shndx),
            "st_value": int(s.st_value),
            "st_size": int(s.st_size),
        }
        for s in raw_syms
    ]
    return {
        "e_entry": int(img.entry),
        "e_phnum": len(raw_phdrs),
        "phdrs": phdrs,
        "syms": syms,
    }


def evaluate_stdbin_5d(
    parsed: Mapping[str, Any],
    lean_externs: Sequence[str],
    *,
    dehooked_syms: Sequence[str] = (),
    elf_name: str = "signal-session-stock-stdbin.elf",
    elf_size: int = 0,
    elf_sha256: str = "",
    readelf_tool: str = "readelf",
) -> dict[str, Any]:
    """Evaluate fail-closed 5d acceptance criteria on parsed `readelf` / ELF64 structures."""
    failures: list[str] = []
    phdrs = list(parsed["phdrs"])
    pt_loads = [p for p in phdrs if int(p["p_type"]) == 1 or p.get("type_name") == "LOAD"]
    pt_tls = [p for p in phdrs if int(p["p_type"]) == 7 or p.get("type_name") == "TLS"]
    pt_stack = [
        p
        for p in phdrs
        if int(p["p_type"]) == 0x6474E551 or p.get("type_name") == "GNU_STACK"
    ]

    if not pt_loads:
        failures.append("no PT_LOAD segments")
    else:
        first_vaddr = int(pt_loads[0]["p_vaddr"])
        if first_vaddr != 0x400000:
            failures.append(f"first PT_LOAD p_vaddr == {first_vaddr:#x} != 0x400000")

    wx_ok = True
    for p in pt_loads:
        fl = int(p["p_flags"])
        if (fl & 0x2) != 0 and (fl & 0x1) != 0:
            wx_ok = False
            failures.append(
                f"W^X violation on PT_LOAD[{p['idx']}] at {int(p['p_vaddr']):#x} (flags={p['flags']})"
            )

    if not pt_tls:
        failures.append("PT_TLS missing (0 PT_TLS program headers)")

    if len(pt_stack) != 1 or (int(pt_stack[0]["p_flags"]) & 0x1) != 0:
        wx_ok = False
        failures.append(f"PT_GNU_STACK missing or executable: {pt_stack}")

    entry = int(parsed["e_entry"])
    entry_page_aligned = (entry % 0x1000) == 0
    if (entry % 4) != 0:
        failures.append(
            f"e_entry {entry:#x} is not 4-byte instruction-aligned (rem={entry % 4:#x})"
        )

    def _rx_loads_for(vma: int) -> list[dict[str, Any]]:
        return [
            p
            for p in pt_loads
            if int(p["p_vaddr"]) <= vma < int(p["p_vaddr"]) + int(p["p_filesz"])
            and (int(p["p_flags"]) & 0x5) == 0x5
            and (int(p["p_flags"]) & 0x2) == 0
        ]

    def _in_rx(vma: int) -> bool:
        return len(_rx_loads_for(vma)) > 0

    entry_rx_loads = _rx_loads_for(entry)
    entry_rx_vaddr: int | None = (
        int(entry_rx_loads[0]["p_vaddr"]) if entry_rx_loads else None
    )
    if not entry_rx_loads:
        failures.append(f"e_entry {entry:#x} is not inside an RX PT_LOAD file-backed range")
    else:
        for ep in entry_rx_loads:
            ep_va = int(ep["p_vaddr"])
            if (ep_va % 0x1000) != 0:
                failures.append(
                    f"RX PT_LOAD[{ep['idx']}] containing e_entry ({entry:#x}) starts at "
                    f"{ep_va:#x}, not 0x1000-aligned"
                )

    defined_by_name: dict[str, list[dict[str, Any]]] = {}
    all_aarch64_outline: list[str] = []
    for s in list(parsed["syms"])[1:]:
        shndx = int(s["st_shndx"])
        nm = str(s["name"])
        if 0 < shndx < 0xFF00 and nm:
            defined_by_name.setdefault(nm, []).append(s)
            if nm.startswith("__aarch64_") and s.get("type_name") == "FUNC":
                if nm not in all_aarch64_outline:
                    all_aarch64_outline.append(nm)

    lean_externs_set = set(str(x) for x in lean_externs)
    dehooked_set = set(str(x) for x in dehooked_syms)
    check_names_ordered: list[str] = []
    for nm in [*lean_externs, *STDBIN_EXPLICIT_5D_EXTERNS, *sorted(all_aarch64_outline)]:
        s_nm = str(nm)
        if s_nm not in check_names_ordered:
            check_names_ordered.append(s_nm)

    externs_ge_entry: list[dict[str, Any]] = []
    missing_externs: list[str] = []
    non_rx_externs: list[dict[str, Any]] = []
    extern_addrs: dict[str, str] = {}
    explicit_checks: dict[str, Any] = {}

    for nm in check_names_ordered:
        all_defs = defined_by_name.get(nm, [])
        fn_defs = [s for s in all_defs if s.get("type_name") == "FUNC"]
        if not fn_defs:
            missing_externs.append(nm)
            failures.append(f"extern `{nm}` missing as defined STT_FUNC in .symtab")
            continue
        addrs_for_nm = sorted({int(d["st_value"]) for d in all_defs})
        extern_addrs[nm] = (
            hex(addrs_for_nm[0])
            if len(addrs_for_nm) == 1
            else ",".join(hex(a) for a in addrs_for_nm)
        )
        for d in all_defs:
            val = int(d["st_value"])
            if not _in_rx(val):
                non_rx_externs.append(
                    {"name": nm, "addr": hex(val), "type": d.get("type_name")}
                )
            if nm not in dehooked_set and val >= entry:
                externs_ge_entry.append(
                    {
                        "name": nm,
                        "in_libsignalSessionExterns": nm in lean_externs_set,
                        "addr": hex(val),
                        "delta_from_entry": hex(val - entry),
                        "size": int(d["st_size"]),
                        "bind": d.get("bind_name"),
                        "type": d.get("type_name"),
                    }
                )
        if nm in STDBIN_EXPLICIT_5D_EXTERNS or nm.startswith("__aarch64_"):
            explicit_checks[nm] = {
                "in_libsignalSessionExterns": nm in lean_externs_set,
                "addrs": [hex(int(d["st_value"])) for d in all_defs],
                "all_lt_entry": all(int(d["st_value"]) < entry for d in all_defs),
                "all_in_rx": all(_in_rx(int(d["st_value"])) for d in all_defs),
            }

    for d_nm in dehooked_syms:
        s_dnm = str(d_nm)
        d_fn_defs = [
            s for s in defined_by_name.get(s_dnm, []) if s.get("type_name") == "FUNC"
        ]
        if len(d_fn_defs) != 1:
            failures.append(
                f"de-hooked symbol `{s_dnm}` (`cliDehookedSymsPlaced`) expected 1 defined STT_FUNC in .symtab, found {len(d_fn_defs)}"
            )
        elif not _in_rx(int(d_fn_defs[0]["st_value"])):
            failures.append(
                f"de-hooked symbol `{s_dnm}` at {int(d_fn_defs[0]['st_value']):#x} is not in RX PT_LOAD"
            )

    if externs_ge_entry:
        failures.append(
            f"{len(externs_ge_entry)} extern symbol definition(s) >= e_entry ({entry:#x}): "
            + ", ".join(f"{r['name']}@{r['addr']}" for r in externs_ge_entry[:12])
            + (" ..." if len(externs_ge_entry) > 12 else "")
        )
    if non_rx_externs:
        failures.append(f"{len(non_rx_externs)} extern symbol(s) not in RX PT_LOAD")

    main_fn_defs = [
        s for s in defined_by_name.get("main", []) if s.get("type_name") == "FUNC"
    ]
    main_global_defs = [s for s in main_fn_defs if s.get("bind_name") == "GLOBAL"]
    chosen_main = main_global_defs if main_global_defs else main_fn_defs
    main_addr: int | None = int(chosen_main[0]["st_value"]) if len(chosen_main) == 1 else None
    hmain_off: int | None = (entry - main_addr) if main_addr is not None else None
    if main_addr is None or len(main_fn_defs) != 1:
        failures.append(f"expected unique STT_FUNC `main`, found {main_fn_defs}")
    else:
        if not _in_rx(main_addr):
            failures.append(f"`main` ({main_addr:#x}) is not in RX PT_LOAD")
        if main_addr >= entry:
            failures.append(f"`main` ({main_addr:#x}) >= `e_entry` ({entry:#x})")

    return {
        "pass_5d": len(failures) == 0,
        "failures": failures,
        "elf_name": elf_name,
        "elf_size": elf_size,
        "elf_sha256": elf_sha256,
        "readelf_tool": readelf_tool,
        "e_entry": hex(entry),
        "e_entry_page_aligned": entry_page_aligned,
        "entry_rx_pt_load_vaddr": hex(entry_rx_vaddr) if entry_rx_vaddr is not None else None,
        "e_phnum": int(parsed["e_phnum"]),
        "first_pt_load_vaddr": hex(int(pt_loads[0]["p_vaddr"])) if pt_loads else None,
        "pt_loads": [
            {
                "idx": p["idx"],
                "vaddr": hex(int(p["p_vaddr"])),
                "filesz": hex(int(p["p_filesz"])),
                "memsz": hex(int(p["p_memsz"])),
                "flags": p["flags"],
                "align": hex(int(p["p_align"])),
            }
            for p in pt_loads
        ],
        "wx_ok": wx_ok,
        "pt_tls_present": len(pt_tls) > 0,
        "main_addr": hex(main_addr) if main_addr is not None else None,
        "main_lt_entry": (main_addr < entry) if main_addr is not None else False,
        "hmainOff": (
            (hex(hmain_off) if hmain_off >= 0 else f"-{-hmain_off:#x}")
            if hmain_off is not None
            else None
        ),
        "checked_extern_count": len(check_names_ordered),
        "explicit_strlen_and_outline_atomics": explicit_checks,
        "missing_externs": missing_externs,
        "non_rx_externs": non_rx_externs,
        "externs_ge_entry_count": len(externs_ge_entry),
        "externs_ge_entry": externs_ge_entry,
        "extern_addrs": extern_addrs,
    }


def verify_stdbin_5d(
    *,
    elf_path: pathlib.Path,
    lean_externs: Sequence[str],
    dehooked_syms: Sequence[str] = (),
    json_out_path: pathlib.Path | None = None,
    verbose: bool = True,
) -> dict[str, Any]:
    """Run real `readelf` (`-h`, `-lW`, `-sW`) AND cross-check against raw ELF64 parsing, write
    `cv-stock-stdbin-5d.json`, print a 1-line summary, and raise `RuntimeError` on any 5d violation."""
    readelf_bin = _find_readelf_bin()
    style_args = (
        ["--elf-output-style=GNU"]
        if pathlib.Path(readelf_bin).name.startswith("llvm-readelf")
        else []
    )
    readelf_h = subprocess.run(
        [readelf_bin, *style_args, "-h", str(elf_path)],
        capture_output=True,
        text=True,
        check=True,
    ).stdout
    readelf_lw = subprocess.run(
        [readelf_bin, *style_args, "-lW", str(elf_path)],
        capture_output=True,
        text=True,
        check=True,
    ).stdout
    readelf_sw = subprocess.run(
        [readelf_bin, *style_args, "-sW", str(elf_path)],
        capture_output=True,
        text=True,
        check=True,
    ).stdout

    elf_bytes = elf_path.read_bytes()
    elf_sha = hashlib.sha256(elf_bytes).hexdigest()
    tool_base = pathlib.Path(readelf_bin).name

    re_parsed = parse_readelf_5d(readelf_h, readelf_lw, readelf_sw)
    raw_parsed = _parse_raw_elf64_for_5d(elf_bytes)

    rep = evaluate_stdbin_5d(
        re_parsed,
        lean_externs,
        dehooked_syms=dehooked_syms,
        elf_name=elf_path.name,
        elf_size=len(elf_bytes),
        elf_sha256=elf_sha,
        readelf_tool=tool_base,
    )
    raw_rep = evaluate_stdbin_5d(
        raw_parsed,
        lean_externs,
        dehooked_syms=dehooked_syms,
        elf_name=elf_path.name,
        elf_size=len(elf_bytes),
        elf_sha256=elf_sha,
        readelf_tool="raw_elf64",
    )
    for cmp_key in (
        "pass_5d",
        "e_entry",
        "entry_rx_pt_load_vaddr",
        "e_phnum",
        "first_pt_load_vaddr",
        "wx_ok",
        "pt_tls_present",
        "main_addr",
        "extern_addrs",
    ):
        if rep.get(cmp_key) != raw_rep.get(cmp_key):
            rep["pass_5d"] = False
            rep["failures"].append(
                f"readelf vs raw_elf64 mismatch on `{cmp_key}`: "
                f"{rep.get(cmp_key)!r} != {raw_rep.get(cmp_key)!r}"
            )

    eff_json_out = (
        json_out_path
        if json_out_path is not None
        else (elf_path.parent / DEFAULT_STDBIN_5D_NAME)
    )
    eff_json_out.parent.mkdir(parents=True, exist_ok=True)
    eff_json_out.write_text(json.dumps(rep, indent=2) + "\n", encoding="utf-8")

    status = "PASS" if rep["pass_5d"] else "FAIL"
    if verbose or not rep["pass_5d"]:
        print(
            f"cli-elf-stock --stdbin 5d: {status} ({elf_path.name}: entry={rep['e_entry']}, "
            f"first_load={rep['first_pt_load_vaddr']}, pt_tls={rep['pt_tls_present']}, "
            f"main={rep['main_addr']}, hmainOff={rep['hmainOff']}, "
            f"externs_checked={rep['checked_extern_count']}, "
            f"externs_ge_entry={rep['externs_ge_entry_count']}) -> {eff_json_out}"
        )
    if not rep["pass_5d"]:
        raise RuntimeError("StdBin 5d check failed: " + "; ".join(rep["failures"]))
    return rep


def verify_stock_stdbin_elf(
    elf_path: pathlib.Path,
    cfg_path: pathlib.Path,
    stub_manifest: Sequence[dict[str, Any]],
    *,
    sibling_cfg_paths: Sequence[pathlib.Path] = (),
    repo_root: pathlib.Path | None = None,
    expected_externs: Sequence[str] | None = None,
    dehooked_syms: Sequence[str] | None = None,
    retired_stub_slots: Sequence[Mapping[str, Any]] = (),
    active_lib2_roots: Sequence[str] | None = None,
    expected_phnum: int = EXPECTED_STDBIN_PHNUM,
    expected_pt_loads: int = EXPECTED_STDBIN_PT_LOADS,
    expected_symtab_count: int = EXPECTED_STDBIN_SYMTAB_COUNT,
    expected_loader_sym_count: int = EXPECTED_STDBIN_LOADER_SYM_COUNT,
    expected_stub_manifest_count: int = EXPECTED_STDBIN_STUB_MANIFEST_COUNT,
    expected_retained_stub_count: int = EXPECTED_STDBIN_RETAINED_STUB_COUNT,
    expected_stub_manifest_sha: str | None = None,
    weak_undefined_allowed: Sequence[str] = DEFAULT_STDBIN_WEAK_UNDEFINED_ALLOWED,
    enforce_5d: bool = True,
    five_d_json_path: pathlib.Path | None = None,
    verbose: bool = True,
) -> dict[str, Any]:
    """Fail-closed structural, W^X, symbol, sibling-export, weak-undef, stub-manifest, `memcmp`,
    and `libsignalSessionExterns` verifier for the 2-config IO.6b `StdBin` stock ELF."""
    if not stub_manifest:
        raise RuntimeError(
            "verify_stock_stdbin_elf requires a non-empty `stub_manifest` (refusing None/empty)"
        )

    if repo_root is not None:
        derived = derive_placed_expectations(repo_root, cfg_path=cfg_path)
        lean_externs = list(derived["externs"])
        if expected_externs is not None and list(expected_externs) != lean_externs:
            raise RuntimeError("explicit expected_externs disagrees with .GeneratedLean externs")
    elif expected_externs is not None and len(expected_externs) > 0:
        lean_externs = list(expected_externs)
    else:
        raise RuntimeError(
            "verify_stock_stdbin_elf requires `repo_root` (with `.GeneratedLean`) or explicit "
            "`expected_externs` (refusing silent hardcoded externs fallback)"
        )

    elf_bytes = elf_path.read_bytes()
    img, phdrs, sections, raw_syms = elf_loader.parse_raw_elf(elf_bytes, require_symtab=True)
    entry, segs = _BASE.parse_elf64_header_and_pt_loads(elf_bytes)
    if entry != img.entry:
        raise RuntimeError(f"entry mismatch between parsers: {entry:#x} vs {img.entry:#x}")
    if len(phdrs) != expected_phnum:
        raise RuntimeError(
            f"stock StdBin ELF e_phnum {len(phdrs)} != expected {expected_phnum}"
        )
    if len(segs) != expected_pt_loads:
        raise RuntimeError(
            f"stock StdBin ELF expected {expected_pt_loads} PT_LOAD segments, got {len(segs)}"
        )

    # Enforce strict W^X on every PT_LOAD segment and non-executable PT_GNU_STACK.
    for seg_idx, (_poff, p_va, _pfsz, _pmsz, p_flags) in enumerate(segs):
        if (p_flags & 0x2) != 0 and (p_flags & 0x1) != 0:
            raise RuntimeError(
                f"W^X violation on PT_LOAD[{seg_idx}] at {p_va:#x}: p_flags={p_flags:#x} is both W and X"
            )
    gnu_stack_phdrs = [ph for ph in phdrs if ph.p_type == 0x6474E551]
    if len(gnu_stack_phdrs) != 1:
        raise RuntimeError(
            f"stock StdBin ELF expected exactly 1 PT_GNU_STACK phdr, found {len(gnu_stack_phdrs)}"
        )
    if (gnu_stack_phdrs[0].p_flags & 0x1) != 0:
        raise RuntimeError(
            f"PT_GNU_STACK must be non-executable, got p_flags={gnu_stack_phdrs[0].p_flags:#x}"
        )
    entry_read = img.read_bytes(entry, 4)
    if entry_read is None or entry_read[1] != elf_loader.PERM_RX:
        raise RuntimeError(f"stock StdBin ELF e_entry={entry:#x} is not mapped in an RX PT_LOAD")

    if len(raw_syms) != expected_symtab_count:
        raise RuntimeError(
            f"stock StdBin ELF .symtab symbol count {len(raw_syms)} != expected {expected_symtab_count}"
        )
    if len(img.symbols) != expected_loader_sym_count:
        raise RuntimeError(
            f"stock StdBin ELF Loader.lean symbol count {len(img.symbols)} != expected {expected_loader_sym_count}"
        )

    cfg = tomllib.loads(cfg_path.read_text(encoding="utf-8"))
    exports = [str(x) for x in cfg.get("placed", {}).get("exports", [])]
    if not exports or len(set(exports)) != len(exports) or "main" not in exports:
        raise RuntimeError(
            f"translation.toml [placed].exports must be non-empty, duplicate-free, and include `main`, got {exports!r}"
        )
    export_addrs: dict[str, int] = {}
    for exp in exports:
        hits = [val for name, val in img.symbols if name == exp]
        if len(hits) != 1:
            raise RuntimeError(
                f"stock StdBin ELF export `{exp}` expected 1 unique entry in `img.symbols`, found {len(hits)}: {hits}"
            )
        exp_read = img.read_bytes(hits[0], 4)
        if exp_read is None or exp_read[1] != elf_loader.PERM_RX:
            raise RuntimeError(f"stock StdBin ELF export `{exp}` at {hits[0]:#x} not in RX segment")
        export_addrs[exp] = hits[0]

    # Verify sibling exports (e.g. `signal_session_io::*` from `cli/io/translation.toml`) are defined RX STT_FUNCs.
    defined_funcs_by_demangled: dict[str, list[elf_loader.RawElfSym]] = {}
    for s in raw_syms[1:]:
        if s.st_shndx != 0 and s.stype == 2 and s.name:
            defined_funcs_by_demangled.setdefault(s.name, []).append(s)
            dem = alpha_checks.demangle_rust_v0(s.name)
            if dem != s.name:
                defined_funcs_by_demangled.setdefault(dem, []).append(s)

    sibling_exports_verified: list[str] = []
    for sib_cfg_p in sibling_cfg_paths:
        if not sib_cfg_p.is_file():
            raise RuntimeError(f"sibling translation.toml missing at {sib_cfg_p}")
        sib_cfg = tomllib.loads(sib_cfg_p.read_text(encoding="utf-8"))
        if isinstance(sib_cfg.get("lib2_rows"), Mapping) and active_lib2_roots is not None:
            sib_exps = list(active_lib2_roots)
            if not sib_exps:
                continue
        else:
            sib_exps = [str(x) for x in sib_cfg.get("placed", {}).get("exports", [])]
            if not sib_exps:
                raise RuntimeError(f"sibling config {sib_cfg_p} has empty `[placed].exports`")
        for sexp in sib_exps:
            sib_hits = defined_funcs_by_demangled.get(sexp, [])
            if len(sib_hits) != 1:
                raise RuntimeError(
                    f"sibling export `{sexp}` ({sib_cfg_p.name}) expected 1 defined STT_FUNC in .symtab, found {len(sib_hits)}"
                )
            s_read = img.read_bytes(sib_hits[0].st_value, 4)
            if s_read is None or s_read[1] != elf_loader.PERM_RX:
                raise RuntimeError(
                    f"sibling export `{sexp}` at {sib_hits[0].st_value:#x} not mapped in RX segment"
                )
            sibling_exports_verified.append(sexp)

    # Undefined symbol guard: 0 strong undefineds; only pinned CRT `weak_undefined_allowed` permitted
    # (`STB_WEAK` at `st_value == 0`, or `STV_HIDDEN` CRT weak undefs such as `_DYNAMIC` in `crt1.o`
    # localized by `ld.lld -static -no-pie` to `STB_LOCAL` + `STV_HIDDEN` at `st_value == 0`).
    allowed_weak_undefs = set(str(x) for x in weak_undefined_allowed)
    undef_syms = [s for s in raw_syms[1:] if s.st_shndx == 0]
    bad_undefs = [
        (s.idx, s.name, s.bind, s.st_other, s.stype, s.st_value)
        for s in undef_syms
        if s.name not in allowed_weak_undefs
        or s.st_value != 0
        or not (
            s.bind == 2
            or (s.bind == 0 and (s.st_other & 0x3) == 2)
        )
    ]
    if bad_undefs:
        raise RuntimeError(
            f"stock StdBin ELF has disallowed undefined symbol(s) in .symtab "
            f"(allowed CRT weak/hidden-weak={sorted(allowed_weak_undefs)}): {bad_undefs}"
        )

    # F7: Verify `.stock.stub_manifest` section SHA-256 against `stub_manifest` and pinned SHA.
    manifest_sha = stub_manifest_sha256(stub_manifest)
    pin_sha = (
        expected_stub_manifest_sha
        if expected_stub_manifest_sha is not None
        else EXPECTED_STDBIN_STUB_MANIFEST_SHA256
    )
    if not HEX64_RE.match(pin_sha):
        raise RuntimeError(f"missing or invalid pinned stub_manifest sha256: {pin_sha!r}")
    if manifest_sha != pin_sha:
        raise RuntimeError(f"stub_manifest sha256 {manifest_sha} != expected {pin_sha}")
    if len(stub_manifest) != expected_stub_manifest_count:
        raise RuntimeError(
            f"stub_manifest entry count {len(stub_manifest)} != expected {expected_stub_manifest_count}"
        )
    manifest_secs = [s for s in sections if s.name == STUB_MANIFEST_SECTION]
    if len(manifest_secs) != 1:
        raise RuntimeError(
            f"stock StdBin ELF expected 1 `{STUB_MANIFEST_SECTION}` section, found {len(manifest_secs)}"
        )
    msec = manifest_secs[0]
    if (msec.sh_flags & 0x2) != 0:
        raise RuntimeError(
            f"`{STUB_MANIFEST_SECTION}` must be non-SHF_ALLOC, got sh_flags={msec.sh_flags:#x}"
        )
    if msec.sh_offset + msec.sh_size > len(elf_bytes) or msec.sh_size != 64:
        raise RuntimeError(
            f"`{STUB_MANIFEST_SECTION}` expected 64-byte sha256 payload, got size={msec.sh_size}"
        )
    sec_sha_ascii = elf_bytes[msec.sh_offset : msec.sh_offset + msec.sh_size].decode(
        "ascii", errors="replace"
    )
    if sec_sha_ascii != manifest_sha:
        raise RuntimeError(
            f"`{STUB_MANIFEST_SECTION}` payload {sec_sha_ascii!r} != stub_manifest sha256 {manifest_sha!r}"
        )

    retired_by_orig = {
        str(r["originalSymbol"]): dict(r)
        for r in retired_stub_slots
        if isinstance(r, Mapping) and r.get("originalSymbol")
    }
    defined_by_name: dict[str, list[elf_loader.RawElfSym]] = {}
    for s in raw_syms[1:]:
        if s.st_shndx != 0 and s.name:
            defined_by_name.setdefault(s.name, []).append(s)
    expected_stype = {"function_udf0": 2, "object_rw8": 1, "object_rw256": 1, "tls_object": 6}
    retained_stubs = 0
    retained_func_stubs: set[str] = set()
    for item in stub_manifest:
        sname = str(item["name"])
        skind = str(item["kind"])
        ssize = int(item["size"])
        exp_t = expected_stype.get(skind)
        if exp_t is None:
            raise RuntimeError(f"unknown stub manifest kind `{skind}` for `{sname}`")
        if sname in retired_by_orig:
            if skind != "function_udf0" or ssize != 4:
                raise RuntimeError(f"retired stub `{sname}` must be 4-byte function_udf0, got ({skind}, {ssize})")
            ret_sym_nm = str(retired_by_orig[sname]["retiredSymbol"])
            rcands = [
                c
                for c in defined_by_name.get(ret_sym_nm, [])
                if c.bind == 0 and c.stype == 2 and c.st_size == 4
            ]
            if len(rcands) != 1:
                raise RuntimeError(
                    f"retired stub slot `{ret_sym_nm}` (from `{sname}`) expected 1 STB_LOCAL STT_FUNC size 4, found {rcands}"
                )
            rc = rcands[0]
            if not (rc.st_value < entry):
                raise RuntimeError(
                    f"retired stub slot `{ret_sym_nm}` at {rc.st_value:#x} >= e_entry {entry:#x}"
                )
            rgot = img.read_bytes(rc.st_value, 4)
            if rgot is None or rgot[1] != elf_loader.PERM_RX or rgot[0] != b"\x00\x00\x00\x00":
                raise RuntimeError(
                    f"retired stub slot `{ret_sym_nm}` at {rc.st_value:#x} not RX zero-word `udf #0`"
                )
            retained_stubs += 1
            retained_func_stubs.add(sname)
            continue
        cands = defined_by_name.get(sname, [])
        if not cands:
            continue
        retained_stubs += 1
        matching = [c for c in cands if c.stype == exp_t and c.st_size == ssize]
        if not matching:
            raise RuntimeError(
                f"stub manifest symbol `{sname}` ({skind}, size={ssize}) mismatch in .symtab: {cands}"
            )
        for c in matching:
            if skind == "function_udf0":
                retained_func_stubs.add(sname)
                if ssize != 4:
                    raise RuntimeError(f"function_udf0 stub `{sname}` must have size 4, got {ssize}")
                got = img.read_bytes(c.st_value, 4)
                if got is None or got[1] != elf_loader.PERM_RX:
                    raise RuntimeError(
                        f"function_udf0 stub `{sname}` at {c.st_value:#x} not mapped in RX segment"
                    )
                if got[0] != b"\x00\x00\x00\x00":
                    raise RuntimeError(
                        f"function_udf0 stub `{sname}` at {c.st_value:#x} has non-zero payload {got[0].hex()!r} (expected udf #0 = 00000000)"
                    )
            elif skind in ("object_rw8", "object_rw256"):
                got = img.read_bytes(c.st_value, ssize)
                if got is None or got[1] != elf_loader.PERM_RW:
                    raise RuntimeError(
                        f"object stub `{sname}` at {c.st_value:#x} not mapped in RW segment"
                    )
                if got[0] != (b"\x00" * ssize):
                    raise RuntimeError(
                        f"object stub `{sname}` at {c.st_value:#x} has non-zero bytes"
                    )
            elif skind == "tls_object":
                if c.st_shndx == 0 or c.st_shndx >= len(sections):
                    raise RuntimeError(f"tls_object stub `{sname}` has invalid shndx={c.st_shndx}")
                tsec = sections[c.st_shndx]
                if (tsec.sh_flags & 0x400) == 0:
                    raise RuntimeError(f"tls_object stub `{sname}` section `{tsec.name}` missing SHF_TLS")
                if tsec.sh_type != 8:
                    rel = c.st_value
                    if rel + ssize > tsec.sh_size or tsec.sh_offset + rel + ssize > len(elf_bytes):
                        raise RuntimeError(f"tls_object stub `{sname}` out of section bounds")
                    if elf_bytes[tsec.sh_offset + rel : tsec.sh_offset + rel + ssize] != (b"\x00" * ssize):
                        raise RuntimeError(f"tls_object stub `{sname}` has non-zero template bytes")

    if retained_stubs != expected_retained_stub_count:
        raise RuntimeError(
            f"retained stub manifest symbol count {retained_stubs} != expected {expected_retained_stub_count}"
        )

    # F6: `memcmp` guard — only `bcmp` may call/reference unhooked `memcmp`.
    memcmp_ranges = [
        (s.st_value, s.st_value + max(4, s.st_size))
        for s in raw_syms[1:]
        if s.name == "memcmp" and s.stype == 2 and s.st_shndx != 0
    ]
    bcmp_ranges = [
        (s.st_value, s.st_value + max(4, s.st_size))
        for s in raw_syms[1:]
        if s.name == "bcmp" and s.stype == 2 and s.st_shndx != 0
    ]
    if not memcmp_ranges or not bcmp_ranges:
        raise RuntimeError(
            f"stock StdBin ELF expected defined `memcmp` and `bcmp` symbols, got memcmp={memcmp_ranges}, bcmp={bcmp_ranges}"
        )
    non_bcmp_memcmp_callers: list[int] = []
    for p_offset, p_vaddr, p_filesz, _p_memsz, p_flags in segs:
        if (p_flags & 0x1) == 0:
            continue
        seg_data = elf_bytes[p_offset : p_offset + (p_filesz & ~3)]
        for rel in range(0, len(seg_data), 4):
            pc = p_vaddr + rel
            if any(b_lo <= pc < b_hi for b_lo, b_hi in bcmp_ranges):
                continue
            (word,) = struct.unpack_from("<I", seg_data, rel)
            tgt = _BASE.decode_pc_rel_target(word, pc)
            if tgt is not None and any(
                m_lo <= tgt < m_hi and not (m_lo <= pc < m_hi) for m_lo, m_hi in memcmp_ranges
            ):
                non_bcmp_memcmp_callers.append(pc)
    for m_lo, m_hi in memcmp_ranges:
        for src_pc, _tgt_va in _BASE.collect_adrp_add_code_targets(
            segs, elf_bytes, m_lo, m_hi - m_lo
        ):
            if any(b_lo <= src_pc < b_hi for b_lo, b_hi in bcmp_ranges):
                continue
            if m_lo <= src_pc < m_hi:
                continue
            non_bcmp_memcmp_callers.append(src_pc)
    for p_offset, p_vaddr, p_filesz, _p_memsz, _p_flags in segs:
        seg_data = elf_bytes[p_offset : p_offset + (p_filesz & ~7)]
        for rel in range(0, len(seg_data), 8):
            (qword,) = struct.unpack_from("<Q", seg_data, rel)
            if any(m_lo <= qword < m_hi for m_lo, m_hi in memcmp_ranges):
                raise RuntimeError(
                    f"stock StdBin ELF stores pointer to unhooked `memcmp` ({qword:#x}) at {p_vaddr + rel:#x}"
                )
    if non_bcmp_memcmp_callers:
        raise RuntimeError(
            f"stock StdBin ELF has non-bcmp callers/refs to unhooked `memcmp`: {[hex(pc) for pc in non_bcmp_memcmp_callers]}"
        )

    # F2: Exact `libsignalSessionExterns` check (0 extra retained `function_udf0` stubs; all 95 externs RX STT_FUNC).
    lean_externs_set = set(lean_externs)
    extra_retained_fn_stubs = sorted(retained_func_stubs - lean_externs_set)
    if extra_retained_fn_stubs:
        raise RuntimeError(
            f"stock StdBin ELF retained function_udf0 stub(s) outside libsignalSessionExterns: {extra_retained_fn_stubs}"
        )
    for ext_name in lean_externs:
        fn_hits = [s for s in defined_by_name.get(ext_name, []) if s.stype == 2]
        if not fn_hits:
            raise RuntimeError(
                f"stock StdBin ELF extern check failed: Lean extern `{ext_name}` missing as STT_FUNC in .symtab"
            )
        for s in fn_hits:
            fn_read = img.read_bytes(s.st_value, 4)
            if fn_read is None or fn_read[1] != elf_loader.PERM_RX:
                raise RuntimeError(
                    f"stock StdBin ELF extern `{ext_name}` at {s.st_value:#x} is not mapped in RX segment"
                )

    eff_dehooked: tuple[str, ...]
    if dehooked_syms is not None:
        eff_dehooked = tuple(str(x) for x in dehooked_syms)
    elif repo_root is not None and (repo_root / DEFAULT_REL_CLI_BINARY_PQ).is_file():
        eff_dehooked = tuple(load_cli_binary_pq_tables(repo_root)["cliDehookedSymsPlaced"])
    else:
        eff_dehooked = ()
    _verify_dehooked_placed_symbols(
        img=img,
        sections=sections,
        raw_syms=raw_syms,
        dehooked_syms=eff_dehooked,
        allowed_sec_names=frozenset({".text.crate", ".text.b_pre", ".text.lib2"}),
        label="stock StdBin ELF",
    )

    main_addr = export_addrs["main"]
    five_d_extra: dict[str, Any] = {}
    if enforce_5d:
        eff_5d_json = (
            five_d_json_path
            if five_d_json_path is not None
            else (elf_path.parent / DEFAULT_STDBIN_5D_NAME)
        )
        five_d_rep = verify_stdbin_5d(
            elf_path=elf_path,
            lean_externs=lean_externs,
            dehooked_syms=eff_dehooked,
            json_out_path=eff_5d_json,
            verbose=verbose,
        )
        five_d_extra = {
            "pass_5d": True,
            "first_pt_load_vaddr": five_d_rep["first_pt_load_vaddr"],
            "pt_tls_present": five_d_rep["pt_tls_present"],
            "hmainOff": five_d_rep["hmainOff"],
        }
    if verbose:
        print(
            f"cli-elf-stock --stdbin: verified {elf_path.name} (entry={entry:#x}, main={main_addr:#x}, "
            f"{len(phdrs)} phdrs / {len(segs)} PT_LOADs W^X, {len(exports)}/{len(exports)} exports + {len(sibling_exports_verified)} sibling exports, "
            f"{len(raw_syms)} symtab / {len(img.symbols)} loader syms, {len(undef_syms)} allowed weak undefs, "
            f"{len(lean_externs)}/{len(lean_externs)} libsignalSessionExterns RX, "
            f"{retained_stubs} zero-verified retained stubs, stub_manifest={manifest_sha[:12]}...)"
        )
    return {
        "recipe": STDBIN_RECIPE,
        "entry": hex(entry),
        "main_addr": hex(main_addr),
        "phnum": len(phdrs),
        "pt_loads": len(segs),
        "symtab_count": len(raw_syms),
        "loader_sym_count": len(img.symbols),
        "weak_undef_syms": sorted(s.name for s in undef_syms),
        "exports_verified": exports,
        "sibling_exports_verified": sibling_exports_verified,
        "memcmp_crate_or_musl_callers": 0,
        "externs_verified": len(lean_externs),
        "retained_stubs_verified": retained_stubs,
        "stub_manifest_sha256": manifest_sha,
        **five_d_extra,
    }


def _compute_lib0_aggregate_sha256(lib0_shas: Mapping[str, str]) -> str:
    """W3: Compute canonical aggregate SHA-256 over all `lib0_*.o` image objects."""
    if not lib0_shas:
        raise RuntimeError("cannot compute `lib0_aggregate_sha256` over empty `lib0_*.o` map")

    def _lib0_sort_key(item: tuple[str, str]) -> tuple[int, str]:
        nm = item[0]
        m = re.match(r"^lib0_(\d+)\.o$", nm)
        return (int(m.group(1)) if m else 10**9, nm)

    ordered = sorted(((str(k), str(v)) for k, v in lib0_shas.items()), key=_lib0_sort_key)
    for nm, sha in ordered:
        if not HEX64_RE.match(sha):
            raise RuntimeError(f"invalid 64-hex sha256 for `{nm}` in lib0 aggregate: {sha!r}")
    payload = "".join(f"{nm}:{sha}\n" for nm, sha in ordered).encode("utf-8")
    return hashlib.sha256(payload).hexdigest()


def assemble_cv_stock_meta(
    *,
    explicit_engine: bool,
    eng_head: str,
    engine_stock_link_sha: str | None,
    snapshot_link_sha: str | None,
    rustc_version: str,
    lld_ver: str,
    zig_version: str,
    lld_argv_template: list[str],
    lld_cmd_raw: list[str],
    stock_ld_rel: str,
    stock_ld_sha: str,
    stock_lld_arg_files: dict[str, str],
    placed_exports: Sequence[str],
    b2_derived: dict[str, Any],
    scrubbed_keys: list[str],
    env: dict[str, str],
    runtime_archive_shas: dict[str, str],
    manifest_sha: str,
    stub_manifest: list[dict[str, Any]],
    elf_name: str,
    elf_size: int,
    elf_sha: str,
    verify_summary: dict[str, Any],
    input_files: Sequence[pathlib.Path],
    config_path: str | None = None,
    crate_objects: Mapping[str, str] | None = None,
    lib0_aggregate_sha256: str | None = None,
    sysroot_trims: Sequence[Mapping[str, Any]] | None = None,
    m4_lock_path: str | None = None,
    m4_lock_sha256: str | None = None,
    link_map_sha256: str | None = None,
    alpha_scan: Mapping[str, Any] | None = None,
    alpha_displaced_weak_lock: Mapping[str, Any] | None = None,
    s2_real_body_lock: Mapping[str, Any] | None = None,
    d1_extern_data_lock: Mapping[str, Any] | None = None,
) -> dict[str, Any]:
    """Build the canonical `cv-stock-link.json` provenance dictionary (never overwriting engine `stock-link.json`)."""
    meta: dict[str, Any] = {
        "tool": "scripts/cli-elf-stock",
        "explicit_engine": bool(explicit_engine),
        "engine_commit": eng_head,
        "engine_stock_link_json_sha256": engine_stock_link_sha,
        "snapshot_link_sha256": snapshot_link_sha,
        "rustc_version": rustc_version,
        "lld_version": lld_ver,
        "zig_version": zig_version,
        "lld_argv": lld_argv_template,
        "lld_argv_raw": lld_cmd_raw,
        "linker_script": stock_ld_rel,
        "linker_script_sha256": stock_ld_sha,
        "stock_lld_arg_files": dict(sorted(stock_lld_arg_files.items())),
        "icf": "none",
        "orphan_handling": "error",
        "forced_undefined_exports": [e for e in placed_exports if e != "main"],
        "b2_derived_expectations": {
            "blocks": int(b2_derived["blocks"]),
            "placed_code_bytes": int(b2_derived["placed_code_bytes"]),
            "data_objects": int(b2_derived["data_objects"]),
            "placed_data_bytes": int(b2_derived["placed_data_bytes"]),
            "exports": list(b2_derived["exports"]),
            "extern_count": int(b2_derived["extern_count"]),
            "musl_text_size": hex(int(b2_derived["musl_text_size"])),
        },
        "scrubbed_env_keys": list(scrubbed_keys),
        "env_scrub": {
            "checked": _env_scrub_checked_spec(preserve_zig_cache=False),
            "removed": list(scrubbed_keys),
            "ran_before_toolchain_probe": True,
        },
        "active_build_env": {
            k: env[k]
            for k in sorted(env.keys())
            if k in ("LLD", "LLVM_OBJCOPY", "ZIG", "ZIG_GLOBAL_CACHE_DIR", "ZIG_LOCAL_CACHE_DIR")
        },
        "runtime_archives": runtime_archive_shas,
        "stub_manifest_sha256": manifest_sha,
        "stub_manifest": stub_manifest,
        "elf": {
            "name": elf_name,
            "size": elf_size,
            "sha256": elf_sha,
            **verify_summary,
        },
        "inputs": [
            {
                "name": p.name,
                "path": f"work/{p.name}",
                "size": p.stat().st_size,
                "sha256": _BASE.sha256_file(p),
            }
            for p in input_files
        ],
    }
    if config_path is not None:
        meta["config_path"] = config_path
    if crate_objects is not None:
        meta["crate_objects"] = {str(k): str(v) for k, v in crate_objects.items()}
    if lib0_aggregate_sha256 is not None:
        meta["lib0_aggregate_sha256"] = lib0_aggregate_sha256
    if sysroot_trims is not None:
        meta["sysroot_trims"] = [dict(row) for row in sysroot_trims]
    if m4_lock_path is not None:
        meta["m4_lock_path"] = m4_lock_path
    if m4_lock_sha256 is not None:
        meta["m4_lock_sha256"] = m4_lock_sha256
    if link_map_sha256 is not None:
        meta["link_map_sha256"] = link_map_sha256
    if alpha_scan is not None:
        meta["alpha_scan"] = dict(alpha_scan)
    if alpha_displaced_weak_lock is not None:
        meta["alpha_displaced_weak_lock"] = dict(alpha_displaced_weak_lock)
    if s2_real_body_lock is not None:
        meta["s2_real_body_lock"] = dict(s2_real_body_lock)
    if d1_extern_data_lock is not None:
        meta["d1_extern_data_lock"] = dict(d1_extern_data_lock)
    return meta


def _load_and_verify_stock_meta(
    meta_path: pathlib.Path,
    lock: dict[str, Any],
    *,
    expected_stub_manifest_sha: str | None = None,
    require_implicit_engine: bool = False,
    allow_explicit_engine_mismatch: bool = False,
) -> tuple[dict[str, Any], list[dict[str, Any]], str, dict[str, str]]:
    if not meta_path.is_file():
        raise RuntimeError(f"missing cv stock metadata JSON at {meta_path}")
    meta = json.loads(meta_path.read_text(encoding="utf-8"))
    if "explicit_engine" not in meta or not isinstance(meta["explicit_engine"], bool):
        raise RuntimeError(f"{meta_path} missing boolean `explicit_engine` field (F3)")
    env_scrub = meta.get("env_scrub")
    if (
        not isinstance(env_scrub, Mapping)
        or not isinstance(env_scrub.get("checked"), list)
        or not env_scrub.get("checked")
        or not isinstance(env_scrub.get("removed"), list)
        or env_scrub.get("ran_before_toolchain_probe") is not True
    ):
        raise RuntimeError(
            f"{meta_path} missing valid `env_scrub` audit (`checked`, `removed`, `ran_before_toolchain_probe=true`) (D2(c)(4))"
        )
    if require_implicit_engine and meta["explicit_engine"] is not False:
        raise RuntimeError(
            f"{meta_path} recorded `explicit_engine=true`; pinned verification requires default submodule engine"
        )
    exp_eng = _expected_engine_commit(lock)
    got_eng = str(meta.get("engine_commit") or "")
    if not HEX40_RE.match(got_eng):
        raise RuntimeError(f"{meta_path} missing valid 40-hex `engine_commit`: {got_eng!r}")
    if got_eng != exp_eng and not (
        allow_explicit_engine_mismatch and meta["explicit_engine"] is True
    ):
        raise RuntimeError(
            f"{meta_path} engine_commit {got_eng!r} != lock {exp_eng!r}"
        )
    manifest = meta.get("stub_manifest")
    if not isinstance(manifest, list) or not manifest:
        raise RuntimeError(f"{meta_path} missing non-empty `stub_manifest` list")
    rec_sha = str(meta.get("stub_manifest_sha256") or "")
    comp_sha = stub_manifest_sha256(manifest)
    if not HEX64_RE.match(rec_sha) or rec_sha != comp_sha:
        raise RuntimeError(
            f"{meta_path} stub_manifest_sha256 {rec_sha!r} != computed {comp_sha!r}"
        )
    eff_exp_manifest_sha = (
        expected_stub_manifest_sha
        if expected_stub_manifest_sha is not None
        else str(lock.get("stub_manifest_sha256") or "")
    )
    if not HEX64_RE.match(eff_exp_manifest_sha):
        raise RuntimeError(
            f"missing or invalid mandatory lock `stub_manifest_sha256` (F2(3)/F7(1)): {eff_exp_manifest_sha!r}"
        )
    if comp_sha != eff_exp_manifest_sha:
        raise RuntimeError(
            f"{meta_path} stub_manifest_sha256 {comp_sha!r} != pinned {eff_exp_manifest_sha!r}"
        )
    if "stub_manifest" in lock:
        lock_manifest = lock["stub_manifest"]
        if not isinstance(lock_manifest, list) or stub_manifest_sha256(lock_manifest) != comp_sha:
            raise RuntimeError(f"{meta_path} stub_manifest disagrees with lock `stub_manifest`")
    rt_shas = meta.get("runtime_archives")
    if not isinstance(rt_shas, dict) or not rt_shas:
        raise RuntimeError(f"{meta_path} missing `runtime_archives` sha256 map")
    exp_rt = lock.get("runtime_archives")
    _verify_runtime_archive_shas(
        {str(k): str(v) for k, v in rt_shas.items()},
        {str(k): str(v) for k, v in exp_rt.items()} if isinstance(exp_rt, dict) else None,
    )
    return meta, manifest, rec_sha, {str(k): str(v) for k, v in rt_shas.items()}


def _has_alpha_lock_sections(stock_lock: Mapping[str, Any]) -> bool:
    return any(
        k in stock_lock
        for k in (
            "displaced_weak",
            "displaced_weak_referrers",
            "s2_real_body_lock",
            "d1_extern_data_lock",
        )
    )


def _verify_alpha_from_meta_and_lock(
    *,
    elf_path: pathlib.Path,
    meta: Mapping[str, Any],
    stock_lock: Mapping[str, Any],
    repo_root: pathlib.Path | None = None,
    map_path: pathlib.Path | None = None,
) -> dict[str, Any]:
    """Re-verify B3 (`displaced_weak` + `udf #0` + `displaced_weak_referrers ⊆ cliLinkObjs`),
    `S1` + GK rows 373–375 (`s2_real_body_lock`), and `D1` (`d1_extern_data_lock`) from the ELF,
    `link.map`, `cv-stock-link.json`, and `inputs_stock.lock`."""
    eff_map = map_path if map_path is not None else (elf_path.parent / DEFAULT_LINK_MAP_NAME)
    if not eff_map.is_file():
        raise RuntimeError(f"missing stock linker `-Map` file at {eff_map}")
    got_map_sha = _BASE.sha256_file(eff_map)
    if "link_map_sha256" in stock_lock:
        exp_map_sha = str(stock_lock["link_map_sha256"] or "")
        if not HEX64_RE.match(exp_map_sha) or got_map_sha != exp_map_sha:
            raise RuntimeError(
                f"link.map sha256 mismatch for {eff_map}: got {got_map_sha!r} != lock {exp_map_sha!r}"
            )
    if meta.get("link_map_sha256") is not None and str(meta.get("link_map_sha256")) != got_map_sha:
        raise RuntimeError(
            f"cv-stock-link.json link_map_sha256 {meta.get('link_map_sha256')!r} != disk {got_map_sha!r}"
        )

    raw_scan = meta.get("alpha_scan")
    if not isinstance(raw_scan, Mapping):
        raise RuntimeError("cv-stock-link.json missing `alpha_scan` object required for B3 verification")
    alpha_scan = dict(raw_scan)

    # Cross-check `alpha_scan` object & archive SHAs against `meta["inputs"]` and `runtime_archives`
    inputs_list = meta.get("inputs")
    if not isinstance(inputs_list, list) or not inputs_list:
        raise RuntimeError("cv-stock-link.json missing non-empty `inputs` list")
    meta_input_shas = {
        str(ent["name"]): str(ent["sha256"])
        for ent in inputs_list
        if isinstance(ent, Mapping) and "name" in ent and "sha256" in ent
    }
    scan_obj_shas = alpha_scan.get("object_shas")
    scan_ar_shas = alpha_scan.get("archive_shas")
    if not isinstance(scan_obj_shas, Mapping) or not isinstance(scan_ar_shas, Mapping):
        raise RuntimeError("cv-stock-link.json `alpha_scan` missing `object_shas` / `archive_shas`")
    for obj_nm, obj_sha in scan_obj_shas.items():
        if meta_input_shas.get(str(obj_nm)) != str(obj_sha):
            raise RuntimeError(
                f"alpha_scan object_shas[{obj_nm!r}]={obj_sha!r} != inputs[] {meta_input_shas.get(str(obj_nm))!r}"
            )
    for ar_nm, ar_sha in scan_ar_shas.items():
        if meta_input_shas.get(str(ar_nm)) != str(ar_sha):
            raise RuntimeError(
                f"alpha_scan archive_shas[{ar_nm!r}]={ar_sha!r} != inputs[] {meta_input_shas.get(str(ar_nm))!r}"
            )

    # Reload pinned `rustc 1.98.1` `self-contained/libc.a` reference bodies directly from toolchain
    # when `repo_root` is provided (so tampering with `alpha_scan["pinned_musl_ref_bodies"]` fails closed).
    if repo_root is not None:
        fresh_refs, _ = _load_pinned_musl_refs_from_rustc(lock=stock_lock)
        alpha_scan["pinned_musl_ref_bodies"] = fresh_refs
        gen_extern_data = alpha_checks.parse_generated_lean_extern_data(repo_root)
    else:
        d1_meta = meta.get("d1_extern_data_lock")
        if not isinstance(d1_meta, Mapping):
            raise RuntimeError("missing `repo_root` and `d1_extern_data_lock` for D1 check")
        gen_extern_data = {}
        for v in (d1_meta.get("kept") or {}).values():
            if isinstance(v, Mapping) and "demangled_name" in v and "size" in v:
                gen_extern_data[str(v["demangled_name"])] = int(v["size"])
        for gdem in d1_meta.get("gc_dead_demangled") or ():
            s_gdem = str(gdem)
            gen_extern_data[s_gdem] = (
                8 if s_gdem in alpha_checks.EIGHT_BYTE_EXTERN_DATA_SYMS else 256
            )

    return alpha_checks.compute_and_verify_alpha_b3(
        elf_bytes=elf_path.read_bytes(),
        map_text=eff_map.read_text(encoding="utf-8"),
        alpha_scan=alpha_scan,
        generated_extern_data=gen_extern_data,
        expected_lock=stock_lock,
        verify_addresses=True,
    )


STOCK_FILE_BYTES_ELF_RE = re.compile(
    r'file_bytes%\s+"[^"]*signal-(?:session|cli)(?:-stock)?(?:-stdbin)?\.elf"'
)


def parse_stock_cli_elf_pin(lean_mod_path: pathlib.Path) -> str:
    """W1: Fail-closed parser for the single `sha256 "<64 lowercase hex>"` pin in `CliElf.lean`
    (reusing `_BASE.strip_lean_comments` + `_BASE.PIN_LINE_RE`, accepting `signal-{session,cli}{-stock,}.elf`)."""
    if not lean_mod_path.is_file():
        raise ValueError(f"pin module does not exist: {lean_mod_path}")
    text = lean_mod_path.read_text(encoding="utf-8")
    stripped_lines = _BASE.strip_lean_comments(text)
    code_only = "\n".join(code for _, code in stripped_lines)
    fb_matches = STOCK_FILE_BYTES_ELF_RE.findall(code_only)
    if len(fb_matches) != 1:
        raise ValueError(
            f"{lean_mod_path}: expected exactly 1 `file_bytes% \"...(lib)signal-{{session,cli}}.elf\"` in code, "
            f"found {len(fb_matches)}"
        )
    pins: list[tuple[int, str]] = []
    for line_no, code in stripped_lines:
        if not code.strip():
            continue
        m = _BASE.PIN_LINE_RE.match(code)
        if m is not None:
            pins.append((line_no, m.group(1)))
        elif _BASE.ANY_SHA256_KW_RE.match(code):
            raise ValueError(
                f"{lean_mod_path}:{line_no}: malformed `sha256` pin line `{code.strip()}`"
            )
    if len(pins) != 1:
        raise ValueError(
            f"{lean_mod_path}: expected exactly 1 `sha256 \"<64 lowercase hex>\"` pin line, found {len(pins)}"
        )
    return pins[0][1]


def verify_stock_pin(
    *,
    elf_path: pathlib.Path,
    meta_path: pathlib.Path,
    stock_lock_path: pathlib.Path,
    repo_root: pathlib.Path | None = None,
    cfg_path: pathlib.Path | None = None,
    lean_mod_path: pathlib.Path | None = None,
    engine_dir: pathlib.Path | None = None,
    engine_meta_path: pathlib.Path | None = None,
    map_path: pathlib.Path | None = None,
    explicit_engine_cli: bool = False,
    require_lean_pin: bool = False,
    ci_mode: bool = False,
    expected_externs: Sequence[str] | None = None,
    verbose: bool = True,
) -> dict[str, Any]:
    """(c) & W1 & B3: Fail-closed `--verify-pin` against untrusted `inputs_stock.lock` +
    `cv-stock-link.json`: enforces `explicit_engine == false`, exact ELF size & sha256 (and
    `CliElf.lean` pin when configured or passed via `--lean-mod`), `stock.ld` & `--stock-lld-arg`
    file hashes, `stub_manifest_sha256`, `runtime_archives`, exact `lld_argv == lock.lld_argv` with
    0 extra `lld` args, real 64-hex engine `stock-link.json` sha256, `link.map` sha256, B3 (`α` +
    `S1`/`S2` + GK rows 373–375 + `D1`), and full `verify_stock_elf`."""
    if explicit_engine_cli:
        raise RuntimeError("`--verify-pin` forbids `--engine` override (must use default submodule)")
    if not stock_lock_path.is_file():
        raise RuntimeError(f"stock lock file missing: {stock_lock_path}")
    stock_lock = _load_stock_lock_file(stock_lock_path)

    exp_eng = _expected_engine_commit(stock_lock)
    if engine_dir is not None:
        _verify_clean_pinned_engine(
            engine_dir, exp_eng, allow_explicit_mismatch=False, ci_mode=ci_mode
        )

    exp_elf_sha = str(stock_lock.get("elf_sha256") or "")
    if not HEX64_RE.match(exp_elf_sha):
        raise RuntimeError(f"{stock_lock_path} missing valid 64-hex `elf_sha256`: {exp_elf_sha!r}")
    exp_elf_size = int(stock_lock.get("elf_size") or 0)
    if exp_elf_size <= 0:
        raise RuntimeError(f"{stock_lock_path} missing positive `elf_size`")

    eff_lean_mod = lean_mod_path
    if eff_lean_mod is None and stock_lock.get("lean_pin_path"):
        rel_lm = pathlib.Path(str(stock_lock["lean_pin_path"]))
        eff_lean_mod = (repo_root / rel_lm) if repo_root is not None else rel_lm
    if require_lean_pin and eff_lean_mod is None:
        raise RuntimeError(
            f"CI mode `--verify-pin` requires `--lean-mod` or lock `lean_pin_path` in {stock_lock_path} (W1)"
        )
    if eff_lean_mod is not None:
        lean_pin = parse_stock_cli_elf_pin(eff_lean_mod)
        if lean_pin != exp_elf_sha:
            raise RuntimeError(
                f"Lean pin mismatch: {eff_lean_mod} sha256={lean_pin!r} != {stock_lock_path} elf_sha256={exp_elf_sha!r}"
            )

    if not elf_path.is_file():
        raise RuntimeError(f"stock ELF file not found: {elf_path}")
    got_elf_sha = _BASE.sha256_file(elf_path)
    got_elf_size = elf_path.stat().st_size
    if got_elf_sha != exp_elf_sha or got_elf_size != exp_elf_size:
        raise RuntimeError(
            f"stock ELF pin mismatch for {elf_path}: got ({got_elf_size} B, {got_elf_sha}), "
            f"expected ({exp_elf_size} B, {exp_elf_sha})"
        )

    exp_manifest_sha = str(stock_lock.get("stub_manifest_sha256") or "")
    if not HEX64_RE.match(exp_manifest_sha):
        raise RuntimeError(f"{stock_lock_path} missing valid `stub_manifest_sha256`")

    meta, stub_manifest, _, _ = _load_and_verify_stock_meta(
        meta_path,
        stock_lock,
        expected_stub_manifest_sha=exp_manifest_sha,
        require_implicit_engine=True,
        allow_explicit_engine_mismatch=False,
    )

    if str(meta.get("rustc_version") or "") != str(stock_lock["rustc_version"]):
        raise RuntimeError(
            f"rustc_version mismatch: meta={meta.get('rustc_version')!r} != lock={stock_lock['rustc_version']!r}"
        )
    if str(meta.get("zig_version") or "") != str(stock_lock["zig_version"]):
        raise RuntimeError(
            f"zig_version mismatch: meta={meta.get('zig_version')!r} != lock={stock_lock['zig_version']!r}"
        )
    lld_prefix = str(stock_lock["lld_version_prefix"])
    if not str(meta.get("lld_version") or "").startswith(lld_prefix):
        raise RuntimeError(
            f"lld_version {meta.get('lld_version')!r} does not start with lock prefix {lld_prefix!r}"
        )

    is_stdbin = _is_stdbin_lock(stock_lock)
    exp_lld_argv = stock_lock.get("lld_argv")
    if not isinstance(exp_lld_argv, list) or not exp_lld_argv:
        raise RuntimeError(f"{stock_lock_path} missing non-empty `lld_argv` list")
    inputs_list = meta.get("inputs")
    if not isinstance(inputs_list, list) or not inputs_list:
        raise RuntimeError(f"{meta_path} missing non-empty `inputs` list")

    # (c)(3): `cv-stock-link.json` must NEVER collide with engine `stock-link.json`.
    eff_eng_meta = (
        engine_meta_path
        if engine_meta_path is not None
        else (elf_path.parent / ENGINE_STOCK_META_NAME)
    )
    if eff_eng_meta.resolve() == meta_path.resolve():
        raise RuntimeError("cv metadata path must never collide with engine `stock-link.json`")

    # Engine `stock-link.json` sha256 is required in StdBin mode (where `snapshot-link --stock` runs)
    # and whenever explicitly present in `stock_lock`; in 1-config direct-link mode (`snapshot-link`
    # not invoked), `engine_stock_link_json_sha256` is omitted from lock and `None` in `cv-stock-link.json`.
    if is_stdbin or "engine_stock_link_json_sha256" in stock_lock:
        exp_eng_sl_sha = str(stock_lock.get("engine_stock_link_json_sha256") or "")
        if not HEX64_RE.match(exp_eng_sl_sha):
            raise RuntimeError(
                f"invalid or unpinned `engine_stock_link_json_sha256` in {stock_lock_path}: {exp_eng_sl_sha!r}"
            )
        if not eff_eng_meta.is_file():
            raise RuntimeError(f"missing engine `stock-link.json` at {eff_eng_meta}")
        got_eng_sl_sha = _BASE.sha256_file(eff_eng_meta)
        if got_eng_sl_sha != exp_eng_sl_sha or meta.get("engine_stock_link_json_sha256") != exp_eng_sl_sha:
            raise RuntimeError(
                f"engine stock-link.json sha256 mismatch: disk={got_eng_sl_sha!r}, "
                f"cv_meta={meta.get('engine_stock_link_json_sha256')!r}, lock={exp_eng_sl_sha!r}"
            )
    else:
        if meta.get("engine_stock_link_json_sha256") is not None:
            raise RuntimeError(
                f"{meta_path} recorded unexpected `engine_stock_link_json_sha256` without lock pin"
            )

    eff_cfg = (
        cfg_path
        if cfg_path is not None
        else (
            (repo_root / str(stock_lock["config_path"]))
            if repo_root is not None
            else pathlib.Path(str(stock_lock["config_path"]))
        )
    )

    if not is_stdbin:
        # W3 & (c)(2): Mandatory fail-closed 1-config lock keys:
        # `linker_script_sha256`, `stock_lld_arg_files`, `crate_objects`, `lib0_aggregate_sha256`,
        # `sysroot_trims`, and `m4_lock_sha256` (plus `stub_manifest_sha256`, `runtime_archives`, `elf_sha256` above).
        exp_ld_rel = str(stock_lock.get("linker_script_path") or "")
        exp_ld_sha = str(stock_lock.get("linker_script_sha256") or "")
        if not exp_ld_rel or not HEX64_RE.match(exp_ld_sha):
            raise RuntimeError(
                f"{stock_lock_path} missing mandatory valid `linker_script_path` / `linker_script_sha256`: "
                f"({exp_ld_rel!r}, {exp_ld_sha!r})"
            )
        if meta.get("linker_script") != exp_ld_rel or meta.get("linker_script_sha256") != exp_ld_sha:
            raise RuntimeError(
                f"linker_script mismatch in {meta_path}: got ({meta.get('linker_script')!r}, "
                f"{meta.get('linker_script_sha256')!r}), expected ({exp_ld_rel!r}, {exp_ld_sha!r})"
            )
        if repo_root is not None:
            ld_disk = repo_root / exp_ld_rel
            if not ld_disk.is_file() or _BASE.sha256_file(ld_disk) != exp_ld_sha:
                raise RuntimeError(f"on-disk {ld_disk} sha256 != lock {exp_ld_sha}")

        exp_arg_files = stock_lock.get("stock_lld_arg_files")
        if not isinstance(exp_arg_files, dict) or not exp_arg_files:
            raise RuntimeError(f"{stock_lock_path} missing non-empty `[stock_lld_arg_files]` table")
        norm_exp_arg_files = {str(k): str(v) for k, v in exp_arg_files.items()}
        for rel_k, sha_v in norm_exp_arg_files.items():
            if not HEX64_RE.match(sha_v):
                raise RuntimeError(f"invalid sha256 for stock_lld_arg_files[{rel_k!r}]: {sha_v!r}")
            if repo_root is not None:
                f_disk = repo_root / rel_k
                if not f_disk.is_file() or _BASE.sha256_file(f_disk) != sha_v:
                    raise RuntimeError(f"on-disk stock_lld_arg_files[{rel_k!r}] sha256 != {sha_v}")
        got_arg_files = meta.get("stock_lld_arg_files")
        if not isinstance(got_arg_files, dict) or {str(k): str(v) for k, v in got_arg_files.items()} != norm_exp_arg_files:
            raise RuntimeError(
                f"stock_lld_arg_files mismatch in {meta_path}: got {got_arg_files!r} != lock {norm_exp_arg_files!r}"
            )

        _verify_lld_argv_against_lock(
            meta.get("lld_argv"),
            meta.get("lld_argv_raw"),
            [str(x) for x in exp_lld_argv],
            inputs_list,
            norm_exp_arg_files,
        )

        # W3 & (c)(2): Mandatory `crate_objects` + `lib0_aggregate_sha256` + `sysroot_trims` + `m4_lock_sha256`
        exp_crate_objs = stock_lock.get("crate_objects")
        if not isinstance(exp_crate_objs, Mapping) or not exp_crate_objs:
            raise RuntimeError(f"{stock_lock_path} missing mandatory non-empty `[crate_objects]` sha256 table (W3)")
        norm_exp_crates = {str(k): str(v) for k, v in exp_crate_objs.items()}
        for c_nm, c_sha in sorted(norm_exp_crates.items()):
            if not HEX64_RE.match(c_sha):
                raise RuntimeError(f"invalid sha256 in lock `crate_objects[{c_nm!r}]`: {c_sha!r}")

        meta_in_by_name = {
            str(ent["name"]): str(ent["sha256"])
            for ent in inputs_list
            if isinstance(ent, Mapping) and "name" in ent and "sha256" in ent
        }
        got_meta_crates = meta.get("crate_objects")
        if not isinstance(got_meta_crates, Mapping) or {
            str(k): str(v) for k, v in got_meta_crates.items()
        } != norm_exp_crates:
            raise RuntimeError(
                f"crate_objects mismatch in {meta_path}: got {got_meta_crates!r} != lock {norm_exp_crates!r}"
            )
        for c_nm, c_sha in sorted(norm_exp_crates.items()):
            if meta_in_by_name.get(c_nm) != c_sha:
                raise RuntimeError(
                    f"inputs[] sha256 for `{c_nm}` ({meta_in_by_name.get(c_nm)!r}) != lock crate_objects {c_sha!r}"
                )

        if "sysroot_trims" not in stock_lock or not isinstance(stock_lock["sysroot_trims"], list):
            raise RuntimeError(f"{stock_lock_path} missing mandatory `sysroot_trims` list (W3/D4)")
        exp_trims = stock_lock["sysroot_trims"]
        got_trims = meta.get("sysroot_trims")
        if not isinstance(got_trims, list) or len(got_trims) != len(exp_trims):
            raise RuntimeError(
                f"sysroot_trims count mismatch in {meta_path}: got {got_trims!r} != lock {exp_trims!r}"
            )
        trim_shas_by_obj: dict[str, str] = {}
        for t_idx, (exp_row, got_row) in enumerate(zip(exp_trims, got_trims)):
            if not isinstance(exp_row, Mapping) or not isinstance(got_row, Mapping):
                raise RuntimeError(f"invalid sysroot_trims[{t_idx}] entry")
            for sha_field in ("rlib_sha256", "member_sha256", "emitted_sha256"):
                val = str(exp_row.get(sha_field) or "")
                if not HEX64_RE.match(val):
                    raise RuntimeError(
                        f"invalid 64-hex `{sha_field}` in lock sysroot_trims[{t_idx}]: {val!r}"
                    )
            kept_s = exp_row.get("kept_sections")
            if not isinstance(kept_s, list) or not kept_s:
                raise RuntimeError(f"lock sysroot_trims[{t_idx}] missing non-empty `kept_sections`")
            for cmp_field in (
                "object",
                "crate",
                "roots",
                "rlib",
                "rlib_sha256",
                "member",
                "member_sha256",
                "kept_sections",
                "emitted_sha256",
            ):
                if got_row.get(cmp_field) != exp_row.get(cmp_field):
                    raise RuntimeError(
                        f"sysroot_trims[{t_idx}].{cmp_field} mismatch: meta={got_row.get(cmp_field)!r} != lock={exp_row.get(cmp_field)!r}"
                    )
            t_obj_nm = str(exp_row["object"])
            t_emit_sha = str(exp_row["emitted_sha256"])
            if meta_in_by_name.get(t_obj_nm) != t_emit_sha:
                raise RuntimeError(
                    f"inputs[] sha256 for trimmed sysroot object `{t_obj_nm}` "
                    f"({meta_in_by_name.get(t_obj_nm)!r}) != lock emitted_sha256 {t_emit_sha!r}"
                )
            trim_shas_by_obj[t_obj_nm] = t_emit_sha

        if eff_cfg.is_file():
            parsed_cfg = tomllib.loads(eff_cfg.read_text(encoding="utf-8"))
            cfg_sysroot_objs = parsed_cfg.get("sysroot_objects") or []
            if len(exp_trims) != len(cfg_sysroot_objs):
                raise RuntimeError(
                    f"lock sysroot_trims length {len(exp_trims)} != {eff_cfg} [[sysroot_objects]] length {len(cfg_sysroot_objs)}"
                )
            if repo_root is not None and cfg_sysroot_objs:
                _verify_sysroot_trims_against_toolchain(
                    cfg=parsed_cfg,
                    expected_trims=exp_trims,
                    start_idx=len(norm_exp_crates),
                )

        exp_lib0_agg = str(stock_lock.get("lib0_aggregate_sha256") or "")
        if not HEX64_RE.match(exp_lib0_agg):
            raise RuntimeError(
                f"{stock_lock_path} missing mandatory valid 64-hex `lib0_aggregate_sha256` (W3): {exp_lib0_agg!r}"
            )
        all_lib0_from_inputs = {
            nm: sha for nm, sha in meta_in_by_name.items() if re.match(r"^lib0_\d+\.o$", nm)
        }
        expected_all_lib0 = {**norm_exp_crates, **trim_shas_by_obj}
        if all_lib0_from_inputs != expected_all_lib0:
            raise RuntimeError(
                f"inputs[] lib0_*.o set {sorted(all_lib0_from_inputs.keys())} != "
                f"lock (crate_objects + sysroot_trims) {sorted(expected_all_lib0.keys())}"
            )
        comp_lib0_agg = _compute_lib0_aggregate_sha256(all_lib0_from_inputs)
        if comp_lib0_agg != exp_lib0_agg or meta.get("lib0_aggregate_sha256") != exp_lib0_agg:
            raise RuntimeError(
                f"lib0_aggregate_sha256 mismatch: computed={comp_lib0_agg!r}, "
                f"meta={meta.get('lib0_aggregate_sha256')!r}, lock={exp_lib0_agg!r}"
            )

        exp_m4_sha = str(stock_lock.get("m4_lock_sha256") or "")
        if not HEX64_RE.match(exp_m4_sha):
            raise RuntimeError(
                f"{stock_lock_path} missing mandatory valid 64-hex `m4_lock_sha256` (W3): {exp_m4_sha!r}"
            )
        if meta.get("m4_lock_sha256") is not None and str(meta.get("m4_lock_sha256")) != exp_m4_sha:
            raise RuntimeError(
                f"{meta_path} m4_lock_sha256 {meta.get('m4_lock_sha256')!r} != lock {exp_m4_sha!r}"
            )
        m4_rel = str(stock_lock.get("m4_lock_path") or "").strip()
        if repo_root is not None:
            if not m4_rel:
                raise RuntimeError(f"{stock_lock_path} missing `m4_lock_path` required with `m4_lock_sha256`")
            m4_disk = repo_root / m4_rel
            if not m4_disk.is_file() or _BASE.sha256_file(m4_disk) != exp_m4_sha:
                raise RuntimeError(f"on-disk m4 lock {m4_disk} sha256 != lock {exp_m4_sha!r}")
        elif m4_rel:
            cand_m4 = stock_lock_path.parent / pathlib.Path(m4_rel).name
            if cand_m4.is_file() and _BASE.sha256_file(cand_m4) != exp_m4_sha:
                raise RuntimeError(f"on-disk m4 lock {cand_m4} sha256 != lock {exp_m4_sha!r}")
    else:
        if str(meta.get("recipe") or "") != STDBIN_RECIPE:
            raise RuntimeError(
                f"{meta_path} recipe {meta.get('recipe')!r} != {STDBIN_RECIPE!r}"
            )
        req_stdbin_pairs: list[tuple[str, str]] = [
            ("main_rust_manifest_path", "main_rust_manifest_sha256"),
            ("main_rust_lock_path", "main_rust_lock_sha256"),
            ("main_rust_src_path", "main_rust_src_sha256"),
            ("rdl_shim_path", "rdl_shim_sha256"),
        ]
        if (
            _has_stock_native_only(stock_lock)
            or stock_lock.get("musl_string_config_path")
            or stock_lock.get("musl_string_config_sha256")
        ):
            req_stdbin_pairs.append(("musl_string_config_path", "musl_string_config_sha256"))
        else:
            if (
                meta.get("musl_string_config_path") is not None
                or meta.get("musl_string_config_sha256") is not None
            ):
                raise RuntimeError(
                    f"{meta_path} recorded unexpected musl_string_config fields when lock has native_only = []"
                )
        for path_key, sha_key in req_stdbin_pairs:
            rel_p = str(stock_lock.get(path_key) or "")
            exp_s = str(stock_lock.get(sha_key) or "")
            if not rel_p or not HEX64_RE.match(exp_s):
                raise RuntimeError(
                    f"{stock_lock_path} missing valid ({path_key}, {sha_key}): ({rel_p!r}, {exp_s!r})"
                )
            if meta.get(path_key) != rel_p or meta.get(sha_key) != exp_s:
                raise RuntimeError(
                    f"{meta_path} ({path_key}, {sha_key}) = ({meta.get(path_key)!r}, {meta.get(sha_key)!r}) "
                    f"!= lock ({rel_p!r}, {exp_s!r})"
                )
            if repo_root is not None:
                p_disk = repo_root / rel_p
                if not p_disk.is_file() or _BASE.sha256_file(p_disk) != exp_s:
                    raise RuntimeError(f"on-disk {p_disk} sha256 != lock {exp_s}")

        ld_mode, ld_rel, ld_sha, _ld_abs, ld_arg_files = _resolve_and_verify_stdbin_linker_script(
            repo_root=repo_root,
            lock=stock_lock,
            lock_label=stock_lock_path,
            ci_mode=ci_mode,
        )
        if str(meta.get("stock_ld_mode") or "none") != ld_mode:
            raise RuntimeError(
                f"{meta_path} stock_ld_mode {meta.get('stock_ld_mode')!r} != lock {ld_mode!r}"
            )
        if meta.get("linker_script") != ld_rel or meta.get("linker_script_sha256") != ld_sha:
            raise RuntimeError(
                f"{meta_path} (linker_script, linker_script_sha256) = "
                f"({meta.get('linker_script')!r}, {meta.get('linker_script_sha256')!r}) "
                f"!= lock ({ld_rel!r}, {ld_sha!r})"
            )
        got_meta_af = {
            str(k): str(v) for k, v in (meta.get("stock_lld_arg_files") or {}).items()
        }
        if got_meta_af != ld_arg_files:
            raise RuntimeError(
                f"{meta_path} stock_lld_arg_files {got_meta_af!r} != lock {ld_arg_files!r}"
            )

        eng_sl = json.loads(eff_eng_meta.read_text(encoding="utf-8"))
        eng_lld_sec = eng_sl.get("lld") or {}
        eng_lld_args_raw = [str(x) for x in (eng_lld_sec.get("args") or ())]
        eng_lld_args = _normalize_and_verify_stdbin_engine_arg_files(
            eng_lld_args_raw=eng_lld_args_raw,
            eng_arg_files_raw=eng_lld_sec.get("argFiles"),
            stock_ld_mode=ld_mode,
            linker_script_rel=ld_rel,
            linker_script_sha=ld_sha,
            repo_root=repo_root,
        )
        eng_inputs = eng_sl.get("inputs") or []
        _verify_stdbin_lld_argv_against_lock(
            eng_lld_args,
            [str(x) for x in exp_lld_argv],
            eng_inputs,
            stock_lld_arg_files=ld_arg_files,
        )
        if [str(x) for x in (meta.get("lld_argv") or ())] != [str(x) for x in exp_lld_argv]:
            raise RuntimeError(f"{meta_path} lld_argv != lock lld_argv")

        std_bin_obj = eng_sl.get("stdBin") or {}
        exp_weakened = [str(x) for x in (stock_lock.get("weakened_in_main") or ())]
        if list(std_bin_obj.get("weakenedInMain") or ()) != exp_weakened:
            raise RuntimeError(
                f"stock-link.json stdBin.weakenedInMain {std_bin_obj.get('weakenedInMain')!r} != lock {exp_weakened!r}"
            )
        unwind_retained = [
            m
            for m in (std_bin_obj.get("archiveMembers") or ())
            if "libunwind.a" in str(m.get("archive") or "")
        ]
        if unwind_retained:
            raise RuntimeError(
                f"stock-link.json retained unexpected libunwind.a section(s): {unwind_retained}"
            )
        eng_in_by_path = {str(ent.get("path")): str(ent.get("sha256")) for ent in eng_inputs}
        exp_main_rust_sha = str(stock_lock.get("main_rust_obj_sha256") or "")
        if not HEX64_RE.match(exp_main_rust_sha) or eng_in_by_path.get("work/main_rust.o") != exp_main_rust_sha:
            raise RuntimeError(
                f"work/main_rust.o sha256 {eng_in_by_path.get('work/main_rust.o')!r} != lock {exp_main_rust_sha!r}"
            )
        exp_cb_sha = str(stock_lock.get("compiler_builtins_sha256") or "")
        if not HEX64_RE.match(exp_cb_sha) or eng_in_by_path.get("work/compiler_builtins.a") != exp_cb_sha:
            raise RuntimeError(
                f"work/compiler_builtins.a sha256 {eng_in_by_path.get('work/compiler_builtins.a')!r} != lock {exp_cb_sha!r}"
            )

    elf_meta = meta.get("elf")
    if not isinstance(elf_meta, dict):
        raise RuntimeError(f"{meta_path} missing `elf` metadata object")
    if elf_meta.get("sha256") != exp_elf_sha or int(elf_meta.get("size") or -1) != exp_elf_size:
        raise RuntimeError(
            f"{meta_path} elf.sha256/size ({elf_meta.get('sha256')!r}, {elf_meta.get('size')!r}) "
            f"!= lock ({exp_elf_sha!r}, {exp_elf_size})"
        )

    if "link_map_sha256" in stock_lock:
        eff_map = map_path if map_path is not None else (elf_path.parent / DEFAULT_LINK_MAP_NAME)
        if not eff_map.is_file():
            raise RuntimeError(f"missing stock linker `-Map` file at {eff_map}")
        exp_map_sha = str(stock_lock["link_map_sha256"] or "")
        got_map_sha = _BASE.sha256_file(eff_map)
        if not HEX64_RE.match(exp_map_sha) or got_map_sha != exp_map_sha:
            raise RuntimeError(
                f"link.map sha256 mismatch for {eff_map}: got {got_map_sha!r} != lock {exp_map_sha!r}"
            )
        if meta.get("link_map_sha256") is not None and str(meta.get("link_map_sha256")) != exp_map_sha:
            raise RuntimeError(
                f"{meta_path.name} link_map_sha256 {meta.get('link_map_sha256')!r} != lock {exp_map_sha!r}"
            )

    if not is_stdbin:
        verify_res = verify_stock_elf(
            elf_path,
            eff_cfg,
            stub_manifest=stub_manifest,
            repo_root=repo_root,
            expected_externs=expected_externs,
            expected_symtab_count=int(stock_lock["expected_symtab_count"]),
            expected_loader_sym_count=int(stock_lock["expected_loader_sym_count"]),
            expected_stub_manifest_count=int(stock_lock["expected_stub_manifest_count"]),
            expected_retained_stub_count=int(stock_lock["expected_retained_stub_count"]),
            expected_stub_manifest_sha=exp_manifest_sha,
            verbose=verbose,
        )
    else:
        cfg_paths_rel = [str(p) for p in (stock_lock.get("config_paths") or ())]
        if len(cfg_paths_rel) < 2 or cfg_paths_rel[0] != str(stock_lock["config_path"]):
            raise RuntimeError(
                f"{stock_lock_path} StdBin lock requires `config_paths` with >=2 entries starting with `config_path`"
            )
        lib2_cfg_doc: Mapping[str, Any] | None = None
        if repo_root is not None and (repo_root / DEFAULT_REL_LIB2_CONFIG).is_file():
            lib2_cfg_doc = tomllib.loads(
                (repo_root / DEFAULT_REL_LIB2_CONFIG).read_text(encoding="utf-8")
            )
        active_lib2_names_pin, active_lib2_roots_pin, moved_libc_rows_pin = _resolve_c2_row_selection(
            lib2_cfg=lib2_cfg_doc,
            lock=stock_lock,
        )
        sib_cfgs = [
            (repo_root / p) if repo_root is not None else pathlib.Path(p)
            for p in cfg_paths_rel[1:]
        ]
        if (
            active_lib2_names_pin
            and repo_root is not None
            and str(DEFAULT_REL_LIB2_CONFIG) not in cfg_paths_rel
        ):
            sib_cfgs.append(repo_root / DEFAULT_REL_LIB2_CONFIG)
        pin_retired_slots = tuple(eng_sl.get("retiredStubSlots") or ())
        verify_res = verify_stock_stdbin_elf(
            elf_path,
            eff_cfg,
            stub_manifest=stub_manifest,
            sibling_cfg_paths=sib_cfgs,
            repo_root=repo_root,
            expected_externs=expected_externs,
            active_lib2_roots=active_lib2_roots_pin if active_lib2_names_pin else None,
            retired_stub_slots=pin_retired_slots,
            expected_phnum=int(stock_lock.get("expected_phnum", EXPECTED_STDBIN_PHNUM)),
            expected_pt_loads=int(stock_lock.get("expected_pt_loads", EXPECTED_STDBIN_PT_LOADS)),
            expected_symtab_count=int(stock_lock["expected_symtab_count"]),
            expected_loader_sym_count=int(stock_lock["expected_loader_sym_count"]),
            expected_stub_manifest_count=int(stock_lock["expected_stub_manifest_count"]),
            expected_retained_stub_count=int(stock_lock["expected_retained_stub_count"]),
            expected_stub_manifest_sha=exp_manifest_sha,
            weak_undefined_allowed=tuple(
                str(x)
                for x in stock_lock.get(
                    "weak_undefined_allowed", DEFAULT_STDBIN_WEAK_UNDEFINED_ALLOWED
                )
            ),
            enforce_5d=(ld_mode != "none" or ci_mode),
            five_d_json_path=meta_path.parent / DEFAULT_STDBIN_5D_NAME,
            verbose=verbose,
        )
        if active_lib2_roots_pin or moved_libc_rows_pin:
            eff_pin_map = map_path if map_path is not None else (elf_path.parent / DEFAULT_LINK_MAP_NAME)
            _verify_c2_mechanical_invariants(
                elf_bytes=elf_path.read_bytes(),
                norm_map_text=eff_pin_map.read_text(encoding="utf-8"),
                active_lib2_roots=active_lib2_roots_pin,
                moved_libc_rows=moved_libc_rows_pin,
                retired_slots=pin_retired_slots,
            )
    if _has_alpha_lock_sections(stock_lock):
        alpha_res = _verify_alpha_from_meta_and_lock(
            elf_path=elf_path,
            meta=meta,
            stock_lock=stock_lock,
            repo_root=repo_root,
            map_path=map_path,
        )
        verify_res["alpha_b3"] = alpha_res

    if verbose:
        print(
            f"cli-elf-stock --verify-pin: OK ({elf_path.name}: {got_elf_size} bytes, "
            f"sha256={got_elf_sha}, argv={len(exp_lld_argv)} exact tokens)"
        )
    return verify_res


def build_stock_stdbin_into(
    repo_root: pathlib.Path,
    out_dir: pathlib.Path,
    engine_dir: pathlib.Path,
    lock: dict[str, Any],
    eff_stock_lock: pathlib.Path,
    explicit_engine: bool = False,
    isolated_cold_zig: bool = False,
    subdir_nesting: str = "build_stock",
    keep_work_dir: pathlib.Path | None = None,
    ci_mode: bool = False,
    unpinned: bool = False,
    lib2_rows_spec: str | None = None,
    c2_libc_rows_spec: str | None = None,
    c2_rehearsal_dehook: bool = False,
) -> pathlib.Path:
    """5a-i: Reproducible 2-config IO.6b `StdBin` builder (`main.rs` + `signal-session-io` +
    `rustc 1.98.1` `self-contained/{crt*.o,libc.a}` with real `mallocng` + `rdl_shim.S` +
    `extern_stubs_clean.o`, plus optional C2 `lib2` sibling + `2C` `libc` string-block move)."""
    if unpinned and ci_mode:
        raise RuntimeError("`--unpinned` is forbidden in CI mode")
    if ci_mode and (lib2_rows_spec is not None or c2_libc_rows_spec is not None or c2_rehearsal_dehook):
        raise RuntimeError(
            "CLI overrides `--lib2-rows`, `--c2-libc-rows`, and `--c2-rehearsal-dehook` are forbidden in CI mode"
        )
    if c2_rehearsal_dehook and not unpinned:
        raise RuntimeError("`--c2-rehearsal-dehook` requires `--unpinned`")
    lock = _unwrap_stock_lock_dict(lock)
    if "native_only" not in lock or not isinstance(lock["native_only"], list):
        raise RuntimeError(f"{eff_stock_lock} missing mandatory `native_only` list")
    has_native_only = _has_stock_native_only(lock)
    req_build_pairs: list[tuple[str, str]] = [
        ("main_rust_manifest_path", "main_rust_manifest_sha256"),
        ("main_rust_lock_path", "main_rust_lock_sha256"),
        ("main_rust_src_path", "main_rust_src_sha256"),
        ("rdl_shim_path", "rdl_shim_sha256"),
    ]
    if (
        has_native_only
        or lock.get("musl_string_config_path")
        or lock.get("musl_string_config_sha256")
    ):
        req_build_pairs.append(("musl_string_config_path", "musl_string_config_sha256"))
    fallback_root = SCRIPT_DIR.parent
    actual_build_pair_shas: dict[str, str] = {}
    resolved_build_pair_paths: dict[str, pathlib.Path] = {}
    for path_key, sha_key in req_build_pairs:
        rel_p = str(lock.get(path_key) or "")
        exp_s = str(lock.get(sha_key) or "")
        if not rel_p or (not unpinned and not HEX64_RE.match(exp_s)):
            raise RuntimeError(
                f"{eff_stock_lock} missing valid ({path_key}, {sha_key}): ({rel_p!r}, {exp_s!r})"
            )
        abs_p = repo_root / rel_p
        if not abs_p.is_file() and unpinned and (fallback_root / rel_p).is_file():
            abs_p = fallback_root / rel_p
        if not abs_p.is_file():
            raise RuntimeError(f"missing StdBin input file {abs_p}")
        got_s = _BASE.sha256_file(abs_p)
        if not unpinned and got_s != exp_s:
            raise RuntimeError(f"{abs_p} sha256 {got_s} != lock {exp_s}")
        actual_build_pair_shas[sha_key] = got_s
        resolved_build_pair_paths[path_key] = abs_p

    ld_mode, ld_rel, ld_sha, ld_abs, ld_arg_files = _resolve_and_verify_stdbin_linker_script(
        repo_root=repo_root,
        lock=lock,
        lock_label=eff_stock_lock,
        ci_mode=ci_mode,
        fallback_repo_root=fallback_root if unpinned else None,
        unpinned=unpinned,
    )

    lib2_cfg_path: pathlib.Path | None = None
    lib2_cfg_doc: dict[str, Any] | None = None
    cand_lib2_cfg = repo_root / DEFAULT_REL_LIB2_CONFIG
    if not cand_lib2_cfg.is_file() and unpinned and (fallback_root / DEFAULT_REL_LIB2_CONFIG).is_file():
        cand_lib2_cfg = fallback_root / DEFAULT_REL_LIB2_CONFIG
    if cand_lib2_cfg.is_file():
        lib2_cfg_path = cand_lib2_cfg.resolve()
        lib2_cfg_doc = tomllib.loads(lib2_cfg_path.read_text(encoding="utf-8"))

    active_lib2_names, active_lib2_roots, moved_libc_rows = _resolve_c2_row_selection(
        lib2_cfg=lib2_cfg_doc,
        lock=lock,
        lib2_rows_spec=lib2_rows_spec,
        c2_libc_rows_spec=c2_libc_rows_spec,
    )

    base_stock_ld_disk = repo_root / DEFAULT_REL_STOCK_LD
    if not base_stock_ld_disk.is_file() and unpinned and (fallback_root / DEFAULT_REL_STOCK_LD).is_file():
        base_stock_ld_disk = fallback_root / DEFAULT_REL_STOCK_LD
    c2_stock_ld_disk = repo_root / DEFAULT_REL_STOCK_C2_LD
    if not c2_stock_ld_disk.is_file() and unpinned and (fallback_root / DEFAULT_REL_STOCK_C2_LD).is_file():
        c2_stock_ld_disk = fallback_root / DEFAULT_REL_STOCK_C2_LD

    partial_c2_ld_text: str | None = None
    if moved_libc_rows:
        if not base_stock_ld_disk.is_file():
            raise RuntimeError(f"missing base `stock.ld` at {base_stock_ld_disk} for C2 `2C` switch")
        base_ld_text = base_stock_ld_disk.read_text(encoding="utf-8")
        full_c2_rendered = _render_c2_stock_ld(base_ld_text, C2_LIBC_CANONICAL_ORDER)
        if c2_stock_ld_disk.is_file():
            disk_c2_text = c2_stock_ld_disk.read_text(encoding="utf-8")
            if disk_c2_text != full_c2_rendered:
                raise RuntimeError(
                    f"on-disk `{c2_stock_ld_disk}` drifted from `_render_c2_stock_ld(stock.ld, all)`"
                )
        if moved_libc_rows == C2_LIBC_CANONICAL_ORDER:
            if not c2_stock_ld_disk.is_file():
                raise RuntimeError(f"missing C2 linker script `{c2_stock_ld_disk}`")
            c2_rel_str = str(DEFAULT_REL_STOCK_C2_LD)
            c2_sha_str = _BASE.sha256_file(c2_stock_ld_disk)
            if not unpinned and ld_rel != c2_rel_str:
                raise RuntimeError(
                    f"pinned build with `c2_moved_libc_rows = all` requires lock "
                    f"`linker_script_path = {c2_rel_str!r}`, got {ld_rel!r}"
                )
            ld_mode = "pinned"
            ld_rel = c2_rel_str
            ld_abs = c2_stock_ld_disk.resolve()
            ld_sha = c2_sha_str
            ld_arg_files = {c2_rel_str: c2_sha_str}
        else:
            if not unpinned and ld_mode != "scratch":
                raise RuntimeError(
                    "partial C2 `c2_moved_libc_rows` subset requires `--unpinned` or `stock_ld_mode = 'scratch'`"
                )
            partial_c2_ld_text = _render_c2_stock_ld(base_ld_text, moved_libc_rows)

    pre_link_pinned_ld_sha: str | None = None
    if ld_mode == "scratch" and (repo_root / DEFAULT_REL_STOCK_LD).is_file():
        pre_link_pinned_ld_sha = _BASE.sha256_file(repo_root / DEFAULT_REL_STOCK_LD)

    exp_eng = _expected_engine_commit(lock)
    eng_head = _verify_clean_pinned_engine(
        engine_dir,
        exp_eng,
        allow_explicit_mismatch=explicit_engine or unpinned,
        ci_mode=ci_mode,
    )

    config_paths = [str(p) for p in (lock.get("config_paths") or ())]
    if len(config_paths) < 2 or config_paths[0] != str(lock.get("config_path") or ""):
        raise RuntimeError(
            f"{eff_stock_lock} StdBin lock requires `config_paths` with >=2 entries starting with `config_path`"
        )
    for c_rel in config_paths:
        if not (repo_root / c_rel).is_file():
            raise RuntimeError(f"missing translation.toml config at {repo_root / c_rel}")

    cfg0_path = repo_root / config_paths[0]
    sib_cfg_paths = [repo_root / c_rel for c_rel in config_paths[1:]]
    if not unpinned:
        b2_derived = derive_placed_expectations(repo_root, cfg_path=cfg0_path)
        placed_exports = list(b2_derived["exports"])
        lean_externs = list(b2_derived["externs"])
        generated_extern_data = alpha_checks.parse_generated_lean_extern_data(repo_root)
    else:
        cfg0_doc = tomllib.loads(cfg0_path.read_text(encoding="utf-8"))
        placed_exports = [str(x) for x in (cfg0_doc.get("placed", {}).get("exports") or ())]
        try:
            b2_derived = derive_placed_expectations(repo_root, cfg_path=cfg0_path)
            lean_externs = list(b2_derived["externs"])
        except Exception:  # noqa: BLE001
            b2_derived = None
            lean_externs = []
        try:
            generated_extern_data = alpha_checks.parse_generated_lean_extern_data(repo_root)
        except Exception:  # noqa: BLE001
            try:
                generated_extern_data = alpha_checks.parse_generated_lean_extern_data(fallback_root)
            except Exception:  # noqa: BLE001
                generated_extern_data = None

    lock_stub_manifest = lock.get("stub_manifest")
    if not unpinned and (not isinstance(lock_stub_manifest, list) or not lock_stub_manifest):
        raise RuntimeError(
            f"{eff_stock_lock} missing non-empty `[[stub_manifest]]` list required for pre-staged stock link"
        )
    exp_manifest_count = int(
        lock.get("expected_stub_manifest_count", EXPECTED_STDBIN_STUB_MANIFEST_COUNT)
    )
    exp_manifest_sha = str(
        lock.get("stub_manifest_sha256", EXPECTED_STDBIN_STUB_MANIFEST_SHA256)
    )
    lock_displaced_weak = tuple(
        str(x) for x in lock.get("displaced_weak", alpha_checks.EXPECTED_DISPLACED_WEAK)
    )
    elf_name = str(lock.get("elf_name") or "signal-session-stock-stdbin.elf")
    main_rust_manifest_rel = str(lock["main_rust_manifest_path"])
    rdl_shim_src = resolved_build_pair_paths["rdl_shim_path"]

    cache_tmp_root = _BASE.get_cache_tmp_root()
    with tempfile.TemporaryDirectory(dir=cache_tmp_root, prefix="cli-elf-stdbin.") as run_tmp_str:
        run_tmp = pathlib.Path(run_tmp_str)
        env, scrubbed_keys = _resolve_scrubbed_pinned_toolchain(lock, run_tmp)
        if isolated_cold_zig:
            zig_cache = run_tmp / "cold-zig-cache"
            (zig_cache / "global").mkdir(parents=True, exist_ok=True)
            (zig_cache / "local").mkdir(parents=True, exist_ok=True)
            env["ZIG_GLOBAL_CACHE_DIR"] = str(zig_cache / "global")
            env["ZIG_LOCAL_CACHE_DIR"] = str(zig_cache / "local")

        if has_native_only:
            _BASE.ensure_musl_tarball_verified(engine_dir, lock, env)
        snapshot_link_sha: str | None = None

        work_root = run_tmp / subdir_nesting
        work_root.mkdir(parents=True, exist_ok=True)

        musl_native_objs = _compile_stock_native_objects(
            repo_root, engine_dir, lock, work_root, env, allow_empty=True
        )
        rdl_dir = work_root / "rdl_shim"
        rdl_dir.mkdir(parents=True, exist_ok=True)
        rdl_shim_o = rdl_dir / "rdl_shim.o"
        subprocess.run(
            [
                env["ZIG"],
                "cc",
                *STOCK_NATIVE_CFLAGS,
                "-c",
                str(rdl_shim_src),
                "-o",
                str(rdl_shim_o),
            ],
            cwd=str(rdl_dir),
            check=True,
            env=env,
        )
        pinned_musl_ref_bodies, _ = _load_pinned_musl_refs_from_rustc(lock=lock, env=env)
        stage_raw = work_root / "stock_stage"
        stage_raw.mkdir(parents=True, exist_ok=True)
        if partial_c2_ld_text is not None:
            partial_ld_abs = (stage_raw / "stock_c2_partial.ld").resolve()
            partial_ld_abs.write_text(partial_c2_ld_text, encoding="utf-8")
            ld_mode = "scratch"
            ld_rel = "stock_c2_partial.ld"
            ld_abs = partial_ld_abs
            ld_sha = _BASE.sha256_file(partial_ld_abs)
            ld_arg_files = {ld_rel: ld_sha}
        if not unpinned:
            assert isinstance(lock_stub_manifest, list)
            stubs_o, manifest_sha = _assemble_stub_manifest_object(
                stub_manifest=lock_stub_manifest,
                stubs_dir=work_root / "stubs",
                env=env,
                expected_manifest_count=exp_manifest_count,
                expected_manifest_sha=exp_manifest_sha,
            )
            stage_res = _stage_and_link_stdbin_direct(
                repo_root=repo_root,
                stage_raw=stage_raw,
                work_root=work_root,
                config_paths=config_paths,
                main_rust_manifest_rel=main_rust_manifest_rel,
                elf_name=elf_name,
                native_inputs=[*musl_native_objs, rdl_shim_o, stubs_o],
                ld_mode=ld_mode,
                ld_rel=ld_rel,
                ld_sha=ld_sha,
                ld_abs=ld_abs,
                lld_no_relax=bool(lock.get("lld_no_relax", ld_mode != "none")),
                placed_exports=placed_exports,
                eng_head=eng_head,
                env=env,
                lib2_cfg_rel=str(DEFAULT_REL_LIB2_CONFIG) if active_lib2_names else None,
                lib2_cfg_abs=lib2_cfg_path if active_lib2_names else None,
                active_lib2_names=active_lib2_names,
                active_lib2_roots=active_lib2_roots,
                moved_libc_rows=moved_libc_rows,
            )
        else:
            stage_res = _stage_and_link_stdbin_direct(
                repo_root=repo_root,
                stage_raw=stage_raw,
                work_root=work_root,
                config_paths=config_paths,
                main_rust_manifest_rel=main_rust_manifest_rel,
                elf_name=elf_name,
                native_inputs=[*musl_native_objs, rdl_shim_o],
                ld_mode=ld_mode,
                ld_rel=ld_rel,
                ld_sha=ld_sha,
                ld_abs=ld_abs,
                lld_no_relax=bool(lock.get("lld_no_relax", ld_mode != "none")),
                placed_exports=placed_exports,
                eng_head=eng_head,
                env=env,
                dynamic_stubs_dir=work_root / "stubs",
                initial_lean_externs=lean_externs or None,
                displaced_weak=lock_displaced_weak,
                lib2_cfg_rel=str(DEFAULT_REL_LIB2_CONFIG) if active_lib2_names else None,
                lib2_cfg_abs=lib2_cfg_path if active_lib2_names else None,
                active_lib2_names=active_lib2_names,
                active_lib2_roots=active_lib2_roots,
                moved_libc_rows=moved_libc_rows,
            )
            stubs_o = stage_res.get("stubs_o") or (work_root / "stubs" / STUB_OBJ_NAME)
            manifest_sha = str(stage_res["manifest_sha"])
            lean_externs = list(stage_res["lean_externs"] or ())
            exp_manifest_count = len(stage_res["stub_manifest"] or ())
            raw_unpinned_ext_data: list[str] = list(stage_res["extern_data"] or ())
            if b2_derived is None:
                b2_derived = {
                    "blocks": 0,
                    "placed_code_bytes": 0,
                    "data_objects": 0,
                    "placed_data_bytes": 0,
                    "exports": list(placed_exports),
                    "extern_count": len(lean_externs),
                }
        if pre_link_pinned_ld_sha is not None:
            post_link_pinned_ld_sha = _BASE.sha256_file(repo_root / DEFAULT_REL_STOCK_LD)
            if post_link_pinned_ld_sha != pre_link_pinned_ld_sha:
                raise RuntimeError(
                    f"pinned `{DEFAULT_REL_STOCK_LD}` changed during scratch build: "
                    f"{pre_link_pinned_ld_sha} -> {post_link_pinned_ld_sha}"
                )

        engine_sl_src = stage_raw / ENGINE_STOCK_META_NAME
        if not engine_sl_src.is_file():
            raise RuntimeError(f"snapshot-link --stock did not emit {engine_sl_src}")
        engine_sl_sha = _BASE.sha256_file(engine_sl_src)
        eng_sl = json.loads(engine_sl_src.read_text(encoding="utf-8"))
        eng_lld_sec = eng_sl.get("lld") or {}
        eng_lld_args_raw = [str(x) for x in (eng_lld_sec.get("args") or ())]
        eng_lld_args = _normalize_and_verify_stdbin_engine_arg_files(
            eng_lld_args_raw=eng_lld_args_raw,
            eng_arg_files_raw=eng_lld_sec.get("argFiles"),
            stock_ld_mode=ld_mode,
            linker_script_rel=ld_rel,
            linker_script_sha=ld_sha,
            repo_root=repo_root,
            ld_abs=ld_abs,
        )
        eng_inputs = eng_sl.get("inputs") or []
        if not unpinned and "lld_argv" in lock:
            _verify_stdbin_lld_argv_against_lock(
                eng_lld_args,
                [str(x) for x in lock["lld_argv"]],
                eng_inputs,
                stock_lld_arg_files=ld_arg_files,
            )

        std_bin_obj = eng_sl.get("stdBin") or {}
        if not unpinned and "weakened_in_main" in lock:
            exp_weakened = [str(x) for x in lock["weakened_in_main"]]
            if list(std_bin_obj.get("weakenedInMain") or ()) != exp_weakened:
                raise RuntimeError(
                    f"stock-link.json stdBin.weakenedInMain {std_bin_obj.get('weakenedInMain')!r} != lock {exp_weakened!r}"
                )
        unwind_retained = [
            m
            for m in (std_bin_obj.get("archiveMembers") or ())
            if "libunwind.a" in str(m.get("archive") or "")
        ]
        if unwind_retained:
            raise RuntimeError(
                f"stock-link.json retained unexpected libunwind.a section(s): {unwind_retained}"
            )

        raw_work = stage_raw / "work"
        cli_link_objs: list[pathlib.Path] = []
        lib2_link_objs: list[pathlib.Path] = []
        for cfg_ent in eng_sl.get("configs") or ():
            is_lib2_cfg = str(cfg_ent.get("role") or "") == "lib2"
            for obj_ent in cfg_ent.get("objects") or ():
                p_obj = stage_raw / str(obj_ent["path"])
                if not p_obj.is_file():
                    raise RuntimeError(f"missing staged cliLinkObj {p_obj}")
                if is_lib2_cfg:
                    lib2_link_objs.append(p_obj)
                else:
                    cli_link_objs.append(p_obj)
        if not cli_link_objs:
            raise RuntimeError(f"{engine_sl_src} recorded 0 `configs[*].objects[*]` entries")
        retired_slots = list(eng_sl.get("retiredStubSlots") or ())

        sc_dir = raw_work / "self-contained"
        sc_objs = [
            sc_dir / "crt1.o",
            sc_dir / "crti.o",
            sc_dir / "crtbegin.o",
            sc_dir / "crtend.o",
            sc_dir / "crtn.o",
        ]
        main_rust_o = raw_work / "main_rust.o"
        libc_a = sc_dir / "libc.a"
        compiler_builtins_a = raw_work / "compiler_builtins.a"
        libunwind_a = sc_dir / "libunwind.a"
        runtime_archives = [libc_a, compiler_builtins_a, libunwind_a]
        staged_native_non_stub = [
            raw_work / "native" / p.name for p in [*musl_native_objs, rdl_shim_o]
        ]
        staged_stubs_o = raw_work / "native" / stubs_o.name

        for req in [*sc_objs, main_rust_o, *runtime_archives, *staged_native_non_stub, staged_stubs_o]:
            if not req.is_file():
                raise RuntimeError(f"missing staged StdBin input: {req}")

        if not unpinned and "main_rust_obj_sha256" in lock:
            got_mr_sha = _BASE.sha256_file(main_rust_o)
            if got_mr_sha != str(lock["main_rust_obj_sha256"]):
                raise RuntimeError(
                    f"main_rust.o sha256 {got_mr_sha!r} != lock {lock['main_rust_obj_sha256']!r}"
                )
        if not unpinned and "compiler_builtins_sha256" in lock:
            got_cb_sha = _BASE.sha256_file(compiler_builtins_a)
            if got_cb_sha != str(lock["compiler_builtins_sha256"]):
                raise RuntimeError(
                    f"compiler_builtins.a sha256 {got_cb_sha!r} != lock {lock['compiler_builtins_sha256']!r}"
                )

        runtime_archive_shas = {
            p.name: _BASE.sha256_file(p) for p in [*sc_objs, libc_a, libunwind_a]
        }
        _verify_runtime_archive_shas(
            runtime_archive_shas,
            {str(k): str(v) for k, v in lock["runtime_archives"].items()}
            if "runtime_archives" in lock
            else None,
        )

        # Recompute canonical `stub_manifest` from staged `lib0_*` + `lib1_*` and runtime/native inputs.
        stub_manifest = _compute_stock_stub_manifest(
            lib_objs=cli_link_objs,
            rt_inputs=[*sc_objs, main_rust_o, *staged_native_non_stub, *runtime_archives],
            lean_externs=lean_externs,
            displaced_weak=lock_displaced_weak,
        )
        recomputed_manifest_sha = stub_manifest_sha256(stub_manifest)
        if recomputed_manifest_sha != manifest_sha:
            raise RuntimeError(
                f"recomputed StdBin stub_manifest sha256 {recomputed_manifest_sha} != lock {manifest_sha}; "
                f"re-pin `[[stub_manifest]]` in {eff_stock_lock}"
            )

        staged_elf = stage_raw / elf_name
        if not staged_elf.is_file():
            raise RuntimeError(f"snapshot-link --stock did not produce {staged_elf}")
        raw_map_path = raw_work / DEFAULT_LINK_MAP_NAME
        if not raw_map_path.is_file():
            raise RuntimeError(f"snapshot-link --stock did not persist {raw_map_path}")

        link_out = work_root / "link_out"
        link_out.mkdir(parents=True, exist_ok=True)
        built_elf = link_out / elf_name
        shutil.copy2(staged_elf, built_elf)

        # Strip `<stage_raw.resolve()>/` prefix from `work/link.map` so `link.map` is 100%
        # byte-identical across arbitrary `TMPDIR` / path-nesting depths.
        stage_prefix = f"{stage_raw.resolve()}/"
        norm_map_text = raw_map_path.read_text(encoding="utf-8").replace(stage_prefix, "")
        if str(stage_raw.resolve()) in norm_map_text:
            raise RuntimeError(f"unnormalized temp path prefix remained in {raw_map_path}")
        built_map = link_out / DEFAULT_LINK_MAP_NAME
        built_map.write_text(norm_map_text, encoding="utf-8")
        link_map_sha = _BASE.sha256_file(built_map)

        pq_tables: dict[str, list[str]] | None = None
        if (repo_root / DEFAULT_REL_CLI_BINARY_PQ).is_file() or (
            unpinned and (fallback_root / DEFAULT_REL_CLI_BINARY_PQ).is_file()
        ):
            pq_tables = load_cli_binary_pq_tables(
                repo_root, fallback_repo_root=fallback_root if unpinned else None
            )

        eff_dehooked_syms: tuple[str, ...] | None = None
        if pq_tables is not None:
            base_dehooked = list(pq_tables["cliDehookedSymsPlaced"])
            if c2_rehearsal_dehook:
                rehearsal_extra = [
                    "memcpy",
                    "memset",
                    *(r for r in moved_libc_rows if r != "memcmp"),
                    *active_lib2_roots,
                ]
                eff_dehooked_syms = tuple(dict.fromkeys([*base_dehooked, *rehearsal_extra]))
            else:
                eff_dehooked_syms = tuple(base_dehooked)
                if active_lib2_roots or moved_libc_rows:
                    must_be_dehooked = [
                        *(r for r in moved_libc_rows if r != "memcmp"),
                        *active_lib2_roots,
                    ]
                    still_hooked = sorted(set(must_be_dehooked) & set(pq_tables["cliHookTablePlaced"]))
                    missing_dehooked = [
                        s for s in must_be_dehooked if s not in set(base_dehooked)
                    ]
                    if still_hooked or missing_dehooked:
                        raise RuntimeError(
                            "C2 atomic de-hook check failed against `CliBinaryPq.lean` "
                            f"(pass `--c2-rehearsal-dehook` with `--unpinned` for pre-cutover trials): "
                            f"still_in_cliHookTablePlaced={still_hooked}, "
                            f"missing_from_cliDehookedSymsPlaced={missing_dehooked}"
                        )
        elif c2_rehearsal_dehook:
            eff_dehooked_syms = tuple(
                dict.fromkeys([
                    "memcpy",
                    "memset",
                    *(r for r in moved_libc_rows if r != "memcmp"),
                    *active_lib2_roots,
                ])
            )

        sib_cfg_paths_verify = list(sib_cfg_paths)
        if (
            active_lib2_names
            and lib2_cfg_path is not None
            and all(p.resolve() != lib2_cfg_path.resolve() for p in sib_cfg_paths_verify)
        ):
            sib_cfg_paths_verify.append(lib2_cfg_path)

        run_5d_in_build = (ld_mode != "none") or ci_mode
        built_5d_json = link_out / DEFAULT_STDBIN_5D_NAME
        if not unpinned:
            eff_symtab_cnt = int(lock.get("expected_symtab_count", EXPECTED_STDBIN_SYMTAB_COUNT))
            eff_loader_cnt = int(
                lock.get("expected_loader_sym_count", EXPECTED_STDBIN_LOADER_SYM_COUNT)
            )
            eff_retained_cnt = int(
                lock.get("expected_retained_stub_count", EXPECTED_STDBIN_RETAINED_STUB_COUNT)
            )
            eff_verify_repo_root: pathlib.Path | None = repo_root
            eff_verify_externs: Sequence[str] | None = None
        else:
            _u_img, _, _, _u_syms = elf_loader.parse_raw_elf(
                built_elf.read_bytes(), require_symtab=True
            )
            eff_symtab_cnt = len(_u_syms)
            eff_loader_cnt = len(_u_img.symbols)
            _u_def_names = {s.name for s in _u_syms[1:] if s.st_shndx != 0 and s.name}
            _u_retired_orig = {str(r["originalSymbol"]) for r in retired_slots if r.get("originalSymbol")}
            eff_retained_cnt = sum(
                1
                for item in stub_manifest
                if str(item["name"]) in _u_def_names or str(item["name"]) in _u_retired_orig
            )
            eff_verify_repo_root = None
            eff_verify_externs = lean_externs
            if generated_extern_data is None:
                _u_obj_sz_by_name: dict[str, int] = {}
                for _s in _u_syms[1:]:
                    if _s.st_shndx != 0 and _s.stype == 1 and _s.name and _s.name not in _u_obj_sz_by_name:
                        _u_obj_sz_by_name[_s.name] = int(_s.st_size)
                _lock_kept_d1 = (
                    (lock.get("d1_extern_data_lock") or {}).get("kept")
                    if isinstance(lock.get("d1_extern_data_lock"), Mapping)
                    else None
                )
                generated_extern_data = {}
                for _usym in raw_unpinned_ext_data:
                    _udem = alpha_checks.demangle_rust_v0(str(_usym))
                    if isinstance(_lock_kept_d1, Mapping) and str(_usym) in _lock_kept_d1:
                        _usz = int(_lock_kept_d1[str(_usym)]["size"])
                    elif str(_usym) in _u_obj_sz_by_name:
                        _usz = _u_obj_sz_by_name[str(_usym)]
                    elif str(_usym) in alpha_checks.EIGHT_BYTE_EXTERN_DATA_SYMS:
                        _usz = 8
                    else:
                        _usz = 0
                    generated_extern_data[_udem] = _usz
        verify_summary = verify_stock_stdbin_elf(
            built_elf,
            cfg0_path,
            stub_manifest,
            sibling_cfg_paths=sib_cfg_paths_verify,
            repo_root=eff_verify_repo_root,
            expected_externs=eff_verify_externs,
            dehooked_syms=eff_dehooked_syms,
            active_lib2_roots=active_lib2_roots if active_lib2_names else None,
            retired_stub_slots=retired_slots,
            expected_phnum=int(lock.get("expected_phnum", EXPECTED_STDBIN_PHNUM)),
            expected_pt_loads=int(lock.get("expected_pt_loads", EXPECTED_STDBIN_PT_LOADS)),
            expected_symtab_count=eff_symtab_cnt,
            expected_loader_sym_count=eff_loader_cnt,
            expected_stub_manifest_count=exp_manifest_count,
            expected_retained_stub_count=eff_retained_cnt,
            expected_stub_manifest_sha=manifest_sha,
            weak_undefined_allowed=tuple(
                str(x)
                for x in lock.get(
                    "weak_undefined_allowed", DEFAULT_STDBIN_WEAK_UNDEFINED_ALLOWED
                )
            ),
            enforce_5d=run_5d_in_build,
            five_d_json_path=built_5d_json if run_5d_in_build else None,
            verbose=True,
        )
        _verify_c2_mechanical_invariants(
            elf_bytes=built_elf.read_bytes(),
            norm_map_text=norm_map_text,
            active_lib2_roots=active_lib2_roots,
            moved_libc_rows=moved_libc_rows,
            retired_slots=retired_slots,
        )

        alpha_scan = alpha_checks.scan_link_inputs_for_alpha(
            cli_link_objs=cli_link_objs,
            other_objs=[*sc_objs, main_rust_o, *lib2_link_objs],
            native_objs=staged_native_non_stub,
            stubs_o=staged_stubs_o,
            runtime_archives=runtime_archives,
            strlen_source_override=None,
            pinned_musl_ref_bodies=pinned_musl_ref_bodies,
        )
        alpha_b3 = alpha_checks.compute_and_verify_alpha_b3(
            elf_bytes=built_elf.read_bytes(),
            map_text=norm_map_text,
            alpha_scan=alpha_scan,
            generated_extern_data=generated_extern_data,
            expected_lock=lock if (not unpinned and "s2_real_body_lock" in lock) else None,
            verify_addresses=not unpinned,
        )

        digest = _BASE.sha256_file(built_elf)
        size = built_elf.stat().st_size
        lld_ver = subprocess.run(
            [env["LLD"], "--version"], capture_output=True, text=True, check=True, env=env
        ).stdout.strip()
        input_files = [
            *sc_objs,
            *staged_native_non_stub,
            staged_stubs_o,
            *cli_link_objs,
            *lib2_link_objs,
            main_rust_o,
            *runtime_archives,
        ]
        assert b2_derived is not None
        stdbin_meta: dict[str, Any] = {
            "tool": "scripts/cli-elf-stock",
            "recipe": STDBIN_RECIPE,
            "explicit_engine": bool(explicit_engine),
            "engine_commit": eng_head,
            "engine_stock_link_json_sha256": engine_sl_sha,
            "snapshot_link_sha256": snapshot_link_sha,
            "rustc_version": str(lock["rustc_version"]),
            "lld_version": lld_ver,
            "zig_version": str(lock["zig_version"]),
            "config_paths": config_paths,
            "main_rust_manifest_path": str(lock["main_rust_manifest_path"]),
            "main_rust_manifest_sha256": actual_build_pair_shas["main_rust_manifest_sha256"],
            "main_rust_lock_path": str(lock["main_rust_lock_path"]),
            "main_rust_lock_sha256": actual_build_pair_shas["main_rust_lock_sha256"],
            "main_rust_src_path": str(lock["main_rust_src_path"]),
            "main_rust_src_sha256": actual_build_pair_shas["main_rust_src_sha256"],
            "rdl_shim_path": str(lock["rdl_shim_path"]),
            "rdl_shim_sha256": actual_build_pair_shas["rdl_shim_sha256"],
            "musl_string_config_path": (
                str(lock["musl_string_config_path"]) if lock.get("musl_string_config_path") else None
            ),
            "musl_string_config_sha256": actual_build_pair_shas.get("musl_string_config_sha256"),
            "stock_ld_mode": ld_mode,
            "linker_script": ld_rel,
            "linker_script_sha256": ld_sha,
            "stock_lld_arg_files": dict(ld_arg_files),
            "lld_argv": eng_lld_args,
            "forced_undefined_exports": [e for e in placed_exports if e != "main"],
            "b2_derived_expectations": {
                "blocks": int(b2_derived["blocks"]),
                "placed_code_bytes": int(b2_derived["placed_code_bytes"]),
                "data_objects": int(b2_derived["data_objects"]),
                "placed_data_bytes": int(b2_derived["placed_data_bytes"]),
                "exports": list(b2_derived["exports"]),
                "extern_count": int(b2_derived["extern_count"]),
            },
            "scrubbed_env_keys": list(scrubbed_keys),
            "env_scrub": {
                "checked": _env_scrub_checked_spec(preserve_zig_cache=False),
                "removed": list(scrubbed_keys),
                "ran_before_toolchain_probe": True,
            },
            "active_build_env": {
                k: env[k]
                for k in sorted(env.keys())
                if k in ("LLD", "LLVM_OBJCOPY", "ZIG", "ZIG_GLOBAL_CACHE_DIR", "ZIG_LOCAL_CACHE_DIR")
            },
            "runtime_archives": runtime_archive_shas,
            "stub_manifest_sha256": manifest_sha,
            "stub_manifest": stub_manifest,
            "elf": {
                "name": elf_name,
                "size": size,
                "sha256": digest,
                **verify_summary,
            },
            "inputs": [
                {"name": p.name, "size": p.stat().st_size, "sha256": _BASE.sha256_file(p)}
                for p in input_files
            ],
            "link_map_sha256": link_map_sha,
            "alpha_scan": alpha_scan,
            "alpha_displaced_weak_lock": alpha_b3["alpha_displaced_weak_lock"],
            "s2_real_body_lock": alpha_b3["s2_real_body_lock"],
            "d1_extern_data_lock": alpha_b3["d1_extern_data_lock"],
        }
        if unpinned:
            stdbin_meta["unpinned"] = True
        if active_lib2_names or moved_libc_rows:
            stdbin_meta["c2"] = {
                "lib2_config": str(DEFAULT_REL_LIB2_CONFIG) if active_lib2_names else None,
                "active_lib2_rows": list(active_lib2_names),
                "active_lib2_roots": list(active_lib2_roots),
                "retired_stub_slots": retired_slots,
                "moved_libc_rows": list(moved_libc_rows),
                "rehearsal_dehook": bool(c2_rehearsal_dehook),
            }
        built_cv_json = link_out / DEFAULT_STDBIN_META_NAME
        built_cv_json.write_text(json.dumps(stdbin_meta, indent=2) + "\n", encoding="utf-8")

        out_dir.mkdir(parents=True, exist_ok=True)
        dst_elf = out_dir / elf_name
        dst_cv_json = out_dir / DEFAULT_STDBIN_META_NAME
        dst_map = out_dir / DEFAULT_LINK_MAP_NAME
        dst_eng_json = out_dir / ENGINE_STOCK_META_NAME

        tmp_dst_elf = out_dir / f".{elf_name}.tmp"
        tmp_dst_cv_json = out_dir / f".{DEFAULT_STDBIN_META_NAME}.tmp"
        tmp_dst_map = out_dir / f".{DEFAULT_LINK_MAP_NAME}.tmp"
        tmp_dst_eng_json = out_dir / f".{ENGINE_STOCK_META_NAME}.tmp"

        shutil.copy2(built_elf, tmp_dst_elf)
        shutil.copy2(built_cv_json, tmp_dst_cv_json)
        shutil.copy2(built_map, tmp_dst_map)
        shutil.copy2(engine_sl_src, tmp_dst_eng_json)

        tmp_dst_eng_json.replace(dst_eng_json)
        tmp_dst_map.replace(dst_map)
        tmp_dst_elf.replace(dst_elf)
        tmp_dst_cv_json.replace(dst_cv_json)
        if built_5d_json.is_file():
            dst_5d_json = out_dir / DEFAULT_STDBIN_5D_NAME
            tmp_dst_5d_json = out_dir / f".{DEFAULT_STDBIN_5D_NAME}.tmp"
            shutil.copy2(built_5d_json, tmp_dst_5d_json)
            tmp_dst_5d_json.replace(dst_5d_json)
        for extra_side_name in ("census.json", "timing.json"):
            src_extra = stage_raw / extra_side_name
            if src_extra.is_file():
                dst_extra = out_dir / extra_side_name
                tmp_extra = out_dir / f".{extra_side_name}.tmp"
                shutil.copy2(src_extra, tmp_extra)
                tmp_extra.replace(dst_extra)

        dst_work = out_dir / "work"
        tmp_dst_work = out_dir / ".work.tmp"
        if tmp_dst_work.exists():
            shutil.rmtree(tmp_dst_work)
        shutil.copytree(raw_work, tmp_dst_work, symlinks=True)
        if dst_work.exists():
            shutil.rmtree(dst_work)
        tmp_dst_work.replace(dst_work)

        if keep_work_dir is not None:
            if keep_work_dir.exists():
                shutil.rmtree(keep_work_dir)
            shutil.copytree(work_root, keep_work_dir, symlinks=True)

        t_info = stage_res["timings"]
        print(
            f"cli-elf-stock --stdbin --build: OK -> {dst_elf} ({size} bytes, sha256={digest}, "
            f"total={t_info['totalSeconds']:.2f}s, crates={t_info['cratesCompileSeconds']:.2f}s, "
            f"build_std={t_info['buildStdSeconds']:.2f}s, lld={t_info['lldWallSeconds']:.3f}s)"
        )
        return dst_elf


def _rewrite_gnu_archive_member_names(buf: bytes, *, keep_only_obj: bool = False) -> bytes:
    """Port of `snapshot-link/src/link.rs:rewrite_gnu_archive`: strip cache directory prefixes from
    GNU `!<arch>\\n` archive member names (`<=15` bytes inline `<base>/`, `>15` bytes in `//` string
    table) and rebase `/` and `/SYM64/` symbol-table offsets so cold-zig-cache builds produce
    byte-identical `libc.a` and `libcompiler_rt.a` SHA-256 digests."""
    if not buf.startswith(b"!<arch>\n"):
        raise ValueError("not a regular GNU archive")
    pos = 8
    n_len = len(buf)
    records: list[tuple[int, bytearray, bytearray]] = []
    while pos < n_len:
        if pos % 2 == 1:
            pos += 1
        if pos == n_len:
            break
        if pos + 60 > n_len:
            raise ValueError(f"truncated archive header at {pos}")
        hdr = bytearray(buf[pos : pos + 60])
        size_s = bytes(hdr[48:58]).decode("ascii", errors="strict").strip()
        size = int(size_s)
        if pos + 60 + size > n_len:
            raise ValueError(f"truncated archive member payload at {pos} (size {size})")
        records.append((pos, hdr, bytearray(buf[pos + 60 : pos + 60 + size])))
        pos += 60 + size

    old_strtab = b""
    for _rpos, hdr, data in records:
        if bytes(hdr[:16]).rstrip(b" ") == b"//":
            old_strtab = bytes(data)
            break
    records = [(rpos, hdr, data) for rpos, hdr, data in records if bytes(hdr[:16]).rstrip(b" ") != b"//"]

    new_strtab = bytearray()
    kept_records: list[tuple[int, bytearray, bytearray]] = []
    for rec_pos, hdr, payload in records:
        trimmed = bytes(hdr[:16]).rstrip(b" ")
        if trimmed in (b"/", b"/SYM64/"):
            kept_records.append((rec_pos, hdr, payload))
            continue
        if hdr[0:1] == b"/" and len(trimmed) > 1 and trimmed[1:].isdigit():
            off = int(trimmed[1:].decode("ascii"))
            if off >= len(old_strtab):
                raise ValueError(f"archive string-table offset /{off} out of bounds ({len(old_strtab)})")
            tail = old_strtab[off:]
            nl = tail.find(b"\n")
            entry_bytes = tail[:nl] if nl >= 0 else tail
            raw_name = entry_bytes[:-1] if entry_bytes.endswith(b"/") else entry_bytes
        else:
            raw_name = trimmed[:-1] if trimmed.endswith(b"/") else trimmed
        base = raw_name.rsplit(b"/", 1)[-1]
        if keep_only_obj and not base.endswith(b".o"):
            continue
        if len(base) <= 15:
            field = bytearray(b" " * 16)
            field[: len(base)] = base
            field[len(base)] = ord("/")
            hdr[:16] = field
        else:
            new_off = len(new_strtab)
            new_strtab.extend(base)
            new_strtab.extend(b"/\n")
            hdr[:16] = f"/{new_off:<15}".encode("ascii")
        kept_records.append((rec_pos, hdr, payload))
    records = kept_records

    if new_strtab:
        st_hdr = bytearray(b" " * 60)
        st_hdr[:2] = b"//"
        st_hdr[48:58] = f"{len(new_strtab):<10}".encode("ascii")
        st_hdr[58:60] = b"`\n"
        insert_idx = len(records)
        for idx, (_rp, hdr, _pl) in enumerate(records):
            if bytes(hdr[:16]).rstrip(b" ") not in (b"/", b"/SYM64/"):
                insert_idx = idx
                break
        records.insert(insert_idx, (0, st_hdr, new_strtab))

    old_pos_to_new: dict[int, int] = {}
    out_pos = 8
    for old_pos, _hdr, data in records:
        if out_pos % 2 == 1:
            out_pos += 1
        if old_pos > 0:
            old_pos_to_new[old_pos] = out_pos
        out_pos += 60 + len(data)

    for _old_pos, hdr, data in records:
        tag = bytes(hdr[:16]).rstrip(b" ")
        if tag == b"/":
            if len(data) < 4:
                raise ValueError("short archive symbol table")
            (n_syms,) = struct.unpack_from(">I", data, 0)
            if len(data) < 4 + 4 * n_syms:
                raise ValueError("truncated archive symbol offsets")
            for k in range(n_syms):
                o = 4 + 4 * k
                (old_m,) = struct.unpack_from(">I", data, o)
                if old_m not in old_pos_to_new:
                    raise ValueError(f"unknown member offset {old_m} in `/`")
                struct.pack_into(">I", data, o, old_pos_to_new[old_m])
        elif tag == b"/SYM64/":
            if len(data) < 8:
                raise ValueError("short SYM64 archive symbol table")
            (n_syms,) = struct.unpack_from(">Q", data, 0)
            if len(data) < 8 + 8 * n_syms:
                raise ValueError("truncated SYM64 symbol offsets")
            for k in range(n_syms):
                o = 8 + 8 * k
                (old_m,) = struct.unpack_from(">Q", data, o)
                if old_m not in old_pos_to_new:
                    raise ValueError(f"unknown member offset {old_m} in `/SYM64/`")
                struct.pack_into(">Q", data, o, old_pos_to_new[old_m])

    out = bytearray(b"!<arch>\n")
    for _old_pos, hdr, data in records:
        if len(out) % 2 == 1:
            out.append(ord("\n"))
        out.extend(hdr)
        out.extend(data)
    return bytes(out)


def _compile_main_c_and_stage_musl_runtime_direct(
    main_c: pathlib.Path,
    work_root: pathlib.Path,
    link_work: pathlib.Path,
    env: dict[str, str],
    *,
    wanted_archive_names: Sequence[str] | None = None,
) -> tuple[pathlib.Path, pathlib.Path, list[pathlib.Path]]:
    """Compile `main_c` and stage `crt1.o` plus the lock-pinned musl runtime `.a` archives
    (`libc.a`, `libcompiler_rt.a`) directly via `zig cc` + `llvm-objcopy` + GNU archive normalization."""
    link_work.mkdir(parents=True, exist_ok=True)
    c_stage = work_root / "main_c_build"
    c_stage.mkdir(parents=True, exist_ok=True)
    staged_main_c = c_stage / "main.c"
    shutil.copy2(main_c, staged_main_c)
    main_o = link_work / "main.o"
    subprocess.run(
        [
            env["ZIG"],
            "cc",
            "-target",
            "aarch64-linux-musl",
            "-O2",
            "-fno-sanitize=all",
            "-fno-pie",
            "-no-pie",
            "-static",
            "-g0",
            "-c",
            "main.c",
            "-o",
            str(main_o),
        ],
        cwd=str(c_stage),
        check=True,
        env=env,
    )

    probe_dir = work_root / "musl_rt_probe"
    probe_dir.mkdir(parents=True, exist_ok=True)
    probe_c = probe_dir / "probe.c"
    probe_c.write_text("int main(void) { return 0; }\n", encoding="utf-8")
    probe_o = probe_dir / "probe.o"
    subprocess.run(
        [
            env["ZIG"],
            "cc",
            "-target",
            "aarch64-linux-musl",
            "-O2",
            "-fno-sanitize=all",
            "-fno-pie",
            "-no-pie",
            "-static",
            "-g0",
            "-c",
            str(probe_c),
            "-o",
            str(probe_o),
        ],
        cwd=str(probe_dir),
        check=True,
        env=env,
    )
    probe_res = subprocess.run(
        [
            env["ZIG"],
            "cc",
            "-target",
            "aarch64-linux-musl",
            "-O2",
            "-fno-sanitize=all",
            "-fno-pie",
            "-no-pie",
            "-static",
            "-v",
            str(probe_o),
            "-o",
            str(probe_dir / "probe"),
        ],
        cwd=str(probe_dir),
        capture_output=True,
        text=True,
        check=True,
        env=env,
    )
    verbose = probe_res.stdout + "\n" + probe_res.stderr
    probe_o_s = str(probe_o)
    link_line: str | None = None
    for line in verbose.splitlines():
        if "ld.lld" in line and probe_o_s in line.split():
            link_line = line
            break
    if link_line is None:
        raise RuntimeError(f"no `zig cc -v` ld.lld link line mentions {probe_o}")

    pre: list[pathlib.Path] = []
    libs: list[pathlib.Path] = []
    post: list[pathlib.Path] = []
    seen_main = False
    for tok in link_line.split():
        p = pathlib.Path(tok)
        if p == probe_o:
            seen_main = True
        elif tok.endswith(".a"):
            libs.append(p)
        elif tok.endswith(".o"):
            (post if seen_main else pre).append(p)
    if not seen_main or not any(p.name == "crt1.o" for p in pre) or post:
        raise RuntimeError(
            f"unexpected `zig cc -v` musl runtime inputs: pre={pre}, libs={libs}, post={post}"
        )
    if wanted_archive_names is not None:
        wanted_set = {str(x) for x in wanted_archive_names}
        found_set = {p.name for p in libs}
        missing_rt = sorted(wanted_set - found_set)
        if missing_rt:
            raise RuntimeError(
                f"lock `runtime_archives` archive(s) {missing_rt} missing from `zig cc -v` libs {[p.name for p in libs]}"
            )
        libs = [p for p in libs if p.name in wanted_set]

    seen_names: set[str] = set()
    staged_pre: list[pathlib.Path] = []
    staged_libs: list[pathlib.Path] = []
    for src in [*pre, *libs]:
        nm = src.name
        if nm in seen_names:
            raise RuntimeError(f"duplicate runtime input file name `{nm}` while staging {src}")
        seen_names.add(nm)
        dst = link_work / nm
        if src.suffix == ".o":
            subprocess.run(
                [env["LLVM_OBJCOPY"], "--strip-debug", str(src), str(dst)],
                check=True,
                env=env,
            )
            staged_pre.append(dst)
        elif src.suffix == ".a":
            subprocess.run(
                [
                    env["LLVM_OBJCOPY"],
                    "--enable-deterministic-archives",
                    "--strip-debug",
                    str(src),
                    str(dst),
                ],
                check=True,
                env=env,
            )
            dst.write_bytes(_rewrite_gnu_archive_member_names(dst.read_bytes()))
            staged_libs.append(dst)
        else:
            raise RuntimeError(f"unsupported runtime input extension for {src}")

    crt1_cands = [p for p in staged_pre if p.name == "crt1.o"]
    if len(crt1_cands) != 1 or len(staged_pre) != 1:
        raise RuntimeError(f"expected single startup object `crt1.o`, got {staged_pre}")
    return crt1_cands[0], main_o, staged_libs


def _canonicalize_existing_prefix(d: pathlib.Path) -> pathlib.Path:
    if d.exists():
        return d.resolve()
    anc = d.parent
    while not anc.exists() and anc != anc.parent:
        anc = anc.parent
    return anc.resolve() / d.relative_to(anc)


def _prefix_remaps(what: str, d: pathlib.Path, to: str) -> list[tuple[str, str]]:
    dirs = [d]
    canon = _canonicalize_existing_prefix(d)
    if canon != d:
        dirs.append(canon)
    out: list[tuple[str, str]] = []
    for item in dirs:
        s = str(item)
        if any(ch.isspace() or ord(ch) < 32 for ch in s) or "=" in s:
            raise RuntimeError(f"{what} path `{s}` cannot be passed in RUSTFLAGS --remap-path-prefix")
        out.append((s, f"--remap-path-prefix={s}={to}"))
    return out


def _resolve_upstream_for_cfg(
    repo_root: pathlib.Path,
    crate_dir: pathlib.Path,
    cfg: Mapping[str, Any],
    env: Mapping[str, str],
) -> tuple[pathlib.Path, str] | None:
    up = cfg.get("upstream")
    if not isinstance(up, Mapping):
        return None
    name = str(up["name"])
    tag = str(up["tag"])
    vendor_symlink = up.get("vendor_symlink")
    probe_path = up.get("probe_path")
    env_var = str(up.get("env_var") or f"{name.upper()}_SRC")
    home_subdir = pathlib.Path(str(up.get("home_subdir") or f"sw/{name}"))

    candidates: list[pathlib.Path] = []
    if env.get(env_var):
        candidates.append(pathlib.Path(str(env[env_var])))
    candidates.append(repo_root / "third_party" / f"{name}-{tag}")
    if tag.startswith("v"):
        candidates.append(repo_root / "third_party" / f"{name}-{tag[1:]}")
    if vendor_symlink:
        candidates.append(crate_dir / str(vendor_symlink))
    if env.get("HOME"):
        home_dir = pathlib.Path(str(env["HOME"]))
        candidates.append(home_dir / home_subdir)
        if up.get("commit"):
            candidates.append(
                home_dir
                / ".cache"
                / "arm64-verification-engine"
                / "git"
                / f"{name}-{up['commit']}"
            )

    chosen: pathlib.Path | None = None
    for cand in candidates:
        valid = (cand / str(probe_path)).is_file() if probe_path else (cand / ".git").exists()
        if valid:
            chosen = cand.resolve() if cand.is_symlink() else cand
            break
    if chosen is None:
        raise RuntimeError(
            f"no `{name}` upstream checkout found at tag `{tag}` (checked {candidates})"
        )

    commit = subprocess.run(
        ["git", "-C", str(chosen), "rev-parse", "--verify", "HEAD"],
        capture_output=True,
        text=True,
        check=True,
    ).stdout.strip()
    if not HEX40_RE.match(commit):
        raise RuntimeError(f"invalid upstream `{name}` HEAD commit: {commit!r}")
    if "commit" in up and str(up["commit"]) != commit:
        raise RuntimeError(f"upstream `{name}` at {commit} != pinned {up['commit']}")
    tag_commit_res = subprocess.run(
        ["git", "-C", str(chosen), "rev-parse", "--verify", f"{tag}^{{commit}}"],
        capture_output=True,
        text=True,
        check=False,
    )
    if tag_commit_res.returncode == 0 and tag_commit_res.stdout.strip() != commit:
        raise RuntimeError(
            f"upstream `{name}` HEAD {commit} != tag `{tag}` commit {tag_commit_res.stdout.strip()}"
        )

    if vendor_symlink:
        sym_path = crate_dir / str(vendor_symlink)
        if not sym_path.exists():
            sym_path.parent.mkdir(parents=True, exist_ok=True)
            sym_path.symlink_to(chosen)

    return chosen, f"/upstream/{name}/{commit}"


def _compute_rust_obj2lean_remaps_and_host_dirs(
    target_dir: pathlib.Path,
    cargo_home: pathlib.Path,
    sysroot: pathlib.Path,
    rustc_commit: str,
    crate_dir: pathlib.Path,
    upstream: tuple[pathlib.Path, str] | None,
) -> tuple[list[str], list[str]]:
    remaps: list[tuple[str, str]] = []
    remaps.extend(_prefix_remaps("CARGO_HOME", cargo_home / "registry" / "src", "/cargo-registry"))
    remaps.extend(_prefix_remaps("cargo target-dir", target_dir, "/cargo-target"))
    remaps.extend(_prefix_remaps("CARGO_HOME", cargo_home / "git" / "checkouts", "/cargo-git"))
    remaps.extend(
        _prefix_remaps("rustc sysroot", sysroot / "lib" / "rustlib" / "src" / "rust", f"/rustc/{rustc_commit}")
    )
    if upstream is not None:
        up_src, up_to = upstream
        for d_s, flg in _prefix_remaps("upstream", up_src, up_to):
            if pathlib.Path(d_s).is_absolute():
                remaps.append((d_s, flg))

    remap_paths = [pathlib.Path(d_s) for d_s, _ in remaps]

    def _depth(item: tuple[str, str]) -> int:
        p = pathlib.Path(item[0])
        return sum(1 for other in remap_paths if other != p and p.is_relative_to(other))

    remaps.sort(key=_depth)

    host_dirs = [d_s for d_s, _ in remaps]
    extra_roots = [sysroot, crate_dir]
    if upstream is not None:
        extra_roots.append(upstream[0])
    for p in extra_roots:
        cands = ([p] if p.is_absolute() else []) + [_canonicalize_existing_prefix(p)]
        for q in cands:
            qs = str(q)
            if qs not in host_dirs:
                host_dirs.append(qs)
    return [flg for _, flg in remaps], host_dirs


def _check_no_host_paths(name: str, obj_bytes: bytes, host_dirs: Sequence[str]) -> None:
    for d in host_dirs:
        if d and d.encode("utf-8") in obj_bytes:
            raise RuntimeError(
                f"object `{name}` contains unremapped host path `{d}`"
            )


def _find_crate_in_cargo_packages(
    packages: Sequence[Mapping[str, Any]],
    spec: str,
    *,
    only_path_deps: bool,
) -> list[tuple[str, str]]:
    want = spec.replace("-", "_")
    matches: list[tuple[str, str]] = []
    for pkg in packages:
        if only_path_deps and pkg.get("source") is not None:
            continue
        lib_tgt = None
        for tgt in pkg.get("targets") or ():
            kinds = set(tgt.get("kind") or ())
            if "lib" in kinds or "rlib" in kinds:
                lib_tgt = tgt
                break
        if lib_tgt is None:
            continue
        pkg_name = str(pkg["name"])
        lib_name = str(lib_tgt["name"]).replace("-", "_")
        if pkg_name.replace("-", "_") == want or lib_name == want:
            matches.append((pkg_name, lib_name))
    return matches


def _resolve_cargo_crates_for_cfg(
    crate_dir: pathlib.Path,
    specs: Sequence[str],
    env: Mapping[str, str],
    *,
    meta_no_deps: Mapping[str, Any],
) -> list[tuple[str, str]]:
    full_meta: dict[str, Any] | None = None
    resolved: list[tuple[str, str]] = []
    for spec in specs:
        matches = _find_crate_in_cargo_packages(meta_no_deps.get("packages") or (), spec, only_path_deps=False)
        if not matches:
            if full_meta is None:
                res = subprocess.run(
                    ["cargo", "metadata", "--format-version", "1", "--locked"],
                    cwd=str(crate_dir),
                    capture_output=True,
                    text=True,
                    check=True,
                    env=dict(env),
                )
                full_meta = json.loads(res.stdout)
            matches = _find_crate_in_cargo_packages(full_meta.get("packages") or (), spec, only_path_deps=True)
            if not matches:
                matches = _find_crate_in_cargo_packages(full_meta.get("packages") or (), spec, only_path_deps=False)
        if len(matches) != 1:
            raise RuntimeError(
                f"crate `{spec}` resolved to {len(matches)} packages in {crate_dir}: {matches}"
            )
        resolved.append(matches[0])
    return resolved


def _compile_rust_crates_direct(
    *,
    repo_root: pathlib.Path,
    cfg_path: pathlib.Path,
    cfg: Mapping[str, Any],
    work_root: pathlib.Path,
    link_work: pathlib.Path,
    env: Mapping[str, str],
    obj_prefix: str = "lib0_",
) -> tuple[list[pathlib.Path], dict[str, str]]:
    """Compile `[crates]` from `translation.toml` directly via `cargo rustc --emit=obj` using the
    exact `rust-obj2lean` `RUSTFLAGS` & path-remap discipline (`CARGO_BUILD_JOBS=8`, fresh target dir)."""
    crate_specs = [str(x) for x in (cfg.get("crates") or ())]
    if not crate_specs:
        return [], {}

    crate_dir = (
        (cfg_path.parent / str(cfg["crate_dir"])).resolve()
        if cfg.get("crate_dir")
        else cfg_path.parent.resolve()
    )
    upstream = _resolve_upstream_for_cfg(repo_root, crate_dir, cfg, env)

    cargo_home_raw = env.get("CARGO_HOME")
    if cargo_home_raw:
        cargo_home = pathlib.Path(cargo_home_raw)
    elif env.get("HOME"):
        cargo_home = pathlib.Path(str(env["HOME"])) / ".cargo"
    else:
        raise RuntimeError("neither CARGO_HOME nor HOME is set")
    if not cargo_home.is_absolute():
        raise RuntimeError(f"CARGO_HOME `{cargo_home}` must be an absolute path")

    sysroot = pathlib.Path(
        subprocess.run(
            ["rustc", "--print", "sysroot"],
            cwd=str(crate_dir),
            capture_output=True,
            text=True,
            check=True,
            env=dict(env),
        ).stdout.strip()
    )
    rustc_vv = subprocess.run(
        ["rustc", "-vV"],
        cwd=str(crate_dir),
        capture_output=True,
        text=True,
        check=True,
        env=dict(env),
    ).stdout
    rustc_commit = ""
    for line in rustc_vv.splitlines():
        if line.strip().startswith("commit-hash:"):
            rustc_commit = line.split(":", 1)[1].strip()
            break
    if not HEX40_RE.match(rustc_commit):
        raise RuntimeError(f"failed to parse 40-hex commit-hash from `rustc -vV`: {rustc_commit!r}")

    cargo_target_dir = work_root / "cargo_target"
    cargo_target_dir.mkdir(parents=True, exist_ok=True)
    cargo_env = dict(env)
    cargo_env["CARGO_TARGET_DIR"] = str(cargo_target_dir)
    cargo_env["CARGO_BUILD_JOBS"] = "8"
    cargo_env.pop("CARGO_ENCODED_RUSTFLAGS", None)

    meta_res = subprocess.run(
        ["cargo", "metadata", "--format-version", "1", "--no-deps"],
        cwd=str(crate_dir),
        capture_output=True,
        text=True,
        check=True,
        env=cargo_env,
    )
    meta_no_deps = json.loads(meta_res.stdout)
    eff_target_dir = pathlib.Path(str(meta_no_deps["target_directory"]))

    remap_flags, host_dirs = _compute_rust_obj2lean_remaps_and_host_dirs(
        target_dir=eff_target_dir,
        cargo_home=cargo_home,
        sysroot=sysroot,
        rustc_commit=rustc_commit,
        crate_dir=crate_dir,
        upstream=upstream,
    )
    rustflags_tokens = [
        "-C",
        "codegen-units=1",
        "-C",
        "relocation-model=static",
        *DETERMINISTIC_RUSTC_CODEGEN_FLAGS,
        *remap_flags,
        *(str(f) for f in (cfg.get("rustflags") or ())),
    ]
    cargo_env["RUSTFLAGS"] = " ".join(rustflags_tokens)
    cargo_env["CARGO_PROFILE_RELEASE_CODEGEN_UNITS"] = "1"
    cargo_env["CARGO_PROFILE_RELEASE_PANIC"] = "abort"
    cargo_env["CARGO_PROFILE_RELEASE_LTO"] = "off"

    resolved_crates = _resolve_cargo_crates_for_cfg(
        crate_dir, crate_specs, cargo_env, meta_no_deps=meta_no_deps
    )
    target = str(cfg.get("target") or DEFAULT_RUST_TARGET_TRIPLE)
    link_work.mkdir(parents=True, exist_ok=True)

    lib_objs: list[pathlib.Path] = []
    crate_obj_shas: dict[str, str] = {}
    for idx, (pkg_name, lib_name) in enumerate(resolved_crates):
        emit_tmp = work_root / "emit_objs" / f"crate_{idx}"
        emit_tmp.mkdir(parents=True, exist_ok=True)
        obj_out = emit_tmp / f"{lib_name}.o"
        cmd = [
            "cargo",
            "rustc",
            "-p",
            pkg_name,
            "--release",
            "--locked",
            "--lib",
            "--target",
            target,
            "--message-format=json-render-diagnostics",
            "--",
            f"--emit=obj={obj_out}",
        ]
        subprocess.run(
            cmd,
            cwd=str(crate_dir),
            stdout=subprocess.DEVNULL,
            check=True,
            env=cargo_env,
        )
        emitted = sorted(emit_tmp.glob("*.o"))
        if len(emitted) != 1 or emitted[0] != obj_out:
            raise RuntimeError(
                f"`cargo rustc` for `{pkg_name}` produced {emitted}, expected [{obj_out}]"
            )
        obj_bytes = obj_out.read_bytes()
        _check_no_host_paths(lib_name, obj_bytes, host_dirs)
        dst_o = link_work / f"{obj_prefix}{idx}.o"
        dst_o.write_bytes(obj_bytes)
        lib_objs.append(dst_o)
        crate_obj_shas[dst_o.name] = _BASE.sha256_file(dst_o)
    return lib_objs, crate_obj_shas


def _rlib_crate_stem(path: pathlib.Path) -> str:
    stem = path.stem
    if stem.startswith("lib"):
        stem = stem[3:]
    return stem.rsplit("-", 1)[0] if "-" in stem else stem


def _root_section_closure_reloc(
    reloc_obj: Any,
    roots: Sequence[str],
    label: str,
) -> list[str]:
    """D4: Compute exact `STB_LOCAL` relocation reachability closure over `RelocObject` sections
    starting from `roots` (matching `rust-obj2lean` `root_section_closure`)."""
    if not roots:
        raise RuntimeError(f"empty `roots` for sysroot_objects entry `{label}`")
    keep_sec_idxs: set[int] = set()
    queue: list[int] = []
    for root in roots:
        hits = [
            s
            for s in reloc_obj.symbols
            if s.bind in (1, 2)
            and s.stype in (1, 2)
            and s.st_shndx not in (0, 0xFFF1, 0xFFF2)
            and 0 < s.st_shndx < len(reloc_obj.sections)
            and (s.name == root or s.demangled == root)
        ]
        if len(hits) != 1:
            raise RuntimeError(
                f"sysroot root `{root}` expected 1 defined symbol in {label}, found {len(hits)}"
            )
        sec_idx = int(hits[0].st_shndx)
        if sec_idx not in keep_sec_idxs:
            keep_sec_idxs.add(sec_idx)
            queue.append(sec_idx)

    while queue:
        sec_idx = queue.pop()
        sec = reloc_obj.sections[sec_idx]
        for rel in sec.relocs:
            if rel.r_type in (0, 256):  # R_AARCH64_NONE
                continue
            if 0 < rel.sym_idx < len(reloc_obj.symbols):
                tsym = reloc_obj.symbols[rel.sym_idx]
                if tsym.bind == 0 and 0 < tsym.st_shndx < len(reloc_obj.sections):
                    if tsym.st_shndx not in keep_sec_idxs:
                        keep_sec_idxs.add(tsym.st_shndx)
                        queue.append(tsym.st_shndx)

    return [str(reloc_obj.sections[idx].name) for idx in sorted(keep_sec_idxs)]




"""Reproducible stock-`ld.lld` CLI ELF builder & fail-closed verifier (`cli-elf-stock`).

Builds `signal-session-stock.elf` from pinned lock inputs + `stock.ld` using stock LLVM
`ld.lld` (no custom relocation stitcher), enforces structural, symbol, relocation, stub-byte,
layout, argv, and environment invariants (`GK-165` `F1`–`F9` + runtime-archive SHA, env-scrub,
and `--verify-pin` checks), and writes cv provenance to `cv-stock-link.json` without ever
overwriting engine `stock-link.json`.

Note: Python checks here are defense-in-depth build/preflight guards only; they never
replace in-Lean kernel checks or CI gates.
"""

from __future__ import annotations

import argparse
import hashlib
import importlib.machinery
import importlib.util
import json
import os
import pathlib
import re
import shutil
import struct
import subprocess
import sys
import tempfile
import tomllib
from typing import Any, Mapping, Sequence

SCRIPT_DIR = pathlib.Path(__file__).resolve().parent
if str(SCRIPT_DIR) not in sys.path:
    sys.path.insert(0, str(SCRIPT_DIR))

from stock_elf_prep import alpha_checks, elf_loader  # noqa: E402


def _load_cli_elf_base() -> Any:
    base_path = SCRIPT_DIR / "cli-elf"
    loader = importlib.machinery.SourceFileLoader("cli_elf_base", str(base_path))
    spec = importlib.util.spec_from_loader("cli_elf_base", loader)
    if spec is None or spec.loader is None:
        raise RuntimeError(f"unable to load {base_path}")
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod


_BASE = _load_cli_elf_base()


def _load_elf_inspect() -> Any:
    candidates = [SCRIPT_DIR / "stock-pin" / "elf_inspect.py"]
    for entry in sys.path:
        if entry:
            candidates.append(pathlib.Path(entry) / "stock-pin" / "elf_inspect.py")
    insp_path = next((p for p in candidates if p.is_file()), candidates[0])
    loader = importlib.machinery.SourceFileLoader("elf_inspect", str(insp_path))
    spec = importlib.util.spec_from_loader("elf_inspect", loader)
    if spec is None or spec.loader is None:
        raise RuntimeError(f"unable to load {insp_path}")
    mod = importlib.util.module_from_spec(spec)
    sys.modules["elf_inspect"] = mod
    loader.exec_module(mod)
    return mod


_ELF_INSPECT = _load_elf_inspect()


def _load_alink_check() -> Any:
    candidates = [SCRIPT_DIR / "stock-pin" / "alink_check.py"]
    for entry in sys.path:
        if entry:
            candidates.append(pathlib.Path(entry) / "stock-pin" / "alink_check.py")
    chk_path = next((p for p in candidates if p.is_file()), candidates[0])
    if not chk_path.is_file():
        raise RuntimeError(f"missing A-LINK checker at {chk_path}")
    chk_dir = str(chk_path.parent)
    if chk_dir not in sys.path:
        sys.path.insert(0, chk_dir)
    loader = importlib.machinery.SourceFileLoader("alink_check_mod", str(chk_path))
    spec = importlib.util.spec_from_loader("alink_check_mod", loader)
    if spec is None or spec.loader is None:
        raise RuntimeError(f"unable to load {chk_path}")
    mod = importlib.util.module_from_spec(spec)
    sys.modules["alink_check_mod"] = mod
    loader.exec_module(mod)
    return mod


def _run_alink_check_with_lock(
    *,
    out_dir: pathlib.Path,
    repo_root: pathlib.Path,
    alink_lock_path: pathlib.Path,
    work_dir: pathlib.Path | None = None,
    elf_path: pathlib.Path | None = None,
    map_path: pathlib.Path | None = None,
    stock_lock_path: pathlib.Path | None = None,
    stock_lock: Mapping[str, Any] | None = None,
    ci_mode: bool = False,
) -> int:
    alink_mod = _load_alink_check()
    resolved_lock = alink_lock_path.resolve()
    if not resolved_lock.is_file():
        raise RuntimeError(f"A-LINK `--lock` file not found: {resolved_lock}")
    eff_work = work_dir
    if eff_work is None:
        if (out_dir / "work").is_dir():
            eff_work = out_dir / "work"
        elif (out_dir.parent / "stock_stage" / "work").is_dir():
            eff_work = out_dir.parent / "stock_stage" / "work"
    argv_chk = [
        "--out-dir",
        str(out_dir.resolve()),
        "--repo-root",
        str(repo_root.resolve()),
        "--lock",
        str(resolved_lock),
    ]
    if eff_work is not None:
        argv_chk.extend(["--work-dir", str(eff_work.resolve())])
    if elf_path is not None:
        argv_chk.extend(["--elf", str(elf_path.resolve())])
    if map_path is not None:
        argv_chk.extend(["--map", str(map_path.resolve())])
    has_m4_pin = bool(stock_lock and stock_lock.get("m4_lock_sha256"))
    if stock_lock_path is not None and (ci_mode or has_m4_pin):
        argv_chk.extend(["--inputs-lock", str(stock_lock_path.resolve())])
    if ci_mode:
        argv_chk.append("--ci")
    rc = int(alink_mod.main(argv_chk))
    if rc != 0:
        raise RuntimeError(f"alink_check failed (rc={rc}) with --lock {resolved_lock}")
    return rc


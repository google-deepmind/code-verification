def _strip_lean_comments_preserving_strings(src: str) -> str:
    """Strip Lean `--` line comments and nested `/- ... -/` block comments while preserving `"..."` literals."""
    out: list[str] = []
    i = 0
    n = len(src)
    in_str = False
    block_depth = 0
    while i < n:
        ch = src[i]
        if block_depth > 0:
            if src.startswith("/-", i):
                block_depth += 1
                out.append("  ")
                i += 2
                continue
            if src.startswith("-/", i):
                block_depth -= 1
                out.append("  ")
                i += 2
                continue
            out.append("\n" if ch == "\n" else " ")
            i += 1
            continue
        if in_str:
            out.append(ch)
            if ch == "\\" and i + 1 < n:
                out.append(src[i + 1])
                i += 2
                continue
            if ch == '"':
                in_str = False
            i += 1
            continue
        if src.startswith("/-", i):
            block_depth = 1
            out.append("  ")
            i += 2
            continue
        if src.startswith("--", i):
            while i < n and src[i] != "\n":
                i += 1
            continue
        if ch == '"':
            in_str = True
        out.append(ch)
        i += 1
    if block_depth != 0:
        raise RuntimeError("unterminated `/- ... -/` block comment in Lean source")
    if in_str:
        raise RuntimeError("unterminated string literal in Lean source")
    return "".join(out)


def _split_top_level_lean_sep(expr: str, sep: str) -> list[str]:
    """Split `expr` on `sep` at delimiter depth 0 (`()`, `[]`, `{}`, `⟨⟩`), respecting `"..."` strings."""
    parts: list[str] = []
    cur: list[str] = []
    depth = 0
    in_str = False
    i = 0
    n = len(expr)
    sep_len = len(sep)
    while i < n:
        ch = expr[i]
        if in_str:
            cur.append(ch)
            if ch == "\\" and i + 1 < n:
                cur.append(expr[i + 1])
                i += 2
                continue
            if ch == '"':
                in_str = False
            i += 1
            continue
        if ch == '"':
            in_str = True
            cur.append(ch)
            i += 1
            continue
        if ch in "([{⟨":
            depth += 1
            cur.append(ch)
            i += 1
            continue
        if ch in ")]}⟩":
            if depth <= 0:
                raise RuntimeError(f"unbalanced closing delimiter `{ch}` in Lean expression {expr!r}")
            depth -= 1
            cur.append(ch)
            i += 1
            continue
        if depth == 0 and expr.startswith(sep, i):
            parts.append("".join(cur))
            cur = []
            i += sep_len
            continue
        cur.append(ch)
        i += 1
    if depth != 0 or in_str:
        raise RuntimeError(f"unbalanced delimiters in Lean expression {expr!r}")
    parts.append("".join(cur))
    return parts


def _eval_lean_string_atom(atom: str, str_defs: Mapping[str, str], *, label: str) -> str:
    s = atom.strip()
    while s.startswith("(") and s.endswith(")"):
        inner = s[1:-1].strip()
        try:
            parts = _split_top_level_lean_sep(inner, ",")
        except RuntimeError:
            break
        if len(parts) == 1 and inner == parts[0].strip():
            s = inner
        else:
            break
    if len(s) >= 2 and s[0] == '"' and s[-1] == '"':
        out_chars: list[str] = []
        i = 1
        end = len(s) - 1
        while i < end:
            ch = s[i]
            if ch == "\\":
                if i + 1 >= end:
                    raise RuntimeError(f"{label}: dangling backslash in string literal {s!r}")
                nxt = s[i + 1]
                esc_map = {'"': '"', "\\": "\\", "n": "\n", "t": "\t", "r": "\r"}
                if nxt not in esc_map:
                    raise RuntimeError(f"{label}: unsupported escape `\\{nxt}` in {s!r}")
                out_chars.append(esc_map[nxt])
                i += 2
                continue
            if ch == '"':
                raise RuntimeError(f"{label}: unexpected quote inside string atom {s!r}")
            out_chars.append(ch)
            i += 1
        val = "".join(out_chars)
        if not val:
            raise RuntimeError(f"{label}: empty symbol string literal in Lean table")
        return val
    if re.fullmatch(r"[A-Za-z_][A-Za-z0-9_'.]*", s):
        if s not in str_defs:
            raise RuntimeError(f"{label}: unknown Lean String identifier `{s}`")
        return str_defs[s]
    raise RuntimeError(f"{label}: unsupported Lean String expression `{s}`")


def parse_cli_binary_pq_text(
    text: str, *, source_label: str = "CliBinaryPq.lean"
) -> dict[str, list[str]]:
    """D-C2d: Count-agnostic, fail-closed parser for `cliHookTablePlaced`, `cliDehookedSymsPlaced`,
    and `cliPanicSymbolsPlaced` from `CliBinaryPq.lean` (resolving `abbrev`/`def : String`, string
    literals, and `++` list concatenations without hard-coded row counts)."""
    cleaned = _strip_lean_comments_preserving_strings(text)
    top_re = re.compile(
        r"(?m)^(?:@[^\n]+\n)*(?:noncomputable\s+|private\s+|protected\s+)*"
        r"(abbrev|def|theorem|lemma|namespace|end|section|open|set_option|structure|inductive)\b"
    )
    matches = list(top_re.finditer(cleaned))
    decls: list[tuple[str, str, str]] = []
    for idx, m in enumerate(matches):
        kw = m.group(1)
        if kw not in ("abbrev", "def"):
            continue
        end_pos = matches[idx + 1].start() if idx + 1 < len(matches) else len(cleaned)
        chunk = cleaned[m.end() : end_pos].strip()
        nm_m = re.match(r"^([A-Za-z_][A-Za-z0-9_']*)\b(.*)$", chunk, flags=re.DOTALL)
        if nm_m is None:
            continue
        decl_name = nm_m.group(1)
        rest = nm_m.group(2)
        assign_parts = _split_top_level_lean_sep(rest, ":=")
        if len(assign_parts) < 2:
            continue
        lhs_sig = assign_parts[0].strip()
        rhs_body = ":=".join(assign_parts[1:]).strip()
        decls.append((decl_name, lhs_sig, rhs_body))

    str_defs: dict[str, str] = {}
    for decl_name, lhs_sig, rhs_body in decls:
        sig_parts = _split_top_level_lean_sep(lhs_sig, ":")
        if len(sig_parts) >= 2 and re.sub(r"\s+", " ", sig_parts[-1]).strip() == "String":
            str_defs[decl_name] = _eval_lean_string_atom(
                rhs_body, str_defs, label=f"{source_label}:{decl_name}"
            )

    str_lists: dict[str, list[str]] = {}
    pair_key_lists: dict[str, list[str]] = {}
    target_str_list_names = {"cliDehookedSymsPlaced", "cliPanicSymbolsPlaced"}
    target_pair_list_names = {"cliHookTablePlaced"}

    for decl_name, lhs_sig, rhs_body in decls:
        sig_parts = _split_top_level_lean_sep(lhs_sig, ":")
        ret_ty = re.sub(r"\s+", " ", sig_parts[-1]).strip() if len(sig_parts) >= 2 else ""
        is_str_list = ret_ty == "List String" or decl_name in target_str_list_names
        is_pair_list = (
            ret_ty.startswith("List (String ×")
            or ret_ty.startswith("List (Prod String")
            or decl_name in target_pair_list_names
        )
        if not (is_str_list or is_pair_list):
            continue
        try:
            summands = _split_top_level_lean_sep(rhs_body, "++")
            acc: list[str] = []
            for raw_sum in summands:
                s_sum = raw_sum.strip()
                if not s_sum:
                    raise RuntimeError(f"{source_label}:{decl_name}: empty `++` summand")
                if s_sum.startswith("[") and s_sum.endswith("]"):
                    inner = s_sum[1:-1].strip()
                    if not inner:
                        continue
                    elems = [e.strip() for e in _split_top_level_lean_sep(inner, ",") if e.strip()]
                    if is_str_list:
                        for el in elems:
                            acc.append(
                                _eval_lean_string_atom(
                                    el, str_defs, label=f"{source_label}:{decl_name}"
                                )
                            )
                    else:
                        for el in elems:
                            if not (el.startswith("(") and el.endswith(")")):
                                raise RuntimeError(
                                    f"{source_label}:{decl_name}: expected `(sym, hook)` pair, got {el!r}"
                                )
                            pair_elems = _split_top_level_lean_sep(el[1:-1], ",")
                            if len(pair_elems) < 2:
                                raise RuntimeError(
                                    f"{source_label}:{decl_name}: malformed pair {el!r}"
                                )
                            acc.append(
                                _eval_lean_string_atom(
                                    pair_elems[0],
                                    str_defs,
                                    label=f"{source_label}:{decl_name}",
                                )
                            )
                else:
                    call_tok = s_sum.split()[0]
                    table_ref = str_lists if is_str_list else pair_key_lists
                    if call_tok not in table_ref:
                        raise RuntimeError(
                            f"{source_label}:{decl_name}: unknown helper list `{call_tok}` in `{s_sum}`"
                        )
                    acc.extend(table_ref[call_tok])
            if is_str_list:
                str_lists[decl_name] = acc
            else:
                pair_key_lists[decl_name] = acc
        except RuntimeError:
            if decl_name in (target_str_list_names | target_pair_list_names):
                raise
            continue

    missing_tables = [
        nm
        for nm, tbl in (
            ("cliHookTablePlaced", pair_key_lists),
            ("cliDehookedSymsPlaced", str_lists),
            ("cliPanicSymbolsPlaced", str_lists),
        )
        if nm not in tbl
    ]
    if missing_tables:
        raise RuntimeError(
            f"{source_label}: missing required Lean symbol declaration(s): {missing_tables}"
        )

    hook_keys = list(pair_key_lists["cliHookTablePlaced"])
    dehooked_syms = list(str_lists["cliDehookedSymsPlaced"])
    panic_syms = list(str_lists["cliPanicSymbolsPlaced"])
    if not hook_keys:
        raise RuntimeError(f"{source_label}: `cliHookTablePlaced` parsed to 0 rows")
    if not panic_syms:
        raise RuntimeError(f"{source_label}: `cliPanicSymbolsPlaced` parsed to 0 entries")

    for tbl_name, vals in (
        ("cliHookTablePlaced", hook_keys),
        ("cliDehookedSymsPlaced", dehooked_syms),
        ("cliPanicSymbolsPlaced", panic_syms),
    ):
        if len(set(vals)) != len(vals):
            seen_s: set[str] = set()
            dups = sorted({v for v in vals if v in seen_s or seen_s.add(v)})  # type: ignore[func-returns-value]
            raise RuntimeError(f"{source_label}: duplicate symbol(s) in `{tbl_name}`: {dups}")

    overlap_hd = sorted(set(hook_keys) & set(dehooked_syms))
    if overlap_hd:
        raise RuntimeError(
            f"{source_label}: symbol(s) in both `cliHookTablePlaced` and `cliDehookedSymsPlaced`: {overlap_hd}"
        )
    overlap_hp = sorted(set(hook_keys) & set(panic_syms))
    if overlap_hp:
        raise RuntimeError(
            f"{source_label}: symbol(s) in both `cliHookTablePlaced` and `cliPanicSymbolsPlaced`: {overlap_hp}"
        )
    overlap_dp = sorted(set(dehooked_syms) & set(panic_syms))
    if overlap_dp:
        raise RuntimeError(
            f"{source_label}: symbol(s) in both `cliDehookedSymsPlaced` and `cliPanicSymbolsPlaced`: {overlap_dp}"
        )

    return {
        "cliHookTablePlaced": hook_keys,
        "cliDehookedSymsPlaced": dehooked_syms,
        "cliPanicSymbolsPlaced": panic_syms,
    }


def load_cli_binary_pq_tables(
    repo_root: pathlib.Path,
    *,
    rel_path: pathlib.Path = DEFAULT_REL_CLI_BINARY_PQ,
    fallback_repo_root: pathlib.Path | None = None,
) -> dict[str, list[str]]:
    cand = repo_root / rel_path
    if not cand.is_file() and fallback_repo_root is not None:
        fb = fallback_repo_root / rel_path
        if fb.is_file():
            cand = fb
    if not cand.is_file():
        raise RuntimeError(f"missing `CliBinaryPq.lean` at {cand}")
    return parse_cli_binary_pq_text(
        cand.read_text(encoding="utf-8"), source_label=str(cand)
    )


def _parse_c2_row_tokens(raw: str | Sequence[str] | None) -> list[str] | None:
    if raw is None:
        return None
    if isinstance(raw, str):
        s = raw.strip()
        if not s or s.lower() == "none":
            return []
        if s.lower() == "all":
            return ["all"]
        return [tok.strip() for tok in s.split(",") if tok.strip()]
    items = [str(x).strip() for x in raw if str(x).strip()]
    if len(items) == 1 and items[0].lower() == "none":
        return []
    return items


def _resolve_c2_row_selection(
    *,
    lib2_cfg: Mapping[str, Any] | None,
    lock: Mapping[str, Any],
    lib2_rows_spec: str | None = None,
    c2_libc_rows_spec: str | None = None,
) -> tuple[tuple[str, ...], tuple[str, ...], tuple[str, ...]]:
    """Resolve `(active_lib2_row_names, active_lib2_roots, moved_libc_rows)` fail-closed in canonical
    order (`SystemTime::add` strictly LAST among `lib2` roots; `memmove -> memcmp -> bcmp -> strlen`
    for `2C` libc rows, with `bcmp` and `memcmp` coupled so their 56-byte hull never splits)."""
    raw_lib2 = (
        _parse_c2_row_tokens(lib2_rows_spec)
        if lib2_rows_spec is not None
        else _parse_c2_row_tokens(lock.get("lib2_rows"))
    )
    if not raw_lib2:
        active_lib2_names: tuple[str, ...] = ()
        active_lib2_roots: tuple[str, ...] = ()
    else:
        if lib2_cfg is None:
            raise RuntimeError("`lib2` row selection requires `cli/rt/translation.toml`")
        rows_tbl = lib2_cfg.get("lib2_rows")
        placed_exps = [str(x) for x in (lib2_cfg.get("placed", {}).get("exports") or ())]
        if not isinstance(rows_tbl, Mapping) or not rows_tbl or not placed_exps:
            raise RuntimeError("`cli/rt/translation.toml` missing `[lib2_rows]` or `[placed].exports`")
        if placed_exps[-1] != C2_LIB2_TIME_ADD_SYM:
            raise RuntimeError(
                f"`cli/rt/translation.toml` `[placed].exports` must place `SystemTime::add` LAST, "
                f"got {placed_exps[-1]!r}"
            )
        root_to_row: dict[str, str] = {}
        row_to_root: dict[str, str] = {}
        for rname, rinfo in rows_tbl.items():
            if not isinstance(rinfo, Mapping) or not rinfo.get("root"):
                raise RuntimeError(f"`[lib2_rows.{rname}]` missing `root`")
            rsym = str(rinfo["root"])
            row_to_root[str(rname)] = rsym
            root_to_row[rsym] = str(rname)
        canonical_pairs: list[tuple[str, str]] = []
        for exp_sym in placed_exps:
            if exp_sym not in root_to_row:
                raise RuntimeError(
                    f"`cli/rt/translation.toml` export `{exp_sym}` missing `[lib2_rows.*]` entry"
                )
            canonical_pairs.append((root_to_row[exp_sym], exp_sym))
        if raw_lib2 == ["all"]:
            chosen_names_set = {nm for nm, _ in canonical_pairs}
        else:
            chosen_names_set = set()
            for tok in raw_lib2:
                resolved_nm = (
                    tok if tok in row_to_root else root_to_row.get(tok)
                )
                if resolved_nm is None:
                    raise RuntimeError(
                        f"unknown `lib2` row `{tok}` (known rows: {[nm for nm, _ in canonical_pairs]})"
                    )
                if resolved_nm in chosen_names_set:
                    raise RuntimeError(f"duplicate `lib2` row `{resolved_nm}`")
                chosen_names_set.add(resolved_nm)
        ordered_active = [(nm, rsym) for nm, rsym in canonical_pairs if nm in chosen_names_set]
        active_lib2_names = tuple(nm for nm, _ in ordered_active)
        active_lib2_roots = tuple(rsym for _, rsym in ordered_active)

    if c2_libc_rows_spec is not None:
        raw_libc = _parse_c2_row_tokens(c2_libc_rows_spec)
    elif "c2_moved_libc_rows" in lock:
        raw_libc = _parse_c2_row_tokens(lock.get("c2_moved_libc_rows"))
    elif active_lib2_names:
        raw_libc = ["all"]
    else:
        raw_libc = []

    if not raw_libc:
        moved_libc_rows: tuple[str, ...] = ()
    elif raw_libc == ["all"]:
        moved_libc_rows = C2_LIBC_CANONICAL_ORDER
    else:
        chosen_libc: set[str] = set()
        for tok in raw_libc:
            if tok not in C2_LIBC_CANONICAL_ORDER:
                raise RuntimeError(
                    f"unknown C2 libc row `{tok}` (expected subset of {list(C2_LIBC_CANONICAL_ORDER)})"
                )
            if tok in chosen_libc:
                raise RuntimeError(f"duplicate C2 libc row `{tok}`")
            chosen_libc.add(tok)
        if ("bcmp" in chosen_libc) != ("memcmp" in chosen_libc):
            raise RuntimeError(
                "`bcmp` and `memcmp` must move or stay together under C2 `2C` "
                "(preserving `bcmp`'s 4-byte `b memcmp` and the 56-byte `memcmp + bcmp` hull)"
            )
        moved_libc_rows = tuple(r for r in C2_LIBC_CANONICAL_ORDER if r in chosen_libc)

    return active_lib2_names, active_lib2_roots, moved_libc_rows


def _render_c2_stock_ld(
    base_stock_ld_text: str, moved_libc_rows: Sequence[str]
) -> str:
    """Render the C2 `D-C2f = 2C` linker script from `cli-elf/stock.ld` by moving `moved_libc_rows`
    (`memmove -> memcmp -> bcmp -> strlen`) out of `.text.crate` (`:text_a`) to the tail of
    `.text.b_pre` (`:text_b`, `< e_entry`) right after `*memset.lo(.text .text.*)`."""
    _, _, moved_tup = _resolve_c2_row_selection(
        lib2_cfg=None,
        lock={},
        lib2_rows_spec="none",
        c2_libc_rows_spec=",".join(moved_libc_rows) if moved_libc_rows else "none",
    )
    if not moved_tup:
        return base_stock_ld_text

    moved_set = set(moved_tup)
    crate_anchor = (
        "    *extern_stubs_clean.o(.text .text.*)\n"
        "    KEEP(*extern_stubs_clean.o(.text.__retired_*))\n"
        "    memmove.o(.text .text.*)\n"
        "    */memmove.o(.text .text.*)\n"
        "    *libc.a:memmove.lo(.text .text.*)\n"
        "    memcmp.o(.text .text.*)\n"
        "    */memcmp.o(.text .text.*)\n"
        "    *libc.a:memcmp.lo(.text .text.*)\n"
        "    bcmp.o(.text .text.*)\n"
        "    */bcmp.o(.text .text.*)\n"
        "    *libc.a:bcmp.lo(.text .text.*)\n"
        "    *(EXCLUDE_FILE(*lib2_*.o) .text.strlen EXCLUDE_FILE(*lib2_*.o) .text.compiler_rt.*)\n"
    )
    if crate_anchor not in base_stock_ld_text:
        raise RuntimeError("`stock.ld` missing expected `.text.crate` libc string block anchor")

    b_pre_anchor = (
        "    memset.o(.text .text.*)\n"
        "    */memset.o(.text .text.*)\n"
        "    *libc.a:memset.lo(.text .text.*)\n"
        "    *memset.lo(.text .text.*)\n"
        "  } :text_b =0"
    )
    if b_pre_anchor not in base_stock_ld_text:
        raise RuntimeError("`stock.ld` missing expected `.text.b_pre` `memset.lo` tail anchor")

    crate_lines = [
        "    *extern_stubs_clean.o(.text .text.*)",
        "    KEEP(*extern_stubs_clean.o(.text.__retired_*))",
    ]
    for r in ("memmove", "memcmp", "bcmp"):
        if r not in moved_set:
            crate_lines.extend([
                f"    {r}.o(.text .text.*)",
                f"    */{r}.o(.text .text.*)",
                f"    *libc.a:{r}.lo(.text .text.*)",
            ])
    if "strlen" in moved_set:
        crate_lines.append("    *(EXCLUDE_FILE(*lib2_*.o) .text.compiler_rt.*)")
    else:
        crate_lines.append(
            "    *(EXCLUDE_FILE(*lib2_*.o) .text.strlen EXCLUDE_FILE(*lib2_*.o) .text.compiler_rt.*)"
        )

    b_pre_lines = [
        "    memset.o(.text .text.*)",
        "    */memset.o(.text .text.*)",
        "    *libc.a:memset.lo(.text .text.*)",
        "    *memset.lo(.text .text.*)",
    ]
    for r in moved_tup:
        b_pre_lines.extend([
            f"    {r}.o(.text .text.*)",
            f"    */{r}.o(.text .text.*)",
            f"    *libc.a:{r}.lo(.text .text.*)",
            f"    *{r}.lo(.text .text.*)",
        ])
        if r == "strlen":
            b_pre_lines.append("    *(EXCLUDE_FILE(*lib2_*.o) .text.strlen)")
    b_pre_lines.append("  } :text_b =0")

    rendered = base_stock_ld_text.replace(crate_anchor, "\n".join(crate_lines) + "\n", 1)
    rendered = rendered.replace(b_pre_anchor, "\n".join(b_pre_lines), 1)

    if moved_tup == C2_LIBC_CANONICAL_ORDER:
        hdr_orig = (
            "/* Deterministic stock `ld.lld` linker script v2 for `libsignal-cli` (`StdBin` 2-config + `--no-relax`).\n"
        )
        hdr_c2 = (
            "/* Deterministic stock `ld.lld` linker script v2 (C2 `D-C2f = 2C` variant) for `libsignal-cli`.\n"
            " *\n"
            " * Identical to `cli-elf/stock.ld` except that the 4 de-hooked `libc.a` string primitives\n"
            " * (`memmove.lo` -> `memcmp.lo` -> `bcmp.lo` -> `strlen.lo`) are placed at the tail of `.text.b_pre`\n"
            " * (`:text_b`, `< e_entry`) immediately after `memset.lo` instead of `.text.crate` (`:text_a`),\n"
            " * preserving `bcmp`'s `b memcmp` branch word and the 56-byte `memcmp + bcmp` hull.\n"
            " * Generated deterministically from `cli-elf/stock.ld` by `_render_c2_stock_ld`.\n"
        )
        c_crate_orig = (
            " *        `KEEP(.text.__retired_*)` retired stub slots), hooked musl string primitives\n"
            " *        (`memmove.lo`, `memcmp.lo`, `bcmp.lo`, `strlen.lo` when still hooked; moved to the\n"
            " *        `.text.b_pre` tail after `memset.lo` in `stock/stock_c2.ld` under C2 `D-C2f = 2C`), and\n"
            " *        `.text.compiler_rt.*`;\n"
        )
        c_crate_c2 = (
            " *        `KEEP(.text.__retired_*)` retired stub slots), and `.text.compiler_rt.*`;\n"
        )
        c_bpre_orig = (
            " *          `memcpy.lo` / `memset.lo` (followed at C2 `2C` by `memmove.lo` -> `memcmp.lo` ->\n"
            " *          `bcmp.lo` -> `strlen.lo`, `< e_entry`);\n"
        )
        c_bpre_c2 = (
            " *          `memcpy.lo` / `memset.lo` followed by `memmove.lo` -> `memcmp.lo` -> `bcmp.lo` -> `strlen.lo`\n"
            " *          (`< e_entry`);\n"
        )
        if hdr_orig in rendered:
            rendered = rendered.replace(hdr_orig, hdr_c2, 1)
        if c_crate_orig in rendered:
            rendered = rendered.replace(c_crate_orig, c_crate_c2, 1)
        if c_bpre_orig in rendered:
            rendered = rendered.replace(c_bpre_orig, c_bpre_c2, 1)

    return rendered


def _retire_stub_slots_in_object(
    stubs_obj_path: pathlib.Path,
    active_lib2_roots: Sequence[str],
    env: Mapping[str, str],
) -> list[dict[str, Any]]:
    """Retire each active `lib2` root's 4-byte `udf #0` slot in `extern_stubs_clean.o` in-place via
    two-pass `llvm-objcopy` (`--rename-section` + `--redefine-sym` first, `--localize-symbol` second)
    so `.text.__retired_<i>` (`sh_flags == 0x6`, no `SHF_GNU_RETAIN`) stays at its exact original
    section index while becoming `STB_LOCAL` (invisible to global resolution in `ld.lld`)."""
    if not active_lib2_roots:
        return []
    pre_obj = _ELF_INSPECT.parse_reloc_obj(stubs_obj_path.read_bytes(), stubs_obj_path.name)
    sec_by_name = {sec.name: sec for sec in pre_obj.sections}
    global_fn_by_name = {
        s.name: s
        for s in pre_obj.symbols
        if s.bind == 1 and s.stype == 2 and 0 < s.st_shndx < len(pre_obj.sections)
    }
    pass1_args: list[str] = []
    pass2_args: list[str] = []
    retired_records: list[dict[str, Any]] = []
    for idx, root_sym in enumerate(active_lib2_roots):
        orig_sec_name = f".text.{root_sym}"
        ret_sym = f"__retired_{idx}"
        ret_sec = f".text.{ret_sym}"
        if orig_sec_name not in sec_by_name or root_sym not in global_fn_by_name:
            raise RuntimeError(
                f"cannot retire stub `{root_sym}` in {stubs_obj_path.name}: "
                f"missing global STT_FUNC / `{orig_sec_name}`"
            )
        orig_sec = sec_by_name[orig_sec_name]
        if orig_sec.sh_size != 4 or orig_sec.data != b"\x00\x00\x00\x00":
            raise RuntimeError(
                f"stub section `{orig_sec_name}` expected 4 zero bytes, got size={orig_sec.sh_size}"
            )
        pass1_args.extend([
            "--rename-section",
            f"{orig_sec_name}={ret_sec}",
            "--redefine-sym",
            f"{root_sym}={ret_sym}",
        ])
        pass2_args.append(f"--localize-symbol={ret_sym}")
        retired_records.append({
            "index": idx,
            "symbol": root_sym,
            "originalSymbol": root_sym,
            "retiredSymbol": ret_sym,
            "retiredSection": ret_sec,
            "size": 4,
            "objectSectionIndex": int(orig_sec.idx),
        })

    objcopy_bin = str(env["LLVM_OBJCOPY"])
    tmp_pass1 = stubs_obj_path.with_name(f".{stubs_obj_path.name}.retire1.tmp")
    tmp_pass2 = stubs_obj_path.with_name(f".{stubs_obj_path.name}.retire2.tmp")
    subprocess.run(
        [objcopy_bin, *pass1_args, str(stubs_obj_path), str(tmp_pass1)],
        check=True,
        env=dict(env),
    )
    subprocess.run(
        [objcopy_bin, *pass2_args, str(tmp_pass1), str(tmp_pass2)],
        check=True,
        env=dict(env),
    )
    tmp_pass1.unlink(missing_ok=True)
    tmp_pass2.replace(stubs_obj_path)

    post_obj = _ELF_INSPECT.parse_reloc_obj(stubs_obj_path.read_bytes(), stubs_obj_path.name)
    active_set = set(active_lib2_roots)
    leaked = sorted(s.name for s in post_obj.symbols if s.name in active_set)
    if leaked:
        raise RuntimeError(
            f"retired stub symbol(s) remained in {stubs_obj_path.name} after llvm-objcopy: {leaked}"
        )
    post_secs = {sec.name: sec for sec in post_obj.sections}
    for rec in retired_records:
        ret_sym = str(rec["retiredSymbol"])
        ret_sec = str(rec["retiredSection"])
        if ret_sec not in post_secs:
            raise RuntimeError(f"missing `{ret_sec}` in {stubs_obj_path.name} after llvm-objcopy")
        psec = post_secs[ret_sec]
        if psec.sh_flags != 0x6 or psec.sh_size != 4 or psec.data != b"\x00\x00\x00\x00":
            raise RuntimeError(
                f"retired stub section `{ret_sec}` invalid flags/size/bytes: "
                f"flags={psec.sh_flags:#x}, size={psec.sh_size}"
            )
        hits = [
            s
            for s in post_obj.symbols
            if s.name == ret_sym and s.st_shndx == psec.idx and s.stype == 2
        ]
        if len(hits) != 1 or hits[0].bind != 0 or hits[0].st_size != 4:
            raise RuntimeError(
                f"retired stub `{ret_sym}` must be unique STB_LOCAL STT_FUNC size 4, got {hits}"
            )
    return retired_records


def _verify_dehooked_placed_symbols(
    *,
    img: Any,
    sections: Sequence[Any],
    raw_syms: Sequence[Any],
    dehooked_syms: Sequence[str],
    allowed_sec_names: frozenset[str],
    label: str,
) -> None:
    """D-C2d positive verifier: every `sym` in `cliDehookedSymsPlaced` resolves to a unique defined
    `STT_FUNC` in `.symtab` inside `allowed_sec_names` with RX non-`0x00000000` instruction bytes."""
    if not dehooked_syms:
        return
    fn_by_name: dict[str, list[Any]] = {}
    for s in raw_syms[1:]:
        if s.st_shndx != 0 and s.stype == 2 and s.name:
            fn_by_name.setdefault(s.name, []).append(s)
    for sym in dehooked_syms:
        hits = fn_by_name.get(str(sym), [])
        if len(hits) != 1:
            raise RuntimeError(
                f"{label}: de-hooked symbol `{sym}` (`cliDehookedSymsPlaced`) expected 1 defined "
                f"STT_FUNC in .symtab, found {len(hits)}"
            )
        dsym = hits[0]
        if dsym.st_shndx <= 0 or dsym.st_shndx >= len(sections):
            raise RuntimeError(
                f"{label}: de-hooked symbol `{sym}` has invalid shndx={dsym.st_shndx}"
            )
        sec_nm = str(sections[dsym.st_shndx].name)
        if sec_nm not in allowed_sec_names:
            raise RuntimeError(
                f"{label}: de-hooked symbol `{sym}` at {dsym.st_value:#x} sits in disallowed "
                f"section `{sec_nm}` (allowed={sorted(allowed_sec_names)})"
            )
        if dsym.st_size < 4:
            raise RuntimeError(
                f"{label}: de-hooked symbol `{sym}` at {dsym.st_value:#x} has st_size={dsym.st_size} < 4"
            )
        got = img.read_bytes(dsym.st_value, 4)
        if got is None or got[1] != elf_loader.PERM_RX:
            raise RuntimeError(
                f"{label}: de-hooked symbol `{sym}` at {dsym.st_value:#x} is not mapped in RX segment"
            )
        if got[0] == b"\x00\x00\x00\x00":
            raise RuntimeError(
                f"{label}: de-hooked symbol `{sym}` at {dsym.st_value:#x} resolved to `udf #0` (`00000000`)"
            )


def _verify_c2_mechanical_invariants(
    *,
    elf_bytes: bytes,
    norm_map_text: str,
    active_lib2_roots: Sequence[str],
    moved_libc_rows: Sequence[str],
    retired_slots: Sequence[Mapping[str, Any]],
) -> None:
    """Enforce C2 mechanical invariants (`F9`, `0` thunks/veneers, `0` RW bytes from `lib2_*.o`,
    `retired_stub_slots` `.text.crate` `sh_flags == 0x6`, `SystemTime::add` tail placement in
    `.text.lib2` and `.rodata.lib2`, and `D-C2f = 2C` `libc` string-block placement `< e_entry`)."""
    if not active_lib2_roots and not moved_libc_rows:
        return
    img, _phdrs, sections, raw_syms = elf_loader.parse_raw_elf(elf_bytes, require_symtab=True)
    entry = int(img.entry)
    if (entry & 0xFFF) != 0:
        raise RuntimeError(f"C2 invariant: e_entry {entry:#x} is not 0x1000-aligned")
    sec_by_name = {s.name: s for s in sections if s.name}

    # (F9): `.text` starts at `entry`, `.text.crate` has `sh_flags == 0x6` (no `SHF_GNU_RETAIN`),
    # `.text.lib2` sits strictly after `.text` (`>= .text` end) and `<= :data` start.
    text_sec = sec_by_name.get(".text")
    text_crate_sec = sec_by_name.get(".text.crate")
    text_b_pre_sec = sec_by_name.get(".text.b_pre")
    if text_sec is None or text_crate_sec is None or text_b_pre_sec is None:
        raise RuntimeError("C2 invariant (F9): missing `.text`, `.text.crate`, or `.text.b_pre`")
    if text_sec.sh_addr != entry:
        raise RuntimeError(
            f"C2 invariant (F9): `.text` sh_addr {text_sec.sh_addr:#x} != e_entry {entry:#x}"
        )
    if text_crate_sec.sh_flags != 0x6:
        raise RuntimeError(
            f"C2 invariant: `.text.crate` sh_flags {text_crate_sec.sh_flags:#x} != 0x6 "
            "(unexpected SHF_GNU_RETAIN or writable bit)"
        )

    # (thunks): 0 range-extension thunks or veneers in `link.map` or `.symtab`.
    bad_thunk_lines = [
        ln.strip()
        for ln in norm_map_text.splitlines()
        if any(pat in ln for pat in ("Thunk", "veneer", "__AArch64"))
    ]
    if bad_thunk_lines:
        raise RuntimeError(f"C2 invariant (thunks): unexpected thunk/veneer in link.map: {bad_thunk_lines[:5]}")
    bad_thunk_syms = [
        s.name
        for s in raw_syms[1:]
        if s.name and any(pat in s.name for pat in ("Thunk", "veneer", "__AArch64"))
    ]
    if bad_thunk_syms:
        raise RuntimeError(f"C2 invariant (thunks): unexpected thunk symbol(s) in .symtab: {bad_thunk_syms}")

    # Parse `link.map` output sections -> input sections for `(RW)` and `SystemTime::add` RO tail checks.
    rw_out_secs = {
        ".tdata",
        ".tbss",
        ".data.crate",
        ".init_array",
        ".fini_array",
        ".data",
        ".got",
        ".bss.musl",
        ".bss",
    }
    cur_out_sec = ""
    lib2_rw_hits: list[str] = []
    rodata_lib2_inputs: list[tuple[int, int, str]] = []
    for ml in norm_map_text.splitlines()[1:]:
        if len(ml) < 49:
            continue
        hdr_toks = ml[:49].split()
        if len(hdr_toks) != 4:
            continue
        rest = ml[49:]
        indent = len(rest) - len(rest.lstrip(" "))
        item = rest.strip()
        if indent == 0:
            cur_out_sec = item
        elif indent == 8:
            vma = int(hdr_toks[0], 16)
            sz = int(hdr_toks[2], 16)
            if "lib2_" in item and cur_out_sec in rw_out_secs and sz > 0:
                lib2_rw_hits.append(f"{cur_out_sec}: {item} ({sz} B)")
            if cur_out_sec == ".rodata.lib2" and sz > 0:
                rodata_lib2_inputs.append((vma, sz, item))
    if lib2_rw_hits:
        raise RuntimeError(f"C2 invariant (RW): `lib2_*.o` contributed writable `:data` bytes: {lib2_rw_hits}")

    fn_by_name: dict[str, list[Any]] = {}
    for s in raw_syms[1:]:
        if s.st_shndx != 0 and s.stype == 2 and s.name:
            fn_by_name.setdefault(s.name, []).append(s)

    if active_lib2_roots:
        text_lib2 = sec_by_name.get(".text.lib2")
        if text_lib2 is None or text_lib2.sh_size == 0:
            raise RuntimeError("C2 invariant: active `lib2` rows produced missing/empty `.text.lib2`")
        if text_lib2.sh_addr < text_sec.sh_addr + text_sec.sh_size:
            raise RuntimeError(
                f"C2 invariant (F9): `.text.lib2` ({text_lib2.sh_addr:#x}) precedes `.text` end "
                f"({text_sec.sh_addr + text_sec.sh_size:#x})"
            )
        rw_starts = [
            sec_by_name[nm].sh_addr
            for nm in rw_out_secs
            if nm in sec_by_name and sec_by_name[nm].sh_addr > 0
        ]
        if rw_starts and text_lib2.sh_addr + text_lib2.sh_size > min(rw_starts):
            raise RuntimeError(
                f"C2 invariant (F9): `.text.lib2` end {text_lib2.sh_addr + text_lib2.sh_size:#x} "
                f"overruns `:data` start {min(rw_starts):#x}"
            )
        if len(retired_slots) != len(active_lib2_roots):
            raise RuntimeError(
                f"C2 invariant: retired_slots count {len(retired_slots)} != active_lib2_roots {len(active_lib2_roots)}"
            )
        for root_sym in active_lib2_roots:
            rhits = fn_by_name.get(root_sym, [])
            if len(rhits) != 1 or sections[rhits[0].st_shndx].name != ".text.lib2":
                raise RuntimeError(
                    f"C2 invariant: active `lib2` root `{root_sym}` not uniquely in `.text.lib2`: {rhits}"
                )

        # Verify `SystemTime::add` sits strictly LAST in `.text.lib2` and `.rodata.lib2` when enabled.
        if C2_LIB2_TIME_ADD_SYM in active_lib2_roots:
            if active_lib2_roots[-1] != C2_LIB2_TIME_ADD_SYM:
                raise RuntimeError("C2 invariant: `SystemTime::add` must be the final active `lib2` root")
            add_sym = fn_by_name[C2_LIB2_TIME_ADD_SYM][0]
            if add_sym.st_value + add_sym.st_size != text_lib2.sh_addr + text_lib2.sh_size:
                raise RuntimeError(
                    f"C2 invariant: `SystemTime::add` ({add_sym.st_value:#x}..{add_sym.st_value + add_sym.st_size:#x}) "
                    f"is not strictly LAST in `.text.lib2` (end={text_lib2.sh_addr + text_lib2.sh_size:#x})"
                )
            ro_lib2 = sec_by_name.get(".rodata.lib2")
            if ro_lib2 is None or not rodata_lib2_inputs:
                raise RuntimeError("C2 invariant: missing `.rodata.lib2` inputs when `SystemTime::add` is active")
            last_ro_vma, last_ro_sz, last_ro_item = rodata_lib2_inputs[-1]
            last_lib2_idx = len({
                it.split(":(", 1)[0]
                for _, _, it in rodata_lib2_inputs
                if "lib2_" in it
            })
            _ = last_lib2_idx
            if last_ro_vma + last_ro_sz != ro_lib2.sh_addr + ro_lib2.sh_size:
                raise RuntimeError(
                    f"C2 invariant: last `.rodata.lib2` input `{last_ro_item}` "
                    f"({last_ro_vma:#x}+{last_ro_sz:#x}) != `.rodata.lib2` end {ro_lib2.sh_addr + ro_lib2.sh_size:#x}"
                )
            # `SystemTime::add` is always extracted into the highest-numbered `lib2_<M-1>.o`.
            lib2_ro_objs = sorted(
                {
                    int(m.group(1))
                    for _, _, it in rodata_lib2_inputs
                    for m in [re.search(r"lib2_(\d+)\.o:", it)]
                    if m is not None
                }
            )
            if not lib2_ro_objs or f"lib2_{max(lib2_ro_objs)}.o:" not in last_ro_item:
                raise RuntimeError(
                    f"C2 invariant: `SystemTime::add` RO is not strictly LAST in `.rodata.lib2` (last={last_ro_item!r})"
                )

    # Verify `D-C2f = 2C` libc string-block placement (`< e_entry` in `.text.b_pre` for moved rows,
    # `.text.crate` for held-back rows, canonical order `memmove -> memcmp -> bcmp -> strlen`,
    # and preserved 56-byte `memcmp + bcmp` hull).
    moved_set = set(moved_libc_rows)
    prev_moved_end: int | None = None
    for lrow in C2_LIBC_CANONICAL_ORDER:
        lhits = fn_by_name.get(lrow, [])
        if len(lhits) != 1:
            raise RuntimeError(f"C2 `2C` invariant: expected 1 STT_FUNC `{lrow}`, found {len(lhits)}")
        lsym = lhits[0]
        lsec = sections[lsym.st_shndx].name
        exp_sec = ".text.b_pre" if lrow in moved_set else ".text.crate"
        if lsec != exp_sec:
            raise RuntimeError(
                f"C2 `2C` invariant: `{lrow}` sits in `{lsec}`, expected `{exp_sec}`"
            )
        if not (lsym.st_value + max(4, lsym.st_size) <= entry):
            raise RuntimeError(
                f"C2 `2C` invariant: `{lrow}` ({lsym.st_value:#x}+{lsym.st_size:#x}) is not `< e_entry` ({entry:#x})"
            )
        if lrow in moved_set:
            if prev_moved_end is not None and lsym.st_value < prev_moved_end:
                raise RuntimeError(
                    f"C2 `2C` invariant: `{lrow}` at {lsym.st_value:#x} out of order (prev end {prev_moved_end:#x})"
                )
            prev_moved_end = lsym.st_value + lsym.st_size
    if "memcmp" in moved_set and "bcmp" in moved_set:
        mc_sym = fn_by_name["memcmp"][0]
        bc_sym = fn_by_name["bcmp"][0]
        if bc_sym.st_value != mc_sym.st_value + mc_sym.st_size or (mc_sym.st_size + bc_sym.st_size) != 56:
            raise RuntimeError(
                f"C2 `2C` invariant: 56-byte `memcmp + bcmp` hull broken: "
                f"memcmp={mc_sym.st_value:#x}+{mc_sym.st_size}, bcmp={bc_sym.st_value:#x}+{bc_sym.st_size}"
            )

DEFAULT_STOCK_META_NAME: str = "cv-stock-link.json"
DEFAULT_STDBIN_META_NAME: str = "cv-stock-stdbin-link.json"
DEFAULT_STDBIN_5D_NAME: str = "cv-stock-stdbin-5d.json"
ENGINE_STOCK_META_NAME: str = "stock-link.json"

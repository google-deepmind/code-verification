def _unwrap_stock_lock_dict(raw_lock: Mapping[str, Any]) -> dict[str, Any]:
    """Support both top-level stock lock keys (as in `inputs.lock` / `inputs_stock*.lock`) and an
    optional `[stock]` sub-table without mutating `raw_lock`."""
    sub = raw_lock.get("stock")
    if isinstance(sub, Mapping):
        merged = {k: v for k, v in raw_lock.items() if k != "stock"}
        merged.update(sub)
        return merged
    return dict(raw_lock)


def _load_stock_lock_file(lock_path: pathlib.Path) -> dict[str, Any]:
    return _unwrap_stock_lock_dict(tomllib.loads(lock_path.read_text(encoding="utf-8")))


def _is_stdbin_lock(lock: Mapping[str, Any]) -> bool:
    eff = _unwrap_stock_lock_dict(lock)
    return str(eff.get("recipe") or "") == STDBIN_RECIPE


def _has_stock_native_only(lock: Mapping[str, Any]) -> bool:
    eff = _unwrap_stock_lock_dict(lock)
    raw = eff.get("native_only")
    if not isinstance(raw, list):
        return True
    return any(str(x).strip() for x in raw)


def _default_meta_name_for_lock(lock: Mapping[str, Any]) -> str:
    return DEFAULT_STDBIN_META_NAME if _is_stdbin_lock(lock) else DEFAULT_STOCK_META_NAME


def _default_elf_name_for_lock(lock: Mapping[str, Any]) -> str:
    """W2: Parameterized ELF output filename read from lock `elf_name` (1-line `signal-cli` cutover)."""
    explicit = str(lock.get("elf_name") or "").strip()
    if explicit:
        if "/" in explicit or "\\" in explicit:
            raise RuntimeError(f"lock `elf_name` must be a bare filename, got {explicit!r}")
        return explicit
    return (
        "signal-session-stock-stdbin.elf"
        if _is_stdbin_lock(lock)
        else "signal-session-stock.elf"
    )


def _is_ci_mode(explicit_ci: bool = False) -> bool:
    """W4: Detect CI execution mode (`--ci`, `GITHUB_ACTIONS=true`, or `CLI_ELF_STOCK_CI=1`)."""
    return bool(
        explicit_ci
        or os.environ.get("GITHUB_ACTIONS") == "true"
        or os.environ.get("CLI_ELF_STOCK_CI") == "1"
    )


class _ObjectStringTable:
    """Exact port of `object::write::StringTable` (`object-0.36.7/src/write/string.rs`):
    deduplicates byte strings in insertion order, sorts by suffix bytes descending (`0` past start),
    and suffix-merges tail substrings."""

    def __init__(self) -> None:
        self._by_bytes: dict[bytes, int] = {}
        self._items: list[bytes] = []

    def add(self, data: bytes) -> int:
        if not data:
            return -1
        existing = self._by_bytes.get(data)
        if existing is not None:
            return existing
        sid = len(self._items)
        self._by_bytes[data] = sid
        self._items.append(data)
        return sid

    def build(self) -> tuple[bytes, dict[int, int]]:
        import functools

        def _cmp_suffix_desc(a: tuple[int, bytes], b: tuple[int, bytes]) -> int:
            sa, sb = a[1], b[1]
            la, lb = len(sa), len(sb)
            pos = 1
            max_pos = max(la, lb) + 1
            while pos <= max_pos:
                ba = sa[la - pos] if la >= pos else 0
                bb = sb[lb - pos] if lb >= pos else 0
                if ba != bb:
                    return -1 if ba > bb else 1
                pos += 1
            return 0

        indexed = [(sid, sbytes) for sid, sbytes in enumerate(self._items) if sbytes]
        sorted_items = sorted(indexed, key=functools.cmp_to_key(_cmp_suffix_desc))
        out = bytearray(b"\x00")
        offsets: dict[int, int] = {-1: 0}
        prev: bytes | None = None
        for sid, sbytes in sorted_items:
            if prev is not None and prev.endswith(sbytes):
                offsets[sid] = len(out) - len(sbytes) - 1
            else:
                offsets[sid] = len(out)
                out.extend(sbytes)
                out.append(0)
                prev = sbytes
        return bytes(out), offsets


def _read_cstr_at(blob: bytes, off: int) -> bytes:
    if off < 0 or off >= len(blob):
        return b""
    end = blob.find(b"\x00", off)
    return blob[off:] if end < 0 else blob[off:end]


def _emit_trimmed_reloc_obj_snapshot_compat(
    mem_data: bytes,
    keep_section_names: Sequence[str],
    *,
    label: str,
) -> tuple[bytes, list[tuple[int, str]]]:
    """Emit a trimmed `ET_REL` AArch64 ELF64 object matching `rust-obj2lean::parse_object_with` +
    `snapshot-link::trimmed::emit` (`object-0.36.7` `Writer`) byte-for-byte."""
    if len(mem_data) < 64 or mem_data[:4] != b"\x7fELF" or mem_data[4] != 2 or mem_data[5] != 1:
        raise RuntimeError(f"{label}: not a 64-bit little-endian ELF object")
    (
        _e_type,
        e_machine,
        _e_version,
        _e_entry,
        _e_phoff,
        e_shoff,
        _e_flags,
        _e_ehsize,
        _e_phentsize,
        _e_phnum,
        e_shentsize,
        e_shnum,
        e_shstrndx,
    ) = struct.unpack_from("<HHIQQQIHHHHHH", mem_data, 16)
    if e_machine != 183 or e_shentsize != 64 or e_shoff == 0:
        raise RuntimeError(f"{label}: unsupported ELF64 header (machine={e_machine}, shentsize={e_shentsize})")
    if e_shnum == 0:
        sh0 = struct.unpack_from("<IIQQQQIIQQ", mem_data, e_shoff)
        e_shnum = int(sh0[5])
    if e_shstrndx == 0xFFFF:
        sh0 = struct.unpack_from("<IIQQQQIIQQ", mem_data, e_shoff)
        e_shstrndx = int(sh0[6])

    raw_shdrs: list[tuple[int, int, int, int, int, int, int, int, int, int]] = []
    for i in range(e_shnum):
        raw_shdrs.append(struct.unpack_from("<IIQQQQIIQQ", mem_data, e_shoff + i * 64))
    shstr_sh = raw_shdrs[e_shstrndx]
    shstr_blob = mem_data[shstr_sh[4] : shstr_sh[4] + shstr_sh[5]]
    sec_names = [_read_cstr_at(shstr_blob, sh[0]).decode("utf-8", errors="replace") for sh in raw_shdrs]

    keep_set = set(str(n) for n in keep_section_names)
    kept_secs: list[dict[str, Any]] = []
    orig_to_kept_pos: dict[int, int] = {}
    for idx in range(1, e_shnum):
        sh_name_off, sh_type, sh_flags, sh_addr, sh_offset, sh_size, _sh_link, _sh_info, sh_addralign, sh_entsize = raw_shdrs[idx]
        sname = sec_names[idx]
        if (sh_flags & 0x2) == 0 or sname == ".eh_frame" or sname not in keep_set:
            continue
        if (sh_flags & (0x200 | 0x80)) != 0:
            raise RuntimeError(f"trimmed `{label}`: kept section `{sname}` has SHF_GROUP or SHF_LINK_ORDER")
        orig_to_kept_pos[idx] = len(kept_secs)
        is_nobits = sh_type == 8
        s_bytes = b"" if is_nobits else mem_data[sh_offset : sh_offset + sh_size]
        kept_secs.append({
            "elf_index": idx,
            "name": sname,
            "sh_type": sh_type,
            "sh_flags": sh_flags,
            "addr": sh_addr,
            "align": sh_addralign,
            "entsize": sh_entsize,
            "size": sh_size,
            "bytes": s_bytes,
            "is_nobits": is_nobits,
            "is_rel": False,
            "relocs": [],
        })
    found_names = {s["name"] for s in kept_secs}
    if found_names != keep_set:
        raise RuntimeError(
            f"trimmed `{label}`: missing kept section(s) {sorted(keep_set - found_names)}"
        )

    symtab_idx_src: int | None = None
    symtab_shndx_blob: bytes | None = None
    for idx in range(1, e_shnum):
        sh = raw_shdrs[idx]
        if sh[1] == 2:  # SHT_SYMTAB
            symtab_idx_src = idx
        elif sh[1] == 18:  # SHT_SYMTAB_SHNDX
            symtab_shndx_blob = mem_data[sh[4] : sh[4] + sh[5]]
    if symtab_idx_src is None:
        raise RuntimeError(f"{label}: missing SHT_SYMTAB")

    for idx in range(1, e_shnum):
        sh_type = raw_shdrs[idx][1]
        if sh_type not in (4, 9):  # SHT_RELA, SHT_REL
            continue
        target_orig = raw_shdrs[idx][7]
        if target_orig not in orig_to_kept_pos:
            continue
        kpos = orig_to_kept_pos[target_orig]
        is_rel = sh_type == 9
        kept_secs[kpos]["is_rel"] = is_rel
        sh_off, sh_sz = raw_shdrs[idx][4], raw_shdrs[idx][5]
        rel_blob = mem_data[sh_off : sh_off + sh_sz]
        if is_rel:
            for pos in range(0, len(rel_blob), 16):
                r_off, r_info = struct.unpack_from("<QQ", rel_blob, pos)
                kept_secs[kpos]["relocs"].append((r_off, r_info >> 32, r_info & 0xFFFFFFFF, 0))
        else:
            for pos in range(0, len(rel_blob), 24):
                r_off, r_info, r_addend = struct.unpack_from("<QQq", rel_blob, pos)
                kept_secs[kpos]["relocs"].append((r_off, r_info >> 32, r_info & 0xFFFFFFFF, r_addend))

    referenced_orig_syms: set[int] = set()
    for ks in kept_secs:
        ks["relocs"].sort(key=lambda r: r[0])
        for _roff, rsym, _rtype, _radd in ks["relocs"]:
            referenced_orig_syms.add(int(rsym))

    sym_sh = raw_shdrs[symtab_idx_src]
    str_sh = raw_shdrs[sym_sh[6]]
    sym_blob = mem_data[sym_sh[4] : sym_sh[4] + sym_sh[5]]
    str_blob = mem_data[str_sh[4] : str_sh[4] + str_sh[5]]
    n_syms = len(sym_blob) // 24

    kept_syms: list[dict[str, Any]] = []
    old_to_new_sym: dict[int, int] = {}
    for i in range(n_syms):
        st_name, st_info, st_other, st_shndx, st_value, st_size = struct.unpack_from(
            "<IBBHQQ", sym_blob, i * 24
        )
        bind = st_info >> 4
        stype = st_info & 0xF
        raw_name = _read_cstr_at(str_blob, st_name) if i > 0 else b""
        if i == 0:
            sec_kind = ("undef", 0)
            val_out, sz_out = 0, 0
        elif st_shndx == 0:
            sec_kind = ("undef", 0)
            val_out, sz_out = st_value, st_size
        elif st_shndx == 0xFFF1:
            sec_kind = ("abs", 0xFFF1)
            val_out, sz_out = st_value, st_size
        elif st_shndx == 0xFFF2:
            sec_kind = ("common", 0xFFF2)
            val_out, sz_out = st_value, st_size
        else:
            real_shndx = st_shndx
            if st_shndx == 0xFFFF:
                if symtab_shndx_blob is None:
                    raise RuntimeError(f"{label}: symbol {i} has SHN_XINDEX without SHT_SYMTAB_SHNDX")
                (real_shndx,) = struct.unpack_from("<I", symtab_shndx_blob, i * 4)
            if real_shndx in orig_to_kept_pos:
                sec_kind = ("sec", orig_to_kept_pos[real_shndx])
                val_out, sz_out = st_value, st_size
            else:
                sec_kind = ("undef", 0)
                val_out, sz_out = 0, 0

        keep_sym = (
            i == 0
            or (i in referenced_orig_syms)
            or (sec_kind[0] == "sec" and stype != 4)
        )
        if not keep_sym:
            continue
        old_to_new_sym[i] = len(kept_syms)
        kept_syms.append({
            "raw_name": raw_name,
            "bind": bind,
            "stype": stype,
            "st_info": st_info,
            "st_other": st_other,
            "sec_kind": sec_kind,
            "st_value": val_out,
            "st_size": sz_out,
        })

    num_local = 0
    for s in kept_syms:
        if s["bind"] == 0:
            num_local += 1
        else:
            break
    if any(s["bind"] == 0 for s in kept_syms[num_local:]):
        raise RuntimeError(f"trimmed `{label}`: local symbol follows a non-local symbol")

    shstrtab = _ObjectStringTable()
    strtab = _ObjectStringTable()

    # Section indices: 0=null, 1..K=kept_secs, K+1..K+R=non-empty reloc secs, symtab, strtab, shstrtab
    next_sec_idx = 1
    for ks in kept_secs:
        ks["sec_str_id"] = shstrtab.add(ks["name"].encode("utf-8"))
        ks["out_sec_idx"] = next_sec_idx
        next_sec_idx += 1
    for ks in kept_secs:
        if ks["relocs"]:
            rel_prefix = ".rel" if ks["is_rel"] else ".rela"
            ks["rel_str_id"] = shstrtab.add(f"{rel_prefix}{ks['name']}".encode("utf-8"))
            ks["rel_out_sec_idx"] = next_sec_idx
            next_sec_idx += 1
        else:
            ks["rel_str_id"] = None
            ks["rel_out_sec_idx"] = None
    symtab_str_id = shstrtab.add(b".symtab")
    symtab_out_idx = next_sec_idx
    next_sec_idx += 1
    strtab_str_id = shstrtab.add(b".strtab")
    strtab_out_idx = next_sec_idx
    next_sec_idx += 1
    shstrtab_str_id = shstrtab.add(b".shstrtab")
    shstrtab_out_idx = next_sec_idx
    next_sec_idx += 1
    total_out_secs = next_sec_idx

    need_shndx = any(
        s["sec_kind"][0] == "sec" and (kept_secs[s["sec_kind"][1]]["out_sec_idx"] >= 0xFF00)
        for s in kept_syms[1:]
    )
    if need_shndx:
        raise RuntimeError(f"trimmed `{label}`: >= 0xff00 kept sections unsupported")

    for i, s in enumerate(kept_syms):
        if i > 0 and s["raw_name"] and s["stype"] != 3:  # SymKind::Section == STT_SECTION(3)
            s["name_str_id"] = strtab.add(s["raw_name"])
        else:
            s["name_str_id"] = -1

    strtab_bytes, strtab_offs = strtab.build()
    shstrtab_bytes, shstrtab_offs = shstrtab.build()

    buf = bytearray(64)  # placeholder for ELF64 header

    def _align_buf(align: int) -> None:
        if align > 1:
            rem = len(buf) % align
            if rem:
                buf.extend(b"\x00" * (align - rem))

    for ks in kept_secs:
        if ks["is_nobits"]:
            ks["out_offset"] = 0
        else:
            _align_buf(max(1, int(ks["align"])))
            ks["out_offset"] = len(buf)
            buf.extend(ks["bytes"])

    for ks in kept_secs:
        if not ks["relocs"]:
            ks["rel_out_offset"] = 0
            continue
        _align_buf(8)
        ks["rel_out_offset"] = len(buf)
        if ks["is_rel"]:
            for r_off, r_sym_old, r_type, _r_add in ks["relocs"]:
                r_sym_new = old_to_new_sym[int(r_sym_old)]
                buf.extend(struct.pack("<QQ", r_off, (r_sym_new << 32) | (r_type & 0xFFFFFFFF)))
        else:
            for r_off, r_sym_old, r_type, r_add in ks["relocs"]:
                r_sym_new = old_to_new_sym[int(r_sym_old)]
                buf.extend(
                    struct.pack("<QQq", r_off, (r_sym_new << 32) | (r_type & 0xFFFFFFFF), r_add)
                )

    _align_buf(8)
    symtab_offset = len(buf)
    buf.extend(b"\x00" * 24)  # null symbol
    for s in kept_syms[1:]:
        st_name_out = strtab_offs[s["name_str_id"]]
        kind_tag, kind_val = s["sec_kind"]
        if kind_tag == "sec":
            st_shndx_out = kept_secs[kind_val]["out_sec_idx"]
        else:
            st_shndx_out = kind_val
        buf.extend(
            struct.pack(
                "<IBBHQQ",
                st_name_out,
                s["st_info"],
                s["st_other"],
                st_shndx_out,
                s["st_value"],
                s["st_size"],
            )
        )

    strtab_offset = len(buf)
    buf.extend(strtab_bytes)
    shstrtab_offset = len(buf)
    buf.extend(shstrtab_bytes)

    _align_buf(8)
    shdr_offset = len(buf)
    buf.extend(b"\x00" * 64)  # null section header
    for ks in kept_secs:
        buf.extend(
            struct.pack(
                "<IIQQQQIIQQ",
                shstrtab_offs[ks["sec_str_id"]],
                ks["sh_type"],
                ks["sh_flags"],
                ks["addr"],
                ks["out_offset"],
                ks["size"],
                0,
                0,
                ks["align"],
                ks["entsize"],
            )
        )
    for ks in kept_secs:
        if ks["rel_str_id"] is None:
            continue
        ent_sz = 16 if ks["is_rel"] else 24
        buf.extend(
            struct.pack(
                "<IIQQQQIIQQ",
                shstrtab_offs[ks["rel_str_id"]],
                9 if ks["is_rel"] else 4,
                0x40,  # SHF_INFO_LINK
                0,
                ks["rel_out_offset"],
                len(ks["relocs"]) * ent_sz,
                symtab_out_idx,
                ks["out_sec_idx"],
                8,
                ent_sz,
            )
        )
    # .symtab
    buf.extend(
        struct.pack(
            "<IIQQQQIIQQ",
            shstrtab_offs[symtab_str_id],
            2,  # SHT_SYMTAB
            0,
            0,
            symtab_offset,
            len(kept_syms) * 24,
            strtab_out_idx,
            num_local,
            8,
            24,
        )
    )
    # .strtab
    buf.extend(
        struct.pack(
            "<IIQQQQIIQQ",
            shstrtab_offs[strtab_str_id],
            3,  # SHT_STRTAB
            0,
            0,
            strtab_offset,
            len(strtab_bytes),
            0,
            0,
            1,
            0,
        )
    )
    # .shstrtab
    buf.extend(
        struct.pack(
            "<IIQQQQIIQQ",
            shstrtab_offs[shstrtab_str_id],
            3,  # SHT_STRTAB
            0,
            0,
            shstrtab_offset,
            len(shstrtab_bytes),
            0,
            0,
            1,
            0,
        )
    )

    e_ident = b"\x7fELF" + bytes([2, 1, 1, 0, 0]) + b"\x00" * 7
    buf[:64] = struct.pack(
        "<16sHHIQQQIHHHHHH",
        e_ident,
        1,  # ET_REL
        183,  # EM_AARCH64
        1,  # EV_CURRENT
        0,  # e_entry
        0,  # e_phoff
        shdr_offset,
        0,  # e_flags
        64,  # e_ehsize
        0,  # e_phentsize
        0,  # e_phnum
        64,  # e_shentsize
        total_out_secs,
        shstrtab_out_idx,
    )
    kept_pairs = [(int(ks["elf_index"]), str(ks["name"])) for ks in kept_secs]
    return bytes(buf), kept_pairs


def _push_std_remap_pair(remaps: list[tuple[pathlib.Path, str]], d: pathlib.Path, to: str) -> None:
    def _push_unique(p: pathlib.Path) -> None:
        if not any(existing == p for existing, _ in remaps):
            remaps.append((p, to))

    _push_unique(d)
    try:
        canon = d.resolve()
        if canon != d:
            _push_unique(canon)
    except OSError:
        pass


def _build_std_encoded_rustflags(
    *,
    repo_root: pathlib.Path,
    crate_dir: pathlib.Path,
    work_dir: pathlib.Path,
    cargo_home: pathlib.Path | None,
    rustup_home: pathlib.Path | None,
    sysroot: pathlib.Path,
) -> str:
    flags: list[str] = [
        "-Zunstable-options",
        "-Cpanic=immediate-abort",
        "-Crelocation-model=static",
        "-Clinker-flavor=gnu-lld",
        "-Clinker=rust-lld",
        "-Cstrip=debuginfo",
        "-Cmetadata=snapstd",
        *DETERMINISTIC_RUSTC_CODEGEN_FLAGS,
    ]
    remaps: list[tuple[pathlib.Path, str]] = []
    _push_std_remap_pair(remaps, repo_root, "/src")
    if not crate_dir.is_relative_to(repo_root):
        _push_std_remap_pair(remaps, crate_dir, "/src")
    _push_std_remap_pair(remaps, work_dir, "/work")
    if cargo_home is not None:
        _push_std_remap_pair(remaps, cargo_home, "/cargo")
    if rustup_home is not None:
        _push_std_remap_pair(remaps, rustup_home, "/rustup")
    rust_src = sysroot / "lib" / "rustlib" / "src" / "rust"
    _push_std_remap_pair(remaps, rust_src, f"/rustc/{STDBIN_PINNED_RUSTC_COMMIT}")

    all_dirs = [d for d, _ in remaps]
    remaps.sort(
        key=lambda pair: sum(
            1 for other in all_dirs if other != pair[0] and pair[0].is_relative_to(other)
        )
    )
    for from_d, to_s in remaps:
        flags.append(f"--remap-path-prefix={from_d}={to_s}")
    return "\x1f".join(flags)


def _compute_stdbin_rebuild_key(
    *,
    sysroot: pathlib.Path,
    manifest_path: pathlib.Path,
    crate_dir: pathlib.Path,
    bin_stem: str,
    repo_root: pathlib.Path,
    work_dir: pathlib.Path,
    env: Mapping[str, str],
) -> dict[str, Any]:
    home = pathlib.Path(env["HOME"]) if env.get("HOME") else None
    cargo_home = (
        pathlib.Path(env["CARGO_HOME"])
        if env.get("CARGO_HOME")
        else (home / ".cargo" if home is not None else None)
    )
    rustup_home = (
        pathlib.Path(env["RUSTUP_HOME"])
        if env.get("RUSTUP_HOME")
        else (home / ".rustup" if home is not None else None)
    )
    encoded = _build_std_encoded_rustflags(
        repo_root=repo_root,
        crate_dir=crate_dir,
        work_dir=work_dir,
        cargo_home=cargo_home,
        rustup_home=rustup_home,
        sysroot=sysroot,
    )
    remaps_raw: list[str] = []
    rustflags: list[str] = []
    for tok in encoded.split("\x1f"):
        if tok.startswith("--remap-path-prefix="):
            remaps_raw.append(tok)
        else:
            rustflags.append(tok)
    remap_targets = sorted({r.rsplit("=", 1)[1] for r in remaps_raw if "=" in r})

    rust_src = sysroot / "lib" / "rustlib" / "src" / "rust"
    roots: list[tuple[pathlib.Path, str]] = [
        (rust_src, "/rustc"),
        (work_dir, "/work"),
    ]
    if not crate_dir.is_relative_to(repo_root):
        roots.append((crate_dir, "/crate"))
    roots.append((repo_root, "/src"))
    if cargo_home is not None:
        roots.append((cargo_home, "/cargo"))

    def _shown(p: pathlib.Path) -> str:
        best: tuple[int, pathlib.Path, str] | None = None
        for r_dir, to_pfx in roots:
            if p.is_relative_to(r_dir):
                rel_p = p.relative_to(r_dir)
                cand_len = len(str(r_dir))
                if best is None or cand_len > best[0]:
                    best = (cand_len, rel_p, to_pfx)
        if best is None:
            return str(p)
        return f"{best[2]}/{best[1]}"

    def _hashed(p: pathlib.Path) -> dict[str, str]:
        return {"path": _shown(p), "sha256": _BASE.sha256_file(p)}

    lockfile: pathlib.Path | None = None
    cur: pathlib.Path | None = crate_dir
    while cur is not None and (cur.is_relative_to(repo_root) or cur == crate_dir):
        cand_lk = cur / "Cargo.lock"
        if cand_lk.is_file():
            lockfile = cand_lk
            break
        cur = cur.parent if cur.parent != cur else None
    if lockfile is None:
        raise RuntimeError(f"no Cargo.lock found for --main-rust crate {crate_dir}")
    ws_root = lockfile.parent

    deps_dir = work_dir / "rust-target" / STDBIN_MUSL_TARGET / "release" / "deps"

    def _sources(prefix: str, include_files: bool) -> dict[str, Any]:
        src_files: set[pathlib.Path] = set()
        found = 0
        for d_entry in sorted(deps_dir.iterdir()):
            if not (d_entry.is_file() and d_entry.name.startswith(prefix) and d_entry.name.endswith(".d")):
                continue
            found += 1
            for line in d_entry.read_text(encoding="utf-8").splitlines():
                if line.endswith(":"):
                    src_raw = line[:-1]
                    if ": " not in src_raw and src_raw:
                        src_files.add(ws_root / src_raw.replace("\\ ", " "))
        if found == 0:
            raise RuntimeError(f"no cargo dep-info `{prefix}*.d` in {deps_dir}")
        ordered = sorted(src_files, key=lambda p: str(p))
        entries = [_hashed(p) for p in ordered]
        lines = "".join(f"{e['sha256']}  {e['path']}\n" for e in entries)
        out_v: dict[str, Any] = {
            "count": len(entries),
            "sha256": hashlib.sha256(lines.encode("utf-8")).hexdigest(),
        }
        if include_files:
            out_v["files"] = entries
        return out_v

    cargo_args = [
        "rustc",
        "--manifest-path",
        _shown(manifest_path),
        "--target",
        STDBIN_MUSL_TARGET,
        "--release",
        "--locked",
        "-Zbuild-std=std,panic_abort",
        "--",
        "--emit=obj",
    ]
    return {
        "cargoArgs": cargo_args,
        "rustflags": rustflags,
        "remapTargets": remap_targets,
        "manifest": _hashed(manifest_path),
        "lockfile": _hashed(lockfile),
        "mainSources": _sources(f"{bin_stem}-", True),
        "compilerBuiltinsSources": _sources("compiler_builtins-", False),
    }


def _parse_trace_line(line: str) -> tuple[str, str, str] | None:
    s = line.strip()
    for verb in STDBIN_TRACE_VERBS:
        if verb in s:
            f_part, n_part = s.split(verb, 1)
            return f_part, verb[2:].rstrip(), n_part
    return None


def _parse_stdbin_archive_members(
    why_text: str,
    map_text: str,
    lld_out_text: str,
    stage_raw_res: pathlib.Path,
) -> list[dict[str, Any]]:
    prefix = f"{stage_raw_res}/"

    def _rel_s(s: str) -> str:
        return s[len(prefix) :] if s.startswith(prefix) else s

    def _split_in_sec(item: str) -> tuple[str, str] | None:
        if ":(" not in item or not item.endswith(")"):
            return None
        inp, sec = item[:-1].split(":(", 1)
        sec = sec.split("+", 1)[0]
        return inp, sec

    why_lines = why_text.splitlines()
    if not why_lines or why_lines[0] != "reference\textracted\tsymbol":
        raise RuntimeError(f"why-extract.tsv: unrecognized header {why_lines[:1]!r}")

    members: dict[str, dict[str, Any]] = {}
    for line in why_lines[1:]:
        parts = line.split("\t")
        if len(parts) != 3 or any(not x for x in parts) or not parts[1].endswith(")"):
            raise RuntimeError(f"why-extract.tsv: malformed row {line!r}")
        key = _rel_s(parts[1])
        m = members.setdefault(
            key, {"extracted_by": None, "retained": {}, "removed": set()}
        )
        if m["extracted_by"] is None:
            m["extracted_by"] = (_rel_s(parts[0]), parts[2])
    if not members:
        raise RuntimeError("why-extract.tsv: no archive member extracted")

    map_lines = map_text.splitlines()
    exp_map_hdr = "             VMA              LMA     Size Align Out     In      Symbol"
    if not map_lines or map_lines[0] != exp_map_hdr:
        raise RuntimeError(f"link.map: unrecognized header {map_lines[:1]!r}")

    archive_secs = 0
    for line in map_lines[1:]:
        if len(line) < 49:
            raise RuntimeError(f"link.map: short line {line!r}")
        cols, rest = line[:49], line[49:]
        c_toks = cols.split()
        if len(c_toks) != 4:
            raise RuntimeError(f"link.map: malformed columns {line!r}")
        sz_val = int(c_toks[2], 16)
        indent = len(rest) - len(rest.lstrip(" "))
        item = rest[indent:]
        if indent == 8:
            sp = _split_in_sec(item)
            if sp is None:
                raise RuntimeError(f"link.map: malformed input section {item!r}")
            inp, sec = sp
            if not (inp.endswith(")") and ".a(" in inp):
                continue
            key = _rel_s(inp)
            if key not in members:
                raise RuntimeError(f"link.map: section of {key} absent from why-extract.tsv")
            members[key]["retained"][sec] = members[key]["retained"].get(sec, 0) + sz_val
            archive_secs += 1
        elif indent not in (0, 16):
            raise RuntimeError(f"link.map: unexpected indent {indent} in {line!r}")

    if archive_secs == 0:
        raise RuntimeError("link.map: zero retained archive input sections")

    for raw_l in lld_out_text.splitlines():
        ts = raw_l.strip()
        if ts.startswith("removing unused section "):
            rem_item = ts[len("removing unused section ") :]
            sp = _split_in_sec(rem_item)
            if sp is None:
                raise RuntimeError(f"--print-gc-sections: malformed line {raw_l!r}")
            inp, sec = sp
            if inp.endswith(")") and ".a(" in inp:
                key = _rel_s(inp)
                if key not in members:
                    raise RuntimeError(f"--print-gc-sections: section of {key} absent from why-extract.tsv")
                members[key]["removed"].add(sec)

    unaccounted = sorted(
        k for k, m in members.items() if not m["retained"] and not m["removed"]
    )
    if unaccounted:
        raise RuntimeError(
            f"extracted archive members with neither retained nor removed sections: {unaccounted}"
        )

    out_arr: list[dict[str, Any]] = []
    for k in sorted(members.keys()):
        m = members[k]
        eb = m["extracted_by"]
        out_arr.append({
            "member": k,
            "extractedBy": (
                {"reference": eb[0], "symbol": eb[1]} if eb is not None else None
            ),
            "retained": [
                {"section": s_nm, "size": m["retained"][s_nm]}
                for s_nm in sorted(m["retained"].keys())
            ],
            "removed": sorted(m["removed"]),
        })
    return out_arr


def _stdbin_unwind_audit(elf_bytes: bytes, archive_members_json: Sequence[Mapping[str, Any]]) -> dict[str, Any]:
    unw_retained = [
        f"{m['member']}: {[r['section'] for r in m.get('retained', ())]}"
        for m in archive_members_json
        if "libunwind.a(" in str(m.get("member") or "") and m.get("retained")
    ]
    if unw_retained:
        raise RuntimeError(f"unwind audit: libunwind.a sections are linked: {unw_retained}")

    exec_elf = _ELF_INSPECT.parse_exec_elf(elf_bytes, "stdbin.elf")
    allow_map = dict(STDBIN_UNWIND_ALLOW)
    allowed_present: dict[str, str] = {}
    bad: set[str] = set()
    for sym in exec_elf.symbols:
        if sym.stype == 4:  # STT_FILE
            continue
        nm = sym.name
        if not nm or not any(pat in nm for pat in STDBIN_UNWIND_DENY):
            continue
        if nm in allow_map and sym.st_shndx == 0 and sym.bind == 2:
            allowed_present[nm] = allow_map[nm]
        else:
            bad.add(f"{nm} ({'undefined' if sym.st_shndx == 0 else 'defined'})")
    if bad:
        raise RuntimeError(
            f"unwind audit: unwinder symbols in .symtab without allowed weak-undef form: {sorted(bad)}"
        )
    return {
        "allowed": [
            {"symbol": n, "reason": allowed_present[n]}
            for n in sorted(allowed_present.keys())
        ]
    }


def _stdbin_segments_and_sections_json(elf_bytes: bytes) -> tuple[list[dict[str, Any]], list[dict[str, Any]]]:
    _img, phdrs, sections, _raw_syms = elf_loader.parse_raw_elf(elf_bytes, require_symtab=True)
    segs_out = [
        {
            "type": hex(ph.p_type),
            "flags": ph.p_flags,
            "offset": hex(ph.p_offset),
            "vaddr": hex(ph.p_vaddr),
            "filesz": ph.p_filesz,
            "memsz": ph.p_memsz,
            "align": hex(ph.p_align),
        }
        for ph in phdrs
    ]
    secs_out = [
        {
            "name": sec.name,
            "addr": hex(sec.sh_addr),
            "size": sec.sh_size,
        }
        for sec in sections
        if sec.sh_addr != 0
    ]
    return segs_out, secs_out


def _derive_reachable_externs_from_objs(
    objs: Sequence[Any],
    exports: Sequence[str],
) -> tuple[list[str], list[str]]:
    """Derive `(extern_funcs, extern_data)` directly from compiled `lib0_*.o` relocatable objects
    via multi-object section reachability BFS starting from `[placed] exports` + `[[sysroot_objects]]`
    `roots` (excluding `.eh_frame`, matching `rust-obj2lean` `PlacedObj` section reachability).
    Used in `--unpinned` cross-tree builds when `.GeneratedLean/` is absent or stale."""
    global_defs: dict[str, list[tuple[int, int]]] = {}
    for o_i, po in enumerate(objs):
        for s in po.symbols:
            if not s.is_local and 0 < s.st_shndx < len(po.sections):
                sec = po.sections[s.st_shndx]
                if (sec.sh_flags & 0x2) != 0 and sec.name != ".eh_frame":
                    global_defs.setdefault(s.name, []).append((o_i, s.st_shndx))
                    if s.demangled != s.name:
                        global_defs.setdefault(s.demangled, []).append((o_i, s.st_shndx))

    visited: set[tuple[int, int]] = set()
    queue: list[tuple[int, int]] = []
    for exp in exports:
        for pair in global_defs.get(str(exp), ()):
            if pair not in visited:
                visited.add(pair)
                queue.append(pair)

    undef_func: set[str] = set()
    undef_obj: set[str] = set()
    while queue:
        o_i, s_i = queue.pop()
        po = objs[o_i]
        sec = po.sections[s_i]
        if sec.name == ".eh_frame" or (sec.sh_flags & 0x2) == 0:
            continue
        for rel in sec.relocs:
            if rel.r_type in (0, 256):
                continue
            tsym = po.symbols[rel.sym_idx]
            if tsym.is_local:
                if 0 < tsym.st_shndx < len(po.sections):
                    pair = (o_i, tsym.st_shndx)
                    if pair not in visited:
                        visited.add(pair)
                        queue.append(pair)
            else:
                if tsym.name in global_defs:
                    for pair in global_defs[tsym.name]:
                        if pair not in visited:
                            visited.add(pair)
                            queue.append(pair)
                elif tsym.name:
                    if tsym.stype == 1 or tsym.name in alpha_checks.EIGHT_BYTE_EXTERN_DATA_SYMS:
                        undef_obj.add(tsym.name)
                    else:
                        undef_func.add(tsym.name)
    return sorted(undef_func), sorted(undef_obj)


def _stage_and_link_stdbin_direct(
    *,
    repo_root: pathlib.Path,
    stage_raw: pathlib.Path,
    work_root: pathlib.Path,
    config_paths: Sequence[str],
    main_rust_manifest_rel: str,
    elf_name: str,
    native_inputs: Sequence[pathlib.Path],
    ld_mode: str,
    ld_rel: str | None,
    ld_sha: str | None,
    ld_abs: pathlib.Path | None,
    lld_no_relax: bool,
    placed_exports: Sequence[str],
    eng_head: str,
    env: Mapping[str, str],
    dynamic_stubs_dir: pathlib.Path | None = None,
    initial_lean_externs: Sequence[str] | None = None,
    displaced_weak: Sequence[str] = alpha_checks.EXPECTED_DISPLACED_WEAK,
    lib2_cfg_rel: str | None = None,
    lib2_cfg_abs: pathlib.Path | None = None,
    active_lib2_names: Sequence[str] = (),
    active_lib2_roots: Sequence[str] = (),
    moved_libc_rows: Sequence[str] = (),
) -> dict[str, Any]:
    """Direct 2-config `StdBin` staging + `ld.lld` link inside `scripts/cli-elf-stock`
    (bypassing `arm64-semantics` `v0.46.0` `trimmed.rs:86` while emitting every side output
    of `snapshot-link --stock`: `<elf_name>`, `stock-link.json`, `census.json`, `timing.json`,
    and `work/{lib0_*,lib1_*,main_rust.o,compiler_builtins.a,self-contained/*,native/*,link.map,why-extract.tsv,lld.log}`)."""
    import time

    t_stage_start = time.monotonic()

    repo_root_res = repo_root.resolve()
    stage_raw.mkdir(parents=True, exist_ok=True)
    stage_raw_res = stage_raw.resolve()
    raw_work = stage_raw_res / "work"
    if raw_work.exists():
        shutil.rmtree(raw_work)
    raw_work.mkdir(parents=True, exist_ok=True)

    def _rel_path(p: pathlib.Path) -> str:
        try:
            rp = p.resolve()
        except OSError:
            rp = p
        if rp.is_relative_to(stage_raw_res):
            return str(rp.relative_to(stage_raw_res))
        if rp.is_relative_to(repo_root_res):
            return str(rp.relative_to(repo_root_res))
        if p.is_relative_to(stage_raw):
            return str(p.relative_to(stage_raw))
        if p.is_relative_to(repo_root):
            return str(p.relative_to(repo_root))
        return str(p)

    # 1. Stage self-contained runtime from pinned rustc 1.98.1 sysroot and verify SHA-256s up front.
    sysroot = pathlib.Path(
        subprocess.run(
            ["rustc", "--print", "sysroot"],
            cwd=str(repo_root_res),
            capture_output=True,
            text=True,
            check=True,
            env=dict(env),
        ).stdout.strip()
    ).resolve()
    musl_tlibdir = pathlib.Path(
        subprocess.run(
            ["rustc", "--print", "target-libdir", "--target", STDBIN_MUSL_TARGET],
            cwd=str(repo_root_res),
            capture_output=True,
            text=True,
            check=True,
            env=dict(env),
        ).stdout.strip()
    ).resolve()
    sc_src_dir = musl_tlibdir / "self-contained"
    sc_dst_dir = raw_work / "self-contained"
    sc_dst_dir.mkdir(parents=True, exist_ok=True)
    input_notes: dict[pathlib.Path, dict[str, Any]] = {}
    sc_copied: dict[str, pathlib.Path] = {}
    for fname, pinned_sha in STDBIN_SELF_CONTAINED_CHECKSUMS:
        src_p = sc_src_dir / fname
        if not src_p.is_file():
            raise RuntimeError(f"missing self-contained runtime input {src_p}")
        data_b = src_p.read_bytes()
        got_sha = hashlib.sha256(data_b).hexdigest()
        if got_sha != pinned_sha:
            raise RuntimeError(
                f"SHA-256 mismatch for self-contained {src_p}: expected {pinned_sha}, got {got_sha}"
            )
        dst_p = (sc_dst_dir / fname).resolve()
        dst_p.write_bytes(data_b)
        input_notes[dst_p] = {"kind": "selfContained", "pinnedSha256": pinned_sha}
        sc_copied[fname] = dst_p

    # 2. Stage `--stock-native-object` inputs (`rdl_shim.o`, `extern_stubs_clean.o`, etc.) to `work/native/`.
    nat_dst_dir = raw_work / "native"
    nat_dst_dir.mkdir(parents=True, exist_ok=True)
    staged_native: list[pathlib.Path] = []
    for n_src in native_inputs:
        b_nat = n_src.read_bytes()
        _ELF_INSPECT.parse_reloc_obj(b_nat, n_src.name)
        dst_n = (nat_dst_dir / n_src.name).resolve()
        if dst_n.exists():
            raise RuntimeError(f"duplicate native object basename {n_src.name!r}")
        dst_n.write_bytes(b_nat)
        input_notes[dst_n] = {"kind": "nativeObject"}
        staged_native.append(dst_n)

    # 3. Extract translated Rust images (`configs[0..K-1]`: crate `.o`s + `trimmed::emit` sysroot trims).
    t_crates0 = time.monotonic()
    images: list[dict[str, Any]] = []
    for k, cfg_rel in enumerate(config_paths):
        cfg_abs = (repo_root_res / cfg_rel).resolve()
        cfg = tomllib.loads(cfg_abs.read_text(encoding="utf-8"))
        obj_prefix = f"lib{k}_"
        crate_objs, _ = _compile_rust_crates_direct(
            repo_root=repo_root_res,
            cfg_path=cfg_abs,
            cfg=cfg,
            work_root=work_root / f"cfg_{k}",
            link_work=raw_work,
            env=env,
            obj_prefix=obj_prefix,
        )
        trim_objs, trim_recs = _extract_sysroot_trims_direct(
            cfg=cfg,
            start_idx=len(crate_objs),
            link_work=raw_work,
            env=env,
            obj_prefix=obj_prefix,
            use_snapshot_compat_emit=True,
        )
        im_paths = [p.resolve() for p in [*crate_objs, *trim_objs]]
        im_parsed = [_ELF_INSPECT.parse_reloc_obj(p.read_bytes(), p.name) for p in im_paths]
        placed_sec = cfg.get("placed") if isinstance(cfg.get("placed"), Mapping) else {}
        crate_specs = [str(x) for x in (cfg.get("crates") or ())]
        im_obj_entries: list[dict[str, Any]] = []
        im_trim_list: list[dict[str, Any] | None] = []
        for idx_o, p_o in enumerate(im_paths):
            raw_o = p_o.read_bytes()
            sha_o = hashlib.sha256(raw_o).hexdigest()
            if idx_o < len(crate_objs):
                logical_nm = crate_specs[idx_o].replace("-", "_") if idx_o < len(crate_specs) else p_o.stem
                im_obj_entries.append({
                    "name": logical_nm,
                    "path": _rel_path(p_o),
                    "sha256": sha_o,
                    "size": len(raw_o),
                })
                im_trim_list.append(None)
            else:
                tr = trim_recs[idx_o - len(crate_objs)]
                im_obj_entries.append({
                    "name": str(tr["name"]),
                    "path": _rel_path(p_o),
                    "sha256": sha_o,
                    "size": len(raw_o),
                    "trimmedFrom": {
                        "rlib": str(tr["rlib"]),
                        "member": str(tr["member"]),
                        "provenance": str(tr["provenance"]),
                        "roots": list(tr["roots"]),
                        "memberSha256": str(tr["member_sha256"]),
                        "memberSize": int(tr["member_size"]),
                        "keepSetSha256": str(tr["keep_set_sha256"]),
                        "keepSet": list(tr["keep_set"]),
                    },
                })
                im_trim_list.append(tr)

        defs_k: set[str] = set()
        undefs_k: set[str] = set()
        for po in im_parsed:
            defs_k.update(po.defs_by_name.keys())
            undefs_k.update(po.undefs_by_name.keys())
        externs_k = sorted(undefs_k - defs_k)
        exports_k = [
            *(str(e) for e in (placed_sec.get("exports") or ())),
            *(
                str(r)
                for s_ent in (cfg.get("sysroot_objects") or ())
                for r in (s_ent.get("roots") or ())
            ),
        ]
        images.append({
            "config": str(cfg_rel),
            "paths": im_paths,
            "parsed": im_parsed,
            "objects_json": im_obj_entries,
            "trimmed": im_trim_list,
            "externs": externs_k,
            "exports": exports_k,
        })

    if active_lib2_names:
        if lib2_cfg_rel is None or lib2_cfg_abs is None:
            raise RuntimeError("`active_lib2_names` requires `lib2_cfg_rel` and `lib2_cfg_abs`")
        lib2_cfg = tomllib.loads(lib2_cfg_abs.read_text(encoding="utf-8"))
        lib2_prefix = f"lib{len(images)}_"
        lib2_objs, lib2_recs = _extract_lib2_trims_direct(
            lib2_cfg=lib2_cfg,
            active_lib2_names=active_lib2_names,
            cfg0_work_root=work_root / "cfg_0",
            link_work=raw_work,
            env=env,
            obj_prefix=lib2_prefix,
        )
        lib2_paths = [p.resolve() for p in lib2_objs]
        lib2_parsed = [_ELF_INSPECT.parse_reloc_obj(p.read_bytes(), p.name) for p in lib2_paths]
        lib2_obj_entries: list[dict[str, Any]] = []
        lib2_trim_list: list[dict[str, Any] | None] = []
        for p_o, tr in zip(lib2_paths, lib2_recs):
            input_notes[p_o] = {"kind": "lib2Object"}
            raw_o = p_o.read_bytes()
            sha_o = hashlib.sha256(raw_o).hexdigest()
            lib2_obj_entries.append({
                "name": str(tr["name"]),
                "path": _rel_path(p_o),
                "sha256": sha_o,
                "size": len(raw_o),
                "trimmedFrom": {
                    "rlib": str(tr["rlib"]),
                    "member": str(tr["member"]),
                    "provenance": str(tr["provenance"]),
                    "roots": list(tr["roots"]),
                    "memberSha256": str(tr["member_sha256"]),
                    "memberSize": int(tr["member_size"]),
                    "keepSetSha256": str(tr["keep_set_sha256"]),
                    "keepSet": list(tr["keep_set"]),
                },
            })
            lib2_trim_list.append(tr)
        defs_2: set[str] = set()
        undefs_2: set[str] = set()
        for po in lib2_parsed:
            defs_2.update(po.defs_by_name.keys())
            undefs_2.update(po.undefs_by_name.keys())
        images.append({
            "role": "lib2",
            "config": str(lib2_cfg_rel),
            "paths": lib2_paths,
            "parsed": lib2_parsed,
            "objects_json": lib2_obj_entries,
            "trimmed": lib2_trim_list,
            "externs": sorted(undefs_2 - defs_2),
            "exports": list(active_lib2_roots),
        })

    crates_secs = time.monotonic() - t_crates0

    # 4. Compile `std-main` (`-Zbuild-std=std,panic_abort -- --emit=obj`), weaken overlapping
    #    image symbols (`main`), and stage deterministic `compiler_builtins.a`.
    manifest_abs = (repo_root_res / main_rust_manifest_rel).resolve()
    manifest_doc = tomllib.loads(manifest_abs.read_text(encoding="utf-8"))
    pkg_name = str(manifest_doc["package"]["name"])
    bins_cfg = manifest_doc.get("bin")
    if isinstance(bins_cfg, list) and len(bins_cfg) == 1 and isinstance(bins_cfg[0], Mapping):
        bin_name = str(bins_cfg[0].get("name") or pkg_name)
    else:
        bin_name = pkg_name
    bin_stem = bin_name.replace("-", "_")
    std_crate_dir = manifest_abs.parent

    home_p = pathlib.Path(env["HOME"]) if env.get("HOME") else None
    cargo_home_p = (
        pathlib.Path(env["CARGO_HOME"])
        if env.get("CARGO_HOME")
        else (home_p / ".cargo" if home_p is not None else None)
    )
    rustup_home_p = (
        pathlib.Path(env["RUSTUP_HOME"])
        if env.get("RUSTUP_HOME")
        else (home_p / ".rustup" if home_p is not None else None)
    )
    std_enc_flags = _build_std_encoded_rustflags(
        repo_root=repo_root_res,
        crate_dir=std_crate_dir,
        work_dir=raw_work,
        cargo_home=cargo_home_p,
        rustup_home=rustup_home_p,
        sysroot=sysroot,
    )
    std_target_dir = raw_work / "rust-target"
    std_env = dict(env)
    std_env["RUSTC_BOOTSTRAP"] = "1"
    std_env["CARGO_TARGET_DIR"] = str(std_target_dir)
    std_env["CARGO_ENCODED_RUSTFLAGS"] = std_enc_flags
    std_env.pop("RUSTFLAGS", None)
    direct_rustc = sysroot / "bin" / "rustc"
    direct_cargo = sysroot / "bin" / "cargo"
    if direct_rustc.is_file():
        std_env["RUSTC"] = str(direct_rustc)
    cargo_exe = str(direct_cargo) if direct_cargo.is_file() else "cargo"
    t_bstd0 = time.monotonic()
    subprocess.run(
        [
            cargo_exe,
            "rustc",
            "--manifest-path",
            str(manifest_abs),
            "--target",
            STDBIN_MUSL_TARGET,
            "--release",
            "--locked",
            "-Zbuild-std=std,panic_abort",
            "--",
            "--emit=obj",
        ],
        cwd=str(repo_root_res),
        stdout=subprocess.DEVNULL,
        check=True,
        env=std_env,
    )
    build_std_secs = time.monotonic() - t_bstd0
    deps_dir = std_target_dir / STDBIN_MUSL_TARGET / "release" / "deps"
    main_objs = sorted(
        p
        for p in deps_dir.iterdir()
        if p.is_file()
        and p.name.startswith(f"{bin_stem}-")
        and p.name.endswith(".o")
        and not p.name.endswith(".rcgu.o")
    )
    rcgu_objs = sorted(
        p
        for p in deps_dir.iterdir()
        if p.is_file()
        and p.name.startswith(f"{bin_stem}-")
        and p.name.endswith(".rcgu.o")
    )
    builtins_rlibs = sorted(
        p
        for p in deps_dir.iterdir()
        if p.is_file()
        and p.name.startswith("libcompiler_builtins-")
        and p.name.endswith(".rlib")
    )
    raw_main_o = main_objs[0] if len(main_objs) == 1 else (rcgu_objs[0] if not main_objs and len(rcgu_objs) == 1 else None)
    if raw_main_o is None:
        raise RuntimeError(f"expected single `{bin_stem}-*.o` in {deps_dir}, found {main_objs} / {rcgu_objs}")
    if len(builtins_rlibs) != 1:
        raise RuntimeError(f"expected single `libcompiler_builtins-*.rlib` in {deps_dir}, found {builtins_rlibs}")

    objcopy_bin = str(env["LLVM_OBJCOPY"])
    main_rust_o = (raw_work / "main_rust.o").resolve()
    subprocess.run(
        [objcopy_bin, "--strip-debug", str(raw_main_o), str(main_rust_o)],
        check=True,
        env=dict(env),
    )

    all_img_defs: set[str] = set()
    for im in images:
        if im.get("role") == "lib2":
            continue
        for po in im["parsed"]:
            all_img_defs.update(po.defs_by_name.keys())
    parsed_main_pre = _ELF_INSPECT.parse_reloc_obj(main_rust_o.read_bytes(), "main_rust.o")
    weakened_in_main = sorted(set(parsed_main_pre.defs_by_name.keys()) & all_img_defs)
    if weakened_in_main:
        tmp_unweak = raw_work / "main_rust.unweakened.o"
        main_rust_o.rename(tmp_unweak)
        subprocess.run(
            [
                objcopy_bin,
                *(f"--weaken-symbol={s}" for s in weakened_in_main),
                str(tmp_unweak),
                str(main_rust_o),
            ],
            check=True,
            env=dict(env),
        )
        tmp_unweak.unlink()

    raw_cb_a = raw_work / "compiler_builtins.raw.a"
    compiler_builtins_a = (raw_work / "compiler_builtins.a").resolve()
    raw_cb_a.write_bytes(
        _rewrite_gnu_archive_member_names(builtins_rlibs[0].read_bytes(), keep_only_obj=True)
    )
    subprocess.run(
        [
            objcopy_bin,
            "--enable-deterministic-archives",
            "--strip-debug",
            str(raw_cb_a),
            str(compiler_builtins_a),
        ],
        check=True,
        env=dict(env),
    )
    raw_cb_a.unlink()
    compiler_builtins_a.write_bytes(
        _rewrite_gnu_archive_member_names(compiler_builtins_a.read_bytes(), keep_only_obj=False)
    )

    rebuild_key_json = _compute_stdbin_rebuild_key(
        sysroot=sysroot,
        manifest_path=manifest_abs,
        crate_dir=std_crate_dir,
        bin_stem=bin_stem,
        repo_root=repo_root_res,
        work_dir=raw_work,
        env=env,
    )
    shutil.rmtree(std_target_dir, ignore_errors=True)

    dyn_stubs_o: pathlib.Path | None = None
    dyn_stub_manifest: list[dict[str, Any]] | None = None
    dyn_manifest_sha: str | None = None
    eff_lean_externs: list[str] | None = (
        list(initial_lean_externs) if initial_lean_externs is not None else None
    )
    eff_extern_data: list[str] | None = None
    if dynamic_stubs_dir is not None:
        im0_ext_set = set(images[0]["externs"])
        bfs_externs, bfs_ext_data = _derive_reachable_externs_from_objs(
            images[0]["parsed"], images[0]["exports"]
        )
        eff_extern_data = bfs_ext_data
        if not eff_lean_externs or not set(eff_lean_externs).issubset(im0_ext_set):
            eff_lean_externs = bfs_externs
        sc_all_for_manifest = [
            sc_copied["crt1.o"],
            sc_copied["crti.o"],
            sc_copied["crtbegin.o"],
            sc_copied["crtend.o"],
            sc_copied["crtn.o"],
        ]
        rt_archives_for_manifest = [
            sc_copied["libc.a"],
            compiler_builtins_a,
            sc_copied["libunwind.a"],
        ]
        all_im_paths = [p for im in images if im.get("role") != "lib2" for p in im["paths"]]
        dyn_stub_manifest = _compute_stock_stub_manifest(
            lib_objs=all_im_paths,
            rt_inputs=[*sc_all_for_manifest, main_rust_o, *staged_native, *rt_archives_for_manifest],
            lean_externs=eff_lean_externs,
            displaced_weak=displaced_weak,
        )
        dyn_manifest_sha = stub_manifest_sha256(dyn_stub_manifest)
        dyn_stubs_o, _ = _assemble_stub_manifest_object(
            stub_manifest=dyn_stub_manifest,
            stubs_dir=dynamic_stubs_dir,
            env=env,
            expected_manifest_count=len(dyn_stub_manifest),
            expected_manifest_sha=dyn_manifest_sha,
        )
        b_dyn = dyn_stubs_o.read_bytes()
        _ELF_INSPECT.parse_reloc_obj(b_dyn, dyn_stubs_o.name)
        dst_dyn = (nat_dst_dir / dyn_stubs_o.name).resolve()
        if dst_dyn.exists():
            raise RuntimeError(f"duplicate native object basename {dyn_stubs_o.name!r}")
        dst_dyn.write_bytes(b_dyn)
        input_notes[dst_dyn] = {"kind": "nativeObject"}
        staged_native.append(dst_dyn)

    retired_slots: list[dict[str, Any]] = []
    if active_lib2_roots:
        stub_cands_nat = [
            p
            for p in staged_native
            if p.name == STUB_OBJ_NAME or ("stub" in p.name and p.suffix == ".o")
        ]
        if len(stub_cands_nat) != 1:
            raise RuntimeError(
                f"expected 1 staged stub `.o` in {nat_dst_dir} for C2 retirement, found {stub_cands_nat}"
            )
        retired_slots = _retire_stub_slots_in_object(
            stub_cands_nat[0],
            active_lib2_roots,
            env,
        )

    # 5. Pre-link hooked-extern plan & assemble exact `ld.lld` command (`cwd = raw_work`).
    pre_objs = [sc_copied["crt1.o"], sc_copied["crti.o"], sc_copied["crtbegin.o"]]
    libs_group = [sc_copied["libc.a"], compiler_builtins_a, sc_copied["libunwind.a"]]
    post_objs = [sc_copied["crtend.o"], sc_copied["crtn.o"]]

    hooked_set: set[str] = set()
    for im in images:
        if any(t is not None for t in im["trimmed"]):
            hooked_set.update(im["externs"])
    hooked_sorted = sorted(hooked_set)
    traced_only_sorted = sorted(
        {ext for im in images for ext in im["externs"] if ext not in hooked_set}
    ) if hooked_sorted else []
    traced_only_set = set(traced_only_sorted)

    stub_objs_for_hooks = [*pre_objs, *post_objs, *staged_native]
    strong_stub_defs: set[str] = set()
    for p_st in stub_objs_for_hooks:
        po_st = _ELF_INSPECT.parse_reloc_obj(p_st.read_bytes(), p_st.name)
        for s_st in po_st.symbols:
            if s_st.bind == 1 and s_st.st_shndx != 0 and s_st.name in hooked_set:
                strong_stub_defs.add(s_st.name)

    parsed_cb_ar = _ELF_INSPECT.parse_ar_archive(compiler_builtins_a.read_bytes(), "compiler_builtins.a")
    weak_shadowed: list[dict[str, str]] = []
    rejected_ar_defs: list[str] = []
    seen_ar_defs: set[tuple[str, str, bool]] = set()
    for amem in parsed_cb_ar.members:
        for s_ar in amem.obj.symbols:
            if s_ar.st_shndx != 0 and s_ar.bind in (1, 2) and s_ar.name in hooked_set:
                is_weak = s_ar.bind == 2
                seen_ar_defs.add((s_ar.name, f"compiler_builtins.a({amem.name})", is_weak))
    for sym_nm, am_label, is_weak in sorted(seen_ar_defs):
        if is_weak and sym_nm in strong_stub_defs:
            weak_shadowed.append({"symbol": sym_nm, "archiveMember": am_label})
        else:
            rejected_ar_defs.append(f"{am_label}: {sym_nm} ({'weak' if is_weak else 'global'})")
    if rejected_ar_defs:
        raise RuntimeError(
            f"non-runtime archive defines hooked extern(s) not shadowed by strong stub: {rejected_ar_defs}"
        )

    # Sibling-defined hooked externs (`config[1]` exports resolving `config[0]` externs).
    sibling_plan: list[dict[str, Any]] = []
    for a_idx, im_a in enumerate(images):
        if not any(t is not None for t in im_a["trimmed"]):
            continue
        for ext_nm in im_a["externs"]:
            found_sibs: list[tuple[int, pathlib.Path, Any]] = []
            for b_idx, im_b in enumerate(images):
                if b_idx == a_idx:
                    continue
                for p_b, po_b in zip(im_b["paths"], im_b["parsed"]):
                    if ext_nm in po_b.defs_by_name:
                        found_sibs.append((b_idx, p_b, po_b))
            if len(found_sibs) > 1:
                raise RuntimeError(f"hooked extern `{ext_nm}` defined by multiple sibling objects: {found_sibs}")
            if not found_sibs:
                continue
            b_idx, p_b, po_b = found_sibs[0]
            im_b = images[b_idx]
            if ext_nm in im_b["externs"]:
                raise RuntimeError(f"sibling `{im_b['config']}` both defines and imports `{ext_nm}`")
            matched_exp: str | None = None
            for decl_exp in im_b["exports"]:
                hits_e = [
                    s
                    for s in po_b.symbols
                    if s.st_shndx != 0
                    and not s.is_local
                    and s.name == ext_nm
                    and (s.name == decl_exp or s.demangled == decl_exp)
                ]
                if hits_e:
                    matched_exp = decl_exp
                    break
            if matched_exp is None:
                raise RuntimeError(
                    f"hooked extern `{ext_nm}` defined by sibling `{im_b['config']}` ({p_b.name}), "
                    "which does not declare it in `[placed] exports`"
                )
            if not any(sp["symbol"] == ext_nm for sp in sibling_plan):
                sibling_plan.append({
                    "symbol": ext_nm,
                    "export": matched_exp,
                    "hookedBy": im_a["config"],
                    "image": im_b["config"],
                    "object_path": p_b,
                })
    sibling_plan.sort(key=lambda sp: sp["symbol"])

    trim_roots_for_gc: set[str] = set()
    trim_paths_for_gc: list[pathlib.Path] = []
    for im in images:
        for p_o, po_o, t_info in zip(im["paths"], im["parsed"], im["trimmed"]):
            if t_info is not None:
                trim_paths_for_gc.append(p_o)
                if im.get("role") == "lib2":
                    for r_sym in t_info["roots"]:
                        trim_roots_for_gc.add(str(r_sym))
                else:
                    for sym in po_o.symbols:
                        if sym.bind in (1, 2) and 0 < sym.st_shndx < len(po_o.sections) and sym.name:
                            trim_roots_for_gc.add(sym.name)

    exe_out = (stage_raw_res / elf_name).resolve()
    cli_lld_args: list[str] = []
    lld_arg_files_json: list[dict[str, str]] = []
    if ld_mode != "none":
        assert ld_abs is not None and ld_rel is not None and ld_sha is not None
        ld_abs_res = ld_abs.resolve()
        cli_lld_args.extend(["-T", str(ld_abs_res)])
        lld_arg_files_json.append({
            "arg": f"-T {ld_rel}",
            "path": ld_rel,
            "sha256": ld_sha,
        })
    if lld_no_relax:
        cli_lld_args.append("--no-relax")
    for exp_sym in placed_exports:
        if exp_sym != "main":
            cli_lld_args.append(f"--undefined={exp_sym}")

    lld_args_paths: list[str] = [
        *STDBIN_LLD_BASE_FLAGS,
        *cli_lld_args,
        *(f"--undefined={r}" for r in sorted(trim_roots_for_gc)),
        *(["--print-gc-sections"] if trim_paths_for_gc else []),
        "--why-extract=why-extract.tsv",
        "-Map=link.map",
        "--print-gc-sections",
        *(f"--trace-symbol={n}" for n in [*hooked_sorted, *traced_only_sorted]),
        "-o",
        str(exe_out),
        *(str(p) for p in pre_objs),
        *(str(p) for p in staged_native),
        *(str(p) for im in images for p in im["paths"]),
        "--start-group",
        str(main_rust_o),
        *(str(p) for p in libs_group),
        "--end-group",
        *(str(p) for p in post_objs),
    ]

    t0 = time.monotonic()
    lld_proc = subprocess.run(
        [str(env["LLD"]), *lld_args_paths],
        cwd=str(raw_work),
        capture_output=True,
        text=True,
        check=False,
        env=dict(env),
    )
    link_secs = time.monotonic() - t0
    lld_log = (lld_proc.stdout or "") + (lld_proc.stderr or "")
    if lld_proc.returncode != 0:
        raise RuntimeError(
            f"ld.lld exited with rc={lld_proc.returncode}:\n{lld_log[-4000:]}"
        )
    (raw_work / "lld.log").write_text(lld_log, encoding="utf-8")

    # 6. Post-link checks: 0 trimmed sections GC'd, hook single-definer + sibling placed VMA,
    #    archive member provenance, unwind audit, exempt aliases, and JSON manifest emission.
    lld_out_lines: list[str] = []
    for raw_l in lld_log.splitlines():
        tl = _parse_trace_line(raw_l)
        if tl is not None and tl[2] in traced_only_set:
            continue
        lld_out_lines.append(f"{raw_l}\n")
    lld_out = "".join(lld_out_lines)

    dropped_trim_secs: list[str] = []
    for raw_l in lld_out.splitlines():
        ts = raw_l.strip()
        if ts.startswith("removing unused section "):
            rem = ts[len("removing unused section ") :]
            if any(rem.startswith(f"{tp}:(") for tp in trim_paths_for_gc):
                dropped_trim_secs.append(rem)
    if dropped_trim_secs:
        raise RuntimeError(
            f"--gc-sections removed kept section(s) of trimmed sysroot object(s): {dropped_trim_secs}"
        )

    elf_bytes = exe_out.read_bytes()
    exec_elf = _ELF_INSPECT.parse_exec_elf(elf_bytes, elf_name)
    raw_map_text = (raw_work / "link.map").read_text(encoding="utf-8")
    raw_why_text = (raw_work / "why-extract.tsv").read_text(encoding="utf-8")
    if retired_slots:
        local_fn_vmas = {
            s.name: int(s.st_value)
            for s in exec_elf.symbols
            if s.st_shndx != 0 and s.is_local and s.stype == 2 and s.name
        }
        for rs_rec in retired_slots:
            ret_nm = str(rs_rec["retiredSymbol"])
            if ret_nm not in local_fn_vmas:
                raise RuntimeError(
                    f"retired stub symbol `{ret_nm}` missing from linked ELF `.symtab`"
                )
            rs_rec["origAddr"] = hex(local_fn_vmas[ret_nm])

    trace_defs_hooked: list[tuple[str, str]] = []
    for raw_l in lld_out.splitlines():
        ts = raw_l.strip()
        if ": definition of " in ts:
            f_s, sym_s = ts.split(": definition of ", 1)
            trace_defs_hooked.append((f_s, sym_s))
    miscounted_hooks = [
        f"{n}: {sum(1 for _, s in trace_defs_hooked if s == n)} definitions"
        for n in hooked_sorted
        if sum(1 for _, s in trace_defs_hooked if s == n) != 1
    ]
    if miscounted_hooks:
        raise RuntimeError(
            f"hooked extern(s) did not have exactly 1 `definition of` trace line: {miscounted_hooks}"
        )

    runtime_archive_paths = [sc_copied["libc.a"], sc_copied["libunwind.a"]]
    allowed_obj_strs = {str(p) for p in stub_objs_for_hooks}
    allowed_sib_pairs = {(str(sp["object_path"]), sp["symbol"]) for sp in sibling_plan}
    bad_definers: list[str] = []
    for f_s, sym_s in trace_defs_hooked:
        in_stub = f_s in allowed_obj_strs
        in_rt = any(
            f_s.startswith(f"{ra}(") and f_s.endswith(")") for ra in runtime_archive_paths
        )
        in_sib = (f_s, sym_s) in allowed_sib_pairs
        if not (in_stub or in_rt or in_sib):
            bad_definers.append(f"{f_s}: {sym_s}")
    if bad_definers:
        raise RuntimeError(
            f"hooked extern(s) resolved to disallowed definer(s): {bad_definers}"
        )

    sibling_defs_json: list[dict[str, Any]] = []
    for sp in sibling_plan:
        sym_nm = sp["symbol"]
        obj_p = sp["object_path"]
        if not any(f_s == str(obj_p) and s_s == sym_nm for f_s, s_s in trace_defs_hooked):
            raise RuntimeError(f"hooked extern `{sym_nm}` not defined by sibling {obj_p}")
        po_sib = _ELF_INSPECT.parse_reloc_obj(obj_p.read_bytes(), obj_p.name)
        sib_syms = [
            s for s in po_sib.symbols if s.name == sym_nm and s.st_shndx != 0 and not s.is_local
        ]
        if len(sib_syms) != 1:
            raise RuntimeError(f"{obj_p}: `{sym_nm}` not defined uniquely")
        sib_sec_nm = po_sib.sections[sib_syms[0].st_shndx].name
        want_map_item = f"{obj_p}:({sib_sec_nm})"
        vmas_found: list[int] = []
        for ml in raw_map_text.splitlines()[1:]:
            if len(ml) >= 49 and ml[49:] == f"        {want_map_item}":
                vmas_found.append(int(ml[:49].split()[0], 16))
        if len(vmas_found) != 1:
            raise RuntimeError(f"link.map: expected 1 line for {want_map_item}, found {vmas_found}")
        placed_va = vmas_found[0] + sib_syms[0].st_value
        elf_hits = [s.st_value for s in exec_elf.symbols if s.name == sym_nm and s.st_shndx != 0]
        if len(elf_hits) != 1 or elf_hits[0] != placed_va:
            raise RuntimeError(
                f"sibling extern `{sym_nm}` ELF addr {elf_hits} != placed {placed_va:#x}"
            )
        sibling_defs_json.append({
            "symbol": sym_nm,
            "export": sp["export"],
            "hookedBy": sp["hookedBy"],
            "image": sp["image"],
            "object": obj_p.name,
            "address": hex(placed_va),
        })

    # Compute `exemptedAliases` (matching `trimmed::exempt_aliases` / `verify::FORBIDDEN_SYMS`).
    exec_def_addr: dict[str, int] = {}
    for s_ex in exec_elf.symbols:
        if s_ex.st_shndx != 0 and s_ex.name and s_ex.name not in exec_def_addr:
            exec_def_addr[s_ex.name] = s_ex.st_value
    exempt_aliases: set[str] = set()
    for im in images:
        for po_o, t_info in zip(im["parsed"], im["trimmed"]):
            if t_info is None:
                continue
            roots_t = set(t_info["roots"])
            for sec in po_o.sections:
                if (sec.sh_flags & 0x2) == 0 or sec.sh_type == 0:
                    continue
                here = [
                    s
                    for s in po_o.symbols
                    if s.st_shndx == sec.idx and s.stype in (1, 2)
                ]
                if not any(
                    not s.is_local and (s.name in roots_t or s.demangled in roots_t)
                    for s in here
                ):
                    continue
                for s_cand in here:
                    if any(pat in s_cand.name for pat in STDBIN_FORBIDDEN_ALIAS_SUBSTRS):
                        owners = [
                            o_s
                            for o_s in here
                            if not any(pat in o_s.name for pat in STDBIN_FORBIDDEN_ALIAS_SUBSTRS)
                            and o_s.st_value == s_cand.st_value
                            and o_s.st_size >= s_cand.st_size
                        ]
                        if not owners:
                            continue
                        owner0 = owners[0]
                        owner_va = exec_def_addr.get(owner0.name)
                        cand_va = exec_def_addr.get(s_cand.name)
                        if (
                            owner_va is not None
                            and cand_va is not None
                            and cand_va == (owner_va - owner0.st_value) + s_cand.st_value
                        ):
                            exempt_aliases.add(s_cand.name)
    exempt_sorted = sorted(exempt_aliases)

    archive_members_json = _parse_stdbin_archive_members(
        raw_why_text, raw_map_text, lld_out, stage_raw_res
    )
    unwind_audit_json = _stdbin_unwind_audit(elf_bytes, archive_members_json)
    segments_json, sections_json = _stdbin_segments_and_sections_json(elf_bytes)

    all_link_input_paths = [
        *pre_objs,
        *staged_native,
        *(p for im in images for p in im["paths"]),
        main_rust_o,
        *libs_group,
        *post_objs,
    ]
    inputs_json: list[dict[str, Any]] = []
    for p_in in all_link_input_paths:
        ent_in: dict[str, Any] = {
            "path": _rel_path(p_in),
            "sha256": _BASE.sha256_file(p_in),
        }
        if p_in in input_notes:
            ent_in.update(input_notes[p_in])
        inputs_json.append(ent_in)

    def _rel_str_tok(tok: str) -> str:
        p_t = pathlib.Path(tok)
        if p_t.is_absolute():
            return _rel_path(p_t)
        return tok

    trace_defs_json: list[dict[str, str]] = []
    for raw_l in lld_log.splitlines():
        tl = _parse_trace_line(raw_l)
        if tl is None or not tl[1].endswith("definition of"):
            continue
        f_raw, verb_s, sym_s = tl
        if f_raw.endswith(")") and "(" in f_raw:
            ar_p, mem_nm = f_raw[:-1].rsplit("(", 1)
            f_rel = f"{_rel_str_tok(ar_p)}({mem_nm})"
        else:
            f_rel = _rel_str_tok(f_raw)
        trace_defs_json.append({"symbol": sym_s, "kind": verb_s, "file": f_rel})

    lld_ver_line = (
        subprocess.run(
            [str(env["LLD"]), "--version"],
            capture_output=True,
            text=True,
            check=True,
            env=dict(env),
        )
        .stdout.splitlines()[0]
        .strip()
    )
    zig_ver_line = subprocess.run(
        [str(env["ZIG"]), "version"],
        capture_output=True,
        text=True,
        check=True,
        env=dict(env),
    ).stdout.strip()

    lld_json: dict[str, Any] = {
        "version": lld_ver_line,
        "args": [_rel_str_tok(a) for a in lld_args_paths],
        "log": "work/lld.log",
        "map": "work/link.map",
    }
    if lld_arg_files_json:
        lld_json["argFiles"] = lld_arg_files_json

    stock_link_manifest: dict[str, Any] = {
        "tool": "snapshot-link --stock",
        "configs": [
            (
                {"config": im["config"], "role": "lib2", "objects": im["objects_json"]}
                if im.get("role") == "lib2"
                else {"config": im["config"], "objects": im["objects_json"]}
            )
            for im in images
        ],
        "main": main_rust_manifest_rel,
        "elf": {
            "name": elf_name,
            "size": len(elf_bytes),
            "sha256": hashlib.sha256(elf_bytes).hexdigest(),
        },
        "lld": lld_json,
        "zig": zig_ver_line,
        "inputs": inputs_json,
        "segments": segments_json,
        "sections": sections_json,
        "parserCheck": "not-run (engine check_std_elf_exempting not ported)",
    }
    if hooked_sorted:
        stock_link_manifest["traceSymbolDefinitions"] = trace_defs_json
    if trim_paths_for_gc:
        stock_link_manifest["trimmedSysrootObjects"] = {
            "engineCommit": eng_head,
            "hookedExterns": hooked_sorted,
            "exemptedAliases": exempt_sorted,
            "weakArchiveShadowed": weak_shadowed,
            "siblingDefinedExterns": sibling_defs_json,
        }
    stock_link_manifest["stdBin"] = {
        "rustc": STDBIN_PINNED_RUSTC_RELEASE,
        "commit": STDBIN_PINNED_RUSTC_COMMIT,
        "llvm": STDBIN_PINNED_LLVM_VERSION,
        "selfContainedDir": f"<sysroot>/lib/rustlib/{STDBIN_MUSL_TARGET}/lib/self-contained",
        "weakenedInMain": weakened_in_main,
        "rebuildKey": rebuild_key_json,
        "archiveMembers": archive_members_json,
        "unwindAudit": unwind_audit_json,
    }
    if retired_slots:
        stock_link_manifest["retiredStubSlots"] = retired_slots
    if moved_libc_rows:
        stock_link_manifest["c2MovedLibcRows"] = list(moved_libc_rows)

    (stage_raw_res / ENGINE_STOCK_META_NAME).write_text(
        json.dumps(stock_link_manifest, indent=2) + "\n", encoding="utf-8"
    )

    # Emit diagnostic `census.json` & `timing.json` alongside `stock-link.json`.
    total_reloc_sites = sum(
        len(sec.relocs)
        for im in images
        for po in im["parsed"]
        for sec in po.sections
        if (sec.sh_flags & 0x2) != 0 and sec.sh_type != 0
    )
    census_json = {
        "tool": "cli-elf-stock direct-lld census",
        "noRelax": bool(lld_no_relax),
        "configs": [
            {
                "config": im["config"],
                "objects": len(im["parsed"]),
                "allocSections": sum(
                    1
                    for po in im["parsed"]
                    for sec in po.sections
                    if (sec.sh_flags & 0x2) != 0 and sec.sh_type != 0
                ),
                "relocationSites": sum(
                    len(sec.relocs)
                    for po in im["parsed"]
                    for sec in po.sections
                    if (sec.sh_flags & 0x2) != 0 and sec.sh_type != 0
                ),
            }
            for im in images
        ],
        "totalRelocationSites": total_reloc_sites,
    }
    (stage_raw_res / "census.json").write_text(
        json.dumps(census_json, indent=2) + "\n", encoding="utf-8"
    )
    stage_total_secs = time.monotonic() - t_stage_start
    timings_json = {
        "lldWallSeconds": link_secs,
        "cratesCompileSeconds": crates_secs,
        "buildStdSeconds": build_std_secs,
        "totalSeconds": stage_total_secs,
    }
    (stage_raw_res / "timing.json").write_text(
        json.dumps(timings_json, indent=2) + "\n", encoding="utf-8"
    )
    return {
        "timings": timings_json,
        "stubs_o": dyn_stubs_o,
        "stub_manifest": dyn_stub_manifest,
        "manifest_sha": dyn_manifest_sha,
        "lean_externs": eff_lean_externs,
        "extern_data": eff_extern_data,
    }


def _extract_sysroot_trims_from_rlib_dir(
    *,
    sysroot_entries: Sequence[Mapping[str, Any]],
    rlib_dir: pathlib.Path,
    start_idx: int,
    link_work: pathlib.Path | None = None,
    obj_prefix: str = "lib0_",
    use_snapshot_compat_emit: bool = False,
    provenance_kind: str = "sysroot",
) -> tuple[list[pathlib.Path], list[dict[str, Any]]]:
    """D4: Data-driven extraction of `[[sysroot_objects]]` / `[[dep_objects]]` trims from `rlib_dir`
    (`lib<crate>-*.rlib`), recording `rlib`, `rlib_sha256`, `member`, `member_sha256`,
    `kept_sections`, and `emitted_sha256`, and supporting multiple disjoint keep-sets from the
    same `.rlib` member with zero code change."""
    if not sysroot_entries:
        return [], []
    if not rlib_dir.is_dir():
        raise RuntimeError(f"{provenance_kind} target libdir missing: {rlib_dir}")

    rlibs_by_crate: dict[str, list[pathlib.Path]] = {}
    for p in sorted(rlib_dir.glob("*.rlib")):
        if p.is_file():
            rlibs_by_crate.setdefault(_rlib_crate_stem(p), []).append(p)

    parsed_cache: dict[pathlib.Path, Any] = {}
    used_sections_by_member: dict[tuple[str, str], set[str]] = {}
    emitted_paths: list[pathlib.Path] = []
    trim_records: list[dict[str, Any]] = []

    for t_off, entry in enumerate(sysroot_entries):
        crate_name = str(entry["crate"])
        entry_name = str(entry.get("name") or crate_name)
        roots = [str(r) for r in (entry.get("roots") or ())]
        if not roots:
            raise RuntimeError(f"[[{provenance_kind}_objects]] `{entry_name}` has empty `roots`")
        cands = rlibs_by_crate.get(crate_name.replace("-", "_"), [])
        if len(cands) != 1:
            raise RuntimeError(
                f"expected 1 {provenance_kind} rlib for crate `{crate_name}` in {rlib_dir}, found {cands}"
            )
        rlib_path = cands[0]
        if rlib_path not in parsed_cache:
            parsed_cache[rlib_path] = _ELF_INSPECT.parse_rlib_archive(
                rlib_path.read_bytes(), rlib_path.name
            )
        parsed_rlib = parsed_cache[rlib_path]

        # Locate the unique `.o` member defining `roots[0]` (and verify all `roots` live in that member).
        matching_members = []
        for mem in parsed_rlib.members:
            if mem.obj is None:
                continue
            has_root0 = any(
                s.bind in (1, 2)
                and s.stype in (1, 2)
                and s.st_shndx not in (0, 0xFFF1, 0xFFF2)
                and (s.name == roots[0] or s.demangled == roots[0])
                for s in mem.obj.symbols
            )
            if has_root0:
                matching_members.append(mem)
        if len(matching_members) != 1:
            raise RuntimeError(
                f"{provenance_kind} root `{roots[0]}` expected in 1 `.o` member of {rlib_path.name}, "
                f"found {[m.name for m in matching_members]}"
            )
        mem = matching_members[0]
        label = f"{rlib_path.name}({mem.name})"
        kept_sections = _root_section_closure_reloc(mem.obj, roots, label)

        member_key = (str(parsed_rlib.sha256), str(mem.sha256))
        prev_secs = used_sections_by_member.setdefault(member_key, set())
        overlap = sorted(prev_secs & set(kept_sections))
        if overlap:
            raise RuntimeError(
                f"overlapping `kept_sections` {overlap} across `[[{provenance_kind}_objects]]` rows in {label}"
            )
        prev_secs.update(kept_sections)

        kept_pairs_meta: list[tuple[int, str]]
        if use_snapshot_compat_emit:
            trimmed_bytes, kept_pairs_meta = _emit_trimmed_reloc_obj_snapshot_compat(
                mem.data, kept_sections, label=label
            )
        else:
            trimmed_bytes = _ELF_INSPECT.extract_reloc_section_subset(
                mem.data, kept_sections, label=label
            )
            kept_pairs_meta = [
                (sec.idx, sec.name)
                for sec in mem.obj.sections
                if sec.name in set(kept_sections) and (sec.sh_flags & 0x2) != 0
            ]
        keep_set_lines = [f"{e_idx}\t{s_nm}" for e_idx, s_nm in kept_pairs_meta]
        keep_set_sha = hashlib.sha256(
            ("".join(f"{ln}\n" for ln in keep_set_lines)).encode("utf-8")
        ).hexdigest()
        provenance_line = (
            f"{provenance_kind} `{rlib_path.name}` member `{mem.name}` "
            f"(sha256 {mem.sha256}, {len(kept_pairs_meta)} kept sections)"
        )
        obj_idx = start_idx + t_off
        obj_name = f"{obj_prefix}{obj_idx}.o"
        trimmed_obj = _ELF_INSPECT.parse_reloc_obj(trimmed_bytes, obj_name)
        for root in roots:
            ok = any(
                s.bind in (1, 2)
                and s.stype in (1, 2)
                and s.st_shndx not in (0, 0xFFF1, 0xFFF2)
                and (s.name == root or s.demangled == root)
                for s in trimmed_obj.symbols
            )
            if not ok:
                raise RuntimeError(f"trimmed `{obj_name}` lost root symbol `{root}`")

        if link_work is not None:
            link_work.mkdir(parents=True, exist_ok=True)
            dst_o = link_work / obj_name
            dst_o.write_bytes(trimmed_bytes)
            emitted_paths.append(dst_o)

        trim_records.append({
            "index": obj_idx,
            "object": obj_name,
            "name": entry_name,
            "crate": crate_name,
            "roots": roots,
            "rlib": rlib_path.name,
            "rlib_sha256": str(parsed_rlib.sha256),
            "member": str(mem.name),
            "member_sha256": str(mem.sha256),
            "member_size": len(mem.data),
            "kept_sections": kept_sections,
            "keep_set": keep_set_lines,
            "keep_set_sha256": keep_set_sha,
            "provenance": provenance_line,
            "emitted_sha256": str(trimmed_obj.sha256),
        })
    return emitted_paths, trim_records


def _extract_lib2_trims_direct(
    *,
    lib2_cfg: Mapping[str, Any],
    active_lib2_names: Sequence[str],
    cfg0_work_root: pathlib.Path,
    link_work: pathlib.Path | None,
    env: Mapping[str, str],
    obj_prefix: str = "lib2_",
) -> tuple[list[pathlib.Path], list[dict[str, Any]]]:
    """C2: Extract ordered `lib2_*.o` trims from `cli/rt/translation.toml` (`[[sysroot_objects]]`
    from GNU sysroot + `[[dep_objects]]` from `cfg_0`'s compiled `release/deps`), filtered to
    `active_lib2_names` (plus `helper_roots` of active rows ONLY), with `SystemTime::add`
    (`std_time_add`) guaranteed LAST and disjoint in `.text.lib2` and `.rodata.lib2`."""
    if not active_lib2_names:
        return [], []
    rows_tbl = lib2_cfg.get("lib2_rows")
    if not isinstance(rows_tbl, Mapping):
        raise RuntimeError("`cli/rt/translation.toml` missing `[lib2_rows]` table")
    allowed_roots: set[str] = set()
    for rname in active_lib2_names:
        rinfo = rows_tbl.get(rname)
        if not isinstance(rinfo, Mapping):
            raise RuntimeError(f"unknown `[lib2_rows]` entry {rname!r}")
        allowed_roots.add(str(rinfo["root"]))
        for hr in rinfo.get("helper_roots") or ():
            allowed_roots.add(str(hr))

    ordered_specs: list[tuple[int, str, dict[str, Any]]] = []
    seen_orders: set[int] = set()
    for kind, key in (("sysroot", "sysroot_objects"), ("dep", "dep_objects")):
        for raw_ent in lib2_cfg.get(key) or ():
            if not isinstance(raw_ent, Mapping):
                raise RuntimeError(f"malformed `{key}` entry in `cli/rt/translation.toml`: {raw_ent!r}")
            if "order" not in raw_ent:
                raise RuntimeError(
                    f"`cli/rt/translation.toml` `{key}` entry `{raw_ent.get('name')}` missing mandatory `order`"
                )
            ord_idx = int(raw_ent["order"])
            if ord_idx in seen_orders:
                raise RuntimeError(f"duplicate `order = {ord_idx}` in `cli/rt/translation.toml`")
            seen_orders.add(ord_idx)
            filt_roots = [str(r) for r in (raw_ent.get("roots") or ()) if str(r) in allowed_roots]
            if not filt_roots:
                continue
            ent_copy = dict(raw_ent)
            ent_copy["roots"] = filt_roots
            ordered_specs.append((ord_idx, kind, ent_copy))
    ordered_specs.sort(key=lambda item: item[0])
    if not ordered_specs:
        raise RuntimeError(
            f"0 `lib2` trim objects matched active rows {list(active_lib2_names)}"
        )
    if "time_add" in active_lib2_names and ordered_specs[-1][2].get("name") != "std_time_add":
        raise RuntimeError(
            "`SystemTime::add` (`std_time_add`) must be strictly LAST in `lib2` link order, "
            f"got {[it[2].get('name') for it in ordered_specs]}"
        )

    target = str(lib2_cfg.get("target") or DEFAULT_RUST_TARGET_TRIPLE)
    sysroot_tlibdir = pathlib.Path(
        subprocess.run(
            ["rustc", "--print", "target-libdir", "--target", target],
            capture_output=True,
            text=True,
            check=True,
            env=dict(env),
        ).stdout.strip()
    ).resolve()
    dep_rlib_dir = (cfg0_work_root / "cargo_target" / target / "release" / "deps").resolve()

    all_paths: list[pathlib.Path] = []
    all_records: list[dict[str, Any]] = []
    used_by_kind_and_member: dict[tuple[str, str, str], set[str]] = {}
    for out_idx, (_ord_idx, kind, ent_copy) in enumerate(ordered_specs):
        rdir = sysroot_tlibdir if kind == "sysroot" else dep_rlib_dir
        em_p, em_r = _extract_sysroot_trims_from_rlib_dir(
            sysroot_entries=[ent_copy],
            rlib_dir=rdir,
            start_idx=out_idx,
            link_work=link_work,
            obj_prefix=obj_prefix,
            use_snapshot_compat_emit=True,
            provenance_kind=kind,
        )
        rec0 = em_r[0]
        mkey = (kind, str(rec0["rlib_sha256"]), str(rec0["member_sha256"]))
        prev_s = used_by_kind_and_member.setdefault(mkey, set())
        ov_s = sorted(prev_s & set(rec0["kept_sections"]))
        if ov_s:
            raise RuntimeError(
                f"overlapping `kept_sections` {ov_s} across `lib2` entries in {rec0['rlib']}({rec0['member']})"
            )
        prev_s.update(rec0["kept_sections"])
        all_paths.extend(em_p)
        all_records.extend(em_r)

    if "time_add" in active_lib2_names and all_paths:
        add_obj = _ELF_INSPECT.parse_reloc_obj(all_paths[-1].read_bytes(), all_paths[-1].name)
        for sec in add_obj.sections:
            if (sec.sh_flags & 0x2) == 0 or sec.sh_type == 0:
                continue
            if (sec.sh_flags & 0x10) != 0:
                raise RuntimeError(
                    f"`std_time_add` (`{all_paths[-1].name}`) section `{sec.name}` has SHF_MERGE "
                    f"(`sh_flags={sec.sh_flags:#x}`), violating tail-truncation invariance"
                )
            if sec.name.startswith(".data.rel.ro"):
                raise RuntimeError(
                    f"`std_time_add` (`{all_paths[-1].name}`) contains unexpected `{sec.name}`, "
                    "which would sit before `.rodata` in `.rodata.lib2` instead of at its tail"
                )
    return all_paths, all_records


def _extract_sysroot_trims_direct(
    *,
    cfg: Mapping[str, Any],
    start_idx: int,
    link_work: pathlib.Path | None,
    env: Mapping[str, str],
    obj_prefix: str = "lib0_",
    use_snapshot_compat_emit: bool = False,
) -> tuple[list[pathlib.Path], list[dict[str, Any]]]:
    sysroot_entries = list(cfg.get("sysroot_objects") or ())
    if not sysroot_entries:
        return [], []
    target = str(cfg.get("target") or DEFAULT_RUST_TARGET_TRIPLE)
    tlibdir = pathlib.Path(
        subprocess.run(
            ["rustc", "--print", "target-libdir", "--target", target],
            capture_output=True,
            text=True,
            check=True,
            env=dict(env),
        ).stdout.strip()
    )
    return _extract_sysroot_trims_from_rlib_dir(
        sysroot_entries=sysroot_entries,
        rlib_dir=tlibdir,
        start_idx=start_idx,
        link_work=link_work,
        obj_prefix=obj_prefix,
        use_snapshot_compat_emit=use_snapshot_compat_emit,
    )


def _verify_sysroot_trims_against_toolchain(
    *,
    cfg: Mapping[str, Any],
    expected_trims: Sequence[Mapping[str, Any]],
    start_idx: int,
    env: Mapping[str, str] | None = None,
    use_snapshot_compat_emit: bool = False,
) -> None:
    eff_env = dict(env) if env is not None else os.environ.copy()
    _scrub_build_env(eff_env, preserve_zig_cache=True)
    _, fresh_trims = _extract_sysroot_trims_direct(
        cfg=cfg,
        start_idx=start_idx,
        link_work=None,
        env=eff_env,
        use_snapshot_compat_emit=use_snapshot_compat_emit,
    )
    if len(fresh_trims) != len(expected_trims):
        raise RuntimeError(
            f"recomputed sysroot_trims count {len(fresh_trims)} != lock {len(expected_trims)}"
        )
    for idx, (got_r, exp_r) in enumerate(zip(fresh_trims, expected_trims)):
        for k in (
            "object",
            "crate",
            "roots",
            "rlib",
            "rlib_sha256",
            "member",
            "member_sha256",
            "kept_sections",
            "emitted_sha256",
        ):
            if got_r.get(k) != exp_r.get(k):
                raise RuntimeError(
                    f"toolchain sysroot_trims[{idx}].{k} = {got_r.get(k)!r} != lock {exp_r.get(k)!r}"
                )


def build_stock_into(
    repo_root: pathlib.Path,
    out_dir: pathlib.Path,
    engine_dir: pathlib.Path,
    explicit_engine: bool = False,
    isolated_cold_zig: bool = False,
    subdir_nesting: str = "build_stock",
    stock_lock_path: pathlib.Path | None = None,
    keep_work_dir: pathlib.Path | None = None,
    ci_mode: bool = False,
    unpinned: bool = False,
    lib2_rows_spec: str | None = None,
    c2_libc_rows_spec: str | None = None,
    c2_rehearsal_dehook: bool = False,
) -> pathlib.Path:
    eff_stock_lock = (
        stock_lock_path if stock_lock_path is not None else (repo_root / DEFAULT_REL_STOCK_LOCK)
    )
    lock = _load_stock_lock_file(eff_stock_lock)
    if _is_stdbin_lock(lock):
        return build_stock_stdbin_into(
            repo_root=repo_root,
            out_dir=out_dir,
            engine_dir=engine_dir,
            lock=lock,
            eff_stock_lock=eff_stock_lock,
            explicit_engine=explicit_engine,
            isolated_cold_zig=isolated_cold_zig,
            subdir_nesting=subdir_nesting,
            keep_work_dir=keep_work_dir,
            ci_mode=ci_mode,
            unpinned=unpinned,
            lib2_rows_spec=lib2_rows_spec,
            c2_libc_rows_spec=c2_libc_rows_spec,
            c2_rehearsal_dehook=c2_rehearsal_dehook,
        )
    if unpinned:
        raise RuntimeError("`--unpinned` is only supported for `--stdbin` builds")
    if lib2_rows_spec is not None or c2_libc_rows_spec is not None or c2_rehearsal_dehook:
        raise RuntimeError("C2 `lib2`/`2C` options are only supported for `--stdbin` builds")

    elf_name = _default_elf_name_for_lock(lock)
    stock_ld_rel = str(lock.get("linker_script_path") or DEFAULT_REL_STOCK_LD)
    stock_ld = repo_root / stock_ld_rel
    if not stock_ld.is_file():
        raise RuntimeError(f"stock linker script missing: {stock_ld}")
    exp_ld_sha = str(lock.get("linker_script_sha256") or "")
    if not HEX64_RE.match(exp_ld_sha):
        raise RuntimeError(
            f"{eff_stock_lock} missing mandatory 64-hex `linker_script_sha256`: {exp_ld_sha!r}"
        )
    stock_ld_sha = _BASE.sha256_file(stock_ld)
    if stock_ld_sha != exp_ld_sha:
        raise RuntimeError(f"{stock_ld} sha256 {stock_ld_sha} != lock {exp_ld_sha}")

    main_c_rel = str(lock["main_c_path"])
    main_c = repo_root / main_c_rel
    if not main_c.is_file():
        raise RuntimeError(f"main_c file missing: {main_c}")
    got_main_sha = _BASE.sha256_file(main_c)
    if got_main_sha != lock["main_c_sha256"]:
        raise RuntimeError(f"{main_c} sha256 {got_main_sha} != lock {lock['main_c_sha256']}")

    exp_eng = _expected_engine_commit(lock)
    eng_head = _verify_clean_pinned_engine(
        engine_dir, exp_eng, allow_explicit_mismatch=explicit_engine, ci_mode=ci_mode
    )

    cfg_rel = str(lock["config_path"])
    cfg_path = repo_root / cfg_rel
    cfg = tomllib.loads(cfg_path.read_text(encoding="utf-8"))
    b2_derived = derive_placed_expectations(repo_root, cfg_path=cfg_path, stock_lock=lock)
    placed_exports = list(b2_derived["exports"])
    lean_externs = list(b2_derived["externs"])
    generated_extern_data = alpha_checks.parse_generated_lean_extern_data(repo_root)

    lock_stub_manifest = lock.get("stub_manifest")
    if not isinstance(lock_stub_manifest, list) or not lock_stub_manifest:
        raise RuntimeError(
            f"{eff_stock_lock} missing non-empty `[[stub_manifest]]` list required for stock link"
        )
    if "expected_stub_manifest_count" not in lock or "stub_manifest_sha256" not in lock:
        raise RuntimeError(
            f"{eff_stock_lock} missing mandatory `expected_stub_manifest_count` / `stub_manifest_sha256` (F7(1))"
        )
    exp_manifest_count = int(lock["expected_stub_manifest_count"])
    exp_manifest_sha = str(lock["stub_manifest_sha256"])
    if "expected_symtab_count" not in lock or "expected_loader_sym_count" not in lock or "expected_retained_stub_count" not in lock:
        raise RuntimeError(
            f"{eff_stock_lock} missing mandatory `expected_symtab_count` / `expected_loader_sym_count` / `expected_retained_stub_count`"
        )
    lock_displaced_weak = tuple(
        str(x) for x in lock.get("displaced_weak", alpha_checks.EXPECTED_DISPLACED_WEAK)
    )

    m4_lock_rel: str | None = None
    m4_lock_sha: str | None = None
    if lock.get("m4_lock_path"):
        m4_lock_rel = str(lock["m4_lock_path"])
        m4_disk = repo_root / m4_lock_rel
        if not m4_disk.is_file():
            raise RuntimeError(f"pinned m4 lock missing at {m4_disk}")
        m4_lock_sha = _BASE.sha256_file(m4_disk)
        if "m4_lock_sha256" in lock and m4_lock_sha != str(lock["m4_lock_sha256"]):
            raise RuntimeError(
                f"{m4_disk} sha256 {m4_lock_sha} != lock m4_lock_sha256 {lock['m4_lock_sha256']!r}"
            )

    cache_tmp_root = _BASE.get_cache_tmp_root()
    with tempfile.TemporaryDirectory(dir=cache_tmp_root, prefix="cli-elf-stock.") as run_tmp_str:
        run_tmp = pathlib.Path(run_tmp_str)
        env, scrubbed_keys = _resolve_scrubbed_pinned_toolchain(lock, run_tmp)
        if isolated_cold_zig:
            zig_cache = run_tmp / "cold-zig-cache"
            (zig_cache / "global").mkdir(parents=True, exist_ok=True)
            (zig_cache / "local").mkdir(parents=True, exist_ok=True)
            env["ZIG_GLOBAL_CACHE_DIR"] = str(zig_cache / "global")
            env["ZIG_LOCAL_CACHE_DIR"] = str(zig_cache / "local")

        _BASE.ensure_musl_tarball_verified(engine_dir, lock, env)

        work_root = run_tmp / subdir_nesting
        link_out = work_root / "link_out"
        link_work = link_out / "work"
        link_work.mkdir(parents=True, exist_ok=True)

        # 1. Stage `crt1.o`, `main.o`, `libc.a`, `libcompiler_rt.a` directly via `zig cc` + `llvm-objcopy`.
        lock_rt_map = lock.get("runtime_archives")
        if not isinstance(lock_rt_map, Mapping) or not lock_rt_map:
            raise RuntimeError(
                f"{eff_stock_lock} missing mandatory `[runtime_archives]` sha256 table (W3)"
            )
        wanted_rt_archives = [str(k) for k in lock_rt_map.keys() if str(k).endswith(".a")]
        crt1_o, main_o, runtime_archives = _compile_main_c_and_stage_musl_runtime_direct(
            main_c=main_c,
            work_root=work_root,
            link_work=link_work,
            env=env,
            wanted_archive_names=wanted_rt_archives,
        )
        runtime_archive_shas = {
            p.name: _BASE.sha256_file(p) for p in [crt1_o, *runtime_archives]
        }
        _verify_runtime_archive_shas(
            runtime_archive_shas,
            {str(k): str(v) for k, v in lock["runtime_archives"].items()}
            if isinstance(lock.get("runtime_archives"), Mapping)
            else None,
        )

        # 2. Stage musl-string native `.o`s + SHA-pinned `strlen.lo` into `link_work`.
        raw_musl_native = _compile_stock_native_objects(repo_root, engine_dir, lock, work_root, env)
        raw_strlen_lo, pinned_musl_ref_bodies, strlen_override = _extract_pinned_musl_strlen_and_refs(
            lock, work_root, env
        )
        native_objs: list[pathlib.Path] = []
        for src_nat in [*raw_musl_native, raw_strlen_lo]:
            dst_nat = link_work / src_nat.name
            shutil.copy2(src_nat, dst_nat)
            native_objs.append(dst_nat)

        # 3. Compile `[crates]` directly (`cargo rustc --emit=obj`) and trim `[[sysroot_objects]]` (D4).
        crate_objs, crate_obj_shas = _compile_rust_crates_direct(
            repo_root=repo_root,
            cfg_path=cfg_path,
            cfg=cfg,
            work_root=work_root,
            link_work=link_work,
            env=env,
        )
        trim_objs, sysroot_trims = _extract_sysroot_trims_direct(
            cfg=cfg,
            start_idx=len(crate_objs),
            link_work=link_work,
            env=env,
        )
        lib_objs = [*crate_objs, *trim_objs]
        if not lib_objs:
            raise RuntimeError(f"0 `lib0_*.o` objects produced for {cfg_path}")

        all_lib0_shas = {p.name: _BASE.sha256_file(p) for p in lib_objs}
        lib0_agg_sha = _compute_lib0_aggregate_sha256(all_lib0_shas)

        # (c)(2) & W3: Compare `crate_objects`, `sysroot_trims`, and `lib0_aggregate_sha256` against lock when present.
        if "crate_objects" in lock:
            exp_crates = {str(k): str(v) for k, v in lock["crate_objects"].items()}
            if crate_obj_shas != exp_crates:
                raise RuntimeError(
                    f"built crate `.o` sha256 mismatch vs lock `crate_objects`:\n"
                    f"  got:  {crate_obj_shas!r}\n"
                    f"  lock: {exp_crates!r}"
                )
        if "sysroot_trims" in lock:
            exp_trims = lock["sysroot_trims"]
            if len(sysroot_trims) != len(exp_trims):
                raise RuntimeError(
                    f"built sysroot_trims count {len(sysroot_trims)} != lock {len(exp_trims)}"
                )
            for t_i, (got_t, exp_t) in enumerate(zip(sysroot_trims, exp_trims)):
                for k in (
                    "object",
                    "crate",
                    "roots",
                    "rlib",
                    "rlib_sha256",
                    "member",
                    "member_sha256",
                    "kept_sections",
                    "emitted_sha256",
                ):
                    if got_t.get(k) != exp_t.get(k):
                        raise RuntimeError(
                            f"built sysroot_trims[{t_i}].{k} = {got_t.get(k)!r} != lock {exp_t.get(k)!r}"
                        )
        if "lib0_aggregate_sha256" in lock and lib0_agg_sha != str(lock["lib0_aggregate_sha256"]):
            raise RuntimeError(
                f"built lib0_aggregate_sha256 {lib0_agg_sha!r} != lock {lock['lib0_aggregate_sha256']!r}"
            )

        # 4. Assemble & cross-verify `extern_stubs_clean.o` against recomputed `stub_manifest`.
        raw_stubs_o, manifest_sha = _assemble_stub_manifest_object(
            stub_manifest=lock_stub_manifest,
            stubs_dir=work_root / "stubs",
            env=env,
            expected_manifest_count=exp_manifest_count,
            expected_manifest_sha=exp_manifest_sha,
        )
        stubs_o = link_work / raw_stubs_o.name
        shutil.copy2(raw_stubs_o, stubs_o)

        stub_manifest = _compute_stock_stub_manifest(
            lib_objs=lib_objs,
            rt_inputs=[crt1_o, main_o, *native_objs, *runtime_archives],
            lean_externs=lean_externs,
            displaced_weak=lock_displaced_weak,
        )
        recomputed_manifest_sha = stub_manifest_sha256(stub_manifest)
        if recomputed_manifest_sha != manifest_sha:
            raise RuntimeError(
                f"recomputed stub_manifest sha256 {recomputed_manifest_sha} != lock {manifest_sha}; "
                f"re-pin `[[stub_manifest]]` in {eff_stock_lock}"
            )

        # 5. Invoke stock `ld.lld` directly in `link_out` (with deterministic relative `work/*` paths).
        staged_ld_dir = work_root / "linker"
        staged_ld_dir.mkdir(parents=True, exist_ok=True)
        staged_stock_ld = staged_ld_dir / stock_ld.name
        shutil.copy2(stock_ld, staged_stock_ld)
        built_elf = link_out / elf_name
        built_map = link_out / DEFAULT_LINK_MAP_NAME

        lld_cmd, lld_argv_template = build_canonical_lld_argv(
            lld_bin=env["LLD"],
            placed_exports=placed_exports,
            stock_ld_rel=stock_ld_rel,
            stock_ld_abs=staged_stock_ld,
            out_elf=built_elf,
            crt1_o=crt1_o,
            main_o=main_o,
            native_objs=native_objs,
            lib_objs=lib_objs,
            stubs_o=stubs_o,
            runtime_archives=runtime_archives,
            out_map=built_map,
            cwd_dir=link_out,
        )
        if "lld_argv" in lock and lld_argv_template != [str(x) for x in lock["lld_argv"]]:
            raise RuntimeError(
                f"lld_argv template mismatch vs lock:\n  got:  {lld_argv_template!r}\n  lock: {lock['lld_argv']!r}"
            )
        subprocess.run(lld_cmd, cwd=str(link_out), check=True, env=env)
        if not built_map.is_file():
            raise RuntimeError(f"stock ld.lld did not write `-Map` file at {built_map}")
        link_map_sha = _BASE.sha256_file(built_map)

        verify_summary = verify_stock_elf(
            built_elf,
            cfg_path,
            stub_manifest,
            repo_root=repo_root,
            expected_symtab_count=int(lock["expected_symtab_count"]),
            expected_loader_sym_count=int(lock["expected_loader_sym_count"]),
            expected_stub_manifest_count=exp_manifest_count,
            expected_retained_stub_count=int(lock["expected_retained_stub_count"]),
            expected_stub_manifest_sha=manifest_sha,
            verbose=True,
        )

        alpha_scan = alpha_checks.scan_link_inputs_for_alpha(
            cli_link_objs=lib_objs,
            other_objs=[crt1_o, main_o],
            native_objs=native_objs,
            stubs_o=stubs_o,
            runtime_archives=runtime_archives,
            strlen_source_override=strlen_override,
            pinned_musl_ref_bodies=pinned_musl_ref_bodies,
        )
        alpha_b3 = alpha_checks.compute_and_verify_alpha_b3(
            elf_bytes=built_elf.read_bytes(),
            map_text=built_map.read_text(encoding="utf-8"),
            alpha_scan=alpha_scan,
            generated_extern_data=generated_extern_data,
            expected_lock=lock if "s2_real_body_lock" in lock else None,
            verify_addresses=True,
        )

        digest = _BASE.sha256_file(built_elf)
        size = built_elf.stat().st_size
        lld_ver = subprocess.run(
            [env["LLD"], "--version"], capture_output=True, text=True, check=True, env=env
        ).stdout.strip()
        input_files = [crt1_o, main_o, *native_objs, *lib_objs, stubs_o, *runtime_archives]
        stock_lld_arg_files = {stock_ld_rel: stock_ld_sha}
        stock_meta = assemble_cv_stock_meta(
            explicit_engine=explicit_engine,
            eng_head=eng_head,
            engine_stock_link_sha=None,
            snapshot_link_sha=None,
            rustc_version=str(lock["rustc_version"]),
            lld_ver=lld_ver,
            zig_version=str(lock["zig_version"]),
            lld_argv_template=lld_argv_template,
            lld_cmd_raw=lld_cmd,
            stock_ld_rel=stock_ld_rel,
            stock_ld_sha=stock_ld_sha,
            stock_lld_arg_files=stock_lld_arg_files,
            placed_exports=placed_exports,
            b2_derived=b2_derived,
            scrubbed_keys=scrubbed_keys,
            env=env,
            runtime_archive_shas=runtime_archive_shas,
            manifest_sha=manifest_sha,
            stub_manifest=stub_manifest,
            elf_name=elf_name,
            elf_size=size,
            elf_sha=digest,
            verify_summary=verify_summary,
            input_files=input_files,
            config_path=cfg_rel,
            crate_objects=crate_obj_shas,
            lib0_aggregate_sha256=lib0_agg_sha,
            sysroot_trims=sysroot_trims,
            m4_lock_path=m4_lock_rel,
            m4_lock_sha256=m4_lock_sha,
            link_map_sha256=link_map_sha,
            alpha_scan=alpha_scan,
            alpha_displaced_weak_lock=alpha_b3["alpha_displaced_weak_lock"],
            s2_real_body_lock=alpha_b3["s2_real_body_lock"],
            d1_extern_data_lock=alpha_b3["d1_extern_data_lock"],
        )
        built_cv_json = link_out / DEFAULT_STOCK_META_NAME
        built_cv_json.write_text(json.dumps(stock_meta, indent=2) + "\n", encoding="utf-8")

        # (c)(3): Copy `<elf_name>`, `cv-stock-link.json`, `link.map`, and `work/` into `out_dir`,
        # NEVER writing or overwriting `out_dir / "stock-link.json"`.
        out_dir.mkdir(parents=True, exist_ok=True)
        dst_elf = out_dir / elf_name
        dst_cv_json = out_dir / DEFAULT_STOCK_META_NAME
        dst_map = out_dir / DEFAULT_LINK_MAP_NAME
        dst_work = out_dir / "work"
        if dst_cv_json.resolve() == (out_dir / ENGINE_STOCK_META_NAME).resolve():
            raise RuntimeError("cv metadata path must never collide with engine `stock-link.json`")

        tmp_dst_elf = out_dir / f".{elf_name}.tmp"
        tmp_dst_cv_json = out_dir / f".{DEFAULT_STOCK_META_NAME}.tmp"
        tmp_dst_map = out_dir / f".{DEFAULT_LINK_MAP_NAME}.tmp"
        tmp_dst_work = out_dir / ".work.tmp"

        if tmp_dst_work.exists():
            shutil.rmtree(tmp_dst_work)
        shutil.copytree(link_work, tmp_dst_work)
        shutil.copy2(built_elf, tmp_dst_elf)
        shutil.copy2(built_cv_json, tmp_dst_cv_json)
        shutil.copy2(built_map, tmp_dst_map)

        if dst_work.exists():
            shutil.rmtree(dst_work)
        tmp_dst_work.replace(dst_work)
        tmp_dst_map.replace(dst_map)
        tmp_dst_elf.replace(dst_elf)
        tmp_dst_cv_json.replace(dst_cv_json)

        if keep_work_dir is not None:
            if keep_work_dir.exists():
                shutil.rmtree(keep_work_dir)
            shutil.copytree(work_root, keep_work_dir, symlinks=True)

        print(f"cli-elf-stock --build: OK -> {dst_elf} ({size} bytes, sha256={digest})")
        return dst_elf


def check_stock_determinism(
    repo_root: pathlib.Path,
    elf_path: pathlib.Path,
    engine_dir: pathlib.Path,
    explicit_engine: bool = False,
    cold_zig_cache: bool = False,
    stock_lock_path: pathlib.Path | None = None,
    ci_mode: bool = False,
) -> int:
    if not elf_path.is_file():
        raise RuntimeError(f"target stock ELF missing for --check: {elf_path}")
    eff_stock_lock = (
        stock_lock_path if stock_lock_path is not None else (repo_root / DEFAULT_REL_STOCK_LOCK)
    )
    lock = _load_stock_lock_file(eff_stock_lock)
    if _is_stdbin_lock(lock):
        _resolve_and_verify_stdbin_linker_script(
            repo_root=repo_root,
            lock=lock,
            lock_label=eff_stock_lock,
            ci_mode=ci_mode,
        )
    meta_name = _default_meta_name_for_lock(lock)
    meta_path = elf_path.parent / meta_name
    target_meta, rec_manifest, rec_manifest_sha, rec_rt_shas = _load_and_verify_stock_meta(
        meta_path,
        lock,
        expected_stub_manifest_sha=str(lock.get("stub_manifest_sha256") or ""),
        require_implicit_engine=not explicit_engine,
        allow_explicit_engine_mismatch=explicit_engine,
    )

    need_eng_sl = _is_stdbin_lock(lock) or ("engine_stock_link_json_sha256" in lock)
    target_map = elf_path.parent / DEFAULT_LINK_MAP_NAME
    target_eng_sl = elf_path.parent / ENGINE_STOCK_META_NAME
    if not target_map.is_file():
        raise RuntimeError(f"target link.map missing for --check: {target_map}")
    if need_eng_sl and not target_eng_sl.is_file():
        raise RuntimeError(f"target engine stock-link.json missing for --check: {target_eng_sl}")

    cache_tmp_root = _BASE.get_cache_tmp_root()
    with tempfile.TemporaryDirectory(dir=cache_tmp_root, prefix="cli-elf-stock-chk.") as tmp_str:
        tmp = pathlib.Path(tmp_str)
        out1 = tmp / "a"
        out2 = tmp / "deep" / "nested" / "path" / "b"
        e1 = build_stock_into(
            repo_root=repo_root,
            out_dir=out1,
            engine_dir=engine_dir,
            explicit_engine=explicit_engine,
            isolated_cold_zig=False,
            subdir_nesting="short",
            stock_lock_path=eff_stock_lock,
            ci_mode=ci_mode,
        )
        e2 = build_stock_into(
            repo_root=repo_root,
            out_dir=out2,
            engine_dir=engine_dir,
            explicit_engine=explicit_engine,
            isolated_cold_zig=cold_zig_cache,
            subdir_nesting="deep/a/b/c/d",
            stock_lock_path=eff_stock_lock,
            ci_mode=ci_mode,
        )
        b_target = elf_path.read_bytes()
        b1 = e1.read_bytes()
        b2 = e2.read_bytes()
        if b1 != b2:
            raise RuntimeError(
                f"non-deterministic stock rebuild: build1 ({len(b1)} B) != build2 ({len(b2)} B)"
            )
        if b1 != b_target:
            raise RuntimeError(
                f"stock ELF drift vs {elf_path}: rebuilt sha256={_BASE.sha256_file(e1)} != "
                f"existing sha256={_BASE.sha256_file(elf_path)}"
            )

        if need_eng_sl:
            sl_target = target_eng_sl.read_bytes()
            sl1 = (out1 / ENGINE_STOCK_META_NAME).read_bytes()
            sl2 = (out2 / ENGINE_STOCK_META_NAME).read_bytes()
            if sl1 != sl2 or sl1 != sl_target:
                raise RuntimeError(
                    "non-deterministic engine `stock-link.json` across path depths "
                    f"(sha1={hashlib.sha256(sl1).hexdigest()}, sha2={hashlib.sha256(sl2).hexdigest()}, "
                    f"target={hashlib.sha256(sl_target).hexdigest()})"
                )

        # Verify `link.map` is byte-identical across arbitrary temp directory depths!
        m_target = target_map.read_bytes()
        m1 = (out1 / DEFAULT_LINK_MAP_NAME).read_bytes()
        m2 = (out2 / DEFAULT_LINK_MAP_NAME).read_bytes()
        if m1 != m2 or m1 != m_target:
            raise RuntimeError(
                "non-deterministic `link.map` across path depths "
                f"(sha1={hashlib.sha256(m1).hexdigest()}, sha2={hashlib.sha256(m2).hexdigest()}, "
                f"target={hashlib.sha256(m_target).hexdigest()})"
            )

        for cand_meta_path in (out1 / meta_name, out2 / meta_name):
            cand_meta, m_cand, sha_cand, rt_cand = _load_and_verify_stock_meta(
                cand_meta_path,
                lock,
                expected_stub_manifest_sha=rec_manifest_sha,
                require_implicit_engine=not explicit_engine,
                allow_explicit_engine_mismatch=explicit_engine,
            )
            if m_cand != rec_manifest or sha_cand != rec_manifest_sha:
                raise RuntimeError(f"rebuilt stub_manifest drift in {cand_meta_path}")
            _verify_runtime_archive_shas(rt_cand, rec_rt_shas)
            if not _is_stdbin_lock(lock):
                if cand_meta.get("crate_objects") != target_meta.get("crate_objects"):
                    raise RuntimeError(f"rebuilt crate_objects drift in {cand_meta_path}")
                if cand_meta.get("lib0_aggregate_sha256") != target_meta.get("lib0_aggregate_sha256"):
                    raise RuntimeError(f"rebuilt lib0_aggregate_sha256 drift in {cand_meta_path}")
                if cand_meta.get("sysroot_trims") != target_meta.get("sysroot_trims"):
                    raise RuntimeError(f"rebuilt sysroot_trims drift in {cand_meta_path}")

        print(
            f"cli-elf-stock --check: OK (cmp byte-identical ELF + link.map + inputs across 2 builds "
            f"at different path depths, {len(b1)} bytes, sha256={_BASE.sha256_file(elf_path)}, "
            f"cold_zig_cache={cold_zig_cache})"
        )
    return 0


def verify_alpha_standalone(
    *,
    repo_root: pathlib.Path,
    engine_out_dir: pathlib.Path | None = None,
    elf_path: pathlib.Path | None = None,
    map_path: pathlib.Path | None = None,
    stubs_o_path: pathlib.Path | None = None,
    stock_lock_path: pathlib.Path | None = None,
    strict_lock: bool = False,
    json_out_path: pathlib.Path | None = None,
    ci_mode: bool = False,
    verbose: bool = True,
) -> dict[str, Any]:
    """Standalone `--verify-alpha` for direct C-recipe output dirs (`cv-stock-link.json` + `work/*`
    or metadata-only) as well as engine `snapshot-link --stock` output directories."""
    eff_lock_path = (
        stock_lock_path if stock_lock_path is not None else (repo_root / DEFAULT_REL_STOCK_LOCK)
    )
    stock_lock = (
        _load_stock_lock_file(eff_lock_path)
        if eff_lock_path.is_file()
        else {}
    )
    if stock_lock and _is_stdbin_lock(stock_lock):
        _resolve_and_verify_stdbin_linker_script(
            repo_root=repo_root,
            lock=stock_lock,
            lock_label=eff_lock_path,
            ci_mode=ci_mode,
        )

    if engine_out_dir is None:
        if elf_path is None:
            raise RuntimeError("`--verify-alpha` requires `--engine-out-dir` or `--elf`")
        engine_out_dir = elf_path.parent

    cv_meta_path = engine_out_dir / DEFAULT_STOCK_META_NAME
    cv_stdbin_meta_path = engine_out_dir / DEFAULT_STDBIN_META_NAME
    stage_sl_path = engine_out_dir.parent / "stock_stage" / ENGINE_STOCK_META_NAME
    direct_sl_path = engine_out_dir / ENGINE_STOCK_META_NAME

    if (
        not (engine_out_dir / "work").is_dir()
        and not stage_sl_path.is_file()
        and (cv_stdbin_meta_path.is_file() or cv_meta_path.is_file())
    ):
        # Mode C: `--out-dir` without retained `work/` directory (`cv-stock{-stdbin,}-link.json` + `link.map`)
        eff_cv_meta_path = cv_stdbin_meta_path if cv_stdbin_meta_path.is_file() else cv_meta_path
        cv_meta = json.loads(eff_cv_meta_path.read_text(encoding="utf-8"))
        eff_elf = (
            elf_path
            if elf_path is not None
            else (
                engine_out_dir
                / str((cv_meta.get("elf") or {}).get("name") or _default_elf_name_for_lock(stock_lock))
            )
        )
        if not eff_elf.is_file():
            raise RuntimeError(f"ELF file missing for --verify-alpha: {eff_elf}")
        got_elf_sha = _BASE.sha256_file(eff_elf)
        got_elf_sz = eff_elf.stat().st_size
        eff_lock_for_meta = stock_lock if strict_lock else {}
        res = _verify_alpha_from_meta_and_lock(
            elf_path=eff_elf,
            meta=cv_meta,
            stock_lock=eff_lock_for_meta,
            repo_root=repo_root,
            map_path=map_path,
        )
        if json_out_path is not None:
            json_out_path.parent.mkdir(parents=True, exist_ok=True)
            json_out_path.write_text(json.dumps(res, indent=2) + "\n", encoding="utf-8")
        if verbose:
            dw = res["alpha_displaced_weak_lock"]
            d1 = res["d1_extern_data_lock"]
            print(
                f"cli-elf-stock --verify-alpha: OK ({eff_elf.name}: {got_elf_sz} bytes, "
                f"sha256={got_elf_sha}, displaced_weak={len(dw['displaced_weak'])}, "
                f"referrers={len(dw['displaced_weak_referrers'])}, "
                f"s2={len(res['s2_real_body_lock'])}, "
                f"d1_kept={len(d1['kept'])}, d1_gc_dead={len(d1['gc_dead'])})"
            )
        return res

    cli_link_objs: list[pathlib.Path] = []
    other_objs: list[pathlib.Path] = []
    native_objs: list[pathlib.Path] = []
    runtime_archives: list[pathlib.Path] = []
    has_strlen_lo_obj = False

    if cv_meta_path.is_file() and ((engine_out_dir / "work").is_dir() or stage_sl_path.is_file()):
        # Mode B: Direct-link `out_dir` (`cv-stock-link.json` + `work/*`) or staged `keep_work/link_out`
        cv_meta = json.loads(cv_meta_path.read_text(encoding="utf-8"))
        eff_elf = (
            elf_path
            if elf_path is not None
            else (engine_out_dir / str((cv_meta.get("elf") or {}).get("name") or _default_elf_name_for_lock(stock_lock)))
        )
        if not eff_elf.is_file():
            raise RuntimeError(f"ELF file missing for --verify-alpha: {eff_elf}")
        got_elf_sha = _BASE.sha256_file(eff_elf)
        got_elf_sz = eff_elf.stat().st_size
        cv_elf = cv_meta.get("elf") or {}
        if cv_elf.get("sha256") and got_elf_sha != str(cv_elf["sha256"]):
            raise RuntimeError(
                f"ELF sha256 {got_elf_sha!r} != cv-stock-link.json {cv_elf.get('sha256')!r}"
            )
        if cv_elf.get("size") is not None and got_elf_sz != int(cv_elf["size"]):
            raise RuntimeError(
                f"ELF size {got_elf_sz} != cv-stock-link.json {cv_elf.get('size')}"
            )
        if map_path is not None:
            eff_map = map_path
        elif (engine_out_dir / DEFAULT_LINK_MAP_NAME).is_file():
            eff_map = engine_out_dir / DEFAULT_LINK_MAP_NAME
        else:
            eff_map = engine_out_dir / "work" / DEFAULT_LINK_MAP_NAME
        if not eff_map.is_file():
            raise RuntimeError(f"missing `-Map` file for --verify-alpha at {eff_map}")

        if stage_sl_path.is_file():
            stage_sl = json.loads(stage_sl_path.read_text(encoding="utf-8"))
            stage_root = stage_sl_path.parent
            for cfg_ent in stage_sl.get("configs") or ():
                if str(cfg_ent.get("role") or "") == "lib2":
                    continue
                for obj_ent in cfg_ent.get("objects") or ():
                    p_obj = (stage_root / str(obj_ent["path"])).resolve()
                    if not p_obj.is_file():
                        raise RuntimeError(f"missing staged cliLinkObj {p_obj}")
                    cli_link_objs.append(p_obj)
        else:
            work_d = engine_out_dir / "work"
            cli_link_objs = [
                p.resolve()
                for p in sorted(work_d.glob("lib0_*.o"), key=lambda p: int(p.stem.split("_")[1]))
            ]
        if not cli_link_objs:
            raise RuntimeError(f"0 `lib0_*.o` objects found for --verify-alpha under {engine_out_dir}")
        cli_resolved_set = {p.resolve() for p in cli_link_objs}

        lld_argv_raw = [str(x) for x in (cv_meta.get("lld_argv_raw") or ())]
        if len(lld_argv_raw) < 2:
            raise RuntimeError(f"{cv_meta_path} missing `lld_argv_raw`")
        linked_files: list[pathlib.Path] = []
        skip_next = False
        for tok in lld_argv_raw[1:]:
            if skip_next:
                skip_next = False
                continue
            if tok in ("-u", "-z", "-T", "-o", "-Map", "--entry"):
                skip_next = True
                continue
            if tok.startswith("-"):
                continue
            p_in = (engine_out_dir / tok).resolve() if not pathlib.Path(tok).is_absolute() else pathlib.Path(tok).resolve()
            if not p_in.is_file():
                raise RuntimeError(f"missing lld input {p_in} referenced by {cv_meta_path}")
            linked_files.append(p_in)

        if stubs_o_path is not None:
            eff_stubs_o = stubs_o_path.resolve()
            if not eff_stubs_o.is_file():
                raise RuntimeError(f"--stubs-o file not found: {eff_stubs_o}")
        else:
            stub_cands = [p for p in linked_files if "stub" in p.name and p.suffix == ".o"]
            if len(stub_cands) != 1:
                raise RuntimeError(
                    f"expected 1 stub `.o` in {cv_meta_path} lld_argv_raw (or pass `--stubs-o`), found {stub_cands}"
                )
            eff_stubs_o = stub_cands[0]

        native_names = {"memcpy.o", "memset.o", "memmove.o", "memcmp.o", "bcmp.o", "strlen.lo"}
        for p_in in linked_files:
            if p_in in cli_resolved_set or p_in == eff_stubs_o:
                continue
            if p_in.suffix == ".a":
                runtime_archives.append(p_in)
            elif (
                p_in.name in native_names
                or p_in.parent.name in ("native", "musl-self-contained")
                or "musl-string" in p_in.parts
            ):
                native_objs.append(p_in)
                if p_in.name == "strlen.lo":
                    has_strlen_lo_obj = True
            else:
                other_objs.append(p_in)
    else:
        # Mode A: Direct `snapshot-link --stock` output directory (`stock-link.json` + `work/*`)
        sl_path = direct_sl_path
        if not sl_path.is_file():
            raise RuntimeError(f"missing engine `stock-link.json` at {sl_path}")
        sl = json.loads(sl_path.read_text(encoding="utf-8"))

        sl_elf = sl.get("elf") or {}
        eff_elf = elf_path if elf_path is not None else (engine_out_dir / str(sl_elf.get("name") or ""))
        if not eff_elf.is_file():
            raise RuntimeError(f"ELF file missing for --verify-alpha: {eff_elf}")
        got_elf_sha = _BASE.sha256_file(eff_elf)
        got_elf_sz = eff_elf.stat().st_size
        if sl_elf.get("sha256") and got_elf_sha != str(sl_elf["sha256"]):
            raise RuntimeError(
                f"ELF sha256 {got_elf_sha!r} != stock-link.json {sl_elf.get('sha256')!r}"
            )
        if sl_elf.get("size") is not None and got_elf_sz != int(sl_elf["size"]):
            raise RuntimeError(
                f"ELF size {got_elf_sz} != stock-link.json {sl_elf.get('size')}"
            )

        if map_path is not None:
            eff_map = map_path
        elif (engine_out_dir / DEFAULT_LINK_MAP_NAME).is_file():
            eff_map = engine_out_dir / DEFAULT_LINK_MAP_NAME
        else:
            eff_map = engine_out_dir / "work" / DEFAULT_LINK_MAP_NAME
        if not eff_map.is_file():
            raise RuntimeError(f"missing `-Map` file for --verify-alpha at {eff_map}")

        cli_rel_paths: list[str] = []
        for cfg_ent in sl.get("configs") or ():
            if str(cfg_ent.get("role") or "") == "lib2":
                continue
            for obj_ent in cfg_ent.get("objects") or ():
                cli_rel_paths.append(str(obj_ent["path"]))
        if not cli_rel_paths:
            raise RuntimeError(f"{sl_path} has 0 `configs[*].objects[*]` entries")
        cli_rel_set = set(cli_rel_paths)
        cli_link_objs = [engine_out_dir / r for r in cli_rel_paths]
        for p in cli_link_objs:
            if not p.is_file():
                raise RuntimeError(f"missing staged cliLinkObj {p}")

        raw_inputs = sl.get("inputs") or []
        if not raw_inputs:
            raise RuntimeError(f"{sl_path} has 0 `inputs` entries")

        resolved_inputs: list[tuple[dict[str, Any], pathlib.Path]] = []
        for inp in raw_inputs:
            rel_p = str(inp["path"])
            abs_p = engine_out_dir / rel_p
            if not abs_p.is_file():
                raise RuntimeError(f"missing staged input {abs_p} referenced by {sl_path}")
            exp_s = str(inp.get("sha256") or "")
            if not HEX64_RE.match(exp_s) or _BASE.sha256_file(abs_p) != exp_s:
                raise RuntimeError(f"staged input {abs_p} sha256 != stock-link.json {exp_s!r}")
            resolved_inputs.append((inp, abs_p))

        if stubs_o_path is not None:
            eff_stubs_o = stubs_o_path.resolve()
            if not eff_stubs_o.is_file():
                raise RuntimeError(f"--stubs-o file not found: {eff_stubs_o}")
        else:
            stub_cands = [
                abs_p
                for _inp, abs_p in resolved_inputs
                if "stub" in abs_p.name and abs_p.suffix == ".o"
            ]
            if len(stub_cands) != 1:
                raise RuntimeError(
                    f"expected 1 stub `.o` in {sl_path} inputs (or pass `--stubs-o`), found {stub_cands}"
                )
            eff_stubs_o = stub_cands[0].resolve()

        for inp, abs_p in resolved_inputs:
            rel_p = str(inp["path"])
            if rel_p in cli_rel_set:
                continue
            if abs_p.resolve() == eff_stubs_o:
                continue
            if abs_p.suffix == ".a":
                runtime_archives.append(abs_p)
            elif str(inp.get("kind") or "") == "nativeObject" or "/native/" in f"/{rel_p}":
                native_objs.append(abs_p)
                if abs_p.name == "strlen.lo":
                    has_strlen_lo_obj = True
            else:
                other_objs.append(abs_p)

    pinned_refs, _ = _load_pinned_musl_refs_from_rustc(lock=stock_lock)
    strlen_override: dict[str, str] | None = None
    if has_strlen_lo_obj:
        s_info = pinned_refs["strlen"]
        strlen_override = {
            "source_file": "libc.a",
            "archive_member": str(s_info["member"]),
            "archive_sha256": str(s_info["archive_sha256"]),
            "member_sha256": str(s_info["member_sha256"]),
        }

    alpha_scan = alpha_checks.scan_link_inputs_for_alpha(
        cli_link_objs=cli_link_objs,
        other_objs=other_objs,
        native_objs=native_objs,
        stubs_o=eff_stubs_o,
        runtime_archives=runtime_archives,
        strlen_source_override=strlen_override,
        pinned_musl_ref_bodies=pinned_refs,
    )
    gen_extern_data = alpha_checks.parse_generated_lean_extern_data(repo_root)
    res = alpha_checks.compute_and_verify_alpha_b3(
        elf_bytes=eff_elf.read_bytes(),
        map_text=eff_map.read_text(encoding="utf-8"),
        alpha_scan=alpha_scan,
        generated_extern_data=gen_extern_data,
        expected_lock=stock_lock if strict_lock else None,
        verify_addresses=strict_lock,
    )
    if json_out_path is not None:
        json_out_path.parent.mkdir(parents=True, exist_ok=True)
        json_out_path.write_text(json.dumps(res, indent=2) + "\n", encoding="utf-8")
    if verbose:
        dw = res["alpha_displaced_weak_lock"]
        d1 = res["d1_extern_data_lock"]
        print(
            f"cli-elf-stock --verify-alpha: OK ({eff_elf.name}: {got_elf_sz} bytes, "
            f"sha256={got_elf_sha}, displaced_weak={len(dw['displaced_weak'])}, "
            f"referrers={len(dw['displaced_weak_referrers'])}, "
            f"s2={len(res['s2_real_body_lock'])}, "
            f"d1_kept={len(d1['kept'])}, d1_gc_dead={len(d1['gc_dead'])})"
        )
    return res


def main(argv: list[str] | None = None) -> int:
    repo_root = SCRIPT_DIR.parent
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    mode = ap.add_mutually_exclusive_group(required=True)
    mode.add_argument("--build", action="store_true", help="build stock ELF from pinned source")
    mode.add_argument("--check", action="store_true", help="rebuild in separate path depth and require byte identity")
    mode.add_argument("--verify", action="store_true", help="verify structural/symbol/stub/alpha invariants on an existing stock ELF")
    mode.add_argument("--verify-pin", action="store_true", help="verify stock ELF, cv-stock-link.json, link.map, and lld argv against inputs_stock.lock")
    mode.add_argument("--verify-alpha", action="store_true", help="verify Option α + S1/S2 (GK rows 373-375) + D1 on a stock-link output dir")

    ap.add_argument("--out-dir", type=pathlib.Path, default=None, help="output dir for --build")
    ap.add_argument("--keep-work", type=pathlib.Path, default=None, help="preserve intermediate work_root directory on --build")
    ap.add_argument("--elf", type=pathlib.Path, default=None, help="ELF path for --check / --verify / --verify-pin / --verify-alpha")
    ap.add_argument("--meta", type=pathlib.Path, default=None, help="cv-stock-link.json path for --verify / --verify-pin")
    ap.add_argument("--engine-meta", type=pathlib.Path, default=None, help="engine stock-link.json path for --verify-pin")
    ap.add_argument("--map", type=pathlib.Path, default=None, help="ld.lld -Map path for --verify / --verify-pin / --verify-alpha")
    ap.add_argument("--engine-out-dir", type=pathlib.Path, default=None, help="stock-link out-dir for --verify-alpha")
    ap.add_argument("--stubs-o", type=pathlib.Path, default=None, help="explicit stub .o path for --verify-alpha")
    ap.add_argument("--strict-lock", action="store_true", help="also match exact lock addresses/tables in --verify-alpha")
    ap.add_argument("--json-out", type=pathlib.Path, default=None, help="write --verify-alpha JSON summary to path")
    ap.add_argument("--stock-lock", type=pathlib.Path, default=None, help="inputs_stock.lock path (default: cli-elf/stock/inputs_stock.lock)")
    ap.add_argument("--config", type=pathlib.Path, default=None, help="translation.toml path for --verify / --verify-pin")
    ap.add_argument("--lean-mod", type=pathlib.Path, default=None, help="CliElf.lean module path for --verify-pin (W1)")
    ap.add_argument("--engine", type=pathlib.Path, default=None, help="engine directory (default: arm64-semantics)")
    ap.add_argument("--repo-root", type=pathlib.Path, default=None, help="target repository root (default: parent of scripts/)")
    ap.add_argument("--unpinned", action="store_true", help="build an unpinned repo tree (e.g. pre-lock rename branch); forbidden in --ci")
    ap.add_argument("--lib2-rows", type=str, default=None, help="C2 lib2 rows (`none`, `all`, or comma-separated `[lib2_rows]` names); forbidden in --ci")
    ap.add_argument("--c2-libc-rows", type=str, default=None, help="C2 2C moved libc string rows (`none`, `all`, or subset of memmove,memcmp,bcmp,strlen); forbidden in --ci")
    ap.add_argument("--c2-rehearsal-dehook", action="store_true", help="augment `cliDehookedSymsPlaced` with active C2 rows for `--unpinned` pre-cutover trials; forbidden in --ci")
    ap.add_argument("--alink-lock", "--lock", dest="alink_lock", type=pathlib.Path, default=None, help="run stock-pin/alink_check.py --lock <path> on the output directory")
    ap.add_argument("--cold-zig-cache", action="store_true", help="run second build with isolated empty ZIG cache")
    ap.add_argument("--stdbin", action="store_true", help="use 2-config IO.6b StdBin recipe (inputs_stock_stdbin.lock)")
    ap.add_argument("--ci", action="store_true", help="enforce CI mode (W4: reject --engine override on every command)")
    ap.add_argument("--stock", action="store_true", help="compatibility no-op flag")
    args = ap.parse_args(argv)

    tempfile.tempdir = str(_BASE.get_cache_tmp_root())
    repo_root = args.repo_root.resolve() if args.repo_root is not None else SCRIPT_DIR.parent
    ci_mode = _is_ci_mode(bool(args.ci))
    explicit_engine = args.engine is not None
    if ci_mode and explicit_engine:
        print(
            "cli-elf-stock: FAIL: `--engine` override is forbidden in CI mode (W4)",
            file=sys.stderr,
        )
        return 1
    if ci_mode and args.unpinned:
        print(
            "cli-elf-stock: FAIL: `--unpinned` is forbidden in CI mode",
            file=sys.stderr,
        )
        return 1
    if ci_mode and (
        args.lib2_rows is not None
        or args.c2_libc_rows is not None
        or args.c2_rehearsal_dehook
    ):
        print(
            "cli-elf-stock: FAIL: `--lib2-rows`, `--c2-libc-rows`, and `--c2-rehearsal-dehook` are forbidden in CI mode",
            file=sys.stderr,
        )
        return 1
    if args.unpinned and not args.build:
        print(
            "cli-elf-stock: FAIL: `--unpinned` is only valid with `--build`",
            file=sys.stderr,
        )
        return 1
    if args.c2_rehearsal_dehook and not args.unpinned:
        print(
            "cli-elf-stock: FAIL: `--c2-rehearsal-dehook` requires `--unpinned`",
            file=sys.stderr,
        )
        return 1

    if args.engine is not None:
        engine_dir = args.engine.resolve()
    elif (
        args.unpinned
        and not (repo_root / DEFAULT_REL_ENGINE / ".git").exists()
        and (SCRIPT_DIR.parent / DEFAULT_REL_ENGINE / ".git").exists()
    ):
        engine_dir = (SCRIPT_DIR.parent / DEFAULT_REL_ENGINE).resolve()
    else:
        engine_dir = (repo_root / DEFAULT_REL_ENGINE).resolve()
    default_rel_lock = DEFAULT_REL_STDBIN_LOCK if args.stdbin else DEFAULT_REL_STOCK_LOCK
    stock_lock_path = (
        args.stock_lock.resolve()
        if args.stock_lock is not None
        else (repo_root / default_rel_lock).resolve()
    )
    if args.unpinned and args.stock_lock is None and not stock_lock_path.is_file():
        stock_lock_path = (SCRIPT_DIR.parent / default_rel_lock).resolve()
    loaded_lock: dict[str, Any] = {}
    is_stdbin = bool(args.stdbin)
    if stock_lock_path.is_file():
        try:
            loaded_lock = _load_stock_lock_file(stock_lock_path)
            if _is_stdbin_lock(loaded_lock):
                is_stdbin = True
        except Exception:  # noqa: BLE001
            pass
    default_elf_name = (
        _default_elf_name_for_lock(loaded_lock)
        if loaded_lock
        else ("signal-session-stock-stdbin.elf" if is_stdbin else "signal-session-stock.elf")
    )
    default_rel_elf = DEFAULT_REL_OUT_DIR / default_elf_name
    default_meta_name = DEFAULT_STDBIN_META_NAME if is_stdbin else DEFAULT_STOCK_META_NAME

    try:
        if args.verify_alpha:
            verify_alpha_standalone(
                repo_root=repo_root,
                engine_out_dir=args.engine_out_dir.resolve() if args.engine_out_dir is not None else None,
                elf_path=args.elf.resolve() if args.elf is not None else None,
                map_path=args.map.resolve() if args.map is not None else None,
                stubs_o_path=args.stubs_o.resolve() if args.stubs_o is not None else None,
                stock_lock_path=stock_lock_path,
                strict_lock=bool(args.strict_lock),
                json_out_path=args.json_out.resolve() if args.json_out is not None else None,
                ci_mode=ci_mode,
                verbose=True,
            )
            return 0
        if args.verify_pin:
            elf_path = (
                args.elf if args.elf is not None else (repo_root / default_rel_elf)
            ).resolve()
            meta_path = (
                args.meta if args.meta is not None else (elf_path.parent / default_meta_name)
            ).resolve()
            eng_meta_path = (
                args.engine_meta.resolve() if args.engine_meta is not None else None
            )
            map_path = args.map.resolve() if args.map is not None else None
            cfg_path = args.config.resolve() if args.config is not None else None
            lean_mod_path = args.lean_mod.resolve() if args.lean_mod is not None else None
            verify_stock_pin(
                elf_path=elf_path,
                meta_path=meta_path,
                stock_lock_path=stock_lock_path,
                repo_root=repo_root,
                cfg_path=cfg_path,
                lean_mod_path=lean_mod_path,
                engine_dir=engine_dir,
                engine_meta_path=eng_meta_path,
                map_path=map_path,
                explicit_engine_cli=explicit_engine,
                require_lean_pin=ci_mode,
                ci_mode=ci_mode,
                verbose=True,
            )
            if args.alink_lock is not None:
                _run_alink_check_with_lock(
                    out_dir=elf_path.parent,
                    repo_root=repo_root,
                    alink_lock_path=args.alink_lock.resolve(),
                    elf_path=elf_path,
                    map_path=map_path,
                    stock_lock_path=stock_lock_path,
                    stock_lock=loaded_lock,
                    ci_mode=ci_mode,
                )
            return 0
        if args.verify:
            stock_lock = _load_stock_lock_file(stock_lock_path)
            if _is_stdbin_lock(stock_lock):
                stdbin_ld_mode, stdbin_ld_rel, stdbin_ld_sha, _, stdbin_ld_af = (
                    _resolve_and_verify_stdbin_linker_script(
                        repo_root=repo_root,
                        lock=stock_lock,
                        lock_label=stock_lock_path,
                        ci_mode=ci_mode,
                    )
                )
            else:
                stdbin_ld_mode, stdbin_ld_rel, stdbin_ld_sha, stdbin_ld_af = (
                    "none",
                    None,
                    None,
                    {},
                )
            _verify_clean_pinned_engine(
                engine_dir,
                _expected_engine_commit(stock_lock),
                allow_explicit_mismatch=explicit_engine,
                ci_mode=ci_mode,
            )
            elf_path = (
                args.elf if args.elf is not None else (repo_root / default_rel_elf)
            ).resolve()
            meta_path = (
                args.meta if args.meta is not None else (elf_path.parent / _default_meta_name_for_lock(stock_lock))
            ).resolve()
            map_path = args.map.resolve() if args.map is not None else None
            cfg_path = (
                args.config.resolve()
                if args.config is not None
                else (repo_root / str(stock_lock["config_path"])).resolve()
            )
            exp_manifest_sha = str(stock_lock.get("stub_manifest_sha256") or "")
            meta, stub_manifest, _, _ = _load_and_verify_stock_meta(
                meta_path,
                stock_lock,
                expected_stub_manifest_sha=exp_manifest_sha,
                require_implicit_engine=not explicit_engine,
                allow_explicit_engine_mismatch=explicit_engine,
            )
            if _is_stdbin_lock(stock_lock):
                if str(meta.get("stock_ld_mode") or "none") != stdbin_ld_mode:
                    raise RuntimeError(
                        f"{meta_path} stock_ld_mode {meta.get('stock_ld_mode')!r} != lock {stdbin_ld_mode!r}"
                    )
                if stdbin_ld_mode != "none":
                    if (
                        meta.get("linker_script") != stdbin_ld_rel
                        or meta.get("linker_script_sha256") != stdbin_ld_sha
                    ):
                        raise RuntimeError(
                            f"{meta_path} (linker_script, linker_script_sha256) = "
                            f"({meta.get('linker_script')!r}, {meta.get('linker_script_sha256')!r}) "
                            f"!= lock ({stdbin_ld_rel!r}, {stdbin_ld_sha!r})"
                        )
                    got_meta_af = {
                        str(k): str(v)
                        for k, v in (meta.get("stock_lld_arg_files") or {}).items()
                    }
                    if got_meta_af != stdbin_ld_af:
                        raise RuntimeError(
                            f"{meta_path} stock_lld_arg_files {got_meta_af!r} != lock {stdbin_ld_af!r}"
                        )
                eff_eng_meta = (
                    args.engine_meta.resolve()
                    if args.engine_meta is not None
                    else (elf_path.parent / ENGINE_STOCK_META_NAME)
                )
                if stdbin_ld_mode != "none" or ci_mode or eff_eng_meta.is_file():
                    if not eff_eng_meta.is_file():
                        raise RuntimeError(f"missing engine `stock-link.json` at {eff_eng_meta}")
                    eng_sl = json.loads(eff_eng_meta.read_text(encoding="utf-8"))
                    eng_lld_sec = eng_sl.get("lld") or {}
                    eng_lld_args = _normalize_and_verify_stdbin_engine_arg_files(
                        eng_lld_args_raw=[str(x) for x in (eng_lld_sec.get("args") or ())],
                        eng_arg_files_raw=eng_lld_sec.get("argFiles"),
                        stock_ld_mode=stdbin_ld_mode,
                        linker_script_rel=stdbin_ld_rel,
                        linker_script_sha=stdbin_ld_sha,
                        repo_root=repo_root,
                    )
                    if "lld_argv" in stock_lock:
                        _verify_stdbin_lld_argv_against_lock(
                            eng_lld_args,
                            [str(x) for x in stock_lock["lld_argv"]],
                            eng_sl.get("inputs") or [],
                            stock_lld_arg_files=stdbin_ld_af,
                        )
                cfg_paths_rel = [str(p) for p in (stock_lock.get("config_paths") or ())]
                sib_cfgs = [repo_root / p for p in cfg_paths_rel[1:]]
                c2_meta = meta.get("c2") if isinstance(meta.get("c2"), Mapping) else {}
                c2_lib2_cfg_rel = str(c2_meta.get("lib2_config") or "")
                if c2_lib2_cfg_rel:
                    c2_cfg_p = (repo_root / c2_lib2_cfg_rel).resolve()
                    if all(p.resolve() != c2_cfg_p for p in sib_cfgs):
                        sib_cfgs.append(c2_cfg_p)
                c2_active_roots = [str(x) for x in (c2_meta.get("active_lib2_roots") or ())]
                c2_retired_slots = list(c2_meta.get("retired_stub_slots") or ())
                c2_moved_libc = [str(x) for x in (c2_meta.get("moved_libc_rows") or ())]
                verify_stock_stdbin_elf(
                    elf_path,
                    cfg_path,
                    stub_manifest=stub_manifest,
                    sibling_cfg_paths=sib_cfgs,
                    repo_root=repo_root,
                    active_lib2_roots=c2_active_roots or None,
                    retired_stub_slots=c2_retired_slots,
                    expected_phnum=int(stock_lock.get("expected_phnum", EXPECTED_STDBIN_PHNUM)),
                    expected_pt_loads=int(
                        stock_lock.get("expected_pt_loads", EXPECTED_STDBIN_PT_LOADS)
                    ),
                    expected_symtab_count=int(stock_lock["expected_symtab_count"]),
                    expected_loader_sym_count=int(stock_lock["expected_loader_sym_count"]),
                    expected_stub_manifest_count=int(stock_lock["expected_stub_manifest_count"]),
                    expected_retained_stub_count=int(stock_lock["expected_retained_stub_count"]),
                    expected_stub_manifest_sha=exp_manifest_sha,
                    weak_undefined_allowed=tuple(
                        str(x)
                        for x in stock_lock.get(
                            "weak_undefined_allowed", DEFAULT_STDBIN_WEAK_UNDEFINED_ALLOWED
                        )
                    ),
                    enforce_5d=True,
                    five_d_json_path=meta_path.parent / DEFAULT_STDBIN_5D_NAME,
                    verbose=True,
                )
                if c2_active_roots or c2_moved_libc:
                    eff_v_map = (
                        map_path
                        if map_path is not None
                        else (elf_path.parent / DEFAULT_LINK_MAP_NAME)
                    )
                    if eff_v_map.is_file():
                        _verify_c2_mechanical_invariants(
                            elf_bytes=elf_path.read_bytes(),
                            norm_map_text=eff_v_map.read_text(encoding="utf-8"),
                            active_lib2_roots=c2_active_roots,
                            moved_libc_rows=c2_moved_libc,
                            retired_slots=c2_retired_slots,
                        )
            else:
                verify_stock_elf(
                    elf_path,
                    cfg_path,
                    stub_manifest=stub_manifest,
                    repo_root=repo_root,
                    expected_symtab_count=int(stock_lock["expected_symtab_count"]),
                    expected_loader_sym_count=int(stock_lock["expected_loader_sym_count"]),
                    expected_stub_manifest_count=int(stock_lock["expected_stub_manifest_count"]),
                    expected_retained_stub_count=int(stock_lock["expected_retained_stub_count"]),
                    expected_stub_manifest_sha=exp_manifest_sha,
                    verbose=True,
                )
            if _has_alpha_lock_sections(stock_lock):
                _verify_alpha_from_meta_and_lock(
                    elf_path=elf_path,
                    meta=meta,
                    stock_lock=stock_lock,
                    repo_root=repo_root,
                    map_path=map_path,
                )
            if args.alink_lock is not None:
                _run_alink_check_with_lock(
                    out_dir=elf_path.parent,
                    repo_root=repo_root,
                    alink_lock_path=args.alink_lock.resolve(),
                    elf_path=elf_path,
                    map_path=map_path,
                    stock_lock_path=stock_lock_path,
                    stock_lock=loaded_lock,
                    ci_mode=ci_mode,
                )
            return 0
        if args.build:
            out_dir = (
                args.out_dir if args.out_dir is not None else (repo_root / DEFAULT_REL_OUT_DIR)
            ).resolve()
            keep_work = args.keep_work.resolve() if args.keep_work is not None else None
            built_elf_path = build_stock_into(
                repo_root=repo_root,
                out_dir=out_dir,
                engine_dir=engine_dir,
                explicit_engine=explicit_engine,
                isolated_cold_zig=bool(args.cold_zig_cache),
                stock_lock_path=stock_lock_path,
                keep_work_dir=keep_work,
                ci_mode=ci_mode,
                unpinned=bool(args.unpinned),
                lib2_rows_spec=args.lib2_rows,
                c2_libc_rows_spec=args.c2_libc_rows,
                c2_rehearsal_dehook=bool(args.c2_rehearsal_dehook),
            )
            if args.alink_lock is not None:
                _run_alink_check_with_lock(
                    out_dir=out_dir,
                    repo_root=repo_root,
                    alink_lock_path=args.alink_lock.resolve(),
                    elf_path=built_elf_path,
                    stock_lock_path=stock_lock_path,
                    stock_lock=loaded_lock,
                    ci_mode=ci_mode,
                )
            return 0
        if args.check:
            elf_path = (
                args.elf if args.elf is not None else (repo_root / default_rel_elf)
            ).resolve()
            return check_stock_determinism(
                repo_root=repo_root,
                elf_path=elf_path,
                engine_dir=engine_dir,
                explicit_engine=explicit_engine,
                cold_zig_cache=args.cold_zig_cache,
                stock_lock_path=stock_lock_path,
                ci_mode=ci_mode,
            )
    except Exception as exc:  # noqa: BLE001
        print(f"cli-elf-stock: FAIL: {exc}", file=sys.stderr)
        return 1
    return 2


if __name__ == "__main__":
    sys.exit(main())
